{
  "name": "milabud",
  "version": "3.1.10",
  "description": "MILab - plataforma de laboratorios UD",
  "main": "src/app.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1 $(find tests/unit -type f -name '*.test.js' | sort) && node --experimental-test-coverage --test --test-concurrency=1 $(find tests/integration -type f -name '*.test.js' | sort) && npm run test:coverage:thresholds",
    "test:coverage:thresholds": "node scripts/ci/check-coverage-targets.js",
    "test:unit": "node --test --test-concurrency=1 $(find tests/unit -type f -name '*.test.js' | sort)",
    "test:integration": "node --test --test-concurrency=1 $(find tests/integration -type f -name '*.test.js' | sort)",
    "test:integration:postgres": "node scripts/ci/require-capacitacion-test-database.js && node --test --test-concurrency=1 $(find tests/integration -type f -name '*-postgres-regression.test.js' | sort)",
    "sonar:local": "sh scripts/run-local-sonar.sh",
    "sonar:stop": "sh scripts/run-local-sonar.sh stop",
    "start": "node --watch src/app.js",
    "lint": "npx eslint .",
    "format": "npx prettier --write . --ignore-unknown",
    "format:check": "npx prettier --check . --ignore-unknown",
    "db:audit:check": "node scripts/ci/check-db-fk-audit.js",
    "audit": "npm audit --audit-level=high --omit=dev",
    "audit:fix": "npm audit fix",
    "ci:check": "npm run format:check && npm run lint && npm run db:audit:check && npm run audit",
    "analyze:local": "sh scripts/run-local-analysis.sh"
  },
  "author": "UDFJC - Coordinación General de Laboratorios",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1106.0",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.6",
    "cookie-parser": "^1.4.6",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "express-recaptcha": "^5.1.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.13",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^1.0.0",
    "passport-oauth2": "^1.7.0",
    "path": "^0.12.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.2",
    "pino": "^10.3.1",
    "prom-client": "^15.0.0",
    "qrcode": "^1.5.3",
    "recaptcha": "^1.2.1",
    "tar": "^7.5.21",
    "util": "^0.12.5",
    "uuid": "^11.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "qs": "^6.16.0",
    "jake": "^12.10.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/css": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.1.0",
    "@eslint/markdown": "^7.5.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  }
}
