<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>Mantenimiento programado</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #f8f9fa;">
    <tr>
      <td align="center" style="padding: 20px 10px;">
        <table width="600" border="0" cellspacing="0" cellpadding="0" style="max-width: 600px; width: 100%; margin: 0 auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 6px 18px rgba(0,0,0,0.06);">
          <%- buildEmailHeaderHtml() %>

          <tr>
            <td style="padding: 36px 30px 16px 30px; text-align: center;">
              <h1 style="font-size: 26px; font-weight: 700; color: #202124; margin: 0;">Mantenimiento programado</h1>
            </td>
          </tr>

          <tr>
            <td style="padding: 8px 30px 0 30px; color: #5f6368; font-size: 16px; line-height: 1.6;">
              <p style="margin: 0;">Hola,</p>
              <p style="margin: 16px 0 0 0;">
                Se programo un mantenimiento para un equipo de tu
                <strong><%= perfil === 'coordinador' ? 'facultad' : 'laboratorio' %></strong>.
                La alerta se registra en el modulo de Hoja de Vida y Mantenimientos.
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding: 18px 30px 0 30px;">
              <div style="background-color: #e8f0fe; border: 1px solid #c6dafc; border-radius: 12px; padding: 16px;">
                <div style="font-size: 14px; color: #1a56b0; margin-bottom: 4px;">Equipo</div>
                <div style="font-size: 20px; font-weight: 700; color: #174ea6;"><%= equipoNombre %></div>
                <div style="font-size: 14px; color: #1a56b0; margin-top: 4px;">
                  Codigo interno: <strong><%= codigoInterno %></strong> · Inventario: <strong><%= codigoInventario %></strong>
                </div>
              </div>
            </td>
          </tr>

          <tr>
            <td style="padding: 16px 30px 0 30px; color: #202124; font-size: 15px; line-height: 1.7;">
              <p style="margin: 0;"><strong>Tipo de mantenimiento:</strong> <%= tipoMantenimiento %></p>
              <p style="margin: 6px 0 0 0;"><strong>Actividad:</strong> <%= item %></p>
              <p style="margin: 6px 0 0 0;"><strong>Fecha programada:</strong> <%= fechaProgramada %></p>
              <p style="margin: 6px 0 0 0;"><strong>Responsable:</strong> <%= responsable %></p>
              <p style="margin: 6px 0 0 0;"><strong>Laboratorio:</strong> <%= laboratorio %></p>
              <p style="margin: 6px 0 0 0;"><strong>Facultad:</strong> <%= facultad %></p>
              <p style="margin: 6px 0 0 0;"><strong>Registrado por:</strong> <%= registradoPor %></p>
            </td>
          </tr>

          <% if (programacionUrl) { %>
            <tr>
              <td align="center" style="padding: 24px 30px 30px 30px;">
                <a href="<%= programacionUrl %>" style="display: inline-block; background-color: #0d6efd; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 700;">Ver programacion de mantenimientos</a>
                <p style="margin: 10px 0 0 0; color: #5f6368; font-size: 12px;">Si el boton no funciona, copia este enlace: <%= programacionUrl %></p>
              </td>
            </tr>
          <% } %>

          <%- buildEmailFooterHtml(`
            <p style="margin: 0; text-align: center; color: rgba(255,255,255,0.92); font-size: 14px; line-height: 1.6;">Esta es una alerta automatica de MILab.</p>
            <p style="margin: 8px 0 0 0; text-align: center; color: rgba(255,255,255,0.92); font-size: 14px; line-height: 1.6;"><strong>Coordinacion General de Laboratorios</strong></p>
          `) %>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
