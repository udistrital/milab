<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>Resumen de pendientes</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #f8f9fa;">
    <tr>
      <td align="center" style="padding: 20px 10px;">
        <table width="600" border="0" cellspacing="0" cellpadding="0" style="max-width: 600px; width: 100%; margin: 0 auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 6px 18px rgba(0,0,0,0.06);">
          <%- buildEmailHeaderHtml() %>

          <tr>
            <td style="padding: 36px 30px 16px 30px; text-align: center;">
              <h1 style="font-size: 28px; font-weight: 700; color: #202124; margin: 0;">Resumen de notificaciones pendientes</h1>
            </td>
          </tr>

          <tr>
            <td style="padding: 8px 30px 0 30px; color: #5f6368; font-size: 16px; line-height: 1.6;">
              <p style="margin: 0;">Hola <strong><%= coordinadorNombre %></strong>,</p>
              <p style="margin: 16px 0 0 0;">En este corte tienes notificaciones de sanciones pendientes por atender en tu alcance de coordinación.</p>
            </td>
          </tr>

          <tr>
            <td style="padding: 18px 30px 0 30px;">
              <div style="background-color: #fff8e1; border: 1px solid #ffe082; border-radius: 12px; padding: 16px; text-align: center;">
                <div style="font-size: 14px; color: #7c5d00; margin-bottom: 6px;">Pendientes por atender</div>
                <div style="font-size: 34px; line-height: 1; font-weight: 800; color: #b26a00;"><%= pendientes %></div>
              </div>
            </td>
          </tr>

          <tr>
            <td style="padding: 16px 30px 0 30px; color: #202124; font-size: 15px; line-height: 1.6;">
              <p style="margin: 0;"><strong>Facultades asociadas:</strong> <%= facultades %></p>
              <p style="margin: 10px 0 0 0;"><strong>Fecha de corte:</strong> <%= fechaCorte %></p>
            </td>
          </tr>

          <% if (gestionUrl) { %>
            <tr>
              <td align="center" style="padding: 24px 30px 30px 30px;">
                <a href="<%= gestionUrl %>" style="display: inline-block; background-color: #f59e0b; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 700;">Ir a autorizaciones</a>
                <p style="margin: 10px 0 0 0; color: #5f6368; font-size: 12px;">Si el botón no funciona, copia este enlace: <%= gestionUrl %></p>
              </td>
            </tr>
          <% } %>

          <%- buildEmailFooterHtml(`
            <p style="margin: 0; text-align: center; color: rgba(255,255,255,0.92); font-size: 14px; line-height: 1.6;">Este es un recordatorio automático de MILab.</p>
            <p style="margin: 8px 0 0 0; text-align: center; color: rgba(255,255,255,0.92); font-size: 14px; line-height: 1.6;"><strong>Coordinación General de Laboratorios</strong></p>
          `) %>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
