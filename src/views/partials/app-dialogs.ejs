<link rel="stylesheet" href="/milab/public/css/app-dialogs.css">
<dialog class="modal" id="appDialog" aria-labelledby="appDialogTitle" aria-describedby="appDialogMessage">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="appDialogTitle">
          <i class="bi bi-question-circle me-2" aria-hidden="true"></i>
          <span data-dialog-title>Confirmar acción</span>
        </h2>
        <button type="button" class="btn-close" data-dialog-close aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <p id="appDialogMessage" class="mb-0 text-break"></p>
        <div class="mt-3" data-dialog-input-container hidden>
          <label class="form-label" for="appDialogInput" data-dialog-input-label></label>
          <textarea
            class="form-control"
            id="appDialogInput"
            data-dialog-input
            rows="3"
            maxlength="1000"
          ></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-dialog-cancel>Cancelar</button>
        <button type="button" class="btn btn-primary btn-perso" data-dialog-accept>Confirmar</button>
      </div>
    </div>
  </div>
</dialog>
</div>
<script src="/milab/public/js/app-dialogs.js"></script>
