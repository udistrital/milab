              title="Cerrar sesión"
              data-sidebar-action="logout"
            >
              <span class="app-sidebar-action-icon app-sidebar-door" aria-hidden="true">
                <i class="bi bi-door-open app-sidebar-door-open"></i>
                <i class="bi bi-door-closed app-sidebar-door-closed"></i>
              </span>
            </a>
          </nav>
        <% } %>
      </aside>
      <div class="app-main-content">
        <% if (navigationBreadcrumbs.length) { %>
          <nav class="app-breadcrumb-nav" aria-label="Miga de pan">
            <ol class="breadcrumb app-breadcrumb">
              <% navigationBreadcrumbs.forEach(function(item, index) { %>
                <% const isCurrentBreadcrumb = index === navigationBreadcrumbs.length - 1; %>
                <li
                  class="breadcrumb-item <%= isCurrentBreadcrumb ? 'active' : '' %>"
                  <%- isCurrentBreadcrumb ? 'aria-current="page"' : '' %>
                >
                  <% if (item.href && !isCurrentBreadcrumb) { %>
                    <a href="<%= item.href %>">
                      <% if (index === 0) { %><i class="bi bi-house-door" aria-hidden="true"></i><% } %>
                      <%= item.label %>
                    </a>
                  <% } else { %>
                    <span><%= item.label %></span>
                  <% } %>
                </li>
              <% }) %>
            </ol>
          </nav>
        <% } %>
        <% if (locals.laboratoryDashboard) { const dashboard = locals.laboratoryDashboard; %>
          <section class="laboratory-management-labs" aria-label="Laboratorios asignados">
            <h2 class="h6 mb-2">Mis laboratorios</h2>
            <div class="laboratory-management-labs-grid">
              <% dashboard.laboratorios.forEach(function(lab) { const selected = Number(lab.ualId) === Number(dashboard.laboratorio.ualId); %>
                <article class="laboratory-management-lab-card <%= selected ? 'is-selected' : '' %>">
                  <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="min-w-0">
                      <div class="laboratory-management-lab-card-title"><%= lab.laboratorio %></div>
                      <div class="laboratory-management-lab-card-meta"><%= lab.facultad %><% if (lab.dependencia) { %> · <%= lab.dependencia %><% } %></div>
                    </div>
                    <span class="badge <%= lab.loanActivated ? 'text-bg-success' : 'text-bg-warning' %>">
                      <%= lab.loanActivated ? 'Activado' : `${lab.completion.percent}%` %>
                    </span>
                  </div>
                  <div class="laboratory-management-lab-card-actions">
                    <a
                      class="btn btn-perso btn-sm"
                      href="<%= lab.loanActivated ? `/milab/prestamos/activacion/laboratorios/${lab.ualId}/gestion` : `/milab/prestamos/activacion/laboratorios/${lab.ualId}` %>"
                    ><%= lab.loanActivated ? 'Gestión laboratorio' : 'Configurar laboratorio' %></a>
                    <% if (lab.loanActivated) { %>
                      <a class="btn btn-outline-secondary btn-sm" href="/milab/prestamos/activacion/laboratorios/<%= lab.ualId %>/by-request">Plantilla QR</a>
                    <% } %>
                  </div>
                </article>
              <% }) %>
            </div>
          </section>

          <section class="laboratory-management-context" aria-label="Resumen del laboratorio">
            <h1 class="laboratory-management-context-title">Gestión laboratorio</h1>
            <p class="laboratory-management-context-subtitle">
              <strong><%= dashboard.laboratorio.laboratorio %></strong> · <%= dashboard.laboratorio.facultad %>
              <% if (dashboard.laboratorio.dependencia) { %> · <%= dashboard.laboratorio.dependencia %><% } %>
            </p>
            <div class="laboratory-management-context-stats">
              <div class="laboratory-management-context-stat">
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                <span>Préstamos activos<strong><%= dashboard.stats.activos %></strong></span>
              </div>
              <div class="laboratory-management-context-stat">
                <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                <span>Solicitudes pendientes<strong><%= dashboard.stats.pendientes %></strong></span>
              </div>
              <div class="laboratory-management-context-stat">
                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                <span>Préstamos finalizados<strong><%= dashboard.stats.finalizados %></strong></span>
              </div>
              <div class="laboratory-management-context-stat">
                <i class="bi bi-box-seam" aria-hidden="true"></i>
                <span>Equipos disponibles<strong><%= dashboard.stats.disponibles %></strong></span>
              </div>
            </div>
          </section>

          <aside class="laboratory-management-context-menu">
            <h2 class="mb-1">Submódulos</h2>
            <nav aria-label="Submódulos de gestión del laboratorio">
              <% dashboard.modules.forEach(function(module) { const modulePath = module.route.replace('/milab/prestamos', ''); const active = dashboard.activePath === modulePath || dashboard.activePath.startsWith(modulePath + '/'); %>
                <a
                  class="laboratory-management-context-link <%= active ? 'is-active' : '' %>"
                  href="<%= module.href %>"
                  <%- active ? 'aria-current="page"' : '' %>
                >
                  <i class="bi <%= module.icon %>" aria-hidden="true"></i>
                  <span><%= module.title %></span>
                </a>
              <% }) %>
            </nav>
          </aside>

          <script nonce="<%= cspNonce %>">
            (function () {
              var laboratoryId = <%- JSON.stringify(String(dashboard.laboratorio.ualId)) %>;
              var moduleRoots = <%- JSON.stringify(dashboard.modules.map(function(module) { return module.route; })) %>;

              function carryLaboratoryContext(value) {
                var target;
                try {
                  target = new URL(value, window.location.origin);
                } catch (_error) {
                  return value;
                }
                if (target.origin !== window.location.origin) return value;
                var belongsToModule = moduleRoots.some(function (root) {
                  return target.pathname === root || target.pathname.indexOf(root + '/') === 0;
                });
                if (belongsToModule && !target.searchParams.has('laboratorio')) {
                  target.searchParams.set('laboratorio', laboratoryId);
                }
                return target.href;
              }

              document.addEventListener('click', function (event) {
                var link = event.target.closest('a[href]');
                if (!link || link.target === '_blank') return;
                link.href = carryLaboratoryContext(link.href);
              });
              document.addEventListener('submit', function (event) {
                var form = event.target;
                if (form && form.action) form.action = carryLaboratoryContext(form.action);
              }, true);
            })();
          </script>
        <% } %>

  <script nonce="<%= cspNonce %>">
    function openMicrosoftLoginPopup(url) {
      const width = 600;
      const height = 400;
      const left = window.innerWidth / 2 - width / 2;
      const top = window.innerHeight / 2 - height / 2;
      window.open(url, 'MicrosoftLogin', `width=${width},height=${height},left=${left},top=${top}`);
    }
  </script>
