<%
  const navigation = locals.appNavigation || {};
  const isAuthenticated = typeof locals.isAuthenticated === 'boolean'
    ? locals.isAuthenticated
    : Boolean(locals.tipo || navigation.role);
  const sessionRole = locals.sessionRoleLabel || navigation.roleLabel || 'Invitado';
  const sessionName = locals.nombre || '';
  const sessionDocument = locals.documento || '';
  // const pendingSanctionsCount = Number(locals.pendingSanctionsCount || 0);
  const pendingInventoryApprovalsCount = Number(locals.pendingInventoryApprovalsCount || 0);
  // const shouldShowSanctionsBadge = (link) =>
  //   pendingSanctionsCount > 0 && link && link.href === '/milab/api/aprobacion_multa';
  const shouldShowInventoryApprovalsBadge = (link) =>
    pendingInventoryApprovalsCount > 0 && link && link.href === '/milab/inventarios/aprobaciones';
  const hojasVidaAlertsCount = Number(locals.hojasVidaAlertsCount || 0);
  const shouldShowHojasVidaAlertsBadge = (link) =>
    hojasVidaAlertsCount > 0 && link && link.href === '/milab/inventarios/hojas-vida';
  const primaryLinks = Array.isArray(navigation.primaryLinks) ? navigation.primaryLinks : [];
  const secondaryGroups = Array.isArray(navigation.secondaryGroups) ? navigation.secondaryGroups : [];
  const navigationPrimaryLinks = primaryLinks.filter(
    (link) => link && link.href !== '/milab/inicio'
  );
  const navigationGroups = secondaryGroups.filter(
    (group) => group && Array.isArray(group.items) && group.items.length
  );
  function normalizeNavigationPath(value) {
    return String(value || '').split('?')[0].replace(/\/+$/, '') || '/';
  }
  const navigationCurrentPath = normalizeNavigationPath(locals.navigationCurrentPath);
  const accountLinks = Array.isArray(navigation.accountLinks) ? navigation.accountLinks : [];
  const navigationEntries = [
    ...primaryLinks.filter(Boolean).map((link) => ({ link, section: 'primary', group: null })),
    ...navigationGroups.flatMap((group) =>
      group.items.filter(Boolean).map((link) => ({ link, section: 'secondary', group }))
    ),
    ...accountLinks.filter(Boolean).map((link) => ({ link, section: 'account', group: null })),
  ];
  const activeNavigationMatch =
    navigationEntries
      .map((entry, index) => {
        const href = normalizeNavigationPath(entry.link.href);
        return { entry, href, index, exact: href === navigationCurrentPath };
      })
      .filter(
        ({ href }) =>
          href === navigationCurrentPath ||
          (href !== '/' && navigationCurrentPath.startsWith(`${href}/`))
      )
      .sort(
        (left, right) =>
          Number(right.exact) - Number(left.exact) ||
          right.href.length - left.href.length ||
          left.index - right.index
      )[0] || null;
  const activeNavigationEntry = activeNavigationMatch?.entry || null;
  const activeNavigationHref = activeNavigationMatch?.href || '';
  const activeRole = (locals.tipo || navigation.role || '').toString().trim().toLowerCase();
  const activeSanctionsSummary = locals.activeSanctionsSummary || { enabled: false, count: 0, items: [] };
  const activeSanctionsCount = Number(activeSanctionsSummary.count || 0);
  const shouldShowAvatarSanctionsBadge =
    Boolean(activeSanctionsSummary.enabled) && ['estudiante', 'docente'].includes(activeRole);
  const sanctionsActionHref =
    activeRole === 'docente'
      ? '/milab/api/verifica_multa_docente/verificacion'
      : '/milab/api/sanciones/mis-sanciones';
  const claimNotifications = locals.claimNotifications;
  const studentUsageSummary = locals.studentUsageSummary || null;
  const environmentName = (locals.environmentName || 'development').toString().trim();
  const isNonProductionEnvironment = Boolean(locals.isNonProductionEnvironment);
  const helpManualsGeneralUrl = 'https://udistritaleduco-my.sharepoint.com/:f:/g/personal/laboratoriosgeneral_udistrital_edu_co/IgDBJFgDwv7HSogEaqdp0roXAdwuFV8JMJQ6aKDHSIe9mK4?e=Ms7JNz';
  const helpManualsStudentTeacherUrl = 'https://udistritaleduco-my.sharepoint.com/personal/laboratoriosgeneral_udistrital_edu_co/_layouts/15/onedrive.aspx?id=%2Fpersonal%2Flaboratoriosgeneral%5Fudistrital%5Fedu%5Fco%2FDocuments%2FmanualesGlab%2FManual%2Destudiante%2Ddocente&viewid=65e40934%2D07d6%2D488a%2Dbbf2%2D2942f72e8667';
  const helpManualsCoordinatorLabUrl = 'https://udistritaleduco-my.sharepoint.com/:f:/g/personal/mecinformaticop8217_udistrital_edu_co/IgB8RlfOWePtRKj9FE6toWsKAcrYIC7siuOMGP3l9qCXkl4?e=gOZSvb';
  const helpManualsConfigByRole = {
    estudiante: {
      url: helpManualsStudentTeacherUrl,
      label: 'Abrir manuales de estudiante y docente',
    },
    docente: {
      url: helpManualsStudentTeacherUrl,
      label: 'Abrir manuales de estudiante y docente',
    },
    coordinador: {
      url: helpManualsCoordinatorLabUrl,
      label: 'Abrir manuales de coordinador y laboratorista',
    },
    laboratorista: {
      url: helpManualsCoordinatorLabUrl,
      label: 'Abrir manuales de coordinador y laboratorista',
    },
    admin: {
      url: helpManualsCoordinatorLabUrl,
      label: 'Abrir manuales de coordinador y laboratorista',
    },
  };
  const helpManualsConfig = helpManualsConfigByRole[activeRole] || {
    url: helpManualsGeneralUrl,
    label: 'Abrir manuales',
  };
  const isImpersonatingSession = Boolean(locals.user && locals.user.__impersonating && locals.user.__impersonatedBy);
  const impersonatedByDocument = isImpersonatingSession ? String(locals.user.__impersonatedBy) : '';
  const helpManualsUrl = helpManualsConfig.url;
  const helpManualsLabel = helpManualsConfig.label;
  const navigationGuideMap = {
    Inicio: 'nav-inicio',
    Monitoreo: 'nav-monitoreo',
    'Solicitar certificado': 'nav-solicitar-certificado',
    'Solicitar certificado estudiante': 'nav-solicitar-certificado',
    'Solicitar certificado docente': 'nav-solicitar-certificado',
    Reclamaciones: 'nav-reclamaciones',
    'Registro': 'nav-registro',
    'Registro de coordinadores': 'nav-registro-coordinadores',
    'Registro de laboratoristas': 'nav-registro-laboratoristas',
    'Registro de monitores': 'nav-registro-monitores',
    'Gestores de laboratorio': 'nav-gestores-laboratorio',
    'Registro de Admin': 'nav-registro-admin',
    'Agregar admin': 'nav-registro-admin',
    'Consulta y control': 'nav-consulta-control',
    'Consulta masiva': 'nav-consulta-masiva',
    Certificados: 'nav-certificados',
    'Coordinadores registrados': 'nav-coordinadores-registrados',
    'Estudiantes y docentes registrados': 'nav-estudiantes-docentes-registrados',
    'Laboratoristas registrados': 'nav-laboratoristas-registrados',
    'Monitores registrados': 'nav-monitores-registrados',
    'Facultades y UAL': 'nav-facultades-ual',
    Logs: 'nav-logs',
    'Sanciones': 'nav-sanciones',
    'Listado de sanciones': 'nav-listado-sanciones',
    'Paz y Salvos': 'nav-paz-y-salvos',
    'Verificar estudiante': 'nav-verificar-estudiante',
    'Generar PYS Estudiante': 'nav-verificar-estudiante',
    'Verificar docente': 'nav-verificar-docente',
    'Generar PYS Docente': 'nav-verificar-docente',
    'Generar Paz y Salvos Masivo': 'nav-generar-pys-masivo',
    'Administración': 'nav-administracion',
    'Sanciones de estudiantes': 'nav-sanciones-estudiantes',
    'Registro de sanciones a estudiantes': 'nav-sanciones-estudiantes',
    'Sanciones de docentes': 'nav-sanciones-docentes',
    'Registro de sanciones a docentes': 'nav-sanciones-docentes',
    'Configuración': 'nav-configuracion',
    'Esquema de base de datos': 'nav-esquema-bd',
    'Permisos y menus': 'nav-permisos-menus',
    'Permisos y menús': 'nav-permisos-menus',
    Roles: 'nav-roles',
    'Catálogo de sanciones': 'nav-catalogo-sanciones',
    'Prestamos': 'nav-prestamos',
    'Inventario': 'nav-prestamos-inventario',
    'Equipos': 'nav-prestamos-equipos',
    'Solicitar equipo': 'nav-prestamos-solicitar-equipo',
    'Mis solicitudes': 'nav-prestamos-mis-solicitudes',
    'Gestion de solicitudes': 'nav-prestamos-gestion-solicitudes',
    'Entrega y devolucion': 'nav-prestamos-entrega-devolucion',
    'Incidencias': 'nav-prestamos-incidencias',
    'Solicitar practica': 'nav-prestamos-solicitar-practica',
    'Mis practicas': 'nav-prestamos-mis-practicas',
    'Gestion de practicas': 'nav-prestamos-gestion-practicas',
    'Gestión de prácticas': 'nav-prestamos-gestion-practicas',
    'Salas': 'nav-prestamos-salas',
    'Reportes': 'nav-prestamos-reportes',
    'Auditoria': 'nav-prestamos-auditoria',
    'Parametrizaciones': 'nav-prestamos-parametrizaciones',
    'Configuracion de practicas': 'nav-prestamos-configuracion-practicas',
    'Hojas de Vida y Mantenimientos': 'nav-hojas-vida-mantenimientos',
    'Inventarios': 'nav-inventarios',
    'Gestión del inventario': 'nav-inventario-gestion',
    'Aprobaciones de inventario': 'nav-inventario-aprobaciones',
    'Capacitación': 'nav-capacitacion',
    'Creación de cursos': 'nav-capacitacion-cursos',
    'Asociación curso-equipo': 'nav-capacitacion-asociacion-equipos',
    'Gestionar capacitaciones': 'nav-capacitacion-gestion',
    'Mis capacitaciones': 'nav-capacitacion-mis',
    'Encuentros': 'nav-encuentros',
    'Gestionar encuentros': 'nav-gestionar-encuentros',
    'Mis logros': 'nav-mis-logros',
  };
  function getNavigationGuideAttribute(label) {
    const key = navigationGuideMap[label];
    return key ? `data-guide="${key}"` : '';
  }
  function isNavigationLinkActive(link) {
    const entry = navigationEntries.find((candidate) => candidate.link === link);
    if (entry) return entry === activeNavigationEntry;
    return Boolean(activeNavigationEntry && normalizeNavigationPath(link?.href) === activeNavigationHref);
  }
  function isNavigationGroupActive(group) {
    return activeNavigationEntry?.group === group;
  }
  function buildNavigationBreadcrumbs() {
    if (!activeNavigationEntry) return [];

    const isHomeLink =
      activeNavigationEntry.section === 'primary' &&
      String(activeNavigationEntry.link.label || '').trim().toLowerCase() === 'inicio';
    if (isHomeLink) return [{ label: 'Inicio', current: true }];

    const breadcrumbs = [
      {
        label: 'Inicio',
        href: isAuthenticated ? '/milab/inicio' : '/milab/',
      },
    ];
    if (activeNavigationEntry.group) {
      breadcrumbs.push({ label: activeNavigationEntry.group.title });
    }
    breadcrumbs.push({ label: activeNavigationEntry.link.label, current: true });
    return breadcrumbs;
  }
  const navigationBreadcrumbs = buildNavigationBreadcrumbs();
  function isPrestamosNavLink(link) {
    const label = String(link?.label || '').trim().toLowerCase();
    const href = String(link?.href || '').toLowerCase();
    return label === 'prestamos' || href === '/milab/prestamos/';
  }
  function getPrestamosNavLinkClass(link) {
    if (!isPrestamosNavLink(link)) return '';
    return ' nav-link--prestamos-accent';
  }
  function formatUsageHours(value) {
    const numeric = Number(value || 0);
    if (!Number.isFinite(numeric)) return '0.00';
    return numeric.toFixed(2);
  }
  function formatSanctionDate(value) {
    if (!value) return 'Fecha no disponible';
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return 'Fecha no disponible';
    return parsed.toLocaleDateString('es-CO');
  }
%>
<% if (locals.laboratoryDashboard) { %>
  <style>
    body.app-shell--laboratory-management .app-main-content {
      padding-right: 19rem;
    }

    .laboratory-management-context {
      margin: 0.4rem 1rem 1rem;
      padding: 0.85rem 1rem;
      border: 1px solid #e7e5e4;
      border-radius: 0.9rem;
      background: linear-gradient(110deg, #fffdf7, #ffffff 68%);
      box-shadow: 0 5px 16px rgba(120, 87, 30, 0.07);
    }

    .laboratory-management-labs {
      margin: 0.4rem 1rem 0.75rem;
    }

    .laboratory-management-labs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: 0.6rem;
    }

    .laboratory-management-lab-card {
      min-width: 0;
      padding: 0.75rem 0.85rem;
      border: 1px solid #e7e5e4;
      border-radius: 0.8rem;
      background: #fff;
      box-shadow: 0 4px 12px rgba(120, 87, 30, 0.06);
    }

    .laboratory-management-lab-card.is-selected {
      border-color: #e8b84a;
      box-shadow: 0 0 0 2px rgba(232, 184, 74, 0.14);
    }

    .laboratory-management-lab-card-title {
      overflow: hidden;
      color: #172a47;
      font-size: 0.84rem;
      font-weight: 800;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .laboratory-management-lab-card-meta {
      overflow: hidden;
      color: #64748b;
      font-size: 0.7rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .laboratory-management-lab-card-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.55rem;
    }

    .laboratory-management-context-title {
      margin: 0;
      color: #172a47;
      font-size: 1.05rem;
      font-weight: 800;
    }

    .laboratory-management-context-subtitle {
      margin: 0.15rem 0 0;
      color: #64748b;
      font-size: 0.8rem;
    }

    .laboratory-management-context-stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.55rem;
      margin-top: 0.75rem;
    }

    .laboratory-management-context-stat {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      min-width: 0;
      padding: 0.5rem 0.7rem;
      border: 1px solid #eee9dc;
      border-radius: 0.65rem;
      background: #fffaf0;
      color: #334155;
      font-size: 0.75rem;
    }

    .laboratory-management-context-stat i {
      color: #d97706;
      font-size: 1rem;
    }

    .laboratory-management-context-stat strong {
      display: block;
      color: #172a47;
      font-size: 0.9rem;
    }

    .laboratory-management-context-menu {
      position: fixed;
      z-index: 1020;
      top: 8.5rem;
      right: 1.2rem;
      width: 17rem;
      max-height: calc(100vh - 9.5rem);
      overflow-y: auto;
      padding: 0.8rem;
      border: 1px solid #e7e5e4;
      border-radius: 0.9rem;
      background: #fffdf8;
      box-shadow: 0 8px 24px rgba(120, 87, 30, 0.12);
    }

    .laboratory-management-context-menu h2 {
      padding: 0.3rem 0.55rem 0.6rem;
      color: #64748b;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .laboratory-management-context-link {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.65rem 0.7rem;
      border-radius: 0.6rem;
      color: #475569;
      font-size: 0.85rem;
      text-decoration: none;
    }

    .laboratory-management-context-link:hover,
    .laboratory-management-context-link:focus-visible,
    .laboratory-management-context-link.is-active {
      background: #fff3d4;
      color: #9a5b00;
    }

    .laboratory-management-context-link i {
      width: 1.1rem;
      color: #d97706;
      text-align: center;
    }

    @media (max-width: 1199.98px) {
      body.app-shell--laboratory-management .app-main-content {
        padding-right: 0;
      }

      .laboratory-management-context-menu {
        position: static;
        width: auto;
        max-height: none;
        margin: 0 1rem 1rem;
      }

      .laboratory-management-context-menu nav {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.2rem;
      }
    }

    @media (max-width: 767.98px) {
      .laboratory-management-context-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .laboratory-management-context-menu nav {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
<% } %>

</head>

<body
  class="app-shell <%= locals.laboratoryDashboard ? 'app-shell--laboratory-management' : '' %>"
  data-is-authenticated="<%= isAuthenticated ? 'true' : 'false' %>"
  data-non-production="<%= isNonProductionEnvironment ? 'true' : 'false' %>"
  data-show-oati-login-warning="<%= locals.showOatiLoginWarning ? 'true' : 'false' %>"
  data-session-expires-in="<%= locals.sessionExpiresInMs || '' %>"
  data-session-idle-timeout="<%= locals.sessionPolicy ? locals.sessionPolicy.idleTimeoutMs : '' %>"
>
  <script src="/milab/public/js/session-control.js"></script>
  <header class="app-header">
    <%- include('./environment-banner', { environmentBannerAttached: true }) %>
    <% if (locals.periodChangeAlert) { %>
      <div class="alert alert-warning rounded-0 border-0 mb-0 py-2" role="alert" data-testid="period-change-alert">
        <div class="container">
          El período académico cambió de
          <strong><%= locals.periodChangeAlert.periodo_anterior %></strong> a
          <strong><%= locals.periodChangeAlert.codigo_periodo %></strong>
          el <%= locals.periodChangeAlert.fecha_activacion %>.
          Reconfigura los préstamos para el nuevo período en curso.
        </div>
      </div>
    <% } %>
    <% if (isImpersonatingSession) { %>
      <div class="alert alert-warning rounded-0 border-0 mb-0 py-2" role="status">
        <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span>
              Estás impersonando a <strong><%= sessionName || 'este usuario' %></strong>.
              Admin origen: <strong><%= impersonatedByDocument %></strong>.
            </span>
          <form method="POST" action="/milab/api/dashboard/impersonacion/detener" class="m-0">
            <%- include('./csrf_field') %>
            <button type="submit" class="btn btn-sm btn-dark">Volver a mi sesión admin</button>
          </form>
        </div>
      </div>
    <% } %>
    <div class="app-header-shell">
      <div class="app-header-brand-row">
        <a class="app-header-brand app-header-brand--ud" href="/milab/" aria-label="Universidad Distrital Francisco Jose de Caldas">
          <img
            class="app-header-brand-logo"
            data-theme-logo="true"
            data-logo-light="/milab/public/img/Logo_Escudo_Acreditacion_Horizontal.png"
            data-logo-dark="/milab/public/img/Logo_Escudo_Acreditacion_Horizontal_Blanco.png"
            src="/milab/public/img/Logo_Escudo_Acreditacion_Horizontal.png"
            alt="Universidad Distrital Francisco Jose de Caldas"
          />
        </a>

        <a class="app-header-brand app-header-brand--milab" href="/milab/" aria-label="MILab - Sistema de Laboratorios">
          <span class="app-header-brand-title"><span class="app-brand-mi">MI</span><span class="app-brand-lab">Lab</span></span>
        </a>

        <div class="app-header-brand app-header-brand--labs" aria-label="Coordinación General de Laboratorios">
          <span class="app-header-brand-overline">Coordinación General de</span>
          <span class="app-header-brand-side-title">Laboratorios</span>
        </div>
      </div>

      <% if ((claimNotifications && claimNotifications.count > 0) || !isAuthenticated) { %>
      <nav class="navbar app-navbar app-header-tools" aria-label="Herramientas de usuario">
        <div class="container-fluid app-navbar-inner">
          <div class="app-navbar-actions">
            <% if (claimNotifications && claimNotifications.count > 0) { %>
              <a class="btn app-help-pill" href="<%= claimNotifications.href %>" aria-label="<%= claimNotifications.label %>: <%= claimNotifications.count %>" title="<%= claimNotifications.label %>">
                <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                <span class="app-nav-badge"><%= claimNotifications.count %></span>
              </a>
            <% } %>
            <% if (false && isAuthenticated) { %>
              <div class="app-user-tools d-none d-xl-flex">
                <div class="dropdown">
                  <button
                    class="btn app-user-card app-user-card--icon app-user-menu dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                    data-guide="account-menu"
                    aria-expanded="false"
                    aria-label="Abrir opciones de cuenta"
                  >
                    <span class="app-user-card-icon" aria-hidden="true">
                      <i class="bi bi-person-badge"></i>
                    </span>
                    <% if (shouldShowAvatarSanctionsBadge && activeSanctionsCount > 0) { %>
                      <span class="app-avatar-alert-badge" aria-label="Sanciones activas"><%= activeSanctionsCount %></span>
                    <% } %>
                    <span class="visually-hidden">Cuenta</span>
                  </button>

                  <ul class="dropdown-menu dropdown-menu-end app-user-menu-dropdown">
                    <li class="app-user-menu-summary">
                      <div class="app-user-menu-item">
                        <span class="app-user-menu-label">Nombre</span>
