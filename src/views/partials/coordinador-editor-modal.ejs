<div class="alert alert-success d-none" role="alert" data-coordinador-editor-page-feedback="true"></div>

<div
  class="modal fade"
  id="coordinadorEditorModal"
  tabindex="-1"
  aria-labelledby="coordinadorEditorModalLabel"
  aria-hidden="true"
  data-coordinador-editor-modal="true"
>
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content d-flex flex-column" style="max-height: 85vh;">
      <form method="POST" action="<%= actionUrl %>" data-coordinador-editor-form="true" class="d-flex flex-column h-100 overflow-hidden">
        <%- include('./csrf_field') %>
        <input type="hidden" name="documento" value="" data-coordinador-editor-hidden-document="true">

        <div class="modal-header flex-shrink-0">
          <div>
            <h5 class="modal-title" id="coordinadorEditorModalLabel" data-coordinador-editor-title="true">Editar coordinador</h5>
            <p class="text-muted mb-0 small" data-coordinador-editor-subtitle="true">Actualiza los datos institucionales y asigna el coordinador a una facultad o a sus dependencias.</p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>

        <div class="modal-body flex-grow-1 overflow-y-auto" style="min-height: 0;">
          <div class="alert alert-danger d-none" role="alert" data-coordinador-editor-feedback="true"></div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="coordinadorEditorName">Nombre</label>
              <input type="text" class="form-control" id="coordinadorEditorName" readonly data-coordinador-editor-name="true">
            </div>

            <div class="col-md-6">
              <label class="form-label" for="coordinadorEditorDocument">Documento</label>
              <input type="text" class="form-control" id="coordinadorEditorDocument" readonly data-coordinador-editor-document="true">
            </div>

            <div class="col-md-6">
              <label class="form-label" for="coordinadorEditorCurrent">Correo actual</label>
              <input type="text" class="form-control" id="coordinadorEditorCurrent" readonly data-coordinador-editor-current="true">
            </div>

            <div class="col-md-6">
              <label class="form-label" for="coordinadorEditorInput">Nuevo correo institucional</label>
              <input
                type="email"
                class="form-control"
                id="coordinadorEditorInput"
                name="correo"
                required
                autocomplete="off"
                pattern="^[a-zA-Z0-9._%+\-]+@udistrital\.edu\.co$"
                data-coordinador-editor-input="true"
              >
              <div class="form-text">Solo se permiten correos institucionales con dominio @udistrital.edu.co.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="coordinadorEditorNumeroResolucion">N&uacute;mero y a&ntilde;o de Resoluci&oacute;n</label>
              <input
                type="text"
                class="form-control"
                id="coordinadorEditorNumeroResolucion"
                name="numero_resolucion_coordinador"
                autocomplete="off"
                data-coordinador-editor-numero-resolucion="true"
              >
              <div class="form-text">Ejemplo: 001-2025 / Resoluci&oacute;n 012 del 15 de enero de 2025.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="coordinadorEditorSoporteResolucion">Soporte Resoluci&oacute;n (URL sgral)</label>
              <input
                type="url"
                class="form-control"
                id="coordinadorEditorSoporteResolucion"
                name="soporte_resolucion"
                autocomplete="off"
                pattern="^https?://.+"
                placeholder="https://..."
                data-coordinador-editor-soporte-resolucion="true"
              >
              <div class="form-text">Enlace del sistema sgral o URL p&uacute;blica al documento de soporte.</div>
            </div>

            <div class="col-12">
              <label class="form-label" for="coordinadorEditorFaculty">Facultad</label>
              <select class="form-select" id="coordinadorEditorFaculty" data-coordinador-editor-faculty-select="true">
                <option value="">Selecciona una facultad</option>
                <% if (Array.isArray(facultadesDisponibles) && facultadesDisponibles.length) { %>
                  <% facultadesDisponibles.forEach(function(facultad) { %>
                    <option value="<%= facultad.facultad_id %>" data-coordinador-editor-facultad="<%= facultad.facultad_id %>"><%= facultad.nombre %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <fieldset class="col-12" data-coordinador-editor-assignment-scope="true">
              <legend class="form-label fs-6">Alcance</legend>
              <div class="d-flex flex-column gap-2">
                <div class="form-check">
                  <input class="form-check-input" type="radio" id="coordinadorEditorScopeFaculty" name="coordinador_editor_scope" value="facultad" checked>
                  <label class="form-check-label" for="coordinadorEditorScopeFaculty">Toda la facultad</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" id="coordinadorEditorScopeDependencies" name="coordinador_editor_scope" value="dependencias">
                  <label class="form-check-label" for="coordinadorEditorScopeDependencies">Solo dependencias espec&iacute;ficas</label>
                </div>
              </div>
            </fieldset>

            <div class="col-12 d-none" data-coordinador-editor-dependencies-section="true">
              <label class="form-label" for="coordinadorEditorDependencySearch">Dependencias</label>
              <input
                type="search"
                class="form-control mb-2"
                id="coordinadorEditorDependencySearch"
                placeholder="Filtrar dependencias..."
                autocomplete="off"
                data-coordinador-editor-dependency-search="true"
              >
              <div class="coordinator-dependency-list" data-coordinador-editor-dependencies-container="true">
                <% if (Array.isArray(dependenciasDisponibles) && dependenciasDisponibles.length) { %>
                  <% dependenciasDisponibles.forEach(function(dependencia) { %>
                    <label
                      class="form-check coordinator-dependency-option"
                      data-coordinador-editor-dependency-option="true"
                      data-facultad="<%= dependencia.facultad_id %>"
                      data-search="<%= dependencia.nombre.toLowerCase() %>"
                      hidden
                    >
                      <input
                        class="form-check-input me-2"
                        type="checkbox"
                        value="<%= dependencia.dependencia_id %>"
                        data-coordinador-editor-dependency="true"
                      >
                      <span class="form-check-label"><%= dependencia.nombre %></span>
                    </label>
                  <% }); %>
                  <p class="text-muted mb-0" data-coordinador-editor-dependencies-empty="true" hidden>No hay dependencias que coincidan con la facultad y b&uacute;squeda seleccionadas.</p>
                <% } else { %>
                  <p class="text-muted mb-0">No hay dependencias disponibles.</p>
                <% } %>
              </div>
              <small class="form-text text-muted">Puedes seleccionar una o varias dependencias de la facultad elegida.</small>
            </div>

            <div class="col-12 alert alert-info d-none mb-0" role="status" data-coordinador-editor-legacy-assignment="true">
              La asignaci&oacute;n actual abarca varias facultades o no coincide con el nuevo esquema. Si no cambias esta selecci&oacute;n, se conservar&aacute; sin modificaciones; al elegir una facultad se reemplazar&aacute; por el nuevo alcance.
            </div>
          </div>
        </div>

        <div class="modal-footer flex-shrink-0">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary" data-coordinador-editor-save="true">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  (function() {
    var modalEl = document.querySelector('[data-coordinador-editor-modal="true"]');
    if (!modalEl || typeof bootstrap === 'undefined') return;

    var modal = new bootstrap.Modal(modalEl);
    var form = modalEl.querySelector('[data-coordinador-editor-form="true"]');
    var pageFeedback = document.querySelector('[data-coordinador-editor-page-feedback="true"]');
    var feedback = modalEl.querySelector('[data-coordinador-editor-feedback="true"]');
    var hiddenDocument = modalEl.querySelector('[data-coordinador-editor-hidden-document="true"]');
    var titleEl = modalEl.querySelector('[data-coordinador-editor-title="true"]');
    var nameEl = modalEl.querySelector('[data-coordinador-editor-name="true"]');
    var documentEl = modalEl.querySelector('[data-coordinador-editor-document="true"]');
    var currentEl = modalEl.querySelector('[data-coordinador-editor-current="true"]');
    var inputEl = modalEl.querySelector('[data-coordinador-editor-input="true"]');
    var numeroResolucionEl = modalEl.querySelector('[data-coordinador-editor-numero-resolucion="true"]');
    var soporteResolucionEl = modalEl.querySelector('[data-coordinador-editor-soporte-resolucion="true"]');
    var facultySelect = modalEl.querySelector('[data-coordinador-editor-faculty-select="true"]');
    var dependenciesSection = modalEl.querySelector('[data-coordinador-editor-dependencies-section="true"]');
    var dependenciesContainer = modalEl.querySelector('[data-coordinador-editor-dependencies-container="true"]');
    var dependencySearch = modalEl.querySelector('[data-coordinador-editor-dependency-search="true"]');
    var legacyAssignmentNotice = modalEl.querySelector('[data-coordinador-editor-legacy-assignment="true"]');
    var saveBtn = modalEl.querySelector('[data-coordinador-editor-save="true"]');

    var endpoint = '';
    var assignmentChanged = false;

    function showFeedback(el, type, message) {
      if (!el) return;
      el.className = 'alert alert-' + type + ' fade show';
      el.innerHTML = message + '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>';
      if (el === pageFeedback) {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function hideFeedback(el) {
      if (!el) return;
      el.classList.add('d-none');
      el.className = 'alert d-none';
    }

    function clearModalState() {
      hideFeedback(feedback);
      if (form) form.classList.remove('was-validated');
      if (saveBtn) saveBtn.disabled = false;
    }

    function readCsrfToken() {
      if (!form) return '';
      var meta = document.querySelector('meta[name="csrf-token"]');
      if (meta && meta.getAttribute('content')) return meta.getAttribute('content');
      var input = form.querySelector('input[name="_csrf"]');
      return input ? input.value || '' : '';
    }

    function updateFacultadesCell(documento, facultadesText) {
      var row = document.querySelector('[data-coordinador-row="' + String(documento || '').replace(/"/g, '\\"') + '"]');
      if (!row) return;
      var cell = row.querySelector('[data-facultades-cell="true"]');
      if (cell) cell.textContent = facultadesText || '';
    }

    function updateEmailCell(documento, email) {
      var row = document.querySelector('[data-coordinador-row="' + String(documento || '').replace(/"/g, '\\"') + '"]');
      if (!row) return;
      var cell = row.querySelector('[data-email-cell="true"]');
      if (cell) cell.textContent = email || '';
    }

    function updateNumeroResolucionCell(documento, texto) {
      var row = document.querySelector('[data-coordinador-row="' + String(documento || '').replace(/"/g, '\\"') + '"]');
      if (!row) return;
      var cell = row.querySelector('[data-numero-resolucion-cell="true"]');
      if (cell) cell.textContent = texto || '';
    }

    function updateSoporteResolucionCell(documento, texto) {
      var row = document.querySelector('[data-coordinador-row="' + String(documento || '').replace(/"/g, '\\"') + '"]');
      if (!row) return;
      var cell = row.querySelector('[data-soporte-resolucion-cell="true"]');
      if (!cell) return;
      if (!texto) {
        cell.textContent = '';
        return;
      }
      var anchor = document.createElement('a');
      anchor.href = texto;
      anchor.target = '_blank';
      anchor.rel = 'noopener noreferrer';
      anchor.textContent = texto;
      cell.textContent = '';
      cell.appendChild(anchor);
    }

    function selectedScope() {
      var checked = modalEl.querySelector('input[name="coordinador_editor_scope"]:checked');
      return checked ? checked.value : '';
    }

    function updateDependencyOptions() {
      if (!dependenciesContainer || !facultySelect) return;
      var facultyId = facultySelect.value;
      var filter = dependencySearch ? dependencySearch.value.trim().toLocaleLowerCase() : '';
      var options = dependenciesContainer.querySelectorAll('[data-coordinador-editor-dependency-option="true"]');
      var visibleCount = 0;

      if (dependenciesSection) {
        dependenciesSection.classList.toggle('d-none', selectedScope() !== 'dependencias');
      }
      options.forEach(function(option) {
        var matchesFaculty = option.getAttribute('data-facultad') === facultyId;
        var matchesFilter = (option.getAttribute('data-search') || '').includes(filter);
        option.hidden = !matchesFaculty || !matchesFilter;
        if (!option.hidden) visibleCount++;
        if (!matchesFaculty) {
          var checkbox = option.querySelector('[data-coordinador-editor-dependency="true"]');
          if (checkbox) checkbox.checked = false;
        }
      });

      var emptyMessage = dependenciesContainer.querySelector('[data-coordinador-editor-dependencies-empty="true"]');
      if (emptyMessage) emptyMessage.hidden = !facultyId || visibleCount > 0;
    }

    function resetAssignmentSelection() {
      assignmentChanged = false;
      if (facultySelect) facultySelect.value = '';
      if (dependencySearch) dependencySearch.value = '';
      modalEl.querySelectorAll('input[name="coordinador_editor_scope"]').forEach(function(radio) {
        radio.checked = radio.value === 'facultad';
      });
      if (dependenciesContainer) {
        dependenciesContainer.querySelectorAll('[data-coordinador-editor-dependency="true"]').forEach(function(check) {
          check.checked = false;
        });
      }
      if (legacyAssignmentNotice) legacyAssignmentNotice.classList.add('d-none');
      updateDependencyOptions();
    }

    function setAssignmentFromExisting(selectedIds) {
      var ids = selectedIds.map(String);
      var rootIds = Array.from(facultySelect.options)
        .filter(function(option) {
          return option.hasAttribute('data-coordinador-editor-facultad') && ids.indexOf(option.value) >= 0;
        })
        .map(function(option) { return option.value; });
      var dependencyOptions = dependenciesContainer
        ? Array.from(dependenciesContainer.querySelectorAll('[data-coordinador-editor-dependency-option="true"]'))
        : [];
      var dependencyParents = new Map();
      dependencyOptions.forEach(function(option) {
        var checkbox = option.querySelector('[data-coordinador-editor-dependency="true"]');
        if (checkbox) dependencyParents.set(checkbox.value, option.getAttribute('data-facultad'));
      });

      if (rootIds.length === 1 && ids.every(function(id) {
        return id === rootIds[0] || dependencyParents.get(id) === rootIds[0];
      })) {
        facultySelect.value = rootIds[0];
        modalEl.querySelector('#coordinadorEditorScopeFaculty').checked = true;
        updateDependencyOptions();
        return;
      }

      var parents = new Set();
      var allDependencies = ids.every(function(id) {
        var parentId = dependencyParents.get(id);
        if (!parentId) return false;
        parents.add(parentId);
        return true;
      });
      if (rootIds.length === 0 && allDependencies && parents.size === 1) {
        var parentId = Array.from(parents)[0];
        facultySelect.value = parentId;
        modalEl.querySelector('#coordinadorEditorScopeDependencies').checked = true;
        dependenciesContainer.querySelectorAll('[data-coordinador-editor-dependency="true"]').forEach(function(check) {
          check.checked = ids.indexOf(check.value) >= 0;
        });
        updateDependencyOptions();
        return;
      }

      if (legacyAssignmentNotice) legacyAssignmentNotice.classList.remove('d-none');
      updateDependencyOptions();
    }

    document.querySelectorAll('[data-coordinador-editor-trigger="true"]').forEach(function(button) {
      button.addEventListener('click', function() {
        clearModalState();
        resetAssignmentSelection();
        endpoint = button.getAttribute('data-coordinador-editor-endpoint') || form.getAttribute('action') || '';
        if (form && endpoint) form.setAttribute('action', endpoint);

        var documento = button.getAttribute('data-coordinador-editor-document') || '';
        var nombre = button.getAttribute('data-coordinador-editor-name') || '';
        var correo = button.getAttribute('data-coordinador-editor-current-email') || '';
        var numeroResolucion = button.getAttribute('data-coordinador-editor-numero-resolucion') || '';
        var soporteResolucion = button.getAttribute('data-coordinador-editor-soporte-resolucion') || '';
        var rawFacIds = button.getAttribute('data-coordinador-editor-facultad-ids') || '[]';
        var selectedIds = [];
        try {
          var parsed = JSON.parse(rawFacIds);
          selectedIds = Array.isArray(parsed) ? parsed : [];
        } catch (e) {
          selectedIds = [];
        }

        if (hiddenDocument) hiddenDocument.value = documento;
        if (titleEl) titleEl.textContent = 'Editar coordinador';
        if (nameEl) nameEl.value = nombre;
        if (documentEl) documentEl.value = documento;
        if (currentEl) currentEl.value = correo;
        if (inputEl) {
          inputEl.value = correo;
        }
        if (numeroResolucionEl) numeroResolucionEl.value = numeroResolucion;
        if (soporteResolucionEl) soporteResolucionEl.value = soporteResolucion;

        setAssignmentFromExisting(selectedIds);

        modal.show();
      });
    });

    if (facultySelect) {
      facultySelect.addEventListener('change', function() {
        assignmentChanged = true;
        if (legacyAssignmentNotice) legacyAssignmentNotice.classList.add('d-none');
        if (dependenciesContainer) {
          dependenciesContainer.querySelectorAll('[data-coordinador-editor-dependency="true"]').forEach(function(check) {
            check.checked = false;
          });
        }
        updateDependencyOptions();
      });
    }

    modalEl.querySelectorAll('input[name="coordinador_editor_scope"]').forEach(function(radio) {
      radio.addEventListener('change', function() {
        assignmentChanged = true;
        if (legacyAssignmentNotice) legacyAssignmentNotice.classList.add('d-none');
        updateDependencyOptions();
      });
    });

    if (dependenciesContainer) {
      dependenciesContainer.addEventListener('change', function(event) {
        if (event.target.matches('[data-coordinador-editor-dependency="true"]')) {
          assignmentChanged = true;
          if (legacyAssignmentNotice) legacyAssignmentNotice.classList.add('d-none');
        }
      });
    }

    if (dependencySearch) dependencySearch.addEventListener('input', updateDependencyOptions);

    if (form) {
      form.addEventListener('submit', async function(event) {
        event.preventDefault();
        if (!form.checkValidity()) {
          event.stopPropagation();
          form.classList.add('was-validated');
          return;
        }

        var selectedDependencies = dependenciesContainer
          ? dependenciesContainer.querySelectorAll('[data-coordinador-editor-dependency="true"]:checked')
          : [];
        if (assignmentChanged && !facultySelect.value) {
          showFeedback(feedback, 'warning', 'Debes seleccionar una facultad.');
          return;
        }
        if (assignmentChanged && selectedScope() === 'dependencias' && selectedDependencies.length === 0) {
          showFeedback(feedback, 'warning', 'Debes seleccionar al menos una dependencia.');
          return;
        }

        hideFeedback(feedback);
        if (saveBtn) saveBtn.disabled = true;

        var documento = hiddenDocument ? hiddenDocument.value : '';
        var correo = inputEl ? inputEl.value : '';
        var numeroResolucion = numeroResolucionEl ? numeroResolucionEl.value : '';
        var soporteResolucion = soporteResolucionEl ? soporteResolucionEl.value : '';
        var requestBody = {
          documento: documento,
          correo: correo,
          numero_resolucion_coordinador: numeroResolucion,
          soporte_resolucion: soporteResolucion
        };
        if (assignmentChanged) {
          requestBody.facultad_id = facultySelect.value;
          requestBody.alcance = selectedScope();
          requestBody.dependencia_ids = Array.from(selectedDependencies).map(function(check) {
            return check.value;
          });
        }

        try {
          var response = await fetch(endpoint || form.getAttribute('action') || '', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': readCsrfToken() || '',
              'Accept': 'application/json'
            },
            body: JSON.stringify(requestBody)
          });

          var data = await response.json().catch(function() {
            return { ok: false, message: 'No fue posible procesar la respuesta del servidor.' };
          });

          if (!response.ok || !data.ok) {
            throw new Error(data.message || 'No fue posible actualizar el coordinador.');
          }

          if (assignmentChanged) {
            updateFacultadesCell(documento, data.facultad_nombre || '');
            var trigger = document.querySelector(
              '[data-coordinador-editor-trigger="true"][data-coordinador-editor-document="' +
                String(documento || '').replace(/"/g, '\\"') +
                '"]'
            );
            if (trigger) {
              trigger.setAttribute('data-coordinador-editor-facultad-ids', JSON.stringify(data.facultad_ids || []));
            }
          }
          updateEmailCell(documento, correo || data.correo || '');
          updateNumeroResolucionCell(documento, numeroResolucion || data.numero_resolucion_coordinador || '');
          updateSoporteResolucionCell(documento, soporteResolucion || data.soporte_resolucion || '');

          if (currentEl) currentEl.value = correo || data.correo || '';
          if (numeroResolucionEl) numeroResolucionEl.value = numeroResolucion || data.numero_resolucion_coordinador || '';
          if (soporteResolucionEl) soporteResolucionEl.value = soporteResolucion || data.soporte_resolucion || '';

          modal.hide();
          showFeedback(pageFeedback, 'success', 'Coordinador actualizado correctamente.');
          window.setTimeout(function() {
            hideFeedback(pageFeedback);
          }, 4000);
        } catch (error) {
          showFeedback(feedback, 'danger', error.message || 'No fue posible actualizar el coordinador.');
        } finally {
          if (saveBtn) saveBtn.disabled = false;
        }
      });
    }

    modalEl.addEventListener('hidden.bs.modal', function() {
      clearModalState();
    });
  })();
</script>
