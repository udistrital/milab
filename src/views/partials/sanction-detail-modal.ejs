<%
    const returnSource = locals.returnSource || 'listado';
    const lookupToken = locals.lookupToken || '';
%>
<style nonce="<%= cspNonce %>">
    .app-detail-modal {
        z-index: 3000;
    }

    .modal-backdrop.show {
        z-index: 2990;
    }
</style>
<div class="modal fade app-detail-modal" id="detalleSancionModal" tabindex="-1" aria-labelledby="detalleSancionLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header sanction-detail-header">
                <div class="sanction-detail-heading">
                    <span class="sanction-detail-icon" aria-hidden="true"><i class="bi bi-shield-exclamation"></i></span>
                    <div>
                        <p class="sanction-detail-kicker">Gestión de sanciones</p>
                        <h5 class="modal-title" id="detalleSancionLabel">Detalle de la sanción</h5>
                        <p class="sanction-detail-subtitle">Información del estudiante, la sanción y su consulta en SGA.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <section class="sanction-detail-section" aria-labelledby="sanctionPersonHeading">
                    <div class="sanction-detail-section-heading">
                        <i class="bi bi-person-vcard" aria-hidden="true"></i>
                        <div>
                            <h6 id="sanctionPersonHeading">Persona sancionada</h6>
                            <p>Identificación y estado actual</p>
                        </div>
                    </div>
                    <div class="sanction-detail-grid">
                        <div class="sanction-detail-field sanction-detail-field--wide">
                            <span>Nombre</span>
                            <strong data-detail-field="nombre"></strong>
                            <small class="text-warning d-none" data-oati-status aria-live="polite"></small>
                        </div>
                        <div class="sanction-detail-field">
                            <span>Documento</span>
                            <strong data-detail-field="documento"></strong>
                        </div>
                        <div class="sanction-detail-field">
                            <span>Código</span>
                            <strong data-detail-field="codigo"></strong>
                        </div>
                        <div class="sanction-detail-field">
                            <span>Estado</span>
                            <strong data-detail-field="estado"></strong>
                        </div>
                        <div class="sanction-detail-field">
                            <span>Identificador de sanción</span>
                            <strong data-detail-field="id"></strong>
                        </div>
                    </div>
                </section>

                <section class="sanction-detail-section" aria-labelledby="sanctionInfoHeading">
                    <div class="sanction-detail-section-heading">
                        <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
                        <div>
                            <h6 id="sanctionInfoHeading">Información de la sanción</h6>
                            <p>Registro en el sistema de laboratorios</p>
                        </div>
                    </div>
                    <div class="sanction-detail-grid">
                        <div class="sanction-detail-field">
                            <span>Categoría</span>
                            <strong data-detail-field="categoria"></strong>
                        </div>
                        <div class="sanction-detail-field">
                            <span>Tipo</span>
                            <strong data-detail-field="tipo"></strong>
                        </div>
                        <div class="sanction-detail-field">
                            <span>Fecha</span>
                            <strong data-detail-field="fecha"></strong>
                        </div>
                        <div class="sanction-detail-field">
                            <span>Laboratorista</span>
                            <strong data-detail-field="laboratorista"></strong>
                        </div>
                        <div class="sanction-detail-field">
                            <span>UAL</span>
                            <strong data-detail-field="ual"></strong>
                        </div>
                        <div class="sanction-detail-field">
                            <span>Facultad</span>
                            <strong data-detail-field="facultad"></strong>
                        </div>
                        <div class="sanction-detail-field">
                            <span>Dependencia</span>
                            <strong data-detail-field="dependencia"></strong>
                        </div>
                        <div class="sanction-detail-field sanction-detail-field--wide">
                            <span>Observaciones</span>
                            <strong data-detail-field="observaciones"></strong>
                        </div>
                    </div>
                </section>

                <section class="sanction-detail-section" aria-labelledby="sanctionClaimHeading">
                    <h6 id="sanctionClaimHeading">Historial de reclamación del estudiante</h6>
                    <div data-claim-history aria-live="polite"></div>
                </section>
                <section class="sanction-sga-panel d-none" data-sga-debts-panel aria-live="polite">
                    <div class="sanction-detail-section-heading sanction-sga-heading">
                        <i class="bi bi-bank" aria-hidden="true"></i>
                        <div>
                            <h6>Multas activas en SGA</h6>
                            <p data-sga-debts-status>Consultando...</p>
                        </div>
                    </div>
                    <div class="sanction-sga-list" data-sga-debts-list></div>
                </section>
                <div class="border-top pt-3 mt-3 d-none" data-sanction-action-panel>
                    <h6 class="mb-3" data-sanction-action-title>Actualizar sanción</h6>
                    <form action="/milab/api/aprobacion_multa/activar" method="POST" data-sanction-action-form="activate" class="d-none row g-3" data-submit-once="true">
                        <%- include('./csrf_field'); %>
                        <input type="hidden" name="multa_id" data-sanction-action-id>
                        <input type="hidden" name="source" value="<%= returnSource %>">
                        <% if (lookupToken) { %><input type="hidden" name="lookup_token" value="<%= lookupToken %>"><% } %>
                        <div class="col-12">
                            <label class="form-label" for="tipo_sancion_listado">Tipo de sanción</label>
                            <select id="tipo_sancion_listado" name="tipo_sancion" class="form-select" required>
                                <option value="">Selecciona tipo de sanción</option>
                                <% (Array.isArray(locals.SANCTION_TYPES) ? locals.SANCTION_TYPES : []).forEach(function (tipo) { %>
                                    <option value="<%= tipo %>"><%= tipo %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-success" data-submit-loading-label="Activando...">Activar sanción</button>
                        </div>
                    </form>
                    <form action="/milab/api/aprobacion_multa/saldar" method="POST" data-sanction-action-form="saldar" class="d-none d-flex justify-content-end gap-2" data-submit-once="true">
                        <%- include('./csrf_field'); %>
                        <input type="hidden" name="multa_id" data-sanction-action-id>
                        <input type="hidden" name="source" value="<%= returnSource %>">
                        <% if (lookupToken) { %><input type="hidden" name="lookup_token" value="<%= lookupToken %>"><% } %>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" data-submit-loading-label="Saldando...">Saldar sanción</button>
                    </form>
                    <form action="/milab/api/aprobacion_multa/aplazar" method="POST" data-sanction-action-form="defer" class="d-none d-flex justify-content-end gap-2" data-submit-once="true">
                        <%- include('./csrf_field'); %>
                        <input type="hidden" name="multa_id" data-sanction-action-id>
                        <input type="hidden" name="source" value="<%= returnSource %>">
                        <% if (lookupToken) { %><input type="hidden" name="lookup_token" value="<%= lookupToken %>"><% } %>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-warning" data-submit-loading-label="Aplazando...">Aplazar sanción</button>
                    </form>
                    <form action="/milab/api/aprobacion_multa/reactivar" method="POST" data-sanction-action-form="reactivate" class="d-none d-flex justify-content-end gap-2" data-submit-once="true">
                        <%- include('./csrf_field'); %>
                        <input type="hidden" name="multa_id" data-sanction-action-id>
                        <input type="hidden" name="source" value="<%= returnSource %>">
                        <% if (lookupToken) { %><input type="hidden" name="lookup_token" value="<%= lookupToken %>"><% } %>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success" data-submit-loading-label="Reactivando...">Reactivar sanción</button>
                    </form>
                    <form action="/milab/api/quitar-multa" method="POST" data-sanction-action-form="remove" class="d-none d-flex justify-content-end gap-2" data-submit-once="true">
                        <%- include('./csrf_field'); %>
                        <input type="hidden" name="con_id" data-sanction-action-id>
                        <input type="hidden" name="source" value="<%= returnSource %>">
                        <% if (lookupToken) { %><input type="hidden" name="lookup_token" value="<%= lookupToken %>"><% } %>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" data-submit-loading-label="Procesando...">Saldar sanción</button>
                    </form>
                    <form action="/milab/api/get_list_multas/editar" method="POST" data-sanction-action-form="edit" class="d-none row g-3" data-submit-once="true">
                        <%- include('./csrf_field'); %>
                        <input type="hidden" name="multa_id" data-sanction-action-id>
                        <input type="hidden" name="source" value="<%= returnSource %>">
                        <% if (lookupToken) { %><input type="hidden" name="lookup_token" value="<%= lookupToken %>"><% } %>
                        <div class="col-12">
                            <label class="form-label" for="categoria_sancion_listado">Categoría de sanción</label>
                            <select id="categoria_sancion_listado" name="cat_multa" class="form-select" required>
                                <%- include('./multa-options'); %>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="tipo_sancion_edicion_listado">Tipo de sanción</label>
                            <select id="tipo_sancion_edicion_listado" name="tipo_sancion" class="form-select" required>
                                <option value="">Selecciona tipo de sanción</option>
                                <% (Array.isArray(locals.SANCTION_TYPES) ? locals.SANCTION_TYPES : []).forEach(function (tipo) { %>
                                    <option value="<%= tipo %>"><%= tipo %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-warning" data-submit-loading-label="Guardando cambios...">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
