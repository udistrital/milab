<%- include('../partials/header'); -%>
<% if (locals.tipo !== 'admin' && locals.tipo !== 'laboratorista' && locals.tipo !== 'coordinador') { %>
  <script nonce="<%= cspNonce %>">
    window.location.href = '/milab/auth/login';
  </script>
<% } else { %>
  <%
    const isTeacher = personType === 'docente';
    const personKind = isTeacher ? 'docente' : 'estudiante';
    const successFeedback = locals.successFeedback || null;
    const registrationUrl = isTeacher
      ? '/milab/api/get-info-multa-docente'
      : '/milab/api/get-info-multa';
    const searchUrl = isTeacher
      ? '/milab/api/get-info-multa-docente/get'
      : '/milab/api/get-info-multa/get';
  %>
  <main class="container app-page-shell" data-sanction-person-actions-page="true">
    <section class="app-page-header">
      <p class="app-home-welcome-kicker">Paso 2 de 2</p>
      <h1 class="app-page-title">Acciones para <%= personKind %></h1>
      <p class="app-page-subtitle">Revisa la identidad y selecciona qué deseas hacer. No tendrás que buscar de nuevo.</p>
    </section>

    <section class="card app-form-panel app-fine-person-summary">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
          <div>
            <span class="text-muted small"><%= personKind %> encontrado</span>
            <h2 class="app-panel-title mt-1 mb-0"><%= person.nombre %></h2>
          </div>
          <span class="badge rounded-pill text-bg-<%= person.estado === 'ACTIVO' ? 'success' : 'secondary' %>">
            <%= person.estado || 'Estado no disponible' %>
          </span>
        </div>
        <dl class="row g-3 mb-0 mt-2">
          <div class="col-12 col-md-4">
            <dt class="text-muted small">Documento</dt>
            <dd class="mb-0 fw-semibold"><%= person.documento %></dd>
          </div>
          <% if (!isTeacher) { %>
            <div class="col-12 col-md-4">
              <dt class="text-muted small">Código institucional</dt>
              <dd class="mb-0 fw-semibold"><%= person.codigo || 'No disponible' %></dd>
            </div>
            <div class="col-12 col-md-4">
              <dt class="text-muted small">Programa académico</dt>
              <dd class="mb-0 fw-semibold"><%= person.programa || 'No disponible' %></dd>
            </div>
          <% } %>
        </dl>
      </div>
    </section>

    <% if (!isTeacher) { %>
      <%
        const sanctionHistory = locals.sanctionHistory || [];
        const sga = locals.sga || { configured: false, debts: [], failed: false };
      %>
      <section class="mt-4" aria-labelledby="fineActionHeading">
        <% if (successFeedback) { %>
          <div class="alert alert-success mb-3" role="status" aria-live="polite">
            <strong>Operación completada.</strong>
            <%= successFeedback === 'saldada'
                ? ' La sanción se marcó como saldada correctamente.'
                : successFeedback === 'aplazada'
                    ? ' La sanción se aplazó correctamente.'
                    : successFeedback === 'reactivada'
                        ? ' La sanción se reactivó correctamente.'
                        : successFeedback === 'editada'
                            ? ' La sanción se editó correctamente.'
                            : successFeedback === 'registrada'
                                ? ' La sanción se registró correctamente.'
                                : ' La sanción se activó correctamente.' %>
          </div>
        <% } %>

        <div class="d-flex flex-wrap gap-2 mb-3">
          <form method="POST" action="<%= registrationUrl %>">
            <%- include('../partials/csrf_field') %>
            <input type="hidden" name="lookup_token" value="<%= lookupToken %>">
            <button class="btn btn-perso" type="submit" data-submit-lock="true">
              <i class="bi bi-plus-circle" aria-hidden="true"></i> Agregar sanción
            </button>
          </form>
        </div>

        <div class="mb-3">
          <span class="badge rounded-pill text-bg-<%= activeSanctionCount > 0 ? 'warning' : 'light' %>">
            <%= activeSanctionCount %> sanciones activas
          </span>
          <% if (sga.configured) { %>
            <div class="mt-2">
              <% if (sga.failed) { %>
                <span class="badge rounded-pill text-bg-warning">Consulta SGA no concluyente</span>
              <% } %>
              <% if (sga.debts.length > 0) { %>
                <button
                  type="button"
                  class="badge rounded-pill text-bg-danger border-0"
                  data-bs-toggle="modal"
                  data-bs-target="#sgaSancionesPersonaModal"
                >
                  <%= sga.debts.length %>
                  <%= sga.debts.length === 1 ? 'multa' : 'multas' %> de laboratorio en SGA ·
                  Ver detalle
                </button>
              <% } else if (!sga.failed) { %>
                <span class="badge rounded-pill text-bg-light">0 multas de laboratorio en SGA</span>
              <% } %>
            </div>
            <% if (sga.failed && sga.message) { %>
              <div class="alert alert-warning mt-2 mb-0" role="status"><%= sga.message %></div>
            <% } else if (sga.failed) { %>
              <div class="alert alert-warning mt-2 mb-0" role="status">
                No fue posible consultar SGA. El estado de las multas no está verificado.
              </div>
            <% } %>
          <% } %>
        </div>

        <% if (sanctionHistory.length) { %>
          <section class="app-sanctions-report" aria-label="Historial de sanciones del estudiante">
            <table id="tbl-sanciones-persona" class="table table-bordered table-striped table-hover app-table-compact app-sanctions-table js-data-grid app-grid-contained" data-grid-page-length="25" data-grid-scroll-x="false">
              <thead class="text-light">
                <tr>
                  <th>Identificación</th>
                  <th>Estudiante</th>
                  <th>Laboratorio</th>
                  <th class="app-sanction-info-column">Información de sanción</th>
                  <th data-grid-filter="false" data-grid-orderable="false">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% sanctionHistory.forEach(function (data) { %>
                  <tr>
                    <%- include('../partials/sanction-report-cells', { sanction: data }) %>
                    <%- include('../partials/sanction-info-cell', { sanction: data }) %>
                    <%- include('../partials/sanction-actions-cell', { sanction: data, sgaConfigured: sga.configured }) %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </section>
        <% } else if (locals.sanctionHistoryError) { %>
          <div class="alert alert-warning mb-3" role="status">
            No fue posible mostrar el historial de sanciones: <%= sanctionHistoryError %>
          </div>
        <% } else { %>
          <p class="text-muted mb-3">El estudiante no tiene sanciones registradas en MILab.</p>
        <% } %>

        <div class="mt-3">
          <a class="btn btn-outline-secondary" href="<%= searchUrl %>">Buscar otra persona</a>
        </div>
      </section>

      <%- include('../partials/sanction-detail-modal', { returnSource: 'get-info-multa-persona', lookupToken: lookupToken }); %>
      <script src="/milab/public/js/sanction-detail-modal.js"></script>

      <% if (sga.configured && sga.debts.length > 0) { %>
        <div class="modal fade" id="sgaSancionesPersonaModal" tabindex="-1" aria-labelledby="sgaSancionesPersonaLabel" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
              <div class="modal-header">
                <h2 class="modal-title h5" id="sgaSancionesPersonaLabel">Sanciones registradas en SGA</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
              </div>
              <div class="modal-body">
                <% sga.debts.forEach(function (debt) { %>
                  <article class="card mb-3">
                    <div class="card-body">
                      <h3 class="h6 mb-3"><%= debt.categoria || debt.DEU_MATERIAL || 'Multa reportada por SGA' %></h3>
                      <dl class="row g-2 mb-0">
                        <div class="col-12 col-md-6">
                          <dt class="text-muted small">Código académico consultado</dt>
                          <dd class="mb-0 fw-semibold"><%= debt.codigo_estudiante || debt.DEU_EST_COD || 'No disponible' %></dd>
                        </div>
                        <div class="col-12 col-md-6">
                          <dt class="text-muted small">Concepto de laboratorio</dt>
                          <dd class="mb-0 fw-semibold"><%= debt.nombre_concepto || debt.CPTO_NOMBRE || debt.DEU_CPTO_NOMBRE || 'No reportado por SGA' %></dd>
                        </div>
                        <div class="col-12 col-md-6">
                          <dt class="text-muted small">Identificador SGA</dt>
                          <dd class="mb-0 fw-semibold"><%= debt.id_sga || debt.DEU_ID || 'No disponible' %></dd>
                        </div>
                        <div class="col-12 col-md-6">
                          <dt class="text-muted small">Tipo de concepto</dt>
                          <dd class="mb-0 fw-semibold"><%= debt.tipo_concepto || debt.CPTO_TIPO || debt.DEU_CPTO_TIPO || 'No reportado por SGA' %></dd>
                        </div>
                        <div class="col-12 col-md-6">
                          <dt class="text-muted small">Valor reportado</dt>
                          <dd class="mb-0 fw-semibold"><%= debt.valor ?? debt.DEU_MULTA ?? 'No disponible' %></dd>
                        </div>
                        <div class="col-12 col-md-6">
                          <dt class="text-muted small">Estado SGA</dt>
                          <dd class="mb-0 fw-semibold"><%= debt.estado || debt.DEU_ESTADO || 'No disponible' %></dd>
                        </div>
                        <div class="col-12 col-md-6">
                          <dt class="text-muted small">Fecha</dt>
                          <dd class="mb-0 fw-semibold"><%= debt.fecha || debt.DEU_FECHA || 'No disponible' %></dd>
                        </div>
                        <div class="col-12 col-md-6">
                          <dt class="text-muted small">Periodo</dt>
                          <dd class="mb-0 fw-semibold"><%= [debt.anio || debt.DEU_ANO, debt.periodo || debt.DEU_PER].filter(Boolean).join(' / ') || 'No disponible' %></dd>
                        </div>
                        <div class="col-12 col-md-6">
                          <dt class="text-muted small">Fecha de pago</dt>
                          <dd class="mb-0 fw-semibold"><%= debt.fecha_pago || debt.DEU_FECHA_PAGO || 'Pendiente' %></dd>
                        </div>
                        <div class="col-12 col-md-6">
                          <dt class="text-muted small">Laboratorio / dependencia</dt>
                          <dd class="mb-0 fw-semibold">
                            <%= debt.DEU_CPTO_NOMBRE || (debt.DEU_CPTO_COD ? `Código SGA ${debt.DEU_CPTO_COD}` : 'No reportado por SGA') %>
                            <% if (debt.DEU_CPTO_NOMBRE && debt.DEU_CPTO_COD) { %>
                              <small class="d-block text-muted">Código SGA: <%= debt.DEU_CPTO_COD %></small>
                            <% } %>
                          </dd>
                        </div>
                        <div class="col-12 col-md-6">
                          <dt class="text-muted small">Fecha de pago</dt>
                          <dd class="mb-0 fw-semibold"><%= debt.DEU_FECHA_PAGO || 'Pendiente' %></dd>
                        </div>
                      </dl>
                    </div>
                  </article>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    <% } else { %>
    <section class="mt-4" aria-labelledby="fineActionHeading">
      <% if (successFeedback === 'registrada') { %>
        <div class="alert alert-success mb-3" role="status" aria-live="polite">
          <strong>Operación completada.</strong> La sanción se registró correctamente.
        </div>
      <% } %>
      <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
        <div>
          <p class="app-home-welcome-kicker mb-1">Selecciona una acción</p>
          <h2 class="app-panel-title mb-0" id="fineActionHeading">¿Cómo deseas continuar?</h2>
        </div>
        <span class="badge rounded-pill text-bg-<%= activeSanctionCount > 0 ? 'warning' : 'light' %>">
          <%= activeSanctionCount %> sanciones activas
        </span>
      </div>

      <div class="app-fine-action-options">
        <form method="POST" action="<%= registrationUrl %>" class="card app-fine-action-card">
          <%- include('../partials/csrf_field') %>
          <input type="hidden" name="lookup_token" value="<%= lookupToken %>">
          <div class="card-body">
            <div class="app-fine-action-icon app-fine-action-icon--register" aria-hidden="true">
              <i class="bi bi-plus-circle"></i>
            </div>
            <h3 class="h5 mt-3">Registrar sanción</h3>
            <p class="text-muted">Crear un nuevo registro para esta persona.</p>
            <button class="btn btn-perso w-100" type="submit" data-submit-lock="true">
              Continuar con el registro
            </button>
          </div>
        </form>
      </div>

      <div class="mt-3">
        <a class="btn btn-outline-secondary" href="<%= searchUrl %>">Buscar otra persona</a>
      </div>
    </section>
    <% } %>
  </main>
  <%- include('../partials/footer'); -%>
<% } %>
