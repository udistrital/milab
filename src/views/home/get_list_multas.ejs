<%- include('../partials/header'); -%>
<% if (locals.tipo !== 'admin' && locals.tipo !== 'laboratorista' && locals.tipo !== 'coordinador' && locals.tipo !== 'coordinador_general') { %>
    <script nonce="<%= cspNonce %>">
    window.location.href = '/milab/auth/login';
    </script>
  <% } else { %>


        <main class="container-fluid app-page-shell app-sanctions-report">
            <section class="app-page-header">
                <h1 class="app-page-title">Listado de sanciones</h1>
                <p class="app-page-subtitle">Consulta el registro histórico de sanciones con foco en categoría, estado y responsables operativos.</p>
            </section>
        <% const successFeedback = locals.successFeedback || null; %>
        <% if (successFeedback) { %>
            <section class="mb-3" aria-live="polite">
                <div class="alert alert-success mb-0" role="status">
                    <strong>Operación completada.</strong>
                    <%= successFeedback === 'saldada'
                        ? ' La sanción se marcó como saldada correctamente.'
                        : successFeedback === 'aplazada'
                            ? ' La sanción se aplazó correctamente.'
                            : successFeedback === 'reactivada'
                                ? ' La sanción se reactivó correctamente.'
                                : successFeedback === 'editada'
                                    ? ' La sanción se editó correctamente.'
                                    : ' La sanción se activó correctamente.' %>
                </div>
            </section>
        <% } %>
        <section class="card app-table-panel mb-3">
            <div class="card-body">
                <form action="/milab/api/get_list_multas" method="GET" class="row g-3 align-items-end" id="sanctions-filter-form">
                    <% const filtros = locals.filtros || {}; %>
                    <% const filterAccess = locals.filterAccess || {}; %>
                    <% const locationOptions = locals.locationOptions || {}; %>
                    <% const facultadOptions = Array.isArray(locationOptions.facultades) ? locationOptions.facultades : []; %>
                    <% const dependenciaOptions = Array.isArray(locationOptions.dependencias) ? locationOptions.dependencias : []; %>
                    <% const ualOptions = Array.isArray(locationOptions.uals) ? locationOptions.uals : []; %>
                    <div class="col-12">
                        <h2 class="app-filter-title"><i class="bi bi-funnel" aria-hidden="true"></i> Filtro de sanciones</h2>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <label for="fecha_desde" class="form-label">Desde</label>
                        <input
                            type="date"
                            id="fecha_desde"
                            name="fecha_desde"
                            class="form-control"
                            value="<%= filtros.fecha_desde || '' %>"
                        >
                    </div>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <label for="fecha_hasta" class="form-label">Hasta</label>
                        <input
                            type="date"
                            id="fecha_hasta"
                            name="fecha_hasta"
                            class="form-control"
                            value="<%= filtros.fecha_hasta || '' %>"
                        >
                    </div>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <label for="estado_multa" class="form-label">Estado</label>
                        <select id="estado_multa" name="estado_multa" class="form-select">
                            <option value="" <%= !filtros.estado_multa ? 'selected' : '' %>>Todos los estados</option>
                            <option value="ACTIVA" <%= filtros.estado_multa === 'ACTIVA' ? 'selected' : '' %>>ACTIVA</option>
                            <option value="APLAZADA" <%= filtros.estado_multa === 'APLAZADA' ? 'selected' : '' %>>APLAZADA</option>
                            <option value="Pendiente" <%= filtros.estado_multa === 'Pendiente' ? 'selected' : '' %>>Pendiente</option>
                            <option value="POR SALDAR" <%= filtros.estado_multa === 'POR SALDAR' ? 'selected' : '' %>>POR SALDAR</option>
                            <option value="SALDADA" <%= filtros.estado_multa === 'SALDADA' ? 'selected' : '' %>>SALDADA</option>
                        </select>
                    </div>
                    <% if (filterAccess.facultad) { %>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <label for="filtro_facultad" class="form-label">Facultad</label>
                        <select id="filtro_facultad" name="facultad_id" class="form-select">
                            <option value="">Todas las facultades</option>
                            <% facultadOptions.forEach(function (opt) { %>
                                <option value="<%= opt.id %>" <%= String(filtros.facultad_id) === String(opt.id) ? 'selected' : '' %>><%= opt.nombre %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>
                    <% if (filterAccess.dependencia) { %>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <label for="filtro_dependencia" class="form-label">Dependencia</label>
                        <select id="filtro_dependencia" name="dependencia_id" class="form-select">
                            <option value="">Todas las dependencias</option>
                            <% dependenciaOptions.forEach(function (opt) { %>
                                <option value="<%= opt.id %>" data-facultad-id="<%= opt.facultad_id %>" <%= String(filtros.dependencia_id) === String(opt.id) ? 'selected' : '' %>><%= opt.nombre %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>
                    <% if (filterAccess.ual) { %>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <label for="filtro_ual" class="form-label">UAL</label>
                        <select id="filtro_ual" name="ual_id" class="form-select">
                            <option value="">Todas las UAL</option>
                            <% ualOptions.forEach(function (opt) { %>
                                <option value="<%= opt.id %>" data-facultad-id="<%= opt.facultad_id %>" data-dependencia-id="<%= opt.dependencia_id || '' %>" <%= String(filtros.ual_id) === String(opt.id) ? 'selected' : '' %>><%= opt.nombre %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-perso">Filtrar</button>
                        <button
                            type="submit"
                            class="btn btn-outline-success"
                            formaction="/milab/api/get_list_multas/export/excel"
                            formmethod="GET"
                        >
                            Exportar Excel
                        </button>
                        <a href="/milab/api/get_list_multas" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                </form>
            </div>
        </section>
        <section class="card app-table-panel text-light">
        <div class="card-header">
            <div class="row">
                                <div class="text-center"><h5>Registro de sanciones</h5></div>
            </div>
        </div>
                <div class="card-body">
                        <% const estudiantes = locals.sancionesEstudiantes || []; %>
                        <% const docentes = locals.sancionesDocentes || []; %>

                        <ul class="nav nav-tabs mb-3" id="sancionesTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button
                                    class="nav-link active"
                                    id="tab-estudiantes"
                                    data-bs-toggle="tab"
                                    data-bs-target="#pane-estudiantes"
                                    type="button"
                                    role="tab"
                                    aria-controls="pane-estudiantes"
                                    aria-selected="true"
                                >
                                    Sanciones de estudiantes
                                    <span class="badge rounded-pill text-bg-secondary ms-1"><%= estudiantes.length %></span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button
                                    class="nav-link"
                                    id="tab-docentes"
                                    data-bs-toggle="tab"
                                    data-bs-target="#pane-docentes"
                                    type="button"
                                    role="tab"
                                    aria-controls="pane-docentes"
                                    aria-selected="false"
                                >
                                    Sanciones de docentes
                                    <span class="badge rounded-pill text-bg-secondary ms-1"><%= docentes.length %></span>
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="pane-estudiantes" role="tabpanel" aria-labelledby="tab-estudiantes">
                                <% if (estudiantes.length > 0) { %>
                                    <div>
                                        <table id="tbl-sanciones-estudiantes" class="table table-bordered table-striped table-hover app-table-compact app-sanctions-table js-data-grid app-grid-contained" data-grid-page-length="25" data-grid-scroll-x="false">
                                            <thead class="text-light">
                                                <tr>
                                                    <th>Identificación</th>
                                                    <th>Estudiante</th>
                                                    <th>Laboratorio</th>
                                                    <th class="app-sanction-info-column">Información de sanción</th>
                                                    <th data-grid-filter="false" data-grid-orderable="false">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% estudiantes.forEach(function(data) { %>
                                                    <tr>
                                                        <%- include('../partials/sanction-report-cells', { sanction: data }) %>
                                                        <%- include('../partials/sanction-info-cell', { sanction: data }) %>
                                                        <%- include('../partials/sanction-actions-cell', { sanction: data, sgaConfigured: sgaConfigured }) %>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <div class="alert alert-info text-center mb-0">No hay sanciones estudiantiles registradas.</div>
                                <% } %>
                            </div>

                            <div class="tab-pane fade" id="pane-docentes" role="tabpanel" aria-labelledby="tab-docentes">
                                <% if (docentes.length > 0) { %>
                                    <div>
                                        <table id="tbl-sanciones-docentes" class="table table-bordered table-striped table-hover app-table-compact app-sanctions-table js-data-grid app-grid-contained" data-grid-page-length="25" data-grid-scroll-x="false">
                                            <thead class="text-light">
                                                <tr>
                                                    <th>Identificación</th>
                                                    <th>Docente</th>
                                                    <th>Laboratorio</th>
                                                    <th class="app-sanction-info-column">Información de sanción</th>
                                                    <th data-grid-filter="false" data-grid-orderable="false">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% docentes.forEach(function(data) { %>
                                                    <tr>
                                                        <%- include('../partials/sanction-report-cells', { sanction: data }) %>
                                                        <%- include('../partials/sanction-info-cell', { sanction: data }) %>
                                                        <%- include('../partials/sanction-actions-cell', { sanction: data, sgaConfigured: sgaConfigured }) %>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <div class="alert alert-info text-center mb-0">No hay sanciones de docentes registradas.</div>
                                <% } %>
                            </div>
                        </div>
                </div>
        </section>
    </main>

    <%- include('../partials/sanction-detail-modal'); %>
    <script src="/milab/public/js/sanction-detail-modal.js"></script>

    <script nonce="<%= cspNonce %>">
        (function () {
            const facultySelect = document.getElementById('filtro_facultad');
            const dependencySelect = document.getElementById('filtro_dependencia');
            const ualSelect = document.getElementById('filtro_ual');

            function snapshot(select) {
                if (!select) return [];
                return Array.from(select.options).slice(1).map(function (option) {
                    return {
                        value: option.value,
                        text: option.textContent,
                        facultadId: option.getAttribute('data-facultad-id') || '',
                        dependenciaId: option.getAttribute('data-dependencia-id') || '',
                    };
                });
            }

            const allDependencies = snapshot(dependencySelect);
            const allUals = snapshot(ualSelect);

            function rebuild(select, items, predicate, enabled, placeholder) {
                if (!select) return;
                const current = select.value;
                while (select.options.length > 1) select.remove(1);
                select.disabled = !enabled;
                select.options[0].textContent = placeholder;
                items.filter(predicate).forEach(function (item) {
                    const option = new Option(item.text, item.value);
                    option.setAttribute('data-facultad-id', item.facultadId);
                    option.setAttribute('data-dependencia-id', item.dependenciaId);
                    select.add(option);
                });
                select.value = Array.from(select.options).some(function (option) {
                    return option.value === current;
                })
                    ? current
                    : '';
            }

            function refresh() {
                const facultadId = facultySelect ? facultySelect.value : '';
                const dependenciesEnabled = !facultySelect || !!facultadId;
                rebuild(dependencySelect, allDependencies, function (item) {
                    return dependenciesEnabled && (!facultySelect || item.facultadId === facultadId);
                }, dependenciesEnabled, dependenciesEnabled ? 'Todas las dependencias' : 'Selecciona primero una facultad');
                const dependenciaId = dependencySelect ? dependencySelect.value : '';
                const directUal = allUals.find(function (item) {
                    return ualSelect && item.value === ualSelect.value && !item.dependenciaId &&
                        (!facultySelect || item.facultadId === facultadId);
                });
                const ualsEnabled = dependencySelect ? dependenciesEnabled && (!!dependenciaId || !!directUal) : true;
                rebuild(ualSelect, allUals, function (item) {
                    return ualsEnabled && (!dependencySelect ||
                        (dependenciaId ? item.dependenciaId === dependenciaId : directUal && item.value === directUal.value));
                }, ualsEnabled, ualsEnabled ? 'Todas las UAL' : 'Selecciona primero una dependencia');
            }

            // Conserva filtros de enlaces que incluyen solo una dependencia o UAL.
            const initialUal = allUals.find(function (item) { return ualSelect && item.value === ualSelect.value; });
            if (dependencySelect && !dependencySelect.value && initialUal) dependencySelect.value = initialUal.dependenciaId;
            const initialDependency = allDependencies.find(function (item) { return dependencySelect && item.value === dependencySelect.value; });
            if (facultySelect && !facultySelect.value) {
                facultySelect.value = initialDependency ? initialDependency.facultadId : (initialUal ? initialUal.facultadId : '');
            }
            if (facultySelect) facultySelect.addEventListener('change', function () {
                if (dependencySelect) dependencySelect.value = '';
                if (ualSelect) ualSelect.value = '';
                refresh();
            });
            if (dependencySelect) dependencySelect.addEventListener('change', function () {
                if (ualSelect) ualSelect.value = '';
                refresh();
            });
            refresh();
        })();
    </script>

  <script src="/milab/public/js/sanction-claims.js"></script>
  <%- include('../partials/footer'); -%>
  <% } %>
