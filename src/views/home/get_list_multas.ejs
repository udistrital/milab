<%- include('../partials/header'); -%>
<% if (locals.tipo !== 'admin' && locals.tipo !== 'laboratorista' && locals.tipo !== 'coordinador'  ) { %>
    <script nonce="<%= cspNonce %>">
    window.location.href = '/milab/auth/login';
    </script>
  <% } else { %>


        <main class="container app-page-shell">
            <style>
                .app-detail-modal {
                    z-index: 3000;
                }

                .modal-backdrop.show {
                    z-index: 2990;
                }
            </style>
            <section class="app-page-header">
                <h1 class="app-page-title">Listado de sanciones</h1>
                <p class="app-page-subtitle">Consulta el registro histórico de sanciones con foco en categoría, estado y responsables operativos.</p>
            </section>
        <% const successFeedback = locals.successFeedback || null; %>
        <% if (successFeedback) { %>
            <section class="mb-3" aria-live="polite">
                <div class="alert alert-success mb-0" role="status">
                    <strong>Operación completada.</strong>
                    <%= successFeedback === 'saldada'
                        ? ' La sanción se marcó como saldada correctamente.'
                        : successFeedback === 'aplazada'
                            ? ' La sanción se aplazó correctamente.'
                            : successFeedback === 'reactivada'
                                ? ' La sanción se reactivó correctamente.'
                                : successFeedback === 'editada'
                                    ? ' La sanción se editó correctamente.'
                                    : ' La sanción se activó correctamente.' %>
                </div>
            </section>
        <% } %>
        <section class="card app-table-panel mb-3">
            <div class="card-body">
                <form action="/milab/api/get_list_multas" method="GET" class="row g-3 align-items-end">
                    <% const filtros = locals.filtros || {}; %>
                    <div class="col-12 col-md-4">
                        <label for="fecha_desde" class="form-label">Desde</label>
                        <input
                            type="date"
                            id="fecha_desde"
                            name="fecha_desde"
                            class="form-control"
                            value="<%= filtros.fecha_desde || '' %>"
                        >
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="fecha_hasta" class="form-label">Hasta</label>
                        <input
                            type="date"
                            id="fecha_hasta"
                            name="fecha_hasta"
                            class="form-control"
                            value="<%= filtros.fecha_hasta || '' %>"
                        >
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="estado_multa" class="form-label">Estado</label>
                        <select id="estado_multa" name="estado_multa" class="form-select">
                            <option value="" <%= !filtros.estado_multa ? 'selected' : '' %>>Todos los estados</option>
                            <option value="ACTIVA" <%= filtros.estado_multa === 'ACTIVA' ? 'selected' : '' %>>ACTIVA</option>
                            <option value="APLAZADA" <%= filtros.estado_multa === 'APLAZADA' ? 'selected' : '' %>>APLAZADA</option>
                            <option value="Pendiente" <%= filtros.estado_multa === 'Pendiente' ? 'selected' : '' %>>Pendiente</option>
                            <option value="POR SALDAR" <%= filtros.estado_multa === 'POR SALDAR' ? 'selected' : '' %>>POR SALDAR</option>
                            <option value="SALDADA" <%= filtros.estado_multa === 'SALDADA' ? 'selected' : '' %>>SALDADA</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-perso">Filtrar</button>
                        <button
                            type="submit"
                            class="btn btn-outline-success"
                            formaction="/milab/api/get_list_multas/export/excel"
                            formmethod="GET"
                        >
                            Exportar Excel
                        </button>
                        <a href="/milab/api/get_list_multas" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                </form>
            </div>
        </section>
        <section class="card app-table-panel text-light">
        <div class="card-header">
            <div class="row">
                                <div class="text-center"><h5>Registro de sanciones</h5></div>
            </div>
        </div>
                <div class="card-body">
                        <% const estudiantes = locals.sancionesEstudiantes || []; %>
                        <% const docentes = locals.sancionesDocentes || []; %>

                        <ul class="nav nav-tabs mb-3" id="sancionesTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button
                                    class="nav-link active"
                                    id="tab-estudiantes"
                                    data-bs-toggle="tab"
                                    data-bs-target="#pane-estudiantes"
                                    type="button"
                                    role="tab"
                                    aria-controls="pane-estudiantes"
                                    aria-selected="true"
                                >
                                    Sanciones de estudiantes
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button
                                    class="nav-link"
                                    id="tab-docentes"
                                    data-bs-toggle="tab"
                                    data-bs-target="#pane-docentes"
                                    type="button"
                                    role="tab"
                                    aria-controls="pane-docentes"
                                    aria-selected="false"
                                >
                                    Sanciones de docentes
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="pane-estudiantes" role="tabpanel" aria-labelledby="tab-estudiantes">
                                <% if (estudiantes.length > 0) { %>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-striped app-table-compact table-multas js-data-grid" data-grid-page-length="25" data-grid-scroll-x="true">
                                            <thead class="text-light">
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Documento</th>
                                                    <th>Código</th>
                                                    <th>Fecha</th>
                                                    <th>Estado</th>
                                                    <th data-grid-filter="false" data-grid-orderable="false">Ver detalle</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% estudiantes.forEach(function(data) { %>
                                                    <tr>
                                                        <td class="text-light"><%= data.id %></td>
                                                        <td class="text-light"><%= data.documento_sancionado %></td>
                                                        <td class="text-light"><%= data.codigo_sancionado || '-' %></td>
                                                        <td class="text-light"><%= data.fecha_multa_formateada %></td>
                                                        <td class="text-light"><%= data.con_estado_multa %></td>
                                                        <td class="text-light">
                                                            <button
                                                                type="button"
                                                                class="btn btn-outline-info btn-sm app-detail-button"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#detalleSancionModal"
                                                                data-sancion-id="<%= data.id %>"
                                                                data-sancion-nombre="<%= data.nombre_sancionado || '' %>"
                                                                data-sancion-documento="<%= data.documento_sancionado %>"
                                                                data-sancion-codigo="<%= data.codigo_sancionado || '' %>"
                                                                data-sancion-tipo-persona="<%= data.tipo_sancionado %>"
                                                                data-sga-configurado="<%= sgaConfigured ? 'true' : 'false' %>"
                                                                data-sancion-fecha="<%= data.fecha_multa_formateada %>"
                                                                data-sancion-estado="<%= data.con_estado_multa %>"
                                                                data-sancion-laboratorista="<%= data.nombre_laboratorista %>"
                                                                data-sancion-ual="<%= data.ual %>"
                                                                data-sancion-categoria="<%= data.cat_multa %>"
                                                                data-sancion-tipo="<%= data.tipo_sancion || 'Sin definir' %>"
                                                                data-sancion-observaciones="<%= data.obs_multa || 'Sin observaciones' %>"
                                                                data-sancion-action="<%= data.canActivate ? 'activate' : data.canSaldar ? 'saldar' : data.canReactivar ? 'reactivate' : data.canAplazar ? 'defer' : data.canRemove ? 'remove' : '' %>"
                                                            >
                                                                <i class="bi bi-eye"></i>
                                                                Ver detalle
                                                            </button>
                                                            <% if (data.canActivate || data.canSaldar || data.canRemove || data.canReactivar) { %>
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-success btn-sm app-sanction-action-button"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#detalleSancionModal"
                                                                    data-sancion-id="<%= data.id %>"
                                                                    data-sancion-action="<%= data.canActivate ? 'activate' : data.canSaldar ? 'saldar' : data.canReactivar ? 'reactivate' : 'remove' %>"
                                                                >
                                                                    <i class="bi bi-arrow-repeat"></i>
                                                                    <%= data.canActivate ? 'Activar' : data.canSaldar ? 'Saldar' : data.canReactivar ? 'Reactivar' : 'Saldar' %>
                                                                </button>
                                                            <% } %>
                                                            <% if (data.canAplazar) { %>
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-outline-secondary btn-sm app-sanction-action-button"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#detalleSancionModal"
                                                                    data-sancion-id="<%= data.id %>"
                                                                    data-sancion-action="defer"
                                                                >
                                                                    <i class="bi bi-pause-circle"></i>
                                                                    Aplazar
                                                                </button>
                                                            <% } %>
                                                            <% if (data.canEdit) { %>
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-outline-warning btn-sm app-sanction-action-button"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#detalleSancionModal"
                                                                    data-sancion-id="<%= data.id %>"
                                                                    data-sancion-action="edit"
                                                                    data-sancion-categoria="<%= data.cat_multa %>"
                                                                    data-sancion-tipo="<%= data.tipo_sancion || '' %>"
                                                                >
                                                                    <i class="bi bi-pencil"></i>
                                                                    Editar
                                                                </button>
                                                            <% } %>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <div class="alert alert-info text-center mb-0">No hay sanciones estudiantiles registradas.</div>
                                <% } %>
                            </div>

                            <div class="tab-pane fade" id="pane-docentes" role="tabpanel" aria-labelledby="tab-docentes">
                                <% if (docentes.length > 0) { %>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-striped app-table-compact table-multas js-data-grid" data-grid-page-length="25" data-grid-scroll-x="true">
                                            <thead class="text-light">
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Documento</th>
                                                    <th>Código</th>
                                                    <th>Fecha</th>
                                                    <th>Estado</th>
                                                    <th data-grid-filter="false" data-grid-orderable="false">Ver detalle</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% docentes.forEach(function(data) { %>
                                                    <tr>
                                                        <td class="text-light"><%= data.id %></td>
                                                        <td class="text-light"><%= data.documento_sancionado %></td>
                                                        <td class="text-light"><%= data.codigo_sancionado || '-' %></td>
                                                        <td class="text-light"><%= data.fecha_multa_formateada %></td>
                                                        <td class="text-light"><%= data.con_estado_multa %></td>
                                                        <td class="text-light">
                                                            <button
                                                                type="button"
                                                                class="btn btn-outline-info btn-sm app-detail-button"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#detalleSancionModal"
                                                                data-sancion-id="<%= data.id %>"
                                                                data-sancion-nombre="<%= data.nombre_sancionado || '' %>"
                                                                data-sancion-documento="<%= data.documento_sancionado %>"
                                                                data-sancion-codigo="<%= data.codigo_sancionado || '' %>"
                                                                data-sancion-tipo-persona="<%= data.tipo_sancionado %>"
                                                                data-sga-configurado="<%= sgaConfigured ? 'true' : 'false' %>"
                                                                data-sancion-fecha="<%= data.fecha_multa_formateada %>"
                                                                data-sancion-estado="<%= data.con_estado_multa %>"
                                                                data-sancion-laboratorista="<%= data.nombre_laboratorista %>"
                                                                data-sancion-ual="<%= data.ual %>"
                                                                data-sancion-categoria="<%= data.cat_multa %>"
                                                                data-sancion-tipo="<%= data.tipo_sancion || 'Sin definir' %>"
                                                                data-sancion-observaciones="<%= data.obs_multa || 'Sin observaciones' %>"
                                                                data-sancion-action="<%= data.canActivate ? 'activate' : data.canSaldar ? 'saldar' : data.canReactivar ? 'reactivate' : data.canAplazar ? 'defer' : data.canRemove ? 'remove' : '' %>"
                                                            >
                                                                <i class="bi bi-eye"></i>
                                                                Ver detalle
                                                            </button>
                                                            <% if (data.canActivate || data.canSaldar || data.canRemove || data.canReactivar) { %>
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-success btn-sm app-sanction-action-button"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#detalleSancionModal"
                                                                    data-sancion-id="<%= data.id %>"
                                                                    data-sancion-action="<%= data.canActivate ? 'activate' : data.canSaldar ? 'saldar' : data.canReactivar ? 'reactivate' : 'remove' %>"
                                                                >
                                                                    <i class="bi bi-arrow-repeat"></i>
                                                                    <%= data.canActivate ? 'Activar' : data.canSaldar ? 'Saldar' : data.canReactivar ? 'Reactivar' : 'Saldar' %>
                                                                </button>
                                                            <% } %>
                                                            <% if (data.canAplazar) { %>
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-outline-secondary btn-sm app-sanction-action-button"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#detalleSancionModal"
                                                                    data-sancion-id="<%= data.id %>"
                                                                    data-sancion-action="defer"
                                                                >
                                                                    <i class="bi bi-pause-circle"></i>
                                                                    Aplazar
                                                                </button>
                                                            <% } %>
                                                            <% if (data.canEdit) { %>
                                                                <button
                                                                    type="button"
                                                                    class="btn btn-outline-warning btn-sm app-sanction-action-button"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#detalleSancionModal"
                                                                    data-sancion-id="<%= data.id %>"
                                                                    data-sancion-action="edit"
                                                                    data-sancion-categoria="<%= data.cat_multa %>"
                                                                    data-sancion-tipo="<%= data.tipo_sancion || '' %>"
                                                                >
                                                                    <i class="bi bi-pencil"></i>
                                                                    Editar
                                                                </button>
                                                            <% } %>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <div class="alert alert-info text-center mb-0">No hay sanciones de docentes registradas.</div>
                                <% } %>
                            </div>
                        </div>
                </div>
        </section>
    </main>

    <div class="modal fade app-detail-modal" id="detalleSancionModal" tabindex="-1" aria-labelledby="detalleSancionLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header sanction-detail-header">
                    <div class="sanction-detail-heading">
                        <span class="sanction-detail-icon" aria-hidden="true"><i class="bi bi-shield-exclamation"></i></span>
                        <div>
                            <p class="sanction-detail-kicker">Gestión de sanciones</p>
                            <h5 class="modal-title" id="detalleSancionLabel">Detalle de la sanción</h5>
                            <p class="sanction-detail-subtitle">Información del estudiante, la sanción y su consulta en SGA.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <section class="sanction-detail-section" aria-labelledby="sanctionPersonHeading">
                        <div class="sanction-detail-section-heading">
                            <i class="bi bi-person-vcard" aria-hidden="true"></i>
                            <div>
                                <h6 id="sanctionPersonHeading">Persona sancionada</h6>
                                <p>Identificación y estado actual</p>
                            </div>
                        </div>
                        <div class="sanction-detail-grid">
                            <div class="sanction-detail-field sanction-detail-field--wide">
                                <span>Nombre</span>
                                <strong data-detail-field="nombre"></strong>
                                <small class="text-warning d-none" data-oati-status aria-live="polite"></small>
                            </div>
                            <div class="sanction-detail-field">
                                <span>Documento</span>
                                <strong data-detail-field="documento"></strong>
                            </div>
                            <div class="sanction-detail-field">
                                <span>Código</span>
                                <strong data-detail-field="codigo"></strong>
                            </div>
                            <div class="sanction-detail-field">
                                <span>Estado</span>
                                <strong data-detail-field="estado"></strong>
                            </div>
                            <div class="sanction-detail-field">
                                <span>Identificador de sanción</span>
                                <strong data-detail-field="id"></strong>
                            </div>
                        </div>
                    </section>

                    <section class="sanction-detail-section" aria-labelledby="sanctionInfoHeading">
                        <div class="sanction-detail-section-heading">
                            <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
                            <div>
                                <h6 id="sanctionInfoHeading">Información de la sanción</h6>
                                <p>Registro en el sistema de laboratorios</p>
                            </div>
                        </div>
                        <div class="sanction-detail-grid">
                            <div class="sanction-detail-field">
                                <span>Categoría</span>
                                <strong data-detail-field="categoria"></strong>
                            </div>
                            <div class="sanction-detail-field">
                                <span>Tipo</span>
                                <strong data-detail-field="tipo"></strong>
                            </div>
                            <div class="sanction-detail-field">
                                <span>Fecha</span>
                                <strong data-detail-field="fecha"></strong>
                            </div>
                            <div class="sanction-detail-field">
                                <span>Laboratorista</span>
                                <strong data-detail-field="laboratorista"></strong>
                            </div>
                            <div class="sanction-detail-field">
                                <span>UAL</span>
                                <strong data-detail-field="ual"></strong>
                            </div>
                            <div class="sanction-detail-field sanction-detail-field--wide">
                                <span>Observaciones</span>
                                <strong data-detail-field="observaciones"></strong>
                            </div>
                        </div>
                    </section>

                    <section class="sanction-sga-panel d-none" data-sga-debts-panel aria-live="polite">
                        <div class="sanction-detail-section-heading sanction-sga-heading">
                            <i class="bi bi-bank" aria-hidden="true"></i>
                            <div>
                                <h6>Multas activas en SGA</h6>
                                <p data-sga-debts-status>Consultando...</p>
                            </div>
                        </div>
                        <div class="sanction-sga-list" data-sga-debts-list></div>
                    </section>
                    <div class="border-top pt-3 mt-3 d-none" data-sanction-action-panel>
                        <h6 class="mb-3" data-sanction-action-title>Actualizar sanción</h6>
                        <form action="/milab/api/aprobacion_multa/activar" method="POST" data-sanction-action-form="activate" class="d-none row g-3">
                            <%- include('../partials/csrf_field'); %>
                            <input type="hidden" name="multa_id" data-sanction-action-id>
                            <input type="hidden" name="source" value="listado">
                            <div class="col-12">
                                <label class="form-label" for="tipo_sancion_listado">Tipo de sanción</label>
                                <select id="tipo_sancion_listado" name="tipo_sancion" class="form-select" required>
                                    <option value="">Selecciona tipo de sanción</option>
                                    <% (Array.isArray(locals.SANCTION_TYPES) ? locals.SANCTION_TYPES : []).forEach(function (tipo) { %>
                                        <option value="<%= tipo %>"><%= tipo %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-12 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-success">Activar sanción</button>
                            </div>
                        </form>
                        <form action="/milab/api/aprobacion_multa/saldar" method="POST" data-sanction-action-form="saldar" class="d-none d-flex justify-content-end gap-2">
                            <%- include('../partials/csrf_field'); %>
                            <input type="hidden" name="multa_id" data-sanction-action-id>
                            <input type="hidden" name="source" value="listado">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Saldar sanción</button>
                        </form>
                        <form action="/milab/api/aprobacion_multa/aplazar" method="POST" data-sanction-action-form="defer" class="d-none d-flex justify-content-end gap-2">
                            <%- include('../partials/csrf_field'); %>
                            <input type="hidden" name="multa_id" data-sanction-action-id>
                            <input type="hidden" name="source" value="listado">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-warning">Aplazar sanción</button>
                        </form>
                        <form action="/milab/api/aprobacion_multa/reactivar" method="POST" data-sanction-action-form="reactivate" class="d-none d-flex justify-content-end gap-2">
                            <%- include('../partials/csrf_field'); %>
                            <input type="hidden" name="multa_id" data-sanction-action-id>
                            <input type="hidden" name="source" value="listado">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-success">Reactivar sanción</button>
                        </form>
                        <form action="/milab/api/quitar-multa" method="POST" data-sanction-action-form="remove" class="d-none d-flex justify-content-end gap-2">
                            <%- include('../partials/csrf_field'); %>
                            <input type="hidden" name="con_id" data-sanction-action-id>
                            <input type="hidden" name="source" value="listado">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Saldar sanción</button>
                        </form>
                        <form action="/milab/api/get_list_multas/editar" method="POST" data-sanction-action-form="edit" class="d-none row g-3">
                            <%- include('../partials/csrf_field'); %>
                            <input type="hidden" name="multa_id" data-sanction-action-id>
                            <div class="col-12">
                                <label class="form-label" for="categoria_sancion_listado">Categoría de sanción</label>
                                <select id="categoria_sancion_listado" name="cat_multa" class="form-select" required>
                                    <%- include('../partials/multa-options'); %>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="tipo_sancion_edicion_listado">Tipo de sanción</label>
                                <select id="tipo_sancion_edicion_listado" name="tipo_sancion" class="form-select" required>
                                    <option value="">Selecciona tipo de sanción</option>
                                    <% (Array.isArray(locals.SANCTION_TYPES) ? locals.SANCTION_TYPES : []).forEach(function (tipo) { %>
                                        <option value="<%= tipo %>"><%= tipo %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-12 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-warning">Guardar cambios</button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <script nonce="<%= cspNonce %>">
        let activeNameRequestController = null;
        let activeNameRequestId = 0;
        let activeNameRetryTimer = null;
        let activeSgaRequestController = null;
        let activeSgaRequestId = 0;

        function updateOatiStatus(message) {
            const statusTarget = document.querySelector('[data-oati-status]');
            if (!statusTarget) {
                return;
            }

            if (message) {
                statusTarget.textContent = message;
                statusTarget.classList.remove('d-none');
                return;
            }

            statusTarget.textContent = '';
            statusTarget.classList.add('d-none');
        }

        function stopActiveNameLookup() {
            activeNameRequestId += 1;
            if (activeNameRequestController) {
                activeNameRequestController.abort();
                activeNameRequestController = null;
            }
            if (activeNameRetryTimer) {
                clearTimeout(activeNameRetryTimer);
                activeNameRetryTimer = null;
            }
            updateOatiStatus('');
        }

        function stopSgaDebtLookup() {
            activeSgaRequestId += 1;
            if (activeSgaRequestController) {
                activeSgaRequestController.abort();
                activeSgaRequestController = null;
            }

            const panel = document.querySelector('[data-sga-debts-panel]');
            const status = document.querySelector('[data-sga-debts-status]');
            const list = document.querySelector('[data-sga-debts-list]');
            if (panel) panel.classList.add('d-none');
            if (status) status.textContent = '';
            if (list) list.replaceChildren();
        }

        function addSgaDebtField(container, label, value) {
            const field = document.createElement('div');
            field.className = 'sanction-sga-field';
            const labelElement = document.createElement('span');
            labelElement.textContent = label;
            const valueElement = document.createElement('strong');
            valueElement.textContent = value || '-';
            field.append(labelElement, valueElement);
            container.append(field);
        }

        async function loadSgaDebtsForStudent(sanctionId, isConfigured) {
            const panel = document.querySelector('[data-sga-debts-panel]');
            const status = document.querySelector('[data-sga-debts-status]');
            const list = document.querySelector('[data-sga-debts-list]');
            if (!panel || !status || !list) return;

            panel.classList.remove('d-none');
            list.replaceChildren();
            if (!isConfigured) {
                status.textContent = 'La consulta SGA no está configurada en este ambiente.';
                status.dataset.state = 'warning';
                return;
            }

            const requestId = activeSgaRequestId;
            const controller = new AbortController();
            activeSgaRequestController = controller;
            status.textContent = 'Consultando multas activas en SGA...';
            status.dataset.state = 'loading';

            try {
                const response = await fetch(
                    `/milab/api/get_list_multas/${encodeURIComponent(sanctionId)}/sga-multas`,
                    { signal: controller.signal, headers: { Accept: 'application/json' } }
                );
                const result = await response.json();
                if (requestId !== activeSgaRequestId) return;
                if (!response.ok || !result.ok) {
                    throw new Error(result.message || 'No fue posible consultar SGA.');
                }
                if (!result.configured) {
                    status.textContent = 'La consulta SGA no está configurada en este ambiente.';
                    status.dataset.state = 'warning';
                    return;
                }
                if (!result.supported) {
                    status.textContent = 'La consulta de deudores SGA aplica únicamente a estudiantes.';
                    status.dataset.state = 'warning';
                    return;
                }

                const debts = Array.isArray(result.multas) ? result.multas : [];
                if (!debts.length) {
                    status.textContent = 'No se encontraron multas activas en SGA.';
                    status.dataset.state = 'clear';
                    return;
                }

                status.textContent = `${debts.length} multa(s) activa(s) reportada(s) por SGA.`;
                status.dataset.state = 'warning';
                debts.forEach((debt) => {
                    const item = document.createElement('article');
                    item.className = 'sanction-sga-item';
                    const title = document.createElement('h6');
                    title.textContent = debt.DEU_MATERIAL || 'Multa reportada por SGA';
                    const fields = document.createElement('div');
                    fields.className = 'sanction-sga-grid';
                    addSgaDebtField(fields, 'Código', debt.DEU_EST_COD);
                    addSgaDebtField(fields, 'Estado SGA', debt.DEU_ESTADO);
                    addSgaDebtField(fields, 'Fecha', debt.DEU_FECHA);
                    addSgaDebtField(fields, 'Periodo', [debt.DEU_ANO, debt.DEU_PER].filter(Boolean).join(' / '));
                    addSgaDebtField(fields, 'Valor reportado', debt.DEU_MULTA);
                    addSgaDebtField(fields, 'Fecha de pago', debt.DEU_FECHA_PAGO || 'Pendiente');
                    item.append(title, fields);
                    list.append(item);
                });
            } catch (error) {
                if (error.name === 'AbortError' || requestId !== activeSgaRequestId) return;
                status.textContent = error.message || 'No fue posible consultar multas en SGA.';
                status.dataset.state = 'error';
            } finally {
                if (activeSgaRequestController === controller) {
                    activeSgaRequestController = null;
                }
            }
        }

        function fetchNameWithRetry(requestId, documento, attempt) {
            const nombreTarget = document.querySelector('[data-detail-field="nombre"]');
            if (!nombreTarget || requestId !== activeNameRequestId) {
                return;
            }

            if (attempt <= 1) {
                nombreTarget.textContent = 'Cargando...';
                updateOatiStatus('Consultando OATI...');
            } else {
                nombreTarget.textContent = `Cargando... Reintentando (${attempt - 1})`;
                updateOatiStatus(`Consultando OATI... intento ${attempt}`);
            }

            activeNameRequestController = new AbortController();
            const requestController = activeNameRequestController;
            const timeoutId = setTimeout(function () {
                requestController.abort();
            }, 6000);

            fetch(`/milab/api/get_list_multas/resolve_name?documento=${encodeURIComponent(documento)}`, {
                signal: requestController.signal,
            })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    return response.json();
                })
                .then((data) => {
                    if (requestId !== activeNameRequestId) {
                        return;
                    }

                    const nombre = data && typeof data.nombre === 'string' ? data.nombre.trim() : '';
                    if (nombre) {
                        nombreTarget.textContent = nombre;
                        updateOatiStatus('');
                        return;
                    }

                    throw new Error('Nombre vacio');
                })
                .catch(() => {
                    if (requestId !== activeNameRequestId) {
                        return;
                    }

                    activeNameRetryTimer = setTimeout(function () {
                        if (requestId !== activeNameRequestId) {
                            return;
                        }
                        fetchNameWithRetry(requestId, documento, attempt + 1);
                    }, Math.min(5000, 1000 * attempt));
                })
                .finally(() => {
                    clearTimeout(timeoutId);
                    if (activeNameRequestController === requestController) {
                        activeNameRequestController = null;
                    }
                });
        }

        const detailModal = document.getElementById('detalleSancionModal');
        if (detailModal) {
            detailModal.addEventListener('hidden.bs.modal', function () {
                stopActiveNameLookup();
                stopSgaDebtLookup();
            });
        }

        document.addEventListener('click', function (event) {
            const trigger = event.target.closest('.app-detail-button, .app-sanction-action-button');

            if (!trigger) {
                return;
            }

            // Edit/Saldar/Activar buttons can miss detail attributes; reuse row detail button data.
            const detailSource = trigger.getAttribute('data-sancion-documento')
                ? trigger
                : trigger.closest('tr')?.querySelector('.app-detail-button[data-sancion-documento]');

            const source = detailSource || trigger;
            stopSgaDebtLookup();

            const fields = {
                id: source.getAttribute('data-sancion-id'),
                nombre: source.getAttribute('data-sancion-nombre'),
                documento: source.getAttribute('data-sancion-documento'),
                codigo: source.getAttribute('data-sancion-codigo'),
                fecha: source.getAttribute('data-sancion-fecha'),
                estado: source.getAttribute('data-sancion-estado'),
                laboratorista: source.getAttribute('data-sancion-laboratorista'),
                ual: source.getAttribute('data-sancion-ual'),
                categoria: source.getAttribute('data-sancion-categoria'),
                tipo: source.getAttribute('data-sancion-tipo'),
                observaciones: source.getAttribute('data-sancion-observaciones'),
            };

            Object.keys(fields).forEach(function (key) {
                const target = document.querySelector(`[data-detail-field="${key}"]`);
                if (target) {
                    target.textContent = fields[key] || '-';
                }
            });

            const documento = fields.documento || '';
            const nombreLocal = String(fields.nombre || '').trim();
            stopActiveNameLookup();

            if (nombreLocal) {
                const nombreTarget = document.querySelector('[data-detail-field="nombre"]');
                if (nombreTarget) {
                    nombreTarget.textContent = nombreLocal;
                }
                updateOatiStatus('');
            } else if (documento) {
                const currentRequestId = activeNameRequestId;
                fetchNameWithRetry(currentRequestId, documento, 1);
            } else {
                updateOatiStatus('No se pudo consultar OATI: documento no disponible.');
            }

            const action = trigger.getAttribute('data-sancion-action') || '';
            if (
                trigger.classList.contains('app-detail-button') &&
                !action &&
                source.getAttribute('data-sancion-tipo-persona') === 'estudiante'
            ) {
                loadSgaDebtsForStudent(
                    fields.id,
                    source.getAttribute('data-sga-configurado') === 'true'
                );
            }

            const actionPanel = document.querySelector('[data-sanction-action-panel]');
            const actionTitle = document.querySelector('[data-sanction-action-title]');
            const actionForms = document.querySelectorAll('[data-sanction-action-form]');

            if (actionPanel) {
                actionPanel.classList.toggle('d-none', !action);
            }

            if (actionTitle) {
                actionTitle.textContent =
                    action === 'activate'
                        ? 'Activar sanción'
                        : action === 'saldar'
                          ? 'Saldar sanción pendiente'
                                                    : action === 'defer'
                                                        ? 'Aplazar sanción activa'
                                                        : action === 'reactivate'
                                                            ? 'Reactivar sanción aplazada'
                                                            : action === 'remove'
                                                                ? 'Saldar sanción directamente'
                                                                : 'Editar sanción activa';
            }

            actionForms.forEach(function (form) {
                const isActiveForm = form.getAttribute('data-sanction-action-form') === action;
                form.classList.toggle('d-none', !isActiveForm);
                const idInput = form.querySelector('[data-sanction-action-id]');
                if (idInput) {
                    idInput.value = fields.id || '';
                }
            });

            if (action === 'edit') {
                const categorySelect = document.querySelector('#categoria_sancion_listado');
                const typeSelect = document.querySelector('#tipo_sancion_edicion_listado');
                if (categorySelect) categorySelect.value = fields.categoria || '';
                if (typeSelect) typeSelect.value = fields.tipo || '';
            }
        });
    </script>

  <%- include('../partials/footer'); -%>
  <% } %>
