<%- include('../../../partials/header'); -%>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Aprobaciones de inventario</h1>
    <p class="app-page-subtitle">Revisa las cargas asignadas a tu alcance de coordinación.</p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="status"><%= successMessage %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <div class="d-flex justify-content-end mb-3">
    <a class="btn btn-outline-secondary" href="/milab/inventarios/gestion_inventario">
      Gestión del inventario
    </a>
  </div>

  <section class="card app-table-panel text-light">
    <div class="card-header">
      <h2 class="h5 mb-0">Pendientes de aprobación</h2>
    </div>
    <div class="card-body">
      <% if (batches.length) { %>
        <div class="table-responsive">
          <table class="table table-bordered table-striped app-table-compact">
            <thead class="text-light">
              <tr>
                <th>Laboratorio</th>
                <th>Dependencia</th>
                <th>Tipo</th>
                <th>Archivo / declaración</th>
                <th>Laboratorista solicitante</th>
                <th>Fecha</th>
                <th>Filas exitosas</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody>
              <% batches.forEach(function(batch) { %>
                <tr>
                  <td><%= batch.laboratorio %></td>
                  <td><%= batch.dependencia %></td>
                  <td><%= inventoryLabels[batch.tipo_inventario] || batch.tipo_inventario %></td>
                  <td><%= batch.archivo_nombre %></td>
                  <td>
                    <%= batch.solicitante_nombre || 'Nombre no disponible' %>
                    <small class="d-block text-muted"><%= batch.creada_por_documento %></small>
                  </td>
                  <td><%= new Date(batch.fecha_creacion).toLocaleString('es-CO', { timeZone: 'America/Bogota' }) %></td>
                  <td><%= batch.filas_exitosas %></td>
                  <td>
                    <a class="btn btn-outline-info btn-sm" href="/milab/inventarios/aprobaciones/<%= batch.id %>">
                      Revisar
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="alert alert-info mb-0">No tienes cargas pendientes de aprobación.</div>
      <% } %>
    </div>
  </section>
</main>

<%- include('../../../partials/footer'); -%>
