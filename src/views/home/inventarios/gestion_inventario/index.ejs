<%- include('../../../partials/header'); -%>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Gestión del inventario</h1>
    <p class="app-page-subtitle">Carga, seguimiento y consulta del inventario de cada laboratorio.</p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="status"><%= successMessage %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="card app-form-panel text-light mb-4">
    <div class="card-body">
      <form method="get" action="/milab/inventarios/gestion_inventario" class="row g-3 align-items-end">
        <div class="col-md-8">
          <label for="ual_id" class="form-label">Laboratorio asignado</label>
          <select id="ual_id" name="ual_id" class="form-select" required>
            <option value="">Selecciona un laboratorio</option>
            <% laboratories.forEach(function(laboratory) { %>
              <option
                value="<%= laboratory.ual_id %>"
                <%= selectedLaboratory && selectedLaboratory.ual_id === laboratory.ual_id ? 'selected' : '' %>
              >
                <%= laboratory.nombre %> — <%= laboratory.dependencia %>
              </option>
            <% }) %>
          </select>
        </div>
        <% if (selectedType) { %>
          <input type="hidden" name="tipo_inventario" value="<%= selectedType %>">
        <% } %>
        <div class="col-md-4">
          <button class="btn btn-perso" type="submit">Consultar inventario</button>
        </div>
      </form>
      <% if (!laboratories.length) { %>
        <div class="alert alert-info mt-3 mb-0">
          No tienes laboratorios asignados para gestionar inventarios.
        </div>
      <% } %>
    </div>
  </section>

  <% if (selectedLaboratory) { %>
    <section class="mb-4" aria-labelledby="inventoryStatusTitle">
      <h2 id="inventoryStatusTitle" class="h4 mb-3">
        Estado — <%= selectedLaboratory.nombre %>
      </h2>
      <div class="row g-3">
        <% statuses.forEach(function(status) { %>
          <div class="col-md-4">
            <article class="card app-table-panel h-100">
              <div class="card-body">
                <h3 class="h6"><%= status.etiqueta %></h3>
                <% if (status.tipo_inventario === 'reactivo' && status.estado === 'opcional') { %>
                  <p class="mb-1">Opcional — este laboratorio no ha declarado reactivos.</p>
                <% } else if (status.sin_inventario && status.estado === 'aprobado') { %>
                  <p class="mb-1">Sin inventario complementario — aprobado.</p>
                <% } else { %>
                  <p class="mb-1">Estado: <strong><%= status.estado.replaceAll('_', ' ') %></strong></p>
                <% } %>
                <small><%= status.elementos_aprobados %> registros aprobados</small>
              </div>
            </article>
          </div>
        <% }) %>
      </div>
    </section>

    <% if (isEditor) { %>
      <section class="card app-form-panel text-light mb-4">
        <div class="card-header">
          <h2 class="h5 mb-0">Cargar inventario</h2>
        </div>
        <div class="card-body">
          <p>
            Puedes cargar archivos <code>.xls</code> o <code>.xlsx</code>. El sistema separa las filas
            exitosas de las fallidas; solo las exitosas se enviarán a aprobación.
          </p>
          <form
            action="/milab/inventarios/cargas/previsualizar"
            method="post"
            enctype="multipart/form-data"
            class="row g-3 align-items-end"
          >
            <input type="hidden" name="ual_id" value="<%= selectedLaboratory.ual_id %>">
            <div class="col-md-4">
              <label for="tipo_inventario" class="form-label">Tipo de inventario</label>
              <select id="tipo_inventario" name="tipo_inventario" class="form-select" required>
                <option value="equipo_arka" <%= selectedType === 'equipo_arka' ? 'selected' : '' %>>
                  Equipo oficial ARKA (obligatorio)
                </option>
                <option value="complementario" <%= selectedType === 'complementario' ? 'selected' : '' %>>
                  Complementario y materiales (obligatorio)
                </option>
                <option value="reactivo" <%= selectedType === 'reactivo' ? 'selected' : '' %>>
                  Reactivos (opcional)
                </option>
              </select>
            </div>
            <div class="col-md-5">
              <label for="archivo" class="form-label">Archivo Excel</label>
              <input
                id="archivo"
                name="archivo"
                type="file"
                class="form-control"
                accept=".xls,.xlsx"
                required
              >
            </div>
            <div class="col-md-3">
              <button class="btn btn-perso" type="submit" data-submit-lock="true">
                Revisar archivo
              </button>
            </div>
          </form>

          <hr>
          <h3 class="h6">¿No tienes inventario complementario?</h3>
          <p>La declaración requiere aprobación y completa el requisito obligatorio del laboratorio.</p>
          <% if (coordinators.length) { %>
            <form
              action="/milab/inventarios/declarar-sin-complementarios"
              method="post"
              class="row g-3 align-items-end"
              onsubmit="return confirm('¿Confirmas que este laboratorio no tiene inventario complementario?');"
            >
              <input type="hidden" name="ual_id" value="<%= selectedLaboratory.ual_id %>">
              <div class="col-md-8">
                <label for="coordinador_declaracion" class="form-label">Coordinador que aprobará</label>
                <select id="coordinador_declaracion" name="coordinador_documento" class="form-select" required>
                  <option value="">Selecciona un coordinador autorizado</option>
                  <% coordinators.forEach(function(coordinator) { %>
                    <option value="<%= coordinator.documento %>">
                      <%= coordinator.nombre %>
                    </option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-4">
                <button class="btn btn-outline-warning" type="submit" data-submit-lock="true">
                  Enviar declaración
                </button>
              </div>
            </form>
          <% } else { %>
            <div class="alert alert-warning mb-0">
              No hay coordinadores activos autorizados para esta dependencia.
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

    <section class="card app-table-panel text-light mb-4">
      <div class="card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <h2 class="h5 mb-0">Registros del inventario</h2>
        <form method="get" action="/milab/inventarios/gestion_inventario" class="d-flex gap-2">
          <input type="hidden" name="ual_id" value="<%= selectedLaboratory.ual_id %>">
          <label class="visually-hidden" for="filter_type">Filtrar por tipo</label>
          <select id="filter_type" name="tipo_inventario" class="form-select form-select-sm">
            <option value="">Todos los tipos</option>
            <% Object.entries(inventoryLabels).forEach(function(entry) { %>
              <option value="<%= entry[0] %>" <%= selectedType === entry[0] ? 'selected' : '' %>>
                <%= entry[1] %>
              </option>
            <% }) %>
          </select>
          <button class="btn btn-outline-light btn-sm" type="submit">Filtrar</button>
        </form>
      </div>
      <div class="card-body">
        <% if (inventoryItems.length) { %>
          <div class="table-responsive">
            <table class="table table-bordered table-striped app-table-compact">
              <thead class="text-light">
                <tr>
                  <th>Tipo</th>
                  <th>Descripción</th>
                  <th>Placa / serial</th>
                  <th>Identificadores adicionales</th>
                  <th>Control de cantidad</th>
                  <th>Aprobación</th>
                </tr>
              </thead>
              <tbody>
                <% inventoryItems.forEach(function(item) { %>
                  <tr>
                    <td><%= inventoryLabels[item.tipo_inventario] || item.tipo_inventario %></td>
                    <td><%= item.descripcion %></td>
                    <td><%= item.placa || '-' %><%= item.serie ? ` / ${item.serie}` : '' %></td>
                    <td>
                      <% if (item.identificadores && item.identificadores.length) { %>
                        <%= item.identificadores.map(function(identifier) { return `${identifier.tipo}: ${identifier.valor}`; }).join(', ') %>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td>
                      <% if (item.existencias && item.existencias.length) { %>
                        <%= item.existencias.map(function(balance) { return `${balance.cantidad} ${balance.unidad} (${balance.grado}/${balance.ubicacion})`; }).join(', ') %>
                      <% } else { %>
                        <%= item.modo_control === 'cantidad' ? 'Cantidad no informada' : 'Individual' %>
                      <% } %>
                    </td>
                    <td><%= item.estado_aprobacion.replaceAll('_', ' ') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <p class="small mb-0">Se muestran hasta 500 registros del laboratorio.</p>
        <% } else { %>
          <div class="alert alert-info mb-0">
            No hay registros que coincidan con el filtro seleccionado.
          </div>
        <% } %>
      </div>
    </section>

    <section class="card app-table-panel text-light">
      <div class="card-header">
        <h2 class="h5 mb-0">Cargas recientes</h2>
      </div>
      <div class="card-body">
        <% if (recentLoads.length) { %>
          <div class="table-responsive">
            <table class="table table-bordered table-striped app-table-compact">
              <thead class="text-light">
                <tr>
                  <th>Fecha</th>
                  <th>Tipo</th>
                  <th>Archivo</th>
                  <th>Estado</th>
                  <th>Exitosas / fallidas</th>
                  <th>Detalle</th>
                </tr>
              </thead>
              <tbody>
                <% recentLoads.forEach(function(load) { %>
                  <tr>
                    <td><%= new Date(load.fecha_creacion).toLocaleString('es-CO', { timeZone: 'America/Bogota' }) %></td>
                    <td><%= inventoryLabels[load.tipo_inventario] || load.tipo_inventario %></td>
                    <td><%= load.archivo_nombre %></td>
                    <td><%= load.estado.replaceAll('_', ' ') %></td>
                    <td><%= load.filas_exitosas %> / <%= load.filas_fallidas %></td>
                    <td>
                      <a href="/milab/inventarios/cargas/<%= load.id %>">Consultar</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="mb-0">Todavía no se han realizado cargas para este laboratorio.</p>
        <% } %>
      </div>
    </section>
  <% } %>

  <% if (isAdmin) { %>
    <section class="card app-table-panel text-light mt-4">
      <div class="card-header">
        <h2 class="h5 mb-0">Registros históricos por reconciliar</h2>
      </div>
      <div class="card-body">
        <p>
          Los registros previos se conservan y no se asignan automáticamente a un laboratorio
          porque el esquema anterior no guardaba una relación confiable con la UAL.
        </p>
        <h3 class="h6">Inventario histórico (<%= legacyInventoryItems.length %> mostrados, máximo 100)</h3>
        <% if (legacyInventoryItems.length) { %>
          <div class="table-responsive mb-4">
            <table class="table table-bordered table-striped app-table-compact">
              <thead class="text-light">
                <tr>
                  <th>ID</th>
                  <th>Bien</th>
                  <th>Placa</th>
                  <th>Serie</th>
                  <th>Dependencia / espacio</th>
                </tr>
              </thead>
              <tbody>
                <% legacyInventoryItems.forEach(function(item) { %>
                  <tr>
                    <td><%= item.id %></td>
                    <td><%= item.nombre_bien %></td>
                    <td><%= item.placa || '-' %></td>
                    <td><%= item.serie || '-' %></td>
                    <td><%= [item.dependencia, item.espacio_fisico].filter(Boolean).join(' / ') || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p>No hay registros históricos de inventario por reconciliar.</p>
        <% } %>

        <h3 class="h6">Equipos técnicos sin vínculo con inventario (<%= unlinkedEquipmentItems.length %> mostrados, máximo 100)</h3>
        <% if (unlinkedEquipmentItems.length) { %>
          <div class="table-responsive">
            <table class="table table-bordered table-striped app-table-compact">
              <thead class="text-light">
                <tr>
                  <th>ID técnico</th>
                  <th>Código</th>
                  <th>Equipo</th>
                  <th>Categoría / estado</th>
                  <th>Laboratorio / facultad</th>
                </tr>
              </thead>
              <tbody>
                <% unlinkedEquipmentItems.forEach(function(item) { %>
                  <tr>
                    <td><%= item.id %></td>
                    <td><%= item.codigo %></td>
                    <td><%= item.nombre %></td>
                    <td><%= item.categoria %> / <%= item.estado %></td>
                    <td><%= [item.laboratorio, item.facultad].filter(Boolean).join(' / ') || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="mb-0">No hay equipos técnicos pendientes de vínculo.</p>
        <% } %>
      </div>
    </section>
  <% } %>
</main>

<%- include('../../../partials/footer'); -%>
