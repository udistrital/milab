<%- include('../partials/header'); -%>
<main class="container app-page-shell">
  <style>
    .app-detail-modal {
      z-index: 3000;
    }

    .modal-backdrop.show {
      z-index: 2990;
    }
  </style>
  <section class="app-page-header">
    <h1 class="app-page-title">Autorizaciones de sanciones</h1>
    <p class="app-page-subtitle">Desde aquí puedes autorizar a los laboratoristas de tu facultad para que apliquen y salden multas directamente sin pasar por tu aprobación. También puedes gestionar el paso de sanciones pendientes a activas o saldadas.</p>
  </section>

  <section class="card app-table-panel mb-4">
    <div class="card-body">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <h3 class="app-panel-title mb-0">Autorizaciones de facultades</h3>
        <small class="text-muted">Activa los switches por facultad para otorgar permisos directos sobre el ciclo de vida de las multas.</small>
      </div>

      <% if (!Array.isArray(facultadesParaAutorizar) || facultadesParaAutorizar.length === 0) { %>
        <div class="alert alert-info text-center mb-0">No se encontraron facultades asociadas a tu coordinación para gestionar autorizaciones.</div>
      <% } else { %>
        <div class="row g-3">
          <% facultadesParaAutorizar.forEach(function (facultad) { %>
            <div class="col-12 col-lg-6" data-facultad-card="<%= facultad.facultad_id %>">
              <div class="card border-0 bg-body-secondary">
                <div class="card-body">
                  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
                    <h5 class="card-title mb-0"><%= facultad.nombre %></h5>
                    <div data-facultad-badges="<%= facultad.facultad_id %>">
                      <% if (facultad.permite_crear_multas_activas_directas) { %>
                        <span class="badge text-bg-success me-2" data-badge-crear="<%= facultad.facultad_id %>">Crear directo</span>
                      <% } %>
                      <% if (facultad.permite_saldar_multas_directas) { %>
                        <span class="badge text-bg-primary" data-badge-saldar="<%= facultad.facultad_id %>">Saldar directo</span>
                      <% } %>
                      <% if (!facultad.permite_crear_multas_activas_directas && !facultad.permite_saldar_multas_directas) { %>
                        <span class="badge text-bg-secondary" data-badge-tradicional="<%= facultad.facultad_id %>">Flujo tradicional</span>
                      <% } %>
                    </div>
                  </div>

                  <div class="row g-2 mb-3">
                    <div class="col-md-6 d-flex flex-column gap-2">
                      <form
                        id="form_toggle_crear_<%= facultad.facultad_id %>"
                        action="/milab/api/aprobacion_multa/configuracion/<%= facultad.facultad_id %>/toggle-crear-directa"
                        method="POST"
                        class="m-0 js-form-toggle-config"
                        data-config-flag="permite_crear_multas_activas_directas"
                        data-config-facultad="<%= facultad.facultad_id %>"
                      >
                        <%- include('../partials/csrf_field') %>
                        <div class="form-check form-switch ms-1">
                          <input
                            class="form-check-input js-toggle-config"
                            type="checkbox"
                            role="switch"
                            form="form_toggle_crear_<%= facultad.facultad_id %>"
                            id="toggle_crear_<%= facultad.facultad_id %>"
                            <%= facultad.permite_crear_multas_activas_directas ? 'checked' : '' %>
                          >
                          <label class="form-check-label" for="toggle_crear_<%= facultad.facultad_id %>">Crear sanciones ACTIVAS directamente</label>
                        </div>
                      </form>
                      <div class="small text-muted ps-1">El laboratorista asigna directamente el tipo de sanción y la multa queda vigente de inmediato, enviando correo al sancionado.</div>
                    </div>
                    <div class="col-md-6 d-flex flex-column gap-2">
                      <form
                        id="form_toggle_saldar_<%= facultad.facultad_id %>"
                        action="/milab/api/aprobacion_multa/configuracion/<%= facultad.facultad_id %>/toggle-saldar-directa"
                        method="POST"
                        class="m-0 js-form-toggle-config"
                        data-config-flag="permite_saldar_multas_directas"
                        data-config-facultad="<%= facultad.facultad_id %>"
                      >
                        <%- include('../partials/csrf_field') %>
                        <div class="form-check form-switch ms-1">
                          <input
                            class="form-check-input js-toggle-config"
                            type="checkbox"
                            role="switch"
                            form="form_toggle_saldar_<%= facultad.facultad_id %>"
                            id="toggle_saldar_<%= facultad.facultad_id %>"
                            <%= facultad.permite_saldar_multas_directas ? 'checked' : '' %>
                          >
                          <label class="form-check-label" for="toggle_saldar_<%= facultad.facultad_id %>">Saldar sanciones directamente</label>
                        </div>
                      </form>
                      <div class="small text-muted ps-1">El laboratorista cierra la multa como SALDADA inmediatamente, sin pasar por POR SALDAR.</div>
                    </div>
                  </div>

                  <div class="small text-muted ps-1" data-facultad-last-mod="<%= facultad.facultad_id %>">
                    <% if (facultad.fecha_ultima_modificacion) { %>
                      Última modificación: <%= new Date(facultad.fecha_ultima_modificacion).toLocaleString('es-CO') %>
                      <% if (facultad.documento_ultimo_autorizador) { %> · Coordinador: <%= facultad.documento_ultimo_autorizador %><% } %>
                      <% if (facultad.accion_ultima && facultad.accion_ultima !== 'inicial') { %> · Acción: <%= facultad.accion_ultima.replace(/_/g, ' ') %><% } %>
                    <% } else { %>
                      Sin cambios de configuración registrados aún.
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <section class="card app-table-panel p-0">
  <div class="card-body">
  
  <% if (multas.length === 0) { %>
    <div class="alert alert-info text-center">No hay sanciones pendientes asociadas a tu facultad.</div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-bordered table-hover table-light app-table-compact table-multas js-data-grid" data-grid-page-length="25" data-grid-scroll-x="false">
        <thead class="table-light text-center">
          <tr>
            <th>ID</th>
            <th>Documento sancionado</th>
            <th>Fecha de la sanción</th>
            <th>Estado</th>
            <th data-grid-filter="false" data-grid-orderable="false">Ver detalle</th>
          </tr>
        </thead>
        <tbody>
          <% multas.forEach(multa => { %>
            <tr>
              <td><%= multa.id %></td>
              <td><%= multa.documento_sancionado %></td>
              <td><%= new Date(multa.fecha_multa).toLocaleDateString('es-CO') %></td>
              <td><%= multa.con_estado_multa %></td>
              <td class="text-center">
                <button
                  type="button"
                  class="btn btn-outline-info btn-sm app-detail-button"
                  data-bs-toggle="modal"
                  data-bs-target="#detalleSancionModal"
                  data-sancion-id="<%= multa.id %>"
                  data-sancion-documento="<%= multa.documento_sancionado %>"
                  data-sancion-fecha="<%= new Date(multa.fecha_multa).toLocaleDateString('es-CO') %>"
                  data-sancion-estado="<%= multa.con_estado_multa %>"
                  data-sancion-laboratorista="<%= multa.nombre_laboratorista %>"
                  data-sancion-ual="<%= multa.ual %>"
                  data-sancion-categoria="<%= multa.cat_multa %>"
                  data-sancion-tipo="<%= multa.tipo_sancion || 'Por definir' %>"
                  data-sancion-observaciones="<%= multa.obs_multa || 'Sin observaciones' %>"
                >
                  <i class="bi bi-eye"></i>
                  Ver detalle
                </button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
  </section>
</main>

<div class="modal fade app-detail-modal" id="detalleSancionModal" tabindex="-1" aria-labelledby="detalleSancionLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="detalleSancionLabel">Detalle de la sanción</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="text-muted small">ID</div>
            <div class="fw-semibold" data-detail-field="id"></div>
          </div>
          <div class="col-md-6">
            <div class="text-muted small">Estado</div>
            <div class="fw-semibold" data-detail-field="estado"></div>
          </div>
          <div class="col-md-6">
            <div class="text-muted small">Nombre sancionado</div>
            <div class="fw-semibold" data-detail-field="nombre"></div>
          </div>
          <div class="col-md-6">
            <div class="text-muted small">Documento</div>
            <div class="fw-semibold" data-detail-field="documento"></div>
          </div>
          <div class="col-md-6">
            <div class="text-muted small">Fecha de la sanción</div>
            <div class="fw-semibold" data-detail-field="fecha"></div>
          </div>
          <div class="col-md-6">
            <div class="text-muted small">Laboratorista</div>
            <div class="fw-semibold" data-detail-field="laboratorista"></div>
          </div>
          <div class="col-md-6">
            <div class="text-muted small">UAL</div>
            <div class="fw-semibold" data-detail-field="ual"></div>
          </div>
          <div class="col-md-6">
            <div class="text-muted small">Categoría de la sanción</div>
            <div class="fw-semibold" data-detail-field="categoria"></div>
          </div>
          <div class="col-md-6">
            <div class="text-muted small">Tipo de sanción</div>
            <div class="fw-semibold" data-detail-field="tipo"></div>
          </div>
          <div class="col-12">
            <div class="text-muted small">Observaciones</div>
            <div class="fw-semibold" data-detail-field="observaciones"></div>
          </div>
        </div>

        <div class="border-top pt-3 mt-3" data-detail-action="activate">
          <h6 class="mb-3">Aplicar sanción</h6>
          <form action="/milab/api/aprobacion_multa/activar" method="POST" class="row g-3">
            <%- include('../partials/csrf_field') %>
            <input type="hidden" name="multa_id" data-detail-input="multa_id">
            <div class="col-12">
              <label class="form-label" for="tipo_sancion_detalle">Tipo de sanción</label>
              <select id="tipo_sancion_detalle" name="tipo_sancion" class="form-select" required>
                <option value="">Selecciona tipo de sanción</option>
                <% (Array.isArray(SANCTION_TYPES) ? SANCTION_TYPES : []).forEach(function (tipo) { %>
                  <option value="<%= tipo %>"><%= tipo %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-12 d-flex justify-content-end gap-2">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Volver</button>
              <button type="submit" class="btn btn-success">Activar sanción</button>
            </div>
          </form>
        </div>

        <div class="border-top pt-3 mt-3 d-none" data-detail-action="saldar">
          <h6 class="mb-3">Marcar sanción como saldada</h6>
          <form action="/milab/api/aprobacion_multa/saldar" method="POST" class="row g-3">
            <%- include('../partials/csrf_field') %>
            <input type="hidden" name="multa_id" data-detail-input="multa_id">
            <div class="col-12 d-flex justify-content-end gap-2">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Volver</button>
              <button type="submit" class="btn btn-primary">Marcar como saldada</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  (function configureToggles() {
    const forms = document.querySelectorAll('.js-form-toggle-config');
    if (!forms.length) {
      return;
    }

    function readCsrfToken(form) {
      const tokenInput = form.querySelector('input[name="_csrf"]');
      return tokenInput ? tokenInput.value : '';
    }

    function rebuildBadges(facultadId, permiteCrear, permiteSaldar) {
      const badgesWrap = document.querySelector(`[data-facultad-badges="${facultadId}"]`);
      if (!badgesWrap) {
        return;
      }
      badgesWrap.innerHTML = '';
      if (permiteCrear) {
        const span = document.createElement('span');
        span.className = 'badge text-bg-success me-2';
        span.setAttribute('data-badge-crear', String(facultadId));
        span.textContent = 'Crear directo';
        badgesWrap.appendChild(span);
      }
      if (permiteSaldar) {
        const span = document.createElement('span');
        span.className = 'badge text-bg-primary';
        span.setAttribute('data-badge-saldar', String(facultadId));
        span.textContent = 'Saldar directo';
        badgesWrap.appendChild(span);
      }
      if (!permiteCrear && !permiteSaldar) {
        const span = document.createElement('span');
        span.className = 'badge text-bg-secondary';
        span.setAttribute('data-badge-tradicional', String(facultadId));
        span.textContent = 'Flujo tradicional';
        badgesWrap.appendChild(span);
      }
    }

    function updateLastMod(facultadId, fechaIso, documentoAutorizador, accion) {
      const target = document.querySelector(`[data-facultad-last-mod="${facultadId}"]`);
      if (!target) {
        return;
      }
      const fecha = new Date(fechaIso);
      const fechaTexto = fecha.toLocaleString('es-CO');
      let accionTexto = '';
      if (accion && accion !== 'inicial') {
        accionTexto = ' · Acción: ' + String(accion).replace(/_/g, ' ');
      }
      const autorTexto = documentoAutorizador ? ' · Coordinador: ' + String(documentoAutorizador) : '';
      target.innerHTML = 'Última modificación: ' + fechaTexto + autorTexto + accionTexto;
    }

    function getCurrentFlags(facultadId) {
      const crearBadge = document.querySelector(`[data-badge-crear="${facultadId}"]`);
      const saldarBadge = document.querySelector(`[data-badge-saldar="${facultadId}"]`);
      return {
        permiteCrear: !!crearBadge,
        permiteSaldar: !!saldarBadge,
      };
    }

    forms.forEach(function (form) {
      const flag = form.getAttribute('data-config-flag');
      const facultadId = form.getAttribute('data-config-facultad');
      const toggleInput = form.querySelector('.js-toggle-config');
      if (!flag || !facultadId || !toggleInput) {
        return;
      }

      toggleInput.addEventListener('change', function (ev) {
        ev.preventDefault();
        const newValue = toggleInput.checked;
        const previousValue = !newValue;
        const url = form.getAttribute('action') || '';
        const csrf = readCsrfToken(form);

        toggleInput.disabled = true;
        toggleInput.style.cursor = 'progress';

        fetch(url, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'X-CSRF-Token': csrf,
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
          },
          body: '_csrf=' + encodeURIComponent(csrf),
          credentials: 'same-origin',
        })
          .then(function (res) {
            if (res.status >= 400) {
              return res.json().then(
                function (payload) {
                  throw new Error((payload && payload.message) || ('HTTP ' + res.status));
                },
                function () {
                  throw new Error('HTTP ' + res.status);
                }
              );
            }
            return res.json();
          })
          .then(function (payload) {
            if (!payload || !payload.ok) {
              throw new Error((payload && payload.message) || 'Respuesta inválida del servidor');
            }
            const current = getCurrentFlags(facultadId);
            const siguiente = {
              permiteCrear: current.permiteCrear,
              permiteSaldar: current.permiteSaldar,
            };
            if (flag === 'permite_crear_multas_activas_directas') {
              siguiente.permiteCrear = !!payload.nextValue;
            } else if (flag === 'permite_saldar_multas_directas') {
              siguiente.permiteSaldar = !!payload.nextValue;
            }
            rebuildBadges(facultadId, siguiente.permiteCrear, siguiente.permiteSaldar);
            updateLastMod(facultadId, payload.fecha_modificacion, payload.documento_autorizador, payload.accion_ultima);
          })
          .catch(function (err) {
            console.error('Error actualizando configuración de facultad:', err);
            toggleInput.checked = previousValue;
          })
          .finally(function () {
            toggleInput.disabled = false;
            toggleInput.style.cursor = '';
          });
      });
    });
  })();

  document.addEventListener('click', function (event) {
    const trigger = event.target.closest('.app-detail-button');

    if (!trigger) {
      return;
    }

    const fields = {
      id: trigger.getAttribute('data-sancion-id'),
      documento: trigger.getAttribute('data-sancion-documento'),
      fecha: trigger.getAttribute('data-sancion-fecha'),
      estado: trigger.getAttribute('data-sancion-estado'),
      laboratorista: trigger.getAttribute('data-sancion-laboratorista'),
      ual: trigger.getAttribute('data-sancion-ual'),
      categoria: trigger.getAttribute('data-sancion-categoria'),
      tipo: trigger.getAttribute('data-sancion-tipo'),
      observaciones: trigger.getAttribute('data-sancion-observaciones'),
    };

    Object.keys(fields).forEach(function (key) {
      const target = document.querySelector(`[data-detail-field="${key}"]`);
      if (target) {
        target.textContent = fields[key] || '-';
      }
    });

    const nombreTarget = document.querySelector('[data-detail-field="nombre"]');
    if (nombreTarget) {
      nombreTarget.textContent = 'Cargando...';
    }

    const documento = fields.documento || '';
    if (documento) {
      fetch(`/milab/api/get_list_multas/resolve_name?documento=${encodeURIComponent(documento)}`)
        .then((response) => response.json())
        .then((data) => {
          if (nombreTarget) {
            nombreTarget.textContent = data && data.nombre ? data.nombre : 'Sin nombre';
          }
        })
        .catch(() => {
          if (nombreTarget) {
            nombreTarget.textContent = 'Sin nombre';
          }
        });
    }

    const multaIdInputs = document.querySelectorAll('[data-detail-input="multa_id"]');
    const multaId = trigger.getAttribute('data-sancion-id') || '';

    multaIdInputs.forEach(function (input) {
      input.value = multaId;
    });

    const select = document.getElementById('tipo_sancion_detalle');
    const tipoActual = trigger.getAttribute('data-sancion-tipo');
    if (select) {
      select.value = tipoActual && tipoActual !== 'Por definir' ? tipoActual : '';
    }

    const estado = (fields.estado || '').toUpperCase();
    const activarSection = document.querySelector('[data-detail-action="activate"]');
    const saldarSection = document.querySelector('[data-detail-action="saldar"]');

    if (estado === 'PENDIENTE') {
      activarSection?.classList.remove('d-none');
      saldarSection?.classList.add('d-none');
    } else if (estado === 'POR SALDAR') {
      activarSection?.classList.add('d-none');
      saldarSection?.classList.remove('d-none');
    } else {
      activarSection?.classList.add('d-none');
      saldarSection?.classList.add('d-none');
    }
  });
</script>
<%- include('../partials/footer'); -%>

