<%- include('../partials/header'); -%>
<main class="container-fluid app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Período académico</h1>
    <p class="app-page-subtitle">
      Consulta el período vigente en OATI. Si MiLab aún no tiene uno asignado, lo establecerá; si
      detecta un cambio, conservará el historial y avisará a los laboratoristas.
    </p>
  </section>

  <% if (error) { %>
    <div class="alert alert-danger" role="alert"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="alert alert-success" role="status"><%= success %></div>
  <% } %>

  <section class="card app-table-panel mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <h2 class="h5 mb-1">Período activo en MiLab</h2>
        <% if (activePeriod) { %>
          <p class="mb-0">
            <strong><%= activePeriod.codigo_periodo %></strong>
            <span class="text-muted">desde <%= activePeriod.fecha_activacion %></span>
          </p>
        <% } else { %>
          <p class="text-muted mb-0">Todavía no hay un período asignado en MiLab.</p>
        <% } %>
      </div>
      <form method="POST" action="/milab/api/admin/periodo/sincronizar" class="m-0">
        <%- include('../partials/csrf_field') %>
        <button type="submit" class="btn btn-primary" data-submit-lock="true">
          <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Consultar período vigente en OATI
        </button>
      </form>
    </div>
  </section>

  <section class="card app-table-panel">
    <div class="card-body">
      <h2 class="h5">Historial de períodos</h2>
      <% if (periodHistory.length) { %>
        <div class="table-responsive">
          <table class="table table-striped align-middle mb-0">
            <thead>
              <tr>
                <th>Período</th>
                <th>Estado</th>
                <th>Activo desde</th>
                <th>Activo hasta</th>
                <th>Consultado por</th>
              </tr>
            </thead>
            <tbody>
              <% periodHistory.forEach((period) => { %>
                <tr>
                  <td>
                    <strong><%= period.codigo_periodo %></strong>
                    <% if (period.periodo_anterior) { %>
                      <span class="d-block small text-muted">Cambio desde <%= period.periodo_anterior %></span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge <%= period.activo ? 'text-bg-success' : 'text-bg-secondary' %>">
                      <%= period.activo ? 'Activo' : 'Finalizado' %>
                    </span>
                  </td>
                  <td><%= period.fecha_activacion %></td>
                  <td><%= period.fecha_desactivacion || '—' %></td>
                  <td><%= period.consultado_por_documento || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted mb-0">Aún no se han registrado períodos en MiLab.</p>
      <% } %>
    </div>
  </section>
</main>
<%- include('../partials/footer'); -%>
