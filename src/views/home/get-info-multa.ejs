<%- include('../partials/header'); -%>
<% if (locals.tipo !== 'admin' && locals.tipo !== 'laboratorista' && locals.tipo !== 'coordinador') { %>
  <script nonce="<%= cspNonce %>">
    window.location.href = '/milab/auth/login';
  </script>
<% } else { %>
  <main class="container app-page-shell">
    <%- include('../partials/fine-person-search', {
      searchConfig: {
        title: 'Gestión de sanciones estudiantiles',
        description: 'Busca un estudiante para revisar su información y elegir cómo continuar.',
        searchUrl: '/milab/api/get-info-multa',
        loadingMessage: 'Consultando el estudiante en la OATI...',
        studentSearch: true,
      },
    }) %>
  </main>
  <%- include('../partials/footer'); -%>
<% } %>
