      state.asistencias = {
        asistidos: Array.isArray(data.asistencias) || Array.isArray(data.asistidos) ? (data.asistencias || data.asistidos || []).filter(function (a) { return a?.asistio === true || a?.asistio === 'true'; }) : [],
        faltantes: Array.isArray(data.inscritos_sin_asistencia) ? data.inscritos_sin_asistencia : [],
        sesionId: sesionId,
      };
      renderAsistencias();
    };
    xhr.onerror = function () {
      setGlobalAlert('Error de conexión cargando asistencias.', 'danger');
      if (aBody) aBody.innerHTML = '<tr><td colspan="4" class="text-center py-3"><div class="alert alert-danger mb-0 d-inline-block text-start">Error de conexión. Recargue.</div></td></tr>';
      if (fBody) fBody.innerHTML = '<tr><td colspan="4" class="text-center py-3"><div class="alert alert-danger mb-0 d-inline-block text-start">Error de conexión. Recargue.</div></td></tr>';
    };
    xhr.send();
  }

