      var data = safeParseJsonXhr(xhr, 'loadAsistenciasSesion', 'Error cargando asistencias. ');
      if (!data) {
        if (aBody) aBody.innerHTML = '<tr><td colspan="4" class="text-center py-3"><div class="alert alert-danger mb-0 d-inline-block text-start">No se pudieron cargar los asistentes. Recargue la página.</div></td></tr>';
        if (fBody) fBody.innerHTML = '<tr><td colspan="4" class="text-center py-3"><div class="alert alert-danger mb-0 d-inline-block text-start">No se pudieron cargar los inscritos. Recargue la página.</div></td></tr>';
        if (document.getElementById('count-asistidos')) document.getElementById('count-asistidos').textContent = '0';
