<%- include('../partials/header'); -%>
<%
  var userRole = (locals.tipo || navigation.role || '').toString().trim().toLowerCase();
  var isAdmin = userRole === 'admin';
  var isLab = userRole === 'laboratorista' || userRole === 'laboratorista_ud' || userRole === 'laboratorista_ual';
  var canManageFull = isAdmin || userRole === 'coordinador' || userRole === 'coordinador_general' || userRole === 'coordinacion general';
%>

<main class="container app-page-shell" id="capacitacion-gestion-shell">
  <section class="app-page-header">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <h1 class="app-page-title">Gestionar capacitaciones</h1>
        <p class="app-page-subtitle">Gestiona solicitudes de estudiantes, programa sesiones, registra asistencia y certifica localmente a los usuarios.</p>
      </div>
      <div class="d-flex gap-2 align-items-center flex-wrap">
        <button type="button" id="btn-recargar" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-arrow-repeat"></i> Actualizar
        </button>
        <span id="scope-label" class="badge text-bg-light border">Scope: cargando…</span>
        <span class="badge text-bg-light border border-warning-subtle">
          <i class="bi bi-person-badge me-1" style="color:#b45309;"></i>
          Rol: <%= isAdmin ? 'Administrador' : (isLab ? 'Laboratorista' : (canManageFull ? 'Coordinación' : (locals.sessionRoleLabel || userRole))) %>
        </span>
      </div>
    </div>
  </section>

  <div id="mensajes-globales"></div>

  <section class="mb-4" id="scope-alert-section" style="display:none;">
    <div class="alert alert-warning" role="alert" style="border-color:#f0aa00;background:#fff7e1;">
      <div class="d-flex align-items-start gap-3">
        <i class="bi bi-shield-lock fs-3" style="color:#b45309;"></i>
        <div>
          <h5 class="alert-heading mb-1" style="color:#7c3b04;" id="scope-alert-title">Alcance de gestión</h5>
          <p class="mb-0" id="scope-alert-body">Usted solo puede gestionar capacitaciones en los laboratorios y facultades que tiene asignados.</p>
        </div>
      </div>
    </div>
  </section>

  <form style="display:none;" novalidate>
    <%- include('../partials/csrf_field'); -%>
  </form>

  <div class="mb-3" id="gestion-tabs-shell">
    <ul class="nav nav-tabs flex-wrap mb-3" role="tablist" id="tabs-gestion-capacitacion">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-solicitudes" data-bs-toggle="tab" data-bs-target="#pane-solicitudes" type="button" role="tab" aria-controls="pane-solicitudes" aria-selected="true">
          <i class="bi bi-envelope-exclamation me-1"></i> Solicitudes pendientes
          <span id="count-solicitudes" class="badge rounded-pill bg-warning text-dark ms-1">0</span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-sesiones" data-bs-toggle="tab" data-bs-target="#pane-sesiones" type="button" role="tab" aria-controls="pane-sesiones" aria-selected="false">
          <i class="bi bi-calendar-event me-1"></i> Sesiones programadas
          <span id="count-sesiones" class="badge rounded-pill bg-info text-dark ms-1">0</span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-asistencia" data-bs-toggle="tab" data-bs-target="#pane-asistencia" type="button" role="tab" aria-controls="pane-asistencia" aria-selected="false">
          <i class="bi bi-clipboard-check me-1"></i> Asistencia de sesión
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-reporte" data-bs-toggle="tab" data-bs-target="#pane-reporte" type="button" role="tab" aria-controls="pane-reporte" aria-selected="false">
          <i class="bi bi-file-bar-graph me-1"></i> Reporte capacitaciones
        </button>
      </li>
    </ul>

    <div class="tab-content">
      <div class="tab-pane fade show active" id="pane-solicitudes" role="tabpanel" aria-labelledby="tab-solicitudes">
        <section class="card mb-4">
          <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2" style="background:#faf6ed;border-color:#f0e2c1;">
            <h5 class="mb-0" style="color:#7c3b04;">
              <i class="bi bi-filter me-2" style="color:#b45309;"></i>
              Filtros
            </h5>
            <div class="d-flex gap-2 flex-wrap align-items-center">
              <div class="input-group input-group-sm" style="max-width:260px;">
                <span class="input-group-text">Curso</span>
                <input type="text" class="form-control" id="filter-curso-solicitudes" placeholder="Buscar por código o nombre" />
              </div>
              <select class="form-select form-select-sm" id="filter-estado-solicitudes" style="max-width:200px;">
                <option value="">Todos los estados</option>
                <option value="pendiente" selected>Pendientes</option>
                <option value="notificado_programada">Sesión notificada</option>
                <option value="atendido_cerrado">Atendidas</option>
                <option value="cancelado">Canceladas</option>
              </select>
              <button type="button" id="btn-aplicar-filtros-solicitudes" class="btn btn-sm btn-outline-secondary">Aplicar</button>
              <button type="button" id="btn-programar-rapido" class="btn btn-sm btn-warning" style="background:#ffbf00;border-color:#f0aa00;color:#7c3b04;">
                <i class="bi bi-calendar-plus me-1"></i> Programar sesión
              </button>
            </div>
          </div>
          <div class="card-body">
            <div id="alert-solicitudes" class="alert d-none"></div>
            <div class="table-responsive">
              <table class="table table-hover align-middle" id="tabla-solicitudes">
                <thead style="background:#faf6ed;">
                  <tr>
                    <th>Fecha envío</th>
                    <th>Solicitante</th>
                    <th>Curso</th>
                    <th>UAL / Facultad</th>
                    <th>Estado</th>
                    <th>Mensaje</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td colspan="7" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Cargando solicitudes de tu alcance...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>

      <div class="tab-pane fade" id="pane-sesiones" role="tabpanel" aria-labelledby="tab-sesiones">
        <section class="card mb-4">
          <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2" style="background:#e8f6ee;border-color:#b7e5c9;">
            <h5 class="mb-0" style="color:#137333;">
              <i class="bi bi-calendar3 me-2" style="color:#1e8e3e;"></i>
              Sesiones de capacitación (tu alcance)
            </h5>
            <button type="button" id="btn-nueva-sesion" class="btn btn-sm btn-success">
              <i class="bi bi-plus-lg me-1"></i> Nueva sesión
            </button>
          </div>
          <div class="card-body">
            <div id="alert-sesiones" class="alert d-none"></div>
            <div class="table-responsive">
              <table class="table table-hover align-middle" id="tabla-sesiones">
                <thead style="background:#e8f6ee;">
                  <tr>
                    <th># Sesión</th>
                    <th>Curso</th>
                    <th>Fecha / Hora</th>
                    <th>Lugar (UAL)</th>
                    <th>Cupo / Inscritos</th>
                    <th>Estado</th>
                    <th>Laboratorista</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td colspan="8" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Cargando sesiones programadas...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>

      <div class="tab-pane fade" id="pane-asistencia" role="tabpanel" aria-labelledby="tab-asistencia">
        <section class="card mb-4">
          <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2" style="background:#eef7ff;border-color:#c7e6ff;">
            <h5 class="mb-0" style="color:#085394;">
              <i class="bi bi-qr-code me-2" style="color:#0a5c84;"></i>
              Registrar asistencia a sesión
            </h5>
            <div class="d-flex gap-2 align-items-center flex-wrap">
              <label class="form-label mb-0 small" for="asistencia-sesion-select"><b>Sesión:</b></label>
              <select id="asistencia-sesion-select" class="form-select form-select-sm" style="max-width:420px;">
                <option value="">(Seleccione una sesión programada o en curso)</option>
              </select>
            </div>
          </div>
          <div class="card-body">
            <div id="alert-asistencia" class="alert d-none"></div>

            <fieldset class="border rounded p-3 mb-4" style="border-color:#c7e6ff;background:#f7fbff;">
              <legend class="float-none w-auto px-2 fs-6" style="color:#085394;">
                <i class="bi bi-qr-code-scan me-1" style="color:#0a5c84;"></i>
                Marcar asistencia por documento (QR / manual)
              </legend>
              <div class="row g-3 align-items-end">
                <div class="col-md-6">
                  <label for="asistencia-doc-input" class="form-label">Documento del estudiante *</label>
                  <input type="text" class="form-control form-control-lg" id="asistencia-doc-input" maxlength="50" placeholder="Escanea QR del estudiante o pega su documento aquí" autocomplete="off" />
                  <div class="form-text">Luego de escanear/ingresar el documento, presiona Enter o clic en Marcar.</div>
                </div>
                <div class="col-md-3">
                  <label for="asistencia-metodo-select" class="form-label">Método de marcado</label>
                  <select id="asistencia-metodo-select" class="form-select">
                    <option value="qr_documento">📷 QR documento</option>
                    <option value="manual">✍️ Manual / Lista</option>
                    <option value="lista_asistencia">📋 Lista asistencia</option>
                  </select>
                </div>
                <div class="col-md-3">
                  <button type="button" id="btn-marcar-asistencia" class="btn btn-primary w-100" data-submit-lock="true">
                    <i class="bi bi-check2-square me-1"></i> Marcar asistencia
                  </button>
                </div>
              </div>
            </fieldset>

            <div class="row g-3 align-items-end mb-4">
              <div class="col-md-6">
                <label for="filter-asistidos-search" class="form-label">Buscar inscrito</label>
                <input type="text" id="filter-asistidos-search" class="form-control" placeholder="Filtrar tabla por nombre o documento" />
              </div>
              <div class="col-md-6 text-end">
                <button type="button" id="btn-certificar-asistentes-sesion" class="btn btn-outline-success me-2">
                  <i class="bi bi-patch-check me-1"></i> Certificar asistentes (todos)
                </button>
                <button type="button" id="btn-finalizar-sesion" class="btn btn-outline-secondary me-2">
                  <i class="bi bi-flag me-1"></i> Marcar sesión Realizada
                </button>
                <button type="button" id="btn-evidencia-sesion" class="btn btn-outline-info">
                  <i class="bi bi-cloud-upload me-1"></i> Subir evidencia
                </button>
              </div>
            </div>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <div class="card border-success" style="background:#f3fff6;">
                  <div class="card-header bg-success bg-opacity-10 border-success">
                    <b>✅ Asistieron (<span id="count-asistidos">0</span>)</b>
                  </div>
                  <div class="card-body p-0">
                    <div class="table-responsive">
                      <table class="table table-sm align-middle mb-0" id="tabla-asistidos">
                        <thead><tr><th>Documento</th><th>Nombre</th><th>Fecha marcado</th><th>Cert.</th></tr></thead>
                        <tbody><tr><td colspan="4" class="text-center text-muted py-3">Seleccione una sesión para ver la lista de asistentes.</td></tr></tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="card border-secondary" style="background:#fafafa;">
                  <div class="card-header bg-secondary bg-opacity-10 border-secondary">
                    <b>⏳ Inscritos sin asistencia (<span id="count-faltantes">0</span>)</b>
                  </div>
                  <div class="card-body p-0">
                    <div class="table-responsive">
                      <table class="table table-sm align-middle mb-0" id="tabla-faltantes">
                        <thead><tr><th>Documento</th><th>Nombre</th><th>Inscrito el</th><th>Acción</th></tr></thead>
                        <tbody><tr><td colspan="4" class="text-center text-muted py-3">Seleccione una sesión para ver quienes faltan.</td></tr></tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div class="tab-pane fade" id="pane-reporte" role="tabpanel" aria-labelledby="tab-reporte">
        <section class="card mb-4">
          <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2" style="background:#f4f4fb;border-color:#dcdcff;">
            <h5 class="mb-0" style="color:#3a0ca3;">
              <i class="bi bi-journal-text me-2" style="color:#560bad;"></i>
              Reporte de capacitaciones (tu alcance)
            </h5>
            <button type="button" id="btn-descargar-csv" class="btn btn-sm btn-primary">
              <i class="bi bi-filetype-csv me-1"></i> Exportar CSV
            </button>
          </div>
          <div class="card-body">
            <div class="row g-3 mb-4">
              <div class="col-md-3">
                <label for="report-fecha-desde" class="form-label">Fecha desde</label>
                <input type="date" class="form-control" id="report-fecha-desde" />
              </div>
              <div class="col-md-3">
                <label for="report-fecha-hasta" class="form-label">Fecha hasta</label>
                <input type="date" class="form-control" id="report-fecha-hasta" />
              </div>
              <div class="col-md-3">
                <label for="report-estado-sesion" class="form-label">Estado sesión</label>
                <select class="form-select" id="report-estado-sesion">
                  <option value="">Todos</option>
                  <option value="programada">Programada</option>
                  <option value="en_curso">En curso</option>
                  <option value="realizada">Realizada</option>
                  <option value="cancelada">Cancelada</option>
                </select>
              </div>
              <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="button" id="btn-aplicar-filtros-reporte" class="btn btn-outline-secondary w-100"><i class="bi bi-funnel me-1"></i> Aplicar filtros</button>
              </div>
            </div>

            <div id="alert-reporte" class="alert d-none"></div>
            <div class="table-responsive">
              <table class="table table-hover align-middle" id="tabla-reporte">
                <thead style="background:#f4f4fb;">
                  <tr>
                    <th># Sesión</th>
                    <th>Fecha</th>
                    <th>Curso</th>
                    <th>UAL / Facultad</th>
                    <th>Cupo</th>
                    <th>Inscritos</th>
                    <th>Asistentes</th>
                    <th>Certificados</th>
                    <th>Modalidad</th>
                    <th>Evidencia</th>
                    <th>Lab. responsable</th>
                    <th>Estado</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td colspan="12" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Cargando reporte (aplica filtros o espera...)…</td></tr>
                </tbody>
              </table>
            </div>
            <div class="alert alert-info small mt-3" role="alert">
              <i class="bi bi-info-circle me-2"></i>
              <b>Nota:</b> El reporte CSV detallado y filtros avanzados se habilitarán con el Task 7 del módulo. Por ahora puedes exportar y ver resumenes de tus capacitaciones.
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</main>

<!-- Modal Programar Sesión -->
<div class="modal fade" id="modal-programar-sesion" tabindex="-1" aria-labelledby="modal-programar-sesion-title" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header" style="background:#e8f6ee;border-bottom:1px solid #b7e5c9;">
        <h1 class="modal-title fs-5" id="modal-programar-sesion-title" style="color:#137333;">
          <i class="bi bi-calendar-plus me-2" style="color:#1e8e3e;"></i>Programar nueva sesión de capacitación
        </h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <form id="form-programar-sesion" novalidate>
        <div class="modal-body">
          <div id="modal-programar-alert" class="alert d-none"></div>

          <div class="row g-3">
            <div class="col-md-6">
              <label for="ps-codigo-curso" class="form-label">Código curso *</label>
              <input type="text" class="form-control" id="ps-codigo-curso" maxlength="100" list="ps-list-cursos" required placeholder="Código del catálogo cursos" />
              <datalist id="ps-list-cursos"></datalist>
              <div id="ps-nombre-curso-hint" class="form-text text-primary fw-semibold"></div>
            </div>
            <div class="col-md-6">
              <label for="ps-ual" class="form-label">Laboratorio / UAL</label>
              <select id="ps-ual" class="form-select">
                <option value="">Todas (cualquier UAL)</option>
              </select>
              <div class="form-text">Si selecciona una UAL el curso debe pertenecer a la misma facultad de la UAL.</div>
            </div>

            <div class="col-md-6">
              <label for="ps-fecha-inicio" class="form-label">Fecha / Hora inicio *</label>
              <input type="datetime-local" class="form-control" id="ps-fecha-inicio" required />
            </div>
            <div class="col-md-6">
              <label for="ps-fecha-fin" class="form-label">Fecha / Hora fin *</label>
              <input type="datetime-local" class="form-control" id="ps-fecha-fin" required />
            </div>

            <div class="col-md-6">
              <label for="ps-cupo" class="form-label">Cupo máximo *</label>
              <input type="number" class="form-control" id="ps-cupo" min="1" max="5000" step="1" value="25" required />
            </div>
            <div class="col-md-6">
              <label for="ps-lugar" class="form-label">Lugar / ubicación</label>
              <input type="text" class="form-control" id="ps-lugar" maxlength="255" placeholder="Salón 201, Bloque 5, etc." />
            </div>

            <div class="col-md-12">
              <label for="ps-enlace" class="form-label">Enlace sesión (Meet / Teams)</label>
              <input type="url" class="form-control" id="ps-enlace" maxlength="500" placeholder="https://..." />
            </div>

            <div class="col-md-12">
              <label for="ps-descripcion" class="form-label">Descripción / agenda del curso</label>
              <textarea id="ps-descripcion" rows="3" class="form-control" maxlength="1000" placeholder="Temas, pre-requisitos, material, agenda..."></textarea>
            </div>

            <div class="col-md-6">
              <div class="form-check form-switch ps-0 ms-1">
                <input class="form-check-input float-none me-2" type="checkbox" role="switch" id="ps-marcar-notificado" checked style="width:2.2em;height:1.2em;">
                <label class="form-check-label" for="ps-marcar-notificado"><b>Marcar solicitudes pendientes como "sesión notificada"</b></label>
                <div class="form-text ms-0">Actualiza en lote el estado de solicitudes de estudiantes en este curso y les envía la notificación de sesión.</div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-check form-switch ps-0 ms-1">
                <input class="form-check-input float-none me-2" type="checkbox" role="switch" id="ps-notificar-email" checked style="width:2.2em;height:1.2em;">
                <label class="form-check-label" for="ps-notificar-email"><b>Enviar correo a estudiantes interesados</b> (fire-and-forget)</label>
                <div class="form-text ms-0">Envía email branded a quienes tengan solicitud o estén inscritos en la sesión. Requiere SMTP/Office365.</div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer flex-wrap gap-2">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" id="ps-btn-guardar" class="btn btn-success" data-submit-lock="true">
            <i class="bi bi-calendar-check me-1"></i>Programar sesión
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
(function () {
  'use strict';

  var BASE_PATH = '/milab/api/capacitacion-gestion';
  var api = {
    solicitudes: BASE_PATH + '/gestion/solicitudes',
    sesiones: BASE_PATH + '/gestion/sesiones',
    programarSesion: BASE_PATH + '/gestion/sesiones/programar',
    cambiarEstado: BASE_PATH + '/gestion/cambiar-estado',
    marcarAsistencia: BASE_PATH + '/gestion/asistencia/marcar',
    asistenciasList: function (sesionId) { return BASE_PATH + '/gestion/sesiones/' + encodeURIComponent(sesionId) + '/asistencias'; },
    evidencia: function (sesionId) { return BASE_PATH + '/gestion/sesiones/' + encodeURIComponent(sesionId) + '/evidencia'; },
    certificar: function (sesionId) { return BASE_PATH + '/gestion/sesiones/' + encodeURIComponent(sesionId) + '/certificar-asistentes'; },
    reporte: BASE_PATH + '/gestion/reporte',
    reporteCsv: BASE_PATH + '/gestion/reporte.csv',
    contextoCursos: '/milab/api/capacitacion-equipos/list',
  };

  function getCsrfToken() {
    var el = document.querySelector('input[name="_csrf"]');
    return el ? String(el.value || '') : '';
  }
  function setJsonPostHeaders(xhr) {
    if (!xhr) return;
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.setRequestHeader('Accept', 'application/json');
    var t = getCsrfToken();
    if (t) xhr.setRequestHeader('X-CSRF-Token', t);
  }
  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function escapeAttr(s) { return escapeHtml(s); }

  var state = {
    scope: null,
    solicitudes: [],
    sesiones: [],
    asistencias: { asistidos: [], faltantes: [], sesionId: null },
    selectedSesionId: null,
    reporte: [],
    filtros: { solicitudes: {}, reporte: {} },
    contexto: { cursos: [], uales: [] },
  };

  function setGlobalAlert(message, type, containerId) {
    containerId = containerId || 'mensajes-globales';
    var el = document.getElementById(containerId);
    if (!el) return;
    el.classList.remove('d-none', 'alert-info', 'alert-success', 'alert-warning', 'alert-danger');
    el.classList.add('alert', 'alert-' + (type || 'info'));
    el.innerHTML = '';
    var s = document.createElement('strong');
    s.textContent = message || '';
    el.appendChild(s);
    if (type === 'success') {
      setTimeout(function () {
        if (!document.getElementById(containerId)) return;
        el.classList.remove('alert', 'alert-info', 'alert-success', 'alert-warning', 'alert-danger');
        el.classList.add('d-none');
        el.textContent = '';
      }, 6000);
    }
  }

  function safeParseJsonXhr(xhr, label, onErrorMsg) {
    var raw = xhr.responseText || '';
    var ct = xhr.getResponseHeader && xhr.getResponseHeader('Content-Type') ? String(xhr.getResponseHeader('Content-Type')) : '';
    try {
      if (!xhr.status || xhr.status === 0) throw new Error('Sin respuesta del servidor (error de red).');
      if (ct && ct.indexOf('application/json') === -1 && (ct.indexOf('text/html') !== -1 || (raw || '').trim().indexOf('<') === 0)) {
        throw new Error(
          'El servidor respondió con una página HTML en vez de JSON (status ' + (xhr.status || 0) + '). ' +
          'Espere 30s y recargue Ctrl+Shift+R (pods actualizándose).'
        );
      }
      return JSON.parse(raw || '{}');
    } catch (err) {
      var msg = err && err.message ? err.message : String(err || 'Error desconocido');
      console.error('[cap-gestion] ' + label + ' safeParse ERROR:', err, ' preview:', raw && raw.length > 200 ? raw.slice(0, 200) + '…' : raw);
      setGlobalAlert((onErrorMsg || 'Error procesando respuesta. Detalle: ') + escapeHtml(msg), 'danger');
      return null;
    }
  }

  function formatFecha(dateStr) {
    if (!dateStr) return '—';
    try {
      var d = new Date(dateStr);
      if (!d || isNaN(d.getTime())) return escapeHtml(String(dateStr));
      return d.toLocaleString('es-CO', { dateStyle: 'short', timeStyle: 'short' });
    } catch { return escapeHtml(String(dateStr)); }
  }

  function updateScopeLabels(scope) {
    var lbl = document.getElementById('scope-label');
    var title = document.getElementById('scope-alert-title');
    var body = document.getElementById('scope-alert-body');
    var section = document.getElementById('scope-alert-section');
    state.scope = scope || null;
    var isAdminScope = scope ? Boolean(scope.isAdmin || scope.adminAll) : false;
    if (isAdminScope) {
      if (lbl) lbl.textContent = 'Scope Administrador: TODAS las facultades y UALes';
      if (section) section.style.display = 'none';
      return;
    }
    var facs = (scope?.facultades || []).map(function (f) { return f.nombre; }).join(', ');
    var labs = (scope?.laboratorios || []).map(function (l) { return l.nombre; }).join(', ');
    var facIdsOk = Array.isArray(scope?.facultyIds) && scope.facultyIds.length > 0;
    var ualIdsOk = Array.isArray(scope?.ualIds) && scope.ualIds.length > 0;
    var vacio = Boolean(scope?.vacio || (!facIdsOk && !ualIdsOk));
    if (lbl) {
      if (vacio) lbl.textContent = '⚠️ Scope: SIN UALes ASIGNADAS. Contacta administración.';
      else lbl.textContent = 'Scope: ' + (facs || labs || 'OK');
    }
    if (section) {
      section.style.display = vacio ? '' : (facIdsOk || ualIdsOk ? '' : 'none');
      if (title) title.textContent = vacio ? 'Sin UALes asignadas (alcance limitado)' : (facIdsOk || ualIdsOk ? 'Alcance de gestión (Laboratorista)' : 'Scope OK');
      if (body) {
        if (scope && scope.scope_message) body.textContent = scope.scope_message;
        else if (vacio) body.textContent = 'Usted no tiene UALes o laboratorios asignados actualmente. Contacta Coordinación General para asignarte.';
        else body.textContent = 'Usted gestiona: ' + (facs || labs || '—');
      }
    }
  }

  function renderEstadoSolicitud(est) {
    var s = String(est || '').trim().toLowerCase();
    if (!s) return '<span class="badge text-bg-secondary">—</span>';
    if (s.indexOf('pendiente') !== -1) return '<span class="badge text-bg-warning text-dark">Pendiente</span>';
    if (s.indexOf('notificado') !== -1 || s.indexOf('programada') !== -1) return '<span class="badge text-bg-info">Sesión programada</span>';
    if (s.indexOf('atendid') !== -1 || s.indexOf('cerrad') !== -1) return '<span class="badge text-bg-success">Atendida</span>';
    if (s.indexOf('cancel') !== -1) return '<span class="badge text-bg-danger">Cancelada</span>';
    return '<span class="badge text-bg-light border">' + escapeHtml(s) + '</span>';
  }

  function renderEstadoSesion(est) {
    var s = String(est || '').trim().toLowerCase();
    if (!s) return '<span class="badge text-bg-secondary">—</span>';
    if (s.indexOf('programada') !== -1) return '<span class="badge text-bg-primary">Programada</span>';
    if (s.indexOf('curso') !== -1) return '<span class="badge text-bg-info text-dark">En curso</span>';
    if (s.indexOf('realizad') !== -1) return '<span class="badge text-bg-success">Realizada</span>';
    if (s.indexOf('cancel') !== -1) return '<span class="badge text-bg-danger">Cancelada</span>';
    return '<span class="badge text-bg-light border">' + escapeHtml(s) + '</span>';
  }

  function loadSolicitudes() {
    var tbody = document.querySelector('#tabla-solicitudes tbody');
    if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Cargando solicitudes...</td></tr>';
    var xhr = new XMLHttpRequest();
    var url = api.solicitudes;
    var fCurso = document.getElementById('filter-curso-solicitudes')?.value || '';
    var fEstado = document.getElementById('filter-estado-solicitudes')?.value || '';
    var qs = [];
    if (fCurso) qs.push('q=' + encodeURIComponent(fCurso));
    if (fEstado) qs.push('estado=' + encodeURIComponent(fEstado));
    if (qs.length) url = url + (url.indexOf('?') === -1 ? '?' : '&') + qs.join('&');
    xhr.open('GET', url, true);
    xhr.setRequestHeader('Accept', 'application/json');
    xhr.onload = function () {
      var data = safeParseJsonXhr(xhr, 'loadSolicitudes', 'Error cargando solicitudes. ');
      if (!data) {
        if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4"><div class="alert alert-danger mb-0 d-inline-block text-start">No se pudieron cargar las solicitudes. Espere 30s y recargue la página (pods actualizándose). Si el error persiste contacte soporte.</div></td></tr>';
        if (document.getElementById('count-solicitudes')) document.getElementById('count-solicitudes').textContent = '0';
        return;
      }
      if (data.meta?.scope) {
        updateScopeLabels(data.meta.scope);
      } else if (data.scope_is_admin != null || data.scope_vacio) {
        updateScopeLabels({
          isAdmin: Boolean(data.scope_is_admin),
          facultyIds: Array.isArray(data.scope_faculty_ids) ? data.scope_faculty_ids : [],
          ualIds: Array.isArray(data.scope_ual_ids) ? data.scope_ual_ids : [],
          resolvedFrom: data.scope_resolved_from,
          vacio: Boolean(data.scope_vacio),
          scope_message: data.mensaje || data.scope_message || '',
        });
      }
      state.solicitudes = Array.isArray(data.solicitudes) ? data.solicitudes : (Array.isArray(data.data) ? data.data : []);
      state.lastScopeVacio_Solicitudes = Boolean(data.scope_vacio);
      state.lastScopeMessage_Solicitudes = data.mensaje || '';
      renderSolicitudes();
    };
    xhr.onerror = function () {
      setGlobalAlert('Error de conexión cargando solicitudes.', 'danger');
      if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4"><div class="alert alert-danger mb-0 d-inline-block text-start">Error de conexión cargando solicitudes. Revise su red y recargue.</div></td></tr>';
      if (document.getElementById('count-solicitudes')) document.getElementById('count-solicitudes').textContent = '0';
    };
    xhr.send();
  }

  function renderSolicitudes() {
    var elCount = document.getElementById('count-solicitudes');
    if (elCount) elCount.textContent = String(state.solicitudes.length);
    var tbody = document.querySelector('#tabla-solicitudes tbody');
    if (!tbody) return;
    if (!state.solicitudes.length) {
      if (state.lastScopeVacio_Solicitudes) {
        var extraMsg = state.lastScopeMessage_Solicitudes
          ? '<div class="small mt-2 text-muted">' + escapeHtml(state.lastScopeMessage_Solicitudes) + '</div>'
          : '';
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4"><div class="alert alert-warning mb-0 d-inline-block text-start" style="border-color:#f0aa00;background:#fff7e1;color:#7c3b04;"><i class="bi bi-shield-lock me-2"></i><b>Sin alcance para ver solicitudes.</b><br/>No tienes UALes o facultades asignadas. Contacta Coordinación General para asignarte un alcance.' + extraMsg + '</div></td></tr>';
        return;
      }
      tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">No hay solicitudes para mostrar (cambia filtros si es necesario).</td></tr>';
      return;
    }
    tbody.innerHTML = state.solicitudes.map(function (s) {
      return '<tr data-id-solicitud="' + escapeAttr(s.id) + '" data-codigo-curso="' + escapeAttr(s.codigo_curso || '') + '">' +
        '<td>' + formatFecha(s.fecha_creacion || s.fecha_solicitud) + '</td>' +
        '<td><b>' + escapeHtml(s.solicitante_nombre || ('Usuario ' + (s.solicitante_documento || ''))) + '</b><div class="small text-muted">Doc. ' + escapeHtml(s.solicitante_documento || '—') + '</div></td>' +
        '<td><code>' + escapeHtml(s.codigo_curso || '') + '</code>' + (s.nombre_curso ? '<div class="small text-muted">' + escapeHtml(s.nombre_curso) + '</div>' : '') + '</td>' +
        '<td>' + escapeHtml(s.ual_nombre || s.laboratorio_nombre || (s.ual_id_solicitud ? 'UAL ' + s.ual_id_solicitud : 'Cualquiera')) + (s.facultad_nombre ? '<div class="small text-muted">' + escapeHtml(s.facultad_nombre) + '</div>' : '') + '</td>' +
        '<td>' + renderEstadoSolicitud(s.estado) + '</td>' +
        '<td>' + (s.mensaje_solicitante ? escapeHtml(s.mensaje_solicitante.length > 120 ? s.mensaje_solicitante.slice(0,120)+'…' : s.mensaje_solicitante) : '<span class="text-muted small">—</span>') + '</td>' +
        '<td><button type="button" class="btn btn-sm btn-warning programar-btn" style="background:#ffbf00;border-color:#f0aa00;color:#7c3b04;" data-curso="' + escapeAttr(s.codigo_curso || '') + '" data-ual="' + escapeAttr(s.ual_id_solicitud || s.ual_id || '') + '">' +
          '<i class="bi bi-calendar-plus me-1"></i>Programar' +
          '</button></td>' +
        '</tr>';
    }).join('');
    tbody.querySelectorAll('.programar-btn').forEach(function (btn) { btn.addEventListener('click', onProgramarDesdeSolicitud); });
  }

