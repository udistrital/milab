  /* ---------- Contexto: cursos y UALes disponibles para selects ---------- */
  function loadContexto() {
    try {
      var xhr = new XMLHttpRequest();
      xhr.open('GET', api.contextoCursos, true);
      xhr.setRequestHeader('Accept', 'application/json');
      xhr.onload = function () {
        try {
          var data = JSON.parse(xhr.responseText || '{}');
          state.contexto.cursos = Array.isArray(data?.cursos) ? data.cursos : (Array.isArray(data?.data?.cursos) ? data.data.cursos : []);
          state.contexto.uales = Array.isArray(data?.uales) ? data.uales : (Array.isArray(data?.data?.uales) ? data.data.uales : []);
          if (!state.contexto.cursos.length || !state.contexto.uales.length) {
            loadContextoFallback();
          } else {
            populateProgramarSelects();
          }
        } catch {
          loadContextoFallback();
        }
      };
      xhr.onerror = function () { loadContextoFallback(); };
      xhr.send();
    } catch {
      loadContextoFallback();
    }
  }
  function loadContextoFallback() {
    try {
      var xS = new XMLHttpRequest();
      xS.open('GET', api.sesiones + '?todos=1&estado=programada,en_curso,realizada', true);
      xS.setRequestHeader('Accept', 'application/json');
      xS.onload = function () {
        try {
          var d = JSON.parse(xS.responseText || '{}');
          var sList = Array.isArray(d?.sesiones) ? d.sesiones : (Array.isArray(d?.data) ? d.data : []);
          var seenCursos = {};
          var seenUales = {};
          sList.forEach(function (s) {
            if (s.codigo_curso && !seenCursos[s.codigo_curso]) {
              seenCursos[s.codigo_curso] = true;
              state.contexto.cursos.push({ codigo_curso: s.codigo_curso, nombre_curso: s.nombre_curso_snapshot || s.nombre_curso || '' });
            }
            if (s.ual_id && !seenUales[s.ual_id]) {
              seenUales[s.ual_id] = true;
              state.contexto.uales.push({ ual_id: s.ual_id, nombre: s.ual_nombre || ('UAL ' + s.ual_id), facultad_id: s.facultad_id || null });
            }
          });
          populateProgramarSelects();
        } catch { populateProgramarSelects(); }
      };
      xS.onerror = function () { populateProgramarSelects(); };
      xS.send();
    } catch { populateProgramarSelects(); }
  }
  function populateProgramarSelects() {
    var dl = document.getElementById('ps-list-cursos');
    if (dl) {
      dl.innerHTML = state.contexto.cursos.slice(0, 500).map(function (c) {
        return '<option value="' + escapeAttr(c.codigo_curso) + '">' + escapeHtml((c.nombre_curso || '') + ' [' + (c.codigo_curso || '') + ']') + '</option>';
      }).join('');
    }
    var ualSel = document.getElementById('ps-ual');
    if (ualSel) {
      var opts = ['<option value="">Todas (cualquier UAL)</option>'];
      state.contexto.uales.slice(0, 500).forEach(function (u) {
        opts.push('<option value="' + escapeAttr(u.ual_id) + '">' + escapeHtml((u.codigo ? '[' + u.codigo + '] ' : '') + (u.nombre || ('UAL ' + u.ual_id))) + '</option>');
      });
      ualSel.innerHTML = opts.join('');
    }
    var hint = document.getElementById('ps-nombre-curso-hint');
    if (hint) {
      var cur = state.contexto.cursos.find(function (c) { return String(c.codigo_curso || '').trim() === String(document.getElementById('ps-codigo-curso')?.value || '').trim(); });
      hint.textContent = cur && cur.nombre_curso ? cur.nombre_curso : '';
    }
  }

  /* ---------- Modal Programar Sesión ---------- */
  function openProgramarSesionModal(prefill) {
    if (typeof bootstrap === 'undefined' || !bootstrap.Modal) {
      setGlobalAlert('Bootstrap Modal no disponible. Actualiza la página.', 'danger');
      return;
    }
    prefill = prefill || {};
    var modalEl = document.getElementById('modal-programar-sesion');
    if (!modalEl) return;

    if (!state.contexto.cursos.length || !state.contexto.uales.length) {
      loadContexto();
    } else {
      populateProgramarSelects();
    }

    document.getElementById('ps-codigo-curso').value = String(prefill.codigo_curso || '').trim();
    var ualSel = document.getElementById('ps-ual');
    if (ualSel && prefill.ual_id) ualSel.value = String(prefill.ual_id);
    populateProgramarSelects();
    document.getElementById('ps-cupo').value = Number(prefill.cupo || 25);
    document.getElementById('ps-lugar').value = String(prefill.lugar || '').trim();
    document.getElementById('ps-enlace').value = String(prefill.enlace_sesion || '').trim();
    document.getElementById('ps-descripcion').value = String(prefill.descripcion || '').trim();
    document.getElementById('ps-marcar-notificado').checked = prefill.marcar_solicitudes_notificado !== false;
    document.getElementById('ps-notificar-email').checked = prefill.notificar_por_email !== false;

