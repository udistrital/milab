  /* ---------- Task 7 - Reporte ---------- */
  function buildReporteQueryString() {
    var qs = [];
    var fDesde = document.getElementById('report-fecha-desde')?.value || '';
    var fHasta = document.getElementById('report-fecha-hasta')?.value || '';
    var fEstado = document.getElementById('report-estado-sesion')?.value || '';
    if (fDesde)  qs.push('desde=' + encodeURIComponent(fDesde));
    if (fHasta)  qs.push('hasta=' + encodeURIComponent(fHasta + 'T23:59:59'));
    if (fEstado) qs.push('estado=' + encodeURIComponent(fEstado));
    state.filtros.reporte = { desde: fDesde, hasta: fHasta, estado: fEstado };
    return qs.join('&');
  }
  function loadReporte() {
    var tbody = document.querySelector('#tabla-reporte tbody');
    if (tbody) tbody.innerHTML = '<tr><td colspan="12" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Cargando reporte...</td></tr>';
    var xhr = new XMLHttpRequest();
    var qs = buildReporteQueryString();
    var url = api.reporte + (qs ? '?' + qs : '');
    xhr.open('GET', url, true);
    xhr.setRequestHeader('Accept', 'application/json');
    xhr.onload = function () {
      var data = safeParseJsonXhr(xhr, 'loadReporte', 'Error cargando reporte. ');
      if (!data) return;
      if (data && data.scope) updateScopeLabels({
        isAdmin: Boolean(data.scope.is_admin),
        adminAll: Boolean(data.scope.is_admin),
        facultyIds: data.scope.faculty_ids || [],
        ualIds: data.scope.ual_ids || [],
        resolvedFrom: data.scope.resolved_from,
      });
      state.reporte = Array.isArray(data.reporte) ? data.reporte : [];
      renderReporte();
      if (typeof data.filas === 'number' && data.filas === 0) {
        setGlobalAlert('No hay capacitaciones en este rango / filtros (0 filas).', 'info', 'alert-reporte');
      } else {
        setGlobalAlert('Reporte cargado: ' + (state.reporte.length) + ' filas.', 'success', 'alert-reporte');
      }
    };
    xhr.onerror = function () { setGlobalAlert('Error de conexión cargando reporte.', 'danger', 'alert-reporte'); };
    xhr.send();
  }
  function renderReporte() {
    var tbody = document.querySelector('#tabla-reporte tbody');
    if (!tbody) return;
    if (!state.reporte.length) {
      tbody.innerHTML = '<tr><td colspan="12" class="text-center text-muted py-4">Sin datos para el reporte con los filtros actuales.</td></tr>';
      return;
    }
    var html = '';
    for (var i = 0; i < state.reporte.length; i++) {
      var r = state.reporte[i];
      var ualFila = '';
      if (r.ual_nombre || r.facultad_nombre) {
        ualFila = (r.ual_codigo ? '[' + escapeHtml(r.ual_codigo) + '] ' : '') +
          escapeHtml(r.ual_nombre || '—') + '<br><small class="text-muted">' + escapeHtml(r.facultad_nombre || '') + '</small>';
      } else ualFila = '<span class="text-muted">—</span>';
      var modalidad = (r.modalidad && r.modalidad === 'prestamo'
        ? '<span class="badge text-bg-dark">En entrega préstamo</span>'
        : '<span class="badge text-bg-light border">Sesión programada</span>');
      var eviden = (r.evidencia_nombre_original || r.evidencia_path)
        ? '<span class="badge text-bg-success"><i class="bi bi-paperclip me-1"></i>' + escapeHtml(r.evidencia_nombre_original || 'Adjunta') + '</span>'
        : '<span class="text-muted small">—</span>';
      var lab = (r.laboratorista_nombre || r.laboratorista_doc)
          ? escapeHtml(r.laboratorista_nombre || '—') + '<br><small class="text-muted">' + escapeHtml(r.laboratorista_doc || '') + '</small>'
          : '<span class="text-muted">—</span>';
      html += '<tr>' +
        '<th scope="row">' + escapeHtml(r.sesion_id) + '</th>' +
        '<td>' + formatFecha(r.fecha_inicio) + '</td>' +
        '<td><div><b>' + escapeHtml(r.nombre_curso || '—') + '</b><br><small class="text-muted">' + escapeHtml(r.codigo_curso || '') + '</small></div></td>' +
        '<td>' + ualFila + '</td>' +
        '<td>' + escapeHtml(r.cupo_maximo != null ? r.cupo_maximo : '—') + '</td>' +
        '<td>' + escapeHtml(r.inscritos != null ? r.inscritos : 0) + '</td>' +
        '<td>' + escapeHtml(r.asistentes != null ? r.asistentes : 0) + '</td>' +
        '<td>' + escapeHtml(r.certificados_emitidos != null ? r.certificados_emitidos : 0) + '</td>' +
        '<td>' + modalidad + '</td>' +
        '<td>' + eviden + '</td>' +
        '<td>' + lab + '</td>' +
        '<td>' + renderEstadoSesion(r.estado) + '</td>' +
      '</tr>';
    }
    tbody.innerHTML = html;
  }
  function onAplicarFiltrosReporte() { loadReporte(); }
  function onDescargarCsv(ev) {
    try {
      if (window.MiLabSubmitLock) window.MiLabSubmitLock.lock(ev?.currentTarget, 'Generando…');
    } catch (_) {}
    try {
      var qs = buildReporteQueryString();
      var url = api.reporteCsv + (qs ? '?' + qs : '');
      var a = document.createElement('a');
      a.href = url;
      a.setAttribute('download', '');
      a.rel = 'noopener';
      document.body.appendChild(a);
      a.click();
      setTimeout(function () { try { document.body.removeChild(a); } catch (_) {} }, 1500);
      setGlobalAlert('Se está descargando el reporte CSV desde ' + escapeHtml(url), 'success', 'alert-reporte');
    } finally {
      setTimeout(function () {
        try { if (window.MiLabSubmitLock) window.MiLabSubmitLock.unlock(ev?.currentTarget); } catch (_) {}
      }, 1200);
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('btn-recargar')?.addEventListener('click', onRecargar);
    document.getElementById('btn-aplicar-filtros-solicitudes')?.addEventListener('click', onAplicarFiltrosSolicitudes);
    document.getElementById('btn-programar-rapido')?.addEventListener('click', onBtnNuevaSesion);
    document.getElementById('btn-nueva-sesion')?.addEventListener('click', onBtnNuevaSesion);
    document.getElementById('asistencia-sesion-select')?.addEventListener('change', onAsistenciaSesionChange);
    document.getElementById('asistencia-doc-input')?.addEventListener('keyup', onAsistenciaDocKeyup);
    document.getElementById('btn-marcar-asistencia')?.addEventListener('click', onMarcarAsistenciaClick);
    document.getElementById('btn-evidencia-sesion')?.addEventListener('click', onBtnEvidenciaSesion);
    document.getElementById('btn-certificar-asistentes-sesion')?.addEventListener('click', onBtnCertificarAsistentesSesion);
    document.getElementById('btn-finalizar-sesion')?.addEventListener('click', onBtnFinalizarSesion);
    document.getElementById('btn-aplicar-filtros-reporte')?.addEventListener('click', onAplicarFiltrosReporte);
    document.getElementById('btn-descargar-csv')?.addEventListener('click', onDescargarCsv);
    document.getElementById('ps-codigo-curso')?.addEventListener('input', onPsCursoChange);
    document.getElementById('form-programar-sesion')?.addEventListener('submit', submitFormProgramarSesion);
    document.getElementById('tab-reporte')?.addEventListener('shown.bs.tab', function () {
      if (!state.reporte || state.reporte.length === 0) loadReporte();
    });

    loadContexto();
    loadSolicitudes();
    loadSesiones();
  });
})();
</script>

