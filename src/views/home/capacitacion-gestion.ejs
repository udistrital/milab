      var fi = s.fecha_hora_inicio || s.fecha_inicio;
      var ff = s.fecha_hora_fin || s.fecha_fin;
      var labNombre = s.laboratorista_nombre || s.laboratorista_responsable_nombre || '';
      var labDoc = s.laboratorista_documento || s.laboratorista_responsable_doc || '';
      var ualTxt = s.ual_nombre || ('UAL ' + (s.ual_id_lugar || s.ual_id || '?'));
      return '<tr data-id-sesion="' + escapeAttr(s.id) + '">' +
        '<td><code>' + escapeHtml(s.id || '') + '</code></td>' +
        '<td><code>' + escapeHtml(s.codigo_curso || '') + '</code>' + (s.nombre_curso ? '<div class="small text-muted">' + escapeHtml(s.nombre_curso) + '</div>' : (s.nombre_curso_snapshot ? '<div class="small text-muted">' + escapeHtml(s.nombre_curso_snapshot) + '</div>' : '')) + '</td>' +
        '<td>' + formatFecha(fi) + '<div class="small text-muted">hasta ' + formatFecha(ff) + '</div></td>' +
        '<td>' + escapeHtml(ualTxt) + (s.facultad_nombre ? '<div class="small text-muted">' + escapeHtml(s.facultad_nombre) + '</div>' : '') + '</td>' +
        '<td class="text-center"><b>' + (cupo || '∞') + '</b> / <span class="text-muted">' + insc + '</span></td>' +
        '<td>' + renderEstadoSesion(s.estado) + '</td>' +
        '<td>' + (labNombre ? escapeHtml(labNombre) : '<span class="text-muted small">' + escapeHtml(labDoc || '—') + '</span>') + '</td>' +
