    tbody.querySelectorAll('.estado-btn').forEach(function (btn) { btn.addEventListener('click', onCambiarEstadoSesion); });
    tbody.querySelectorAll('.cancelar-btn').forEach(function (btn) { btn.addEventListener('click', onCambiarEstadoSesion); });
    tbody.querySelectorAll('.evidencia-btn').forEach(function (btn) { btn.addEventListener('click', onEvidenciaBtn); });
