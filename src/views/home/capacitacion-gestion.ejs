          '<button type="button" class="btn btn-outline-info evidencia-btn" data-id-sesion="' + escapeAttr(s.id) + '" title="Subir evidencia">📎 Evidencia</button>' +
          '<button type="button" class="btn btn-outline-success certificar-btn" data-id-sesion="' + escapeAttr(s.id) + '" title="Certificar asistentes">🎓 Certificar</button>' +
          '<button type="button" class="btn btn-outline-secondary cancelar-btn" data-estado="cancelada" data-id-sesion="' + escapeAttr(s.id) + '" title="Cancelar sesión">⛔ Cancelar</button>' +
        '</div></td>' +
        '</tr>';
