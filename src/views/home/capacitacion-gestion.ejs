  function populateAsistenciaSesionSelect() {
    var sel = document.getElementById('asistencia-sesion-select');
    if (!sel) return;
    var opts = ['<option value="">(Seleccione una sesión programada o en curso)</option>'];
    state.sesiones.forEach(function (s) {
      var est = String(s.estado || '').toLowerCase();
      if (est.indexOf('cancel') !== -1) return;
      opts.push('<option value="' + escapeAttr(s.id) + '">' +
        '#' + escapeHtml(s.id) + ' | ' +
        escapeHtml(s.codigo_curso || '') + ' - ' +
        escapeHtml((s.nombre_curso || '').slice(0, 60)) + ' | ' +
        formatFecha(s.fecha_hora_inicio) +
        ' [' + escapeHtml(s.estado || '') + ']' +
        '</option>');
    });
    sel.innerHTML = opts.join('');
    if (state.selectedSesionId) sel.value = String(state.selectedSesionId);
  }

