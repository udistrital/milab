  function toIsoLocalInput(valor) {
    try {
      var d = new Date(valor);
      if (isNaN(d.getTime())) return null;
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    } catch { return null; }
  }

  function submitFormProgramarSesion(ev) {
    if (ev) ev.preventDefault();
    var alertEl = document.getElementById('modal-programar-alert');
    function setModalAlert(m, type) {
      if (!alertEl) return;
      alertEl.className = 'alert alert-' + (type || 'info');
      alertEl.textContent = m || '';
    }

    var codigoCurso = String(document.getElementById('ps-codigo-curso')?.value || '').trim();
    var ualId = String(document.getElementById('ps-ual')?.value || '').trim();
    var fiRaw = document.getElementById('ps-fecha-inicio')?.value;
    var ffRaw = document.getElementById('ps-fecha-fin')?.value;
    var cupo = Number(document.getElementById('ps-cupo')?.value || 0);
    var lugar = String(document.getElementById('ps-lugar')?.value || '').trim();
    var enlace = String(document.getElementById('ps-enlace')?.value || '').trim();
    var desc = String(document.getElementById('ps-descripcion')?.value || '').trim();
    var marcarNotificado = Boolean(document.getElementById('ps-marcar-notificado')?.checked);
    var notificarEmail = Boolean(document.getElementById('ps-notificar-email')?.checked);

    if (!codigoCurso) return setModalAlert('Código de curso obligatorio.', 'warning');
    if (!fiRaw || !ffRaw) return setModalAlert('Fecha/hora inicio y fin son obligatorias.', 'warning');
    var fi = new Date(fiRaw);
    var ff = new Date(ffRaw);
    if (isNaN(fi.getTime()) || isNaN(ff.getTime())) return setModalAlert('Formato de fecha/hora inválido.', 'warning');
    if (ff.getTime() <= fi.getTime()) return setModalAlert('Fecha fin debe ser posterior a fecha inicio.', 'warning');
    if (!Number.isInteger(cupo) || cupo <= 0 || cupo > 5000) return setModalAlert('Cupo debe ser un entero 1 a 5000.', 'warning');

    var btn = document.getElementById('ps-btn-guardar');
    try {
      if (window.MiLabSubmitLock) window.MiLabSubmitLock.lock(btn, 'Programando…');
      setModalAlert('Enviando solicitud al servidor…', 'info');
      var xhr = new XMLHttpRequest();
      xhr.open('POST', api.programarSesion, true);
      setJsonPostHeaders(xhr);
      xhr.onload = function () {
        try {
          var data = safeParseJsonXhr(xhr, 'programar-sesion', 'No se pudo programar la sesión. ');
          if (!data) return;
          if (data.ok || data.success) {
            setModalAlert('✅ Sesión programada. Recargando listados…', 'success');
            setTimeout(function () {
              try {
                var modal = bootstrap.Modal.getInstance(document.getElementById('modal-programar-sesion'));
                if (modal) modal.hide();
              } catch {}
              loadSolicitudes();
              loadSesiones();
              if (String(data?.sesion?.id || '')) {
                setGlobalAlert('✅ Sesión #' + escapeHtml(data.sesion.id) + ' programada. ' + (data.notificacion_email ? 'Correos en proceso (fire-and-forget).' : 'Correo deshabilitado.'), 'success');
              } else {
                setGlobalAlert('✅ Sesión programada exitosamente.', 'success');
              }
            }, 700);
          } else {
            setModalAlert('❌ Error: ' + (data.message || 'Respuesta inválida.'), 'danger');
          }
        } finally {
          if (window.MiLabSubmitLock) window.MiLabSubmitLock.unlock(btn);
        }
      };
      xhr.onerror = function () {
        setModalAlert('❌ Error de conexión. Revisa red y reintenta.', 'danger');
        if (window.MiLabSubmitLock) window.MiLabSubmitLock.unlock(btn);
      };
      var body = {
        codigo_curso: codigoCurso,
        fecha_inicio: fi.toISOString(),
        fecha_fin: ff.toISOString(),
        cupo: cupo,
        lugar: lugar || null,
        descripcion: desc || null,
        enlace_sesion: enlace || null,
        marcar_solicitudes_notificado: marcarNotificado,
        notificar_por_email: notificarEmail,
      };
      if (ualId) body.ual_id = ualId;
      xhr.send(JSON.stringify(body));
    } catch (err) {
      setModalAlert('❌ Error al enviar: ' + (err?.message || String(err)), 'danger');
      if (window.MiLabSubmitLock) window.MiLabSubmitLock.unlock(btn);
    }
  }

  function onCambiarEstadoSesion(ev) {
