<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Verificación de certificado - MiLab</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/milab/public/css/styles.css">
</head>
<body>
  <main class="container py-5" style="max-width: 760px;">
    <section class="card shadow-sm">
      <div class="card-body p-4 p-md-5">
        <p class="text-uppercase text-muted small mb-2">MiLab · Universidad Distrital</p>
        <% if (typeof verificationError !== 'undefined' && verificationError) { %>
          <div class="alert alert-warning" role="status">
            No fue posible consultar el registro en este momento. Intenta nuevamente más tarde.
          </div>
        <% } else if (!certificado) { %>
          <div class="alert alert-danger" role="status">El código de verificación no existe o no es válido.</div>
          <h1 class="h3">Certificado no encontrado</h1>
        <% } else { %>
          <% const isValid = certificado.estado === 'valido'; %>
          <div class="alert <%= isValid ? 'alert-success' : 'alert-danger' %>" role="status">
            <i class="bi <%= isValid ? 'bi-patch-check-fill' : 'bi-x-octagon-fill' %> me-2" aria-hidden="true"></i>
            Certificado <%= isValid ? 'válido' : 'anulado' %>
          </div>
          <h1 class="h3 mb-4">Verificación del certificado</h1>
          <dl class="row mb-0">
            <dt class="col-sm-5">Evento</dt>
            <dd class="col-sm-7"><%= certificado.evento %></dd>
            <dt class="col-sm-5">Fecha del evento</dt>
            <dd class="col-sm-7"><%= String(certificado.fecha_evento).slice(0, 10) %></dd>
            <dt class="col-sm-5">Participante</dt>
            <dd class="col-sm-7"><%= certificado.participante %></dd>
            <dt class="col-sm-5">Identificador</dt>
            <dd class="col-sm-7"><%= certificado.codigo %></dd>
            <dt class="col-sm-5">Fecha de emisión</dt>
            <dd class="col-sm-7"><%= new Date(certificado.fecha_emision).toLocaleDateString('es-CO', { timeZone: 'America/Bogota' }) %></dd>
            <dt class="col-sm-5">Validez</dt>
            <dd class="col-sm-7"><%= isValid ? 'Vigente' : 'Anulado' %></dd>
          </dl>
        <% } %>
      </div>
    </section>
  </main>
</body>
</html>
