<%- include('../partials/header'); -%>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Coordinadores registrados</h1>
    <p class="app-page-subtitle">Administra el estado operativo de los coordinadores y consulta su asignación institucional.</p>
  </section>

  <section class="card app-table-panel">
    <div class="card-header text-center">
      <h5>Equipo de coordinación</h5>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table id="myTable" class="table table-bordered table-striped js-data-grid table-coordinadores" data-grid-page-length="25" data-grid-scroll-x="false">
          <thead class="text-light">
            <tr>
              <th>Nombres y Apellidos</th>
              <th>Cédula</th>
              <th>Correo</th>
              <th>Facultad</th>
              <th>Resoluci&oacute;n</th>
              <th>Soporte Resoluci&oacute;n</th>
              <th data-grid-filter="false" data-grid-orderable="false">Editar</th>
              <th>Estado actual</th>
              <th data-grid-filter="false" data-grid-orderable="false">Activar / Inactivar</th>
            </tr>
          </thead>
          <tbody>
            <% coordinadores.forEach(coordinador => { %>
              <% const facultadTexto = String(coordinador.facultad_nombre || ''); %>
              <% const soporteResolucionTexto = String(coordinador.con_soporte_resolucion || ''); %>
              <% const mostrarToggleFacultad = facultadTexto.length > 120; %>
              <% const mostrarToggleSoporte = soporteResolucionTexto.length > 120; %>
              <tr data-coordinador-row="<%= coordinador.con_documento %>">
                <td><%= coordinador.con_nombre %></td>
                <td><%= coordinador.con_documento %></td>
                <td data-email-cell="true"><%= coordinador.con_correo %></td>
                <td data-facultades-cell="true">
                  <span
                    class="app-labs-cell-text <%= mostrarToggleFacultad ? 'is-collapsed' : '' %>"
                    data-labs-text="true"
                  ><%= facultadTexto %></span>
                  <% if (mostrarToggleFacultad) { %>
                    <button
                      type="button"
                      class="app-labs-toggle"
                      data-labs-toggle="true"
                      aria-expanded="false"
                    >
                      Ver más
                    </button>
                  <% } %>
                </td>
                <td data-numero-resolucion-cell="true"><%= coordinador.con_numero_resolucion_coordinador || '' %></td>
                <td data-soporte-resolucion-cell="true">
                  <span
                    class="app-labs-cell-text <%= mostrarToggleSoporte ? 'is-collapsed' : '' %>"
                    data-labs-text="true"
                  ><%= soporteResolucionTexto %></span>
                  <% if (mostrarToggleSoporte) { %>
                    <button
                      type="button"
                      class="app-labs-toggle"
                      data-labs-toggle="true"
                      aria-expanded="false"
                    >
                      Ver más
                    </button>
                  <% } %>
                </td>
                <td>
                  <button
                    type="button"
                    class="btn btn-sm btn-outline-primary"
                    data-coordinador-editor-trigger="true"
                    data-coordinador-editor-endpoint="/milab/api/coordinadores_registrados/actualizar"
                    data-coordinador-editor-document="<%= coordinador.con_documento %>"
                    data-coordinador-editor-name="<%= coordinador.con_nombre %>"
                    data-coordinador-editor-current-email="<%= coordinador.con_correo %>"
                    data-coordinador-editor-numero-resolucion="<%= coordinador.con_numero_resolucion_coordinador || '' %>"
                    data-coordinador-editor-soporte-resolucion="<%= coordinador.con_soporte_resolucion || '' %>"
                    data-coordinador-editor-facultad-ids='<%= JSON.stringify(Array.isArray(coordinador.facultad_ids) ? coordinador.facultad_ids : []) %>'
                  >
                    Editar
                  </button>
                </td>
                <td>
                  <span class="badge <%= coordinador.tipo === 'coordinador' ? 'text-bg-success' : 'text-bg-secondary' %>">
                    <%= coordinador.tipo === 'coordinador' ? 'Activo' : 'Inactivo' %>
                  </span>
                </td>
                <td>
                  <form action="/milab/api/coordinadores_registrados/toggle-estado" method="POST">
                    <%- include('../partials/csrf_field') %>
                    <input type="hidden" name="documento" value="<%= coordinador.con_documento %>">
                    <button type="submit" class="btn btn-sm <%= coordinador.tipo === 'coordinador' ? 'btn-outline-danger' : 'btn-outline-success' %>">
                      <%= coordinador.tipo === 'coordinador' ? 'Inactivar' : 'Activar' %>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <%- include('../partials/coordinador-editor-modal', {
    actionUrl: '/milab/api/coordinadores_registrados/actualizar',
    facultadesDisponibles: facultadesDisponibles || [],
  }) %>

<div class="px-3">
  <div class="card mt-1 mx-auto app-inline-note" style="max-width: 1000px;">
    <div class="card-body p-3">
      <div class="mb-0 text-center" role="alert">
        <strong>Información:</strong> La columna <strong>Estado actual</strong> muestra si el coordinador está activo o inactivo.
        <br>Usa la columna <strong>Activar / Inactivar</strong> para cambiar su estado operativo.
      </div>
    </div>
  </div>
</div>
</main>

<%- include('../partials/footer'); -%>
