<%- include('../partials/header'); -%>

<% const sancionesMilab = Array.isArray(multaInfo) ? multaInfo : []; %>
<% const sancionesSga = typeof sgaMultaInfo !== 'undefined' && Array.isArray(sgaMultaInfo) ? sgaMultaInfo : []; %>

<div class="container mt-5">
  <div class="alert alert-danger" role="alert">
    <h4 class="alert-heading">No se puede generar certificado, el usuario actualmente se encuentra Sancionado</h4>
    <p>El usuario tiene las siguientes sanciones activas:</p>
    <% if (typeof sgaLookupError !== 'undefined' && sgaLookupError) { %>
      <p class="alert alert-warning mb-3"><%= sgaLookupError %></p>
    <% } %>



    <style>
      table, th, td {
        border-collapse: collapse;
        border-spacing: 20px;
      }
    </style>
    
    <div class="card">
      <div class="card-header">
        <div class="row">
          <div class="encabezado-tabla col text-center">Sanciones activas en MILab</div>
        </div>
      </div>
      <div class="card-body">
        <div class="table-responsive table">
          <table class="table table-bordered" style="width:100%">
            <tr>
              <th>ID</th>
              <th>Categoría de la sanción</th>
              <th>Nombre del laboratorista</th>
              <th>Código del sancionado</th>
              <th>UAL</th>
              <th>Fecha de la sanción</th>
              <th>Observaciones</th>
            </tr>
            <% if(sancionesMilab.length > 0) { %>
              <% sancionesMilab.forEach(function(data){ %>
                <% const referenciaSancionado = data.documento_sancionado || data.usuario_sancionado_id; %>
                <tr>
                  <td><%= data.id %></td>
                  <td><%= data.cat_multa %></td>
                  <td><%= data.nombre_laboratorista %></td>
                  <td><%= referenciaSancionado %></td>
                  <td><%= data.ual %></td>
                  <td><%= data.fecha_multa %></td>
                  <td><%= data.obs_multa %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8">No hay sanciones activas registradas en MILab.</td>
              </tr>
            <% } %>
          </table>
        </div>
      </div>
    </div>

    <% if (sancionesSga.length > 0) { %>
      <div class="card mt-4">
        <div class="card-header">
          <div class="row">
            <div class="encabezado-tabla col text-center">Multas activas reportadas por SGA</div>
          </div>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-bordered" style="width:100%">
              <thead>
                <tr>
                  <th>Estudiante</th>
                  <th>Código</th>
                  <th>Detalle reportado</th>
                  <th>Fecha</th>
                  <th>Periodo</th>
                  <th>Valor reportado</th>
                  <th>Fecha de pago</th>
                </tr>
              </thead>
              <tbody>
                <% sancionesSga.forEach(function(data){ %>
                  <tr>
                    <td><%= data.DEU_DEUDOR_NOMBRE || '-' %></td>
                    <td><%= data.DEU_EST_COD || '-' %></td>
                    <td><%= data.DEU_MATERIAL || '-' %></td>
                    <td><%= data.DEU_FECHA || '-' %></td>
                    <td><%= data.DEU_ANO || '-' %> / <%= data.DEU_PER || '-' %></td>
                    <td><%= data.DEU_MULTA || '-' %></td>
                    <td><%= data.DEU_FECHA_PAGO || 'Pendiente' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% } %>
    <br>
    

    <hr>
    <h4>Información de la sanción</h4>
  
    <p>
      Para poder saldar su estado, acérquese a la Unidad Académica de Laboratorio (UAL) y Facultad donde fue Sancionado y solucione su situación.
    </p>
    <button class="btn btn-primary" onclick="goBack()">Volver Atrás</button>
  </div>
</div>








 


  <script nonce="<%= cspNonce %>">
    function goBack() {
      window.history.back();
    }
  </script>
<%- include('../partials/footer'); -%>

