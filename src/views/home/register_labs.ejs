<%- include('../partials/header'); -%>
<% const selectedCoordinator = (coordinadores || []).find(function(coordinador) {
  return selectedCoordinatorDocument === coordinador.documento;
}); %>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Registro de laboratorista</h1>
    <p class="app-page-subtitle">Crea cuentas operativas por facultad con una selección controlada de UAL y un flujo coherente para acceso directo con token.</p>
  </section>

  <section class="card app-form-panel col-xl-8 col-lg-10 mx-auto d-flex justify-content-center">
    <div class="card-body">
      <form
        method="get"
        action="/milab/api/register_labs/load_info"
        class="row g-2 justify-content-center align-items-end app-form-grid mb-4"
      >
        <% if (tipo === 'admin') { %>
          <div class="col-12 col-md-8 mx-auto text-center">
            <label for="coordinador_documento_lookup" class="form-label">Coordinador responsable</label>
            <div data-coordinator-autocomplete data-submit-on-select="true">
              <input
                class="form-control"
                type="search"
                id="coordinador_documento_lookup"
                data-coordinator-search
                placeholder="Busca por nombre o documento..."
                autocomplete="off"
                aria-label="Buscar coordinador por nombre o documento"
                value="<%= selectedCoordinator ? selectedCoordinator.nombre + (selectedCoordinator.facultades ? ' · ' + selectedCoordinator.facultades : '') : '' %>"
              >
              <input type="hidden" name="coordinador_documento" data-coordinator-value value="<%= selectedCoordinatorDocument || '' %>">
              <div class="coordinator-autocomplete-results" data-coordinator-results hidden>
              <% coordinadores.forEach(function(coordinador) { %>
                <button
                  class="coordinator-autocomplete-option"
                  type="button"
                  data-coordinator-option
                  data-value="<%= coordinador.documento %>"
                  data-label="<%= coordinador.nombre %><%= coordinador.facultades ? ' · ' + coordinador.facultades : '' %>"
                  data-search="<%= `${coordinador.nombre} ${coordinador.documento} ${coordinador.facultades || ''}`.toLocaleLowerCase() %>"
                >
                  <span class="d-block fw-semibold"><%= coordinador.nombre %></span>
                  <small class="text-muted"><%= coordinador.documento %><%= coordinador.facultades ? ' · ' + coordinador.facultades : '' %></small>
                </button>
              <% }); %>
              </div>
            </div>
            <small class="form-text text-muted">El admin registra el laboratorista dentro del alcance de este coordinador.</small>
          </div>
        <% } %>
        <div class="col-12 col-md-8 mx-auto text-center">
          <label for="documento_lookup" class="form-label">Consulta en OATI por documento</label>
          <div class="input-group justify-content-center">
            <input
              type="text"
              inputmode="numeric"
              class="form-control"
              id="documento_lookup"
              name="documento"
              placeholder="Ej: 90000000"
              value="<%= lookupDocumento || '' %>"
            >
            <button class="btn btn-perso" type="submit" title="Consultar" aria-label="Consultar" data-read-only-lock="true">
              <i class="bi bi-search" aria-hidden="true"></i>
            </button>
          </div>
          <small class="form-text text-muted">Si existe en OATI se precargan nombre y correo.</small>
        </div>
      </form>

      <% if (lookupMessage) { %>
        <div class="alert alert-<%= lookupStatus || 'warning' %>" role="alert">
          <%= lookupMessage %>
        </div>
      <% } %>

      <form
        method="post"
        action="/milab/api/register_labs"
        data-oati-loading="true"
        data-oati-loading-message="Consultando datos en la OATI..."
        class="row g-3 mx-auto d-flex justify-content-center app-form-grid"
        onsubmit="return validarCorreo() && validarCampos() && validarUales()"
      >
        <%- include('../partials/csrf_field') %>
        <p class="app-page-subtitle mb-2">
          <em>Ingresa los datos del laboratorista y asigna su facultad, uno o varios laboratorios y el acceso inicial.</em>
        </p>

        <% if (tipo === 'admin') { %>
          <input type="hidden" name="coordinador_documento" value="<%= selectedCoordinatorDocument || '' %>">

          <div class="col-md-12">
            <label for="coordinador_documento_display" class="form-label">Coordinador responsable</label>
            <input
              class="form-control"
              type="text"
              id="coordinador_documento_display"
              value="<%= selectedCoordinator ? selectedCoordinator.nombre + (selectedCoordinator.facultades ? ' · ' + selectedCoordinator.facultades : '') : '' %>"
              placeholder="Selecciona un coordinador arriba"
              readonly
              required
            >
            <small class="form-text text-muted">Para cambiarlo usa el selector superior y vuelve a cargar el alcance.</small>
          </div>
        <% } %>

        <div class="col-md-6">
          <label for="nombre" class="form-label">Nombre completo</label>
          <input type="text" class="form-control" id="nombre" name="nombre" value="<%= lookupData?.nombre || '' %>" autocomplete="name" required>
        </div>

        <div class="col-md-6">
          <label for="documento" class="form-label">Número de documento</label>
          <input
            type="text"
            class="form-control"
            id="documento"
            name="documento"
            inputmode="numeric"
            value="<%= lookupData?.documento || '' %>"
            required
          >
        </div>

        <div class="col-md-12">
          <label for="contrato" class="form-label">Número de contrato y vigencia</label>
          <input type="text" class="form-control" id="contrato" name="contrato" placeholder="Ej: 8151-2025" required>
        </div>

        <div class="col-md-12">
          <label for="correo" class="form-label">Correo electrónico institucional</label>
          <input type="email" class="form-control" id="correo" name="correo" value="<%= lookupData?.correo || '' %>" autocomplete="email" required>
        </div>

        <div class="col-md-12">
          <h2 class="form-label fs-6">Asignación institucional</h2>
          <p class="form-text mt-0">Selecciona la sede o facultad y luego uno o varios laboratorios asociados.</p>
        </div>

        <div class="col-md-6">
          <label for="facultad" class="form-label">Sede / Facultad</label>
          <select class="form-select" id="facultad" name="facultad_id" required <%= tipo === 'admin' && !selectedCoordinatorDocument ? 'disabled' : '' %>>
            <option value=""><%= tipo === 'admin' && !selectedCoordinatorDocument ? 'Selecciona primero un coordinador' : 'Selecciona una sede' %></option>
            <% facultades.forEach(function(facultad) { %>
              <option value="<%= facultad.facultad_id %>"><%= facultad.nombre %></option>
            <% }); %>
          </select>
        </div>

        <div class="col-md-12">
          <h2 class="form-label fs-6">Laboratorios asignados</h2>
          <p class="form-text mt-0">Selecciona uno o varios laboratorios. Todos deben pertenecer a la misma facultad elegida.</p>
          <div class="lab-selection-toolbar">
            <label class="form-label mb-0" for="ualSearch">Buscar laboratorio</label>
            <input
              type="search"
              class="form-control"
              id="ualSearch"
              placeholder="Filtrar por nombre, código o descripción..."
              autocomplete="off"
              aria-label="Filtrar laboratorios por nombre, código o descripción"
              disabled
            >
            <div class="d-flex flex-wrap align-items-center gap-2">
              <button class="btn btn-sm btn-outline-secondary" type="button" id="selectVisibleUals" disabled>Marcar visibles</button>
              <button class="btn btn-sm btn-outline-secondary" type="button" id="clearVisibleUals" disabled>Limpiar visibles</button>
              <span class="text-muted small" id="ualSelectionCount" aria-live="polite">Selecciona una facultad para ver los laboratorios.</span>
            </div>
          </div>
          <div class="lab-selection-list mt-2" id="ualOptions">
            <% uals.forEach(function(ual) { %>
              <label class="form-check lab-selection-option" data-ual-option="true" data-facultad="<%= ual.facultad_id %>" data-search="<%= `${ual.nombre} ${ual.codigo_abreviacion || ''} ${ual.descripcion || ''} ${ual.sal_id_espacio || ''}`.toLocaleLowerCase() %>" hidden>
                  <input
                    class="form-check-input me-2"
                    type="checkbox"
                    name="ual_ids"
                    value="<%= ual.ual_id %>"
                    data-ual-checkbox="true"
                    data-facultad="<%= ual.facultad_id %>"
                  >
                  <span class="form-check-label fw-semibold"><%= ual.nombre %></span>
                  <% if (ual.codigo_abreviacion) { %>
                    <small class="text-muted d-block">Código: <%= ual.codigo_abreviacion %></small>
                  <% } %>
                  <% if (ual.sal_id_espacio) { %>
                    <small class="text-muted d-block">ID espacio: <%= ual.sal_id_espacio %></small>
                  <% } %>
                  <% if (ual.sal_ocupantes) { %>
                    <small class="text-muted d-block">Ocupantes: <%= ual.sal_ocupantes %></small>
                  <% } %>
                  <% if (ual.descripcion) { %>
                    <small class="text-muted d-block"><%= ual.descripcion %></small>
                  <% } %>
              </label>
            <% }); %>
            <p class="text-muted m-0 p-3" id="ualsEmpty" hidden>No hay laboratorios que coincidan con la búsqueda en esta facultad.</p>
          </div>
        </div>

        <div id="mensajeError" class="col-md-12 alert alert-danger d-none mb-0" role="alert"></div>

        <% if (error) { %>
          <div class="col-md-12 alert alert-danger mb-0" role="alert">
            <%= error %>
          </div>
        <% } %>

        <div class="col-md-12 d-flex flex-wrap justify-content-center gap-3 pt-2">
          <button class="btn btn-perso col-md-6" type="submit" id="abrirModal" data-submit-lock="true">Registrar</button>
          <% if (tipo === 'admin' || tipo === 'coordinador') { %>
            <a href="/milab/api/register_labs/token" class="btn btn-outline-secondary col-md-5">Generar enlace con token</a>
          <% } %>
        </div>

        <% if (confirmacion) { include('./confirm_create_account.ejs') } %>
      </form>
    </div>
  </section>
</main>

<%- include('../partials/footer'); -%>
<script src="/milab/public/js/coordinator-autocomplete.js"></script>

<script nonce="<%= cspNonce %>">
  const tipoUsuario = '<%= tipo %>';
  const idFacultadSesion = '<%= facultades[0]?.facultad_id || "" %>';

  window.addEventListener('DOMContentLoaded', function () {
    const facultadSelect = document.getElementById('facultad');
    if (!facultadSelect) {
      return;
    }

    if (tipoUsuario === 'coordinador' && !facultadSelect.value && idFacultadSesion) {
      facultadSelect.value = idFacultadSesion;
    }

    actualizarLaboratorios();
  });

  function actualizarLaboratorios() {
    const facultyId = document.getElementById('facultad').value;
    const filter = document.getElementById('ualSearch').value.trim().toLocaleLowerCase();
    const options = document.querySelectorAll('[data-ual-option="true"]');
    const visibleCheckboxes = [];
    let matchingCount = 0;

    options.forEach(function (option) {
      const checkbox = option.querySelector('[data-ual-checkbox="true"]');
      const matchesFaculty = option.getAttribute('data-facultad') === facultyId;
      const matchesFilter = option.getAttribute('data-search').includes(filter);
      option.hidden = !matchesFaculty || !matchesFilter;

      if (!matchesFaculty) checkbox.checked = false;
      if (!option.hidden) {
        matchingCount++;
        visibleCheckboxes.push(checkbox);
      }
    });

    const hasFaculty = Boolean(facultyId);
    document.getElementById('ualSearch').disabled = !hasFaculty;
    document.getElementById('selectVisibleUals').disabled = !matchingCount;
    document.getElementById('clearVisibleUals').disabled = !matchingCount;
    document.getElementById('ualsEmpty').hidden = !hasFaculty || matchingCount > 0;
    const selectedCount = document.querySelectorAll(
      '[data-ual-checkbox="true"]:checked'
    ).length;
    document.getElementById('ualSelectionCount').textContent = hasFaculty
      ? `${matchingCount} laboratorios visibles · ${selectedCount} seleccionados`
      : 'Selecciona una facultad para ver los laboratorios.';

    return visibleCheckboxes;
  }

  document.getElementById('facultad').addEventListener('change', actualizarLaboratorios);
  document.getElementById('ualSearch').addEventListener('input', actualizarLaboratorios);
  document.getElementById('ualOptions').addEventListener('change', actualizarLaboratorios);
  document.getElementById('selectVisibleUals').addEventListener('click', function () {
    actualizarLaboratorios().forEach(function (checkbox) {
      checkbox.checked = true;
    });
    actualizarLaboratorios();
  });
  document.getElementById('clearVisibleUals').addEventListener('click', function () {
    actualizarLaboratorios().forEach(function (checkbox) {
      checkbox.checked = false;
    });
    actualizarLaboratorios();
  });

  function validarCorreo() {
    var correoInput = document.getElementById('correo');
    var correo = correoInput.value.toLowerCase();
    var mensajeError = document.getElementById('mensajeError');
    mensajeError.classList.add('d-none');
    mensajeError.innerHTML = '';

    if (correo.endsWith('@udistrital.edu.co')) {
      return true;
    }

    mensajeError.classList.remove('d-none');
    mensajeError.innerHTML = '<p>Por favor, ingresa un correo institucional @udistrital.edu.co.</p>';
    correoInput.value = '';
    return false;
  }

  function validarCampos() {
    var nombre = document.getElementById('nombre').value;
    var documento = document.getElementById('documento').value;
    var mensajeError = document.getElementById('mensajeError');
    mensajeError.classList.add('d-none');
    mensajeError.innerHTML = '';

    if (!/^[A-Za-zÀ-ÿ\s]+$/.test(nombre)) {
      mensajeError.classList.remove('d-none');
      mensajeError.innerHTML += '<p>El nombre debe contener solamente letras.</p>';
      return false;
    }

    if (!/^\d*[1-9]\d*$/.test(documento)) {
      mensajeError.classList.remove('d-none');
      mensajeError.innerHTML += '<p>El número de documento debe ser positivo y contener solo dígitos.</p>';
      return false;
    }

    return true;
  }

  function validarUales() {
    var facultad = document.getElementById('facultad').value;
    var seleccionadas = document.querySelectorAll('[data-ual-checkbox="true"]:checked');
    var mensajeError = document.getElementById('mensajeError');

    if (!facultad) {
      mensajeError.classList.remove('d-none');
      mensajeError.innerHTML = '<p>Debes seleccionar una facultad.</p>';
      return false;
    }

    if (seleccionadas.length === 0) {
      mensajeError.classList.remove('d-none');
      mensajeError.innerHTML = '<p>Debes seleccionar al menos un laboratorio.</p>';
      return false;
    }

    return true;
  }
</script>