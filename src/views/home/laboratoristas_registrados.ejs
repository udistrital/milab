<%- include('../partials/header'); -%>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Laboratoristas registrados</h1>
    <p class="app-page-subtitle">Supervisa el equipo por facultad y administra su estado operativo sin eliminar historial.</p>
  </section>

  <section class="card app-table-panel text-light">
    <div class="card-header text-center">
      <h5>Equipo de laboratoristas</h5>
    </div>
    <div class="card-body">
      <% if (successMessage) { %>
        <div class="alert alert-success" role="alert"><%= successMessage %></div>
      <% } %>
      <div class="table-responsive">
        <table id="myTable" class="table table-bordered table-striped table-hover app-table-compact js-data-grid table-laboratoristas" data-grid-page-length="25" data-grid-scroll-x="true">
          <thead class="thead-dark text-center">
            <tr>
              <th>Nombres y Apellidos</th>
              <th>Cédula</th>
              <th>Correo</th>
              <th>Facultad</th>
              <th>Dependencias</th>
              <th>UALs</th>
              <th>Estado actual</th>
              <th data-grid-filter="false" data-grid-orderable="false">Acciones</th>
            </tr>
          </thead>
          <tbody class="text-center text-light">
            <% laboratoristas.forEach(laboratorista => { %>
              <% const facultadTexto = String(laboratorista.con_facultad || '—'); %>
              <% const dependenciaTexto = String(laboratorista.con_dependencia || '—'); %>
              <% const ualTexto = String(laboratorista.con_ual || '—'); %>
              <% const mostrarToggleFacultad = facultadTexto.length > 140; %>
              <% const mostrarToggleDependencia = dependenciaTexto.length > 140; %>
              <% const mostrarToggleUal = ualTexto.length > 140; %>
              <tr>
                <td><%= laboratorista.con_nombre %></td>
                <td><%= laboratorista.con_documento %></td>
                <td data-email-cell="true"><%= laboratorista.con_correo %></td>
                <td>
                  <span
                    class="app-labs-cell-text <%= mostrarToggleFacultad ? 'is-collapsed' : '' %>"
                    data-labs-text="true"
                  ><%= facultadTexto %></span>
                  <% if (mostrarToggleFacultad) { %>
                    <button
                      type="button"
                      class="app-labs-toggle"
                      data-labs-toggle="true"
                      aria-expanded="false"
                    >
                      Ver más
                    </button>
                  <% } %>
                </td>
                <td>
                  <span
                    class="app-labs-cell-text <%= mostrarToggleDependencia ? 'is-collapsed' : '' %>"
                    data-labs-text="true"
                  ><%= dependenciaTexto %></span>
                  <% if (mostrarToggleDependencia) { %>
                    <button type="button" class="app-labs-toggle" data-labs-toggle="true" aria-expanded="false">Ver más</button>
                  <% } %>
                </td>
                <td>
                  <span
                    class="app-labs-cell-text <%= mostrarToggleUal ? 'is-collapsed' : '' %>"
                    data-labs-text="true"
                  ><%= ualTexto %></span>
                  <% if (mostrarToggleUal) { %>
                    <button type="button" class="app-labs-toggle" data-labs-toggle="true" aria-expanded="false">Ver más</button>
                  <% } %>
                </td>
                <td>
                  <span class="badge <%= laboratorista.activo ? 'text-bg-success' : 'text-bg-secondary' %>">
                    <%= laboratorista.activo ? 'Activo' : 'Inactivo' %>
                  </span>
                </td>
                <td>
                  <a
                    class="btn btn-sm btn-outline-primary"
                    href="/milab/api/laboratoristas_registrados/editar?documento=<%= encodeURIComponent(laboratorista.con_documento) %>"
                  >
                    Editar
                  </a>
                  <form action="/milab/api/laboratoristas_registrados/toggle-estado" method="POST">
                    <%- include('../partials/csrf_field') %>
                    <input type="hidden" name="documento" value="<%= laboratorista.con_documento %>">
                    <button
                      type="submit"
                      class="btn btn-sm <%= laboratorista.activo ? 'btn-outline-danger' : 'btn-outline-success' %>"
                    >
                      <%= laboratorista.activo ? 'Inactivar' : 'Activar' %>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer'); -%>
