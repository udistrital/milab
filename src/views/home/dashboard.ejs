      { key: 'concepto_multa', label: 'Concepto' },
    ],
    sancionesActivas: [
      { key: 'fecha_multa', label: 'Fecha', format: (v) => formatDate(v) },
      { key: 'cod_multado', label: 'Código multa', format: (v) => String(v ?? '') },
      { key: 'nombre_sancionado', label: 'Sancionado' },
      { key: 'documento_sancionado', label: 'Documento' },
      { key: 'correo_sancionado', label: 'Correo' },
      { key: 'ual_nombre', label: 'UAL / Laboratorio' },
      { key: 'valor_multa', label: 'Valor', format: (v) => formatNumber(v) },
      { key: 'concepto_multa', label: 'Concepto' },
    ],
    sancionesSaldadas: [
      { key: 'fecha_multa', label: 'Fecha registro', format: (v) => formatDate(v) },
      { key: 'cod_multado', label: 'Código multa', format: (v) => String(v ?? '') },
      { key: 'nombre_sancionado', label: 'Sancionado' },
      { key: 'documento_sancionado', label: 'Documento' },
      { key: 'ual_nombre', label: 'UAL / Laboratorio' },
      { key: 'valor_multa', label: 'Valor', format: (v) => formatNumber(v) },
      { key: 'concepto_multa', label: 'Concepto' },
