      { key: 'codigo', label: 'Código' },
      { key: 'carrera', label: 'Carrera / Programa' },
      { key: 'correo', label: 'Correo' },
      { key: 'motivo_exp', label: 'Motivo' },
    ],
    docentes: [
      { key: 'fecha_creacion', label: 'Fecha emisión', format: (v) => formatDate(v) },
      { key: 'certificado_id', label: 'Certificado #', format: (v) => String(v ?? '') },
      { key: 'nombre_docente', label: 'Docente' },
      { key: 'documento', label: 'Documento' },
      { key: 'correo', label: 'Correo' },
      { key: 'motivo_exp', label: 'Motivo' },
      { key: 'origen_descarga', label: 'Origen' },
    ],
    sanciones: [
