<%- include('../partials/header'); -%>

<main class="container py-4 dashboard-page dashboard-page--simplified dashboard-page--compact">
  <section class="dashboard-topbar dashboard-topbar--compact">
    <div class="dashboard-topbar-copy">
      <span class="dashboard-panel-badge dashboard-panel-badge--scope"><%= scopePresentation.badge %></span>
      <h1 class="dashboard-simple-title"><%= scopePresentation.title %></h1>
      <p class="dashboard-simple-subtitle"><%= scopePresentation.subtitle %></p>

      <% if (scopePresentation.chips && scopePresentation.chips.length) { %>
        <div class="dashboard-scope-chip-row">
          <% scopePresentation.chips.forEach(function(chip) { %>
            <span class="dashboard-scope-chip"><%= chip %></span>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="dashboard-toolbar-inline dashboard-toolbar-inline--compact">
      <form method="GET" action="/milab/api/dashboard" class="dashboard-control-group">
        <label for="filtro">Agrupar por</label>
        <input type="hidden" name="grafico" id="dashboardSelectedChart" value="<%= selectedChart %>">
        <div class="dashboard-select-shell">
          <select name="filtro" id="filtro" onchange="this.form.submit()" class="form-select">
            <option value="dia" <%= filtro === 'dia' ? 'selected' : '' %>>Día</option>
            <option value="semana" <%= filtro === 'semana' ? 'selected' : '' %>>Semana</option>
            <option value="mes" <%= filtro === 'mes' ? 'selected' : '' %>>Mes</option>
            <option value="anio" <%= filtro === 'anio' ? 'selected' : '' %>>Año</option>
          </select>
          <i class="bi bi-calendar3"></i>
        </div>
      </form>

      <div class="dashboard-control-group">
        <label for="tipoGrafico">Indicador</label>
        <div class="dashboard-select-shell">
          <select id="tipoGrafico" onchange="cambiarGrafico()" class="form-select">
            <% availableCharts.forEach(function(chart) { %>
              <option value="<%= chart.id %>" <%= selectedChart === chart.id ? 'selected' : '' %>><%= chart.optionLabel %></option>
            <% }) %>
          </select>
          <i class="bi bi-bar-chart-line"></i>
        </div>
      </div>
    </div>
  </section>

  <section class="dashboard-overview-grid">
    <% scopeCounters.forEach(function(counter) { %>
      <article class="dashboard-overview-card">
        <span class="dashboard-overview-label"><%= counter.label %></span>
        <strong class="dashboard-overview-value"><%= counter.value %></strong>
      </article>
    <% }) %>
  </section>

  <section class="dashboard-main-card dashboard-chart-card dashboard-main-card--compact">
    <div class="dashboard-main-header dashboard-main-header--compact">
      <div>
        <span class="dashboard-panel-kicker">Serie principal</span>
        <h2 id="tituloGrafico"><%= availableCharts.find((chart) => chart.id === selectedChart)?.title || '' %></h2>
        <p id="dashboardChartHint" class="dashboard-main-subtitle">
          <%= availableCharts.find((chart) => chart.id === selectedChart)?.summary || '' %>
        </p>
      </div>

      <div class="dashboard-main-meta">
        <div class="dashboard-main-total">
          <span>Total</span>
          <strong id="dashboardChartTotal">0</strong>
        </div>
        <span class="dashboard-panel-badge">Agrupado por <%= labelFormat %></span>
      </div>
    </div>

    <div class="dashboard-canvas-wrap dashboard-canvas-wrap--simple dashboard-canvas-wrap--compact">
      <canvas id="chartDinamico"></canvas>
    </div>
  </section>

  <section class="dashboard-stats-grid dashboard-stats-grid--simplified dashboard-stats-grid--compact">
    <% availableCharts.forEach(function(chart) { %>
      <button
        type="button"
        class="dashboard-stat-card <%= chart.tone %> <%= chart.id === selectedChart ? 'is-active' : '' %>"
        data-chart-target="<%= chart.id %>"
      >
        <span class="dashboard-stat-label"><%= chart.cardLabel %></span>
        <strong class="dashboard-stat-value"><%= chart.total %></strong>
      </button>
    <% }) %>
  </section>

  <section
    id="dashboardDetailPanel"
    class="app-form-panel dashboard-detail-panel mt-4"
  >
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
      <div>
        <h3 id="dashboardDetailTitle" class="mb-0" style="font-size: 1.1rem;">Detalle</h3>
        <p id="dashboardDetailHint" class="mb-0 mt-1 text-muted" style="font-size: 0.88rem;">
          Selecciona una tarjeta superior para ver el detalle de sus registros.
        </p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <div id="dashboardUsuariosFilterWrap" class="dashboard-users-filter d-none">
          <label for="dashboardUsuariosFiltro" class="form-label mb-0">Estado de registro</label>
          <select id="dashboardUsuariosFiltro" class="form-select form-select-sm">
            <option value="registrados" selected>Activos en plataforma</option>
            <option value="placeholder">Pendientes (placeholder no-email)</option>
          </select>
        </div>
        <span id="dashboardDetailCount" class="badge text-bg-light border" style="font-size: 0.82rem;">
          0 registros
        </span>
      </div>
    </div>

    <div id="dashboardDetailFeedback" class="alert d-none py-2" role="alert"></div>

    <div class="table-responsive dashboard-detail-table-wrap">
      <table
        id="dashboardDetailTable"
        class="table table-striped table-hover align-middle"
        style="width: 100%;"
      >
        <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
          <tr id="dashboardDetailTableHead"></tr>
        </thead>
        <tbody id="dashboardDetailTableBody">
          <tr>
            <td class="text-center py-4 text-muted">
              Selecciona una tarjeta superior para cargar el detalle.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</main>

<div class="modal fade" id="dashboardEmailEditorModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="dashboardEmailEditorForm">
        <div class="modal-header">
          <div>
            <h5 class="modal-title">Editar correo y enrolar cuenta</h5>
            <p class="text-muted mb-0 small">Define el tipo de enrolamiento y actualiza el correo institucional.</p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <div id="dashboardEmailModalFeedback" class="alert alert-danger d-none py-2" role="alert"></div>

          <div class="mb-3">
            <label class="form-label" for="dashboardEmailEditorName">Nombre</label>
            <input type="text" class="form-control" id="dashboardEmailEditorName" readonly>
          </div>

          <div class="mb-3">
            <label class="form-label" for="dashboardEmailEditorDocument">Documento</label>
            <input type="text" class="form-control" id="dashboardEmailEditorDocument" readonly>
          </div>

          <div class="mb-3">
            <label class="form-label" for="dashboardEmailEditorCurrent">Correo actual</label>
            <input type="text" class="form-control" id="dashboardEmailEditorCurrent" readonly>
          </div>

          <div class="mb-3">
            <label class="form-label" for="dashboardEmailEditorInput">Nuevo correo institucional</label>
            <input
              type="email"
              class="form-control"
              id="dashboardEmailEditorInput"
              required
              autocomplete="off"
              pattern="^[a-zA-Z0-9._%+-]+@udistrital\.edu\.co$"
            >
          </div>

          <div>
            <label class="form-label" for="dashboardEmailEditorRole">Enrolar como</label>
            <select id="dashboardEmailEditorRole" class="form-select" required>
              <option value="estudiante">Estudiante</option>
              <option value="docente">Docente</option>
            </select>
            <div class="form-text">Este paso activa/crea el perfil del rol seleccionado para habilitar el ingreso.</div>
          </div>

          <div class="alert alert-light border mt-3 mb-0" role="status">
            <strong class="d-block mb-2">Resumen antes de guardar</strong>
            <div class="small">
              Documento: <strong id="dashboardEmailConfirmDocument">-</strong>
            </div>
            <div class="small">
              Nuevo correo: <strong id="dashboardEmailConfirmCorreo">-</strong>
            </div>
            <div class="small">
              Enrolamiento: <strong id="dashboardEmailConfirmRole">-</strong>
            </div>
          </div>

          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="dashboardEmailConfirmCheckbox">
            <label class="form-check-label" for="dashboardEmailConfirmCheckbox">
              Confirmo que quiero guardar este correo y enrolar la cuenta con el tipo seleccionado.
            </label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary" id="dashboardEmailEditorSaveButton" data-submit-lock="true">Guardar y enrolar</button>
        </div>
      </form>
    </div>
  </div>
</div>

