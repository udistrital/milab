      { key: 'con_estado_multa', label: 'Estado', format: (v) => renderEstadoBadge(v) },
      { key: 'cod_multado', label: 'Código multa', format: (v) => String(v ?? '') },
      { key: 'nombre_sancionado', label: 'Sancionado' },
      { key: 'documento_sancionado', label: 'Documento' },
