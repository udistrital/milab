<%- include('../partials/header'); -%>

<main class="container py-4 dashboard-page dashboard-page--simplified dashboard-page--compact">
  <section class="dashboard-topbar dashboard-topbar--compact">
    <div class="dashboard-topbar-copy">
      <span class="dashboard-panel-badge dashboard-panel-badge--scope"><%= scopePresentation.badge %></span>
      <h1 class="dashboard-simple-title"><%= scopePresentation.title %></h1>
      <p class="dashboard-simple-subtitle"><%= scopePresentation.subtitle %></p>

      <% if (scopePresentation.chips && scopePresentation.chips.length) { %>
        <div class="dashboard-scope-chip-row">
          <% scopePresentation.chips.forEach(function(chip) { %>
            <span class="dashboard-scope-chip"><%= chip %></span>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <% const hasPazYSalvo = typeof pazYSalvo !== 'undefined' && Boolean(pazYSalvo); %>
  <% if (hasPazYSalvo) { %>
    <nav class="dashboard-section-tabs" role="tablist" aria-label="Secciones del dashboard">
      <button type="button" class="dashboard-section-tab is-active" id="dashboardTabGeneral" role="tab" aria-selected="true" aria-controls="dashboardSectionGeneral" data-dashboard-section="general">
        <i class="bi bi-grid-1x2" aria-hidden="true"></i>
        <span>Toda la plataforma</span>
      </button>
      <button type="button" class="dashboard-section-tab" id="dashboardTabPys" role="tab" aria-selected="false" aria-controls="dashboardSectionPys" data-dashboard-section="paz-y-salvos" tabindex="-1">
        <i class="bi bi-patch-check" aria-hidden="true"></i>
        <span>Paz y salvos</span>
      </button>
    </nav>
  <% } %>

  <div id="dashboardSectionGeneral" class="dashboard-section-panel" <%- hasPazYSalvo ? 'role="tabpanel" aria-labelledby="dashboardTabGeneral"' : '' %>>
    <% const overview = typeof generalOverview !== 'undefined' && generalOverview ? generalOverview : null; %>
    <% const overviewHints = overview ? overview.hints : {}; %>
    <% const kpiIcons = {
      estudiantes: 'bi-people',
      docentes: 'bi-person-video3',
      laboratoristas: 'bi-tools',
      coordinadores: 'bi-diagram-3',
      usuariosRegistrados: 'bi-person-check',
    }; %>
    <section class="dashboard-general" aria-labelledby="dashboardGeneralTitle">
      <h2 id="dashboardGeneralTitle" class="visually-hidden">Toda la plataforma</h2>

      <div class="dashboard-pys-cards dashboard-kpi-grid">
        <% availableCharts.forEach(function(chart) { %>
          <button
            type="button"
            class="dashboard-pys-card dashboard-kpi-card kpi-<%= chart.tone %> <%= chart.id === selectedChart ? 'is-active' : '' %>"
            data-chart-target="<%= chart.id %>"
            aria-pressed="<%= chart.id === selectedChart ? 'true' : 'false' %>"
          >
            <span class="dashboard-pys-card-label">
              <i class="bi <%= kpiIcons[chart.id] || 'bi-graph-up' %>" aria-hidden="true"></i>
              <%= chart.cardLabel %>
            </span>
            <strong class="dashboard-pys-card-value"><%= Number(chart.total || 0).toLocaleString('es-CO') %></strong>
            <span class="dashboard-pys-card-hint"><%= overviewHints[chart.id] || 'Ver evolución y detalle' %></span>
          </button>
        <% }) %>
      </div>

      <div class="dashboard-pys-panels">
        <article class="dashboard-pys-panel dashboard-gen-panel--wide">
          <div class="dashboard-gen-evolution-head">
            <div class="dashboard-gen-evolution-copy">
              <h3 id="tituloGrafico"><%= availableCharts.find((chart) => chart.id === selectedChart)?.title || '' %></h3>
              <p id="dashboardChartHint" class="dashboard-gen-hint">
                <%= availableCharts.find((chart) => chart.id === selectedChart)?.summary || '' %>
              </p>
            </div>
            <div class="dashboard-gen-evolution-tools">
              <form method="GET" action="/milab/api/dashboard" class="dashboard-control-group">
                <label for="filtro">Agrupar por</label>
                <input type="hidden" name="grafico" id="dashboardSelectedChart" value="<%= selectedChart %>">
                <div class="dashboard-select-shell">
                  <select name="filtro" id="filtro" onchange="this.form.submit()" class="form-select form-select-sm">
                    <option value="dia" <%= filtro === 'dia' ? 'selected' : '' %>>Día</option>
                    <option value="semana" <%= filtro === 'semana' ? 'selected' : '' %>>Semana</option>
                    <option value="mes" <%= filtro === 'mes' ? 'selected' : '' %>>Mes</option>
                    <option value="anio" <%= filtro === 'anio' ? 'selected' : '' %>>Año</option>
                  </select>
                  <i class="bi bi-calendar3"></i>
                </div>
              </form>
              <div class="dashboard-control-group">
                <label for="tipoGrafico">Indicador</label>
                <div class="dashboard-select-shell">
                  <select id="tipoGrafico" onchange="cambiarGrafico()" class="form-select form-select-sm">
                    <% availableCharts.forEach(function(chart) { %>
                      <option value="<%= chart.id %>" <%= selectedChart === chart.id ? 'selected' : '' %>><%= chart.optionLabel %></option>
                    <% }) %>
                  </select>
                  <i class="bi bi-bar-chart-line"></i>
                </div>
              </div>
              <dl class="dashboard-pys-kpis dashboard-gen-total">
                <div>
                  <dt>Total · por <%= labelFormat.toLowerCase() %></dt>
                  <dd id="dashboardChartTotal">0</dd>
                </div>
              </dl>
            </div>
          </div>
          <div class="dashboard-pys-chart" style="height: 260px;">
            <canvas id="chartDinamico" role="img" aria-label="Evolución del indicador seleccionado"></canvas>
          </div>
        </article>

        <% if (overview) { %>
          <% const activityTotal = overview.actividad.datasets.reduce((sum, item) => sum + item.data.reduce((acc, value) => acc + value, 0), 0); %>
          <% if (overview.actividad.datasets.length) { %>
            <article class="dashboard-pys-panel dashboard-gen-panel--wide">
              <h3>Nuevos registros en los últimos 12 meses</h3>
              <% if (activityTotal) { %>
                <div class="dashboard-pys-chart" style="height: 230px;">
                  <canvas data-gen-chart="activity" role="img" aria-label="Nuevos registros por mes: <%= overview.actividad.datasets.map((item) => item.label + ' ' + item.data.reduce((acc, value) => acc + value, 0)).join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Sin registros nuevos en los últimos 12 meses.</p>
              <% } %>
            </article>
          <% } %>

          <% if (overview.usuarios) { %>
            <article class="dashboard-pys-panel">
              <h3>Usuarios por tipo</h3>
              <% if (overview.usuarios.some((item) => item.value > 0)) { %>
                <div class="dashboard-pys-chart" style="height: 210px;">
                  <canvas data-gen-chart="users" role="img" aria-label="Usuarios por tipo: <%= overview.usuarios.map((item) => item.label + ' ' + item.value).join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Aún no hay usuarios en este alcance.</p>
              <% } %>
            </article>
          <% } %>

          <% if (overview.estadosCuenta) { %>
            <article class="dashboard-pys-panel">
              <h3>Estado de cuentas académicas</h3>
              <% if (overview.estadosCuenta.length) { %>
                <div class="dashboard-pys-chart" style="height: 210px;">
                  <canvas data-gen-chart="accountStates" role="img" aria-label="Estado de cuentas: <%= overview.estadosCuenta.map((item) => item.nombre + ' ' + item.total).join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Aún no hay estudiantes ni docentes en este alcance.</p>
              <% } %>
            </article>
          <% } %>

          <% if (overview.programas) { %>
            <article class="dashboard-pys-panel">
              <h3>Estudiantes por programa</h3>
              <% if (overview.programas.length) { %>
                <div class="dashboard-pys-chart" style="height: <%= 24 + overview.programas.length * 28 %>px;">
                  <canvas data-gen-chart="programs" role="img" aria-label="Estudiantes por programa: <%= overview.programas.map((item) => item.nombre + ' ' + item.total).join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Aún no hay estudiantes en este alcance.</p>
              <% } %>
            </article>
          <% } %>

          <% if (overview.laboratoristasEstado) { %>
            <article class="dashboard-pys-panel">
              <h3>Laboratoristas activos</h3>
              <% if (overview.laboratoristasEstado.some((item) => item.value > 0)) { %>
                <div class="dashboard-pys-chart" style="height: 210px;">
                  <canvas data-gen-chart="labStatus" role="img" aria-label="Laboratoristas: <%= overview.laboratoristasEstado.map((item) => item.label + ' ' + item.value).join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Aún no hay laboratoristas en este alcance.</p>
              <% } %>
            </article>
          <% } %>
        <% } %>
      </div>

      <% const cobertura = typeof coberturaOperativa !== 'undefined' && coberturaOperativa ? coberturaOperativa : null; %>
      <% if (cobertura) { %>
        <% const coverageTotals = cobertura.totales; %>
        <section class="dashboard-gen-block" aria-labelledby="dashboardCoverageTitle">
          <header class="dashboard-gen-block-head">
            <h3 id="dashboardCoverageTitle"><i class="bi bi-diagram-3" aria-hidden="true"></i> Cobertura operativa</h3>
            <span class="dashboard-gen-block-scope">Toda la universidad</span>
          </header>
          <div class="dashboard-pys-panels dashboard-gen-panels--pair">
            <article class="dashboard-pys-panel dashboard-gen-panel--wide">
              <h3>UAL activas por facultad</h3>
              <dl class="dashboard-pys-kpis">
                <div><dt>Facultades</dt><dd><%= coverageTotals.facultades %></dd></div>
                <div><dt>UAL activas</dt><dd><%= coverageTotals.ualActivas.toLocaleString('es-CO') %></dd></div>
                <div>
                  <dt>Con laboratorista</dt>
                  <dd><%= coverageTotals.ualConLaboratorista.toLocaleString('es-CO') %><% if (coverageTotals.porcentajeCubierto !== null) { %> <small class="dashboard-gen-kpi-note">(<%= coverageTotals.porcentajeCubierto %>%)</small><% } %></dd>
                </div>
                <div><dt>Laboratoristas activos</dt><dd><%= coverageTotals.laboratoristas %></dd></div>
                <div><dt>Coordinadores activos</dt><dd><%= coverageTotals.coordinadores %></dd></div>
                <div><dt>Monitores activos</dt><dd><%= coverageTotals.monitores %></dd></div>
                <div class="<%= coverageTotals.monitoresPorVencer ? 'dashboard-gen-kpi--warn' : '' %>">
                  <dt>Monitores que vencen en 30 días</dt><dd><%= coverageTotals.monitoresPorVencer %></dd>
                </div>
              </dl>
              <% if (cobertura.facultades.some((item) => item.ualActivas > 0)) { %>
                <div class="dashboard-pys-chart" style="height: <%= 40 + cobertura.facultades.length * 30 %>px;">
                  <canvas data-gen-chart="coverage" role="img" aria-label="UAL por facultad: <%= cobertura.facultades.map((item) => item.nombre + ' ' + item.ualConLaboratorista + ' de ' + item.ualActivas + ' con laboratorista').join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Aún no hay UAL activas.</p>
              <% } %>
            </article>

            <article class="dashboard-pys-panel">
              <h3>Cobertura de laboratoristas</h3>
              <% if (coverageTotals.ualActivas) { %>
                <div class="dashboard-pys-chart" style="height: 210px;">
                  <canvas data-gen-chart="coverageShare" role="img" aria-label="UAL con laboratorista <%= coverageTotals.ualConLaboratorista %>, sin laboratorista <%= coverageTotals.ualActivas - coverageTotals.ualConLaboratorista %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Aún no hay UAL activas.</p>
              <% } %>
            </article>

            <article class="dashboard-pys-panel">
              <h3>Personal por facultad</h3>
              <% if (cobertura.facultadesSinCoordinador) { %>
                <p class="dashboard-gen-hint mb-2"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> <%= cobertura.facultadesSinCoordinador %> facultad(es) sin coordinador activo.</p>
              <% } %>
              <% if (cobertura.facultades.some((item) => item.laboratoristas || item.coordinadores)) { %>
                <div class="dashboard-pys-chart" style="height: <%= 50 + cobertura.facultades.length * 30 %>px;">
                  <canvas data-gen-chart="staff" role="img" aria-label="Personal por facultad: <%= cobertura.facultades.map((item) => item.nombre + ' ' + item.laboratoristas + ' laboratoristas y ' + item.coordinadores + ' coordinadores').join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Aún no hay personal asignado.</p>
              <% } %>
            </article>
          </div>
        </section>
      <% } %>

      <% const actividadLog = typeof actividadPlataforma !== 'undefined' && actividadPlataforma ? actividadPlataforma : null; %>
      <% if (actividadLog) { %>
        <section class="dashboard-gen-block" aria-labelledby="dashboardActivityTitle">
          <header class="dashboard-gen-block-head">
            <h3 id="dashboardActivityTitle"><i class="bi bi-activity" aria-hidden="true"></i> Actividad en la plataforma</h3>
            <span class="dashboard-gen-block-scope">Registro de auditoría · solo administrador</span>
          </header>
          <div class="dashboard-pys-panels dashboard-gen-panels--pair">
            <article class="dashboard-pys-panel dashboard-gen-panel--wide">
              <h3>Acciones registradas por mes</h3>
              <dl class="dashboard-pys-kpis">
                <div><dt>Acciones · últimos 30 días</dt><dd><%= actividadLog.acciones30.toLocaleString('es-CO') %></dd></div>
                <div class="<%= actividadLog.variacion === null ? '' : (actividadLog.variacion >= 0 ? 'dashboard-gen-kpi--up' : 'dashboard-gen-kpi--down') %>">
                  <dt>Vs. 30 días anteriores</dt>
                  <dd><%= actividadLog.variacion === null ? '—' : (actividadLog.variacion > 0 ? '+' : '') + actividadLog.variacion + '%' %></dd>
                </div>
                <div><dt>Usuarios que registraron acciones</dt><dd><%= actividadLog.actores30 %></dd></div>
              </dl>
              <% if (actividadLog.mensual.data.some((value) => value > 0)) { %>
                <div class="dashboard-pys-chart" style="height: 220px;">
                  <canvas data-gen-chart="logMonthly" role="img" aria-label="Acciones por mes: <%= actividadLog.mensual.labels.map((label, index) => label + ' ' + actividadLog.mensual.data[index]).join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Sin acciones registradas en los últimos 12 meses.</p>
              <% } %>
            </article>

            <article class="dashboard-pys-panel">
              <h3>Acciones más frecuentes <small class="dashboard-gen-kpi-note">· 90 días</small></h3>
              <% if (actividadLog.acciones.length) { %>
                <div class="dashboard-pys-chart" style="height: <%= 24 + actividadLog.acciones.length * 28 %>px;">
                  <canvas data-gen-chart="logActions" role="img" aria-label="Acciones más frecuentes: <%= actividadLog.acciones.map((item) => item.nombre + ' ' + item.total).join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Sin acciones en los últimos 90 días.</p>
              <% } %>
            </article>

            <article class="dashboard-pys-panel">
              <h3>Acciones por tipo de usuario <small class="dashboard-gen-kpi-note">· 90 días</small></h3>
              <% if (actividadLog.roles.length) { %>
                <div class="dashboard-pys-chart" style="height: 210px;">
                  <canvas data-gen-chart="logRoles" role="img" aria-label="Acciones por tipo de usuario: <%= actividadLog.roles.map((item) => item.nombre + ' ' + item.total).join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Sin acciones en los últimos 90 días.</p>
              <% } %>
            </article>

            <article class="dashboard-pys-panel">
              <h3>Actividad por día de la semana <small class="dashboard-gen-kpi-note">· 90 días</small></h3>
              <% if (actividadLog.semana.data.some((value) => value > 0)) { %>
                <div class="dashboard-pys-chart" style="height: 230px;">
                  <canvas data-gen-chart="logWeekday" role="img" aria-label="Acciones por día: <%= actividadLog.semana.labels.map((label, index) => label + ' ' + actividadLog.semana.data[index]).join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Sin acciones en los últimos 90 días.</p>
              <% } %>
            </article>

            <article class="dashboard-pys-panel">
              <h3>Usuarios más activos <small class="dashboard-gen-kpi-note">· 30 días</small></h3>
              <% if (actividadLog.actores.length) { %>
                <div class="dashboard-pys-chart" style="height: <%= 24 + actividadLog.actores.length * 28 %>px;">
                  <canvas data-gen-chart="logActors" role="img" aria-label="Usuarios más activos: <%= actividadLog.actores.map((item) => item.nombre + ' ' + item.total).join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Sin acciones en los últimos 30 días.</p>
              <% } %>
            </article>
          </div>
        </section>
      <% } %>
    </section>

    <section
      id="dashboardDetailPanel"
      class="app-form-panel dashboard-detail-panel mt-4"
    >
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
          <h3 id="dashboardDetailTitle" class="mb-0" style="font-size: 1.1rem;">Detalle</h3>
          <p id="dashboardDetailHint" class="mb-0 mt-1 text-muted" style="font-size: 0.88rem;">
            Selecciona una tarjeta superior para ver el detalle de sus registros.
          </p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <div id="dashboardUsuariosFilterWrap" class="dashboard-users-filter d-none">
            <label for="dashboardUsuariosFiltro" class="form-label mb-0">Estado de registro</label>
            <select id="dashboardUsuariosFiltro" class="form-select form-select-sm">
              <option value="registrados" selected>Activos en plataforma</option>
              <option value="placeholder">Pendientes (placeholder no-email)</option>
            </select>
          </div>
          <div id="dashboardUsuariosColumnFilterWrap" class="dashboard-users-filter d-none">
            <label for="dashboardUsuariosFiltroColumna" class="form-label mb-0">Filtro de usuarios</label>
            <div class="d-flex flex-wrap align-items-center gap-2">
              <select id="dashboardUsuariosFiltroColumna" class="form-select form-select-sm">
                <option value="__all" selected>Todas las columnas</option>
              </select>
              <label for="dashboardUsuariosFiltroValor" class="visually-hidden">Valor exacto para filtrar</label>
              <input
                type="text"
                id="dashboardUsuariosFiltroValor"
                class="form-control form-control-sm"
                placeholder="Valor exacto"
                autocomplete="off"
              >
              <button type="button" id="dashboardUsuariosFiltroLimpiar" class="btn btn-sm btn-outline-secondary">Limpiar</button>
            </div>
          </div>
          <span id="dashboardDetailCount" class="badge text-bg-light border" style="font-size: 0.82rem;">
            0 registros
          </span>
        </div>
      </div>

      <div id="dashboardDetailFeedback" class="alert d-none py-2" role="alert"></div>

      <div class="table-responsive dashboard-detail-table-wrap">
        <table
          id="dashboardDetailTable"
          class="table table-striped table-hover align-middle"
          style="width: 100%;"
        >
          <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
            <tr id="dashboardDetailTableHead"></tr>
          </thead>
          <tbody id="dashboardDetailTableBody">
            <tr>
              <td class="text-center py-4 text-muted">
                Selecciona una tarjeta superior para cargar el detalle.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <% if (hasPazYSalvo) { %>
    <div id="dashboardSectionPys" class="dashboard-section-panel" role="tabpanel" aria-labelledby="dashboardTabPys" hidden>
      <section class="dashboard-pys" aria-labelledby="dashboardPysTitle">
        <div class="dashboard-pys-header">
          <h2 id="dashboardPysTitle" class="visually-hidden">Paz y salvos</h2>
          <p class="dashboard-pys-note mb-0">
            Bloquean el paz y salvo las sanciones en estado ACTIVA, Pendiente o POR SALDAR.
          </p>
        </div>

        <div class="dashboard-pys-cards">
          <% pazYSalvo.cards.forEach(function(card) { %>
            <% const cardTag = card.href ? 'a' : 'article'; %>
            <<%= cardTag %>
              class="dashboard-pys-card pys-tone-<%= card.tone %>"
              <% if (card.href) { %>href="<%= card.href %>"<% } %>
            >
              <span class="dashboard-pys-card-label"><%= card.label %></span>
              <strong class="dashboard-pys-card-value"><%= Number(card.value || 0).toLocaleString('es-CO') %></strong>
              <span class="dashboard-pys-card-hint"><%= card.hint %></span>
            </<%= cardTag %>>
          <% }) %>
        </div>

        <% const pysSanciones = pazYSalvo.sanciones; %>
        <% const pysReclamaciones = pazYSalvo.reclamaciones; %>
        <% const pysCertificados = pazYSalvo.certificados; %>
        <div class="dashboard-pys-panels">
          <article class="dashboard-pys-panel">
            <h3>Antigüedad de sanciones abiertas</h3>
            <% if (pysSanciones.abiertas) { %>
              <div class="dashboard-pys-chart" style="height: 150px;">
                <canvas data-pys-chart="aging" role="img" aria-label="Antigüedad de sanciones abiertas: <%= pysSanciones.antiguedad.map((item) => item.label + ' ' + item.value).join(', ') %>"></canvas>
              </div>
            <% } else { %>
              <p class="dashboard-pys-empty">Sin sanciones abiertas.</p>
            <% } %>
          </article>

          <article class="dashboard-pys-panel">
            <h3>¿Dónde se concentran los bloqueos?</h3>
            <% pazYSalvo.rankingGroups.forEach(function(group, groupIndex) { %>
              <p class="dashboard-pys-subtitle"><%= group.title %></p>
              <% if (!group.items.length) { %>
                <p class="dashboard-pys-empty">Sin sanciones abiertas.</p>
              <% } else { %>
                <div class="dashboard-pys-chart" style="height: <%= 24 + group.items.length * 26 %>px;">
                  <canvas data-pys-chart="ranking" data-pys-group="<%= groupIndex %>" role="img" aria-label="Sanciones abiertas por <%= group.title.toLowerCase() %>: <%= group.items.map((item) => item.nombre + ' ' + item.abiertas).join(', ') %>"></canvas>
                </div>
              <% } %>
            <% }) %>
          </article>

          <% if (pysReclamaciones) { %>
            <% const avgHours = pysReclamaciones.horasPromedio; %>
            <article class="dashboard-pys-panel">
              <h3>Reclamaciones</h3>
              <dl class="dashboard-pys-kpis">
                <div><dt>Recibidas</dt><dd><%= pysReclamaciones.total %></dd></div>
                <div>
                  <dt>% que procede</dt>
                  <dd><%= pysReclamaciones.tasaProcede === null ? '—' : pysReclamaciones.tasaProcede + '%' %></dd>
                </div>
                <div>
                  <dt>Respuesta promedio</dt>
                  <dd><%= avgHours === null ? '—' : (avgHours >= 48 ? (avgHours / 24).toFixed(1) + ' días' : avgHours + ' h') %></dd>
                </div>
              </dl>
              <% if (pysReclamaciones.total) { %>
                <div class="dashboard-pys-chart" style="height: 180px;">
                  <canvas data-pys-chart="claims" role="img" aria-label="Reclamaciones: sin respuesta <%= pysReclamaciones.pendientes %>, procede <%= pysReclamaciones.procede %>, no procede <%= pysReclamaciones.noProcede %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Aún no hay reclamaciones en este alcance.</p>
              <% } %>
            </article>
          <% } %>

          <% if (pysCertificados) { %>
            <% const totalCertificados = pysCertificados.estudiantes + (pysCertificados.docentes || 0); %>
            <article class="dashboard-pys-panel">
              <h3>Paz y salvos expedidos</h3>
              <dl class="dashboard-pys-kpis">
                <div><dt>Estudiantes</dt><dd><%= pysCertificados.estudiantes %></dd></div>
                <% if (pysCertificados.docentes !== null) { %>
                  <div><dt>Docentes</dt><dd><%= pysCertificados.docentes %></dd></div>
                <% } %>
                <div><dt>Total</dt><dd><%= totalCertificados %></dd></div>
              </dl>
              <% if (totalCertificados) { %>
                <p class="dashboard-pys-subtitle">Origen</p>
                <div class="dashboard-pys-chart" style="height: 160px;">
                  <canvas data-pys-chart="origin" role="img" aria-label="Origen de los paz y salvos: <%= pysCertificados.origen.map((item) => item.label + ' ' + item.value).join(', ') %>"></canvas>
                </div>
                <p class="dashboard-pys-subtitle">Motivos más frecuentes</p>
                <div class="dashboard-pys-chart" style="height: <%= 24 + pysCertificados.motivos.length * 26 %>px;">
                  <canvas data-pys-chart="reasons" role="img" aria-label="Motivos más frecuentes: <%= pysCertificados.motivos.map((item) => item.nombre + ' ' + item.total).join(', ') %>"></canvas>
                </div>
              <% } else { %>
                <p class="dashboard-pys-empty">Aún no hay paz y salvos en este alcance.</p>
              <% } %>
            </article>
          <% } %>
        </div>
      </section>
    </div>
  <% } %>
</main>

