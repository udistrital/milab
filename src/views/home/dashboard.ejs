<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script nonce="<%= cspNonce %>">
  function escapeHtml(value) {
    if (value === null || value === undefined) return '';
    const str = String(value);
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatDate(value) {
    if (!value) return '';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return escapeHtml(value);
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    const hh = String(d.getHours()).padStart(2, '0');
    const mi = String(d.getMinutes()).padStart(2, '0');
    return `${yyyy}-${mm}-${dd} ${hh}:${mi}`;
  }

  function formatNumber(value) {
    if (value === null || value === undefined || value === '') return '';
    const num = Number(value);
    if (Number.isNaN(num)) return escapeHtml(value);
    return num.toLocaleString();
  }

  function renderList(value) {
    if (!value) return '';
    let arr = [];
    if (Array.isArray(value)) arr = value;
    else if (typeof value === 'string') arr = value.split(',').map((s) => s.trim()).filter(Boolean);
    if (!arr.length) return '<span class="text-muted">—</span>';
    return arr
      .filter((x) => x !== null && x !== undefined && x !== '')
      .map((x) => `<span class="badge text-bg-light border me-1 mb-1">${escapeHtml(x)}</span>`)
      .join('');
  }

  function renderEstadoBadge(value) {
    const raw = String(value || '').trim();
    if (!raw) return '<span class="text-muted">—</span>';
    const upper = raw.toUpperCase();
    let cls = 'text-bg-light border';
    if (
      upper === 'ACTIVA' ||
      upper === 'ACTIVO' ||
      upper === 'EN MORA' ||
      upper === 'PENDIENTE'
    ) {
      cls = 'text-bg-danger';
    } else if (upper === 'SALDADA' || upper === 'SALDADO' || upper === 'NORMALIZADO') {
      cls = 'text-bg-success';
    } else if (upper === 'INACTIVO' || upper === 'INACTIVA') {
      cls = 'text-bg-secondary';
    } else if (upper.startsWith('BLOQUEAD')) {
      cls = 'text-bg-dark';
    }
    return `<span class="badge ${cls}">${escapeHtml(raw)}</span>`;
  }

  function safeFormatCell(def, value) {
    if (def && typeof def.format === 'function') {
      try {
        return def.format(value);
      } catch (e) {
        return escapeHtml(value == null ? '' : value);
      }
    }
    return escapeHtml(value == null ? '' : value);
  }

  function renderCollapsibleCell(value, maxLength) {
    const rawValue = String(value ?? '').trim();
    const normalizedMaxLength = Number.isInteger(maxLength) && maxLength > 0 ? maxLength : 120;

    if (!rawValue) {
      return '<span class="text-muted">—</span>';
    }

    if (rawValue.length <= normalizedMaxLength) {
      return escapeHtml(rawValue);
    }

    return `
      <span class="app-labs-cell-text is-collapsed" data-labs-text="true">${escapeHtml(rawValue)}</span>
      <button
        type="button"
        class="app-labs-toggle"
        data-labs-toggle="true"
        aria-expanded="false"
      >Ver más</button>
    `;
  }

  function renderUsuariosAdminActions(row, rowIndex) {
    const rowId = Number(row?.id);
    if (!Number.isInteger(rowId) || rowId <= 0) {
      return '<span class="text-muted">—</span>';
    }

    return `
      <div class="d-flex flex-wrap gap-1">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-dashboard-action="editar-correo" data-row-index="${rowIndex}">Editar correo</button>
          <button
            type="button"
            class="btn btn-sm btn-outline-primary"
            data-dashboard-action="impersonar"
            data-row-index="${rowIndex}"
            title="Impersonar usuario"
            aria-label="Impersonar usuario"
          ><i class="bi bi-incognito me-1" aria-hidden="true"></i>Impersonar</button>
      </div>
    `;
  }

  function getUsuariosFilterWrapElement() {
    return document.getElementById('dashboardUsuariosFilterWrap');
  }

  function getDashboardFeedbackElement() {
    return document.getElementById('dashboardDetailFeedback');
  }

  function hideDashboardFeedback() {
    const feedback = getDashboardFeedbackElement();
    if (!feedback) return;
    feedback.className = 'alert d-none py-2';
    feedback.textContent = '';
  }

  function showDashboardFeedback(message, type = 'success') {
    const feedback = getDashboardFeedbackElement();
    if (!feedback) return;
    const tone = type === 'error' ? 'alert-danger' : type === 'warning' ? 'alert-warning' : 'alert-success';
    feedback.className = `alert ${tone} py-2`;
    feedback.textContent = message;
    feedback.classList.remove('d-none');
  }

  function inferEnrollmentTypeFromRow(row) {
    const hasCodigo = String(row?.codigo || '').trim() !== '';
    const hasCarrera = String(row?.carrera || '').trim() !== '';
    return hasCodigo || hasCarrera ? 'estudiante' : 'docente';
  }

  function openDashboardEmailEditorModal(rowIndex) {
    const rows = getCurrentUsuariosRegistradosRows();
    const row = rows[rowIndex];
    if (!row || !Number.isInteger(Number(row.id)) || !window.bootstrap) return;

    dashboardEmailEditContext = {
      rowId: Number(row.id),
      rowIndex,
    };

    const nameInput = document.getElementById('dashboardEmailEditorName');
    const documentInput = document.getElementById('dashboardEmailEditorDocument');
    const currentInput = document.getElementById('dashboardEmailEditorCurrent');
    const emailInput = document.getElementById('dashboardEmailEditorInput');
    const roleSelect = document.getElementById('dashboardEmailEditorRole');
    const confirmCheckbox = document.getElementById('dashboardEmailConfirmCheckbox');
    const modalFeedback = document.getElementById('dashboardEmailModalFeedback');

    if (modalFeedback) {
      modalFeedback.classList.add('d-none');
      modalFeedback.textContent = '';
    }

    if (nameInput) nameInput.value = String(row.nombre || '');
    if (documentInput) documentInput.value = String(row.documento || '');
    if (currentInput) currentInput.value = String(row.correo || '');
    if (emailInput) emailInput.value = String(row.correo || '');
    if (roleSelect) roleSelect.value = inferEnrollmentTypeFromRow(row);
    if (confirmCheckbox) confirmCheckbox.checked = false;

    updateDashboardEmailConfirmSummary();
    syncDashboardEmailSaveState();

    const modalElement = document.getElementById('dashboardEmailEditorModal');
    const modal = window.bootstrap.Modal.getOrCreateInstance(modalElement);
    modal.show();
  }

  function updateDashboardEmailConfirmSummary() {
    const documentInput = document.getElementById('dashboardEmailEditorDocument');
    const emailInput = document.getElementById('dashboardEmailEditorInput');
    const roleSelect = document.getElementById('dashboardEmailEditorRole');
    const summaryDocument = document.getElementById('dashboardEmailConfirmDocument');
    const summaryCorreo = document.getElementById('dashboardEmailConfirmCorreo');
    const summaryRole = document.getElementById('dashboardEmailConfirmRole');

    if (summaryDocument) {
      summaryDocument.textContent = String(documentInput?.value || '-').trim() || '-';
    }

    if (summaryCorreo) {
      summaryCorreo.textContent = String(emailInput?.value || '-').trim() || '-';
    }

    if (summaryRole) {
      const roleValue = String(roleSelect?.value || '').trim().toLowerCase();
      summaryRole.textContent = roleValue === 'docente' ? 'Docente' : 'Estudiante';
    }
  }

  function syncDashboardEmailSaveState() {
    const saveButton = document.getElementById('dashboardEmailEditorSaveButton');
    const confirmCheckbox = document.getElementById('dashboardEmailConfirmCheckbox');
    if (!saveButton || !confirmCheckbox) return;

    if (!confirmCheckbox.checked) {
      saveButton.disabled = true;
      saveButton.textContent = 'Confirma para guardar';
      return;
    }

    saveButton.disabled = false;
    saveButton.textContent = 'Guardar y enrolar';
  }

  function isNoEmailPlaceholderCorreo(correo) {
    const normalized = String(correo || '').trim().toLowerCase();
    if (!normalized) return true;
    return normalized.includes('no-email') || normalized.endsWith('@placeholder.milab.local');
  }

  function getCurrentUsuariosRegistradosRows() {
    const registrados = Array.isArray(tablesData.usuariosRegistrados)
      ? tablesData.usuariosRegistrados
      : [];

    if (!canAdminManageUsuarios) {
      return registrados;
    }

    const placeholders = Array.isArray(tablesData.usuariosPlaceholder)
      ? tablesData.usuariosPlaceholder
      : [];

    return usuariosDashboardFilter === 'placeholder' ? placeholders : registrados;
  }

  function syncUsuariosRowsAfterEmailUpdate(rowId, correo) {
    const registrados = Array.isArray(tablesData.usuariosRegistrados)
      ? tablesData.usuariosRegistrados
      : [];
    const placeholders = Array.isArray(tablesData.usuariosPlaceholder)
      ? tablesData.usuariosPlaceholder
      : [];

    const registeredIndex = registrados.findIndex((row) => Number(row?.id) === Number(rowId));
    const placeholderIndex = placeholders.findIndex((row) => Number(row?.id) === Number(rowId));
    const isPlaceholder = isNoEmailPlaceholderCorreo(correo);

    if (registeredIndex >= 0) {
      registrados[registeredIndex].correo = correo;
    }

    if (placeholderIndex >= 0) {
      placeholders[placeholderIndex].correo = correo;
    }

    if (!isPlaceholder && placeholderIndex >= 0) {
      const [row] = placeholders.splice(placeholderIndex, 1);
      if (row && registeredIndex < 0) {
        registrados.unshift(row);
      }
    }

    if (isPlaceholder && registeredIndex >= 0) {
      const [row] = registrados.splice(registeredIndex, 1);
      if (row && placeholderIndex < 0) {
        placeholders.unshift(row);
      }
    }
  }

  async function actualizarCorreoUsuarioDesdeDashboard() {
    if (!dashboardEmailEditContext || !Number.isInteger(dashboardEmailEditContext.rowId)) {
      showDashboardFeedback('No encontramos la cuenta seleccionada para editar.', 'error');
      return;
    }

    const emailInput = document.getElementById('dashboardEmailEditorInput');
    const roleSelect = document.getElementById('dashboardEmailEditorRole');
    const saveButton = document.getElementById('dashboardEmailEditorSaveButton');
    const confirmCheckbox = document.getElementById('dashboardEmailConfirmCheckbox');
    const modalFeedback = document.getElementById('dashboardEmailModalFeedback');
    const normalizedCorreo = String(emailInput?.value || '').trim().toLowerCase();
    const tipoUsuario = String(roleSelect?.value || '').trim().toLowerCase();

    if (!normalizedCorreo || !normalizedCorreo.endsWith('@udistrital.edu.co')) {
      if (modalFeedback) {
        modalFeedback.textContent = 'Debes ingresar un correo institucional valido (@udistrital.edu.co).';
        modalFeedback.classList.remove('d-none');
      }
      return;
    }

    if (!['estudiante', 'docente'].includes(tipoUsuario)) {
      if (modalFeedback) {
        modalFeedback.textContent = 'Debes seleccionar si el enrolamiento será como estudiante o docente.';
        modalFeedback.classList.remove('d-none');
      }
      return;
    }

    if (!confirmCheckbox?.checked) {
      if (modalFeedback) {
        modalFeedback.textContent =
          'Debes confirmar el resumen para continuar con la edición y enrolamiento.';
        modalFeedback.classList.remove('d-none');
      }
      syncDashboardEmailSaveState();
      return;
    }

    try {
      window.MiLabSubmitLock.lock(saveButton, 'Realizando acción en dashboard...');
      const response = await fetch(
        `/milab/api/dashboard/usuarios/${dashboardEmailEditContext.rowId}/correo`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
            Accept: 'application/json',
          },
          body: JSON.stringify({ correo: normalizedCorreo, tipoUsuario }),
        }
      );

      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.ok) {
        if (modalFeedback) {
          modalFeedback.textContent = payload.message || 'No fue posible actualizar el correo.';
          modalFeedback.classList.remove('d-none');
        }
        return;
      }

      syncUsuariosRowsAfterEmailUpdate(dashboardEmailEditContext.rowId, payload.correo);
      renderDetailTable('usuariosRegistrados');

      const modalElement = document.getElementById('dashboardEmailEditorModal');
      const modal = window.bootstrap?.Modal.getOrCreateInstance(modalElement);
      modal?.hide();

      showDashboardFeedback(
        `Cuenta actualizada y enrolada como ${tipoUsuario}. Ya puede intentar ingresar con Microsoft.`,
        'success'
      );
    } catch {
      if (modalFeedback) {
        modalFeedback.textContent =
          'No fue posible actualizar el correo. Verifica la conexión e inténtalo nuevamente.';
        modalFeedback.classList.remove('d-none');
      }
    } finally {
      window.MiLabSubmitLock.release(saveButton);
    }
  }

  async function impersonarUsuarioDesdeDashboard(rowIndex, btnElement) {
    const rows = getCurrentUsuariosRegistradosRows();
    const row = rows[rowIndex];
    if (!row || !Number.isInteger(Number(row.id))) return;

    hideDashboardFeedback();

    try {
      window.MiLabSubmitLock.lock(btnElement, 'Realizando acción en dashboard...');
      const response = await fetch('/milab/api/dashboard/impersonacion/iniciar', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          Accept: 'application/json',
        },
        body: JSON.stringify({ usuarioId: Number(row.id) }),
      });

      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.ok) {
        showDashboardFeedback(payload.message || 'No fue posible impersonar la cuenta seleccionada.', 'error');
        return;
      }

      window.location.href = payload.redirect || '/milab/inicio';
    } finally {
      window.MiLabSubmitLock.release(btnElement);
    }
  }

  function renderDetailTable(tipo) {
    const headEl = document.getElementById('dashboardDetailTableHead');
    const bodyEl = document.getElementById('dashboardDetailTableBody');
    const titleEl = document.getElementById('dashboardDetailTitle');
    const hintEl = document.getElementById('dashboardDetailHint');
    const countEl = document.getElementById('dashboardDetailCount');
    const tableEl = document.getElementById('dashboardDetailTable');

    const columns = TABLE_COLUMN_DEFS[tipo];
    let rows = Array.isArray(tablesData[tipo]) ? tablesData[tipo] : [];
    const config = chartDefinitions[tipo];
    const usuariosFilterWrap = getUsuariosFilterWrapElement();

    if (usuariosFilterWrap) {
      const showUsuariosFilter = canAdminManageUsuarios && tipo === 'usuariosRegistrados';
      usuariosFilterWrap.classList.toggle('d-none', !showUsuariosFilter);
    }

    if (tipo === 'usuariosRegistrados') {
      rows = getCurrentUsuariosRegistradosRows();
    }

    if (!columns || !config) {
      if (tableEl) {
        tableEl.classList.remove('table-coordinadores');
      }
      if (headEl) headEl.innerHTML = '<th>Selecciona una tarjeta superior para ver el detalle.</th>';
      if (bodyEl) {
        bodyEl.innerHTML =
          '<tr><td class="text-center py-4 text-muted">Selecciona una tarjeta superior para ver el detalle.</td></tr>';
      }
      return;
    }

    if (tableEl) {
      tableEl.classList.toggle('table-coordinadores', tipo === 'coordinadores');
    }

    titleEl.textContent = `Detalle - ${config.cardLabel || config.optionLabel || tipo}`;
    hintEl.textContent =
      config.summary ||
      'Registros que componen el total mostrado en la tarjeta. Se presenta el detalle paginado y buscable.';
    countEl.textContent = `${rows.length.toLocaleString()} registro${rows.length === 1 ? '' : 's'}`;

    const shouldRenderAdminActions = canAdminManageUsuarios && tipo === 'usuariosRegistrados';
    const resolvedColumns = shouldRenderAdminActions
      ? [...columns, { key: '__acciones_admin', label: 'Acciones' }]
      : columns;

    headEl.innerHTML = resolvedColumns
      .map((col) => `<th scope="col">${escapeHtml(col.label)}</th>`)
      .join('');

    if (!rows.length) {
      bodyEl.innerHTML = `<tr><td colspan="${resolvedColumns.length}" class="text-center py-4 text-muted">No hay registros para este indicador en el alcance actual.</td></tr>`;
      return;
    }

    bodyEl.innerHTML = rows
      .map((row, rowIndex) => {
        const cells = resolvedColumns
          .map((col) => {
            if (col.key === '__acciones_admin') {
              return `<td>${renderUsuariosAdminActions(row, rowIndex)}</td>`;
            }

            if (tipo === 'coordinadores' && col.key === 'soporte_resolucion') {
              return `<td>${renderCollapsibleCell(row[col.key], 100)}</td>`;
            }

            return `<td>${safeFormatCell(col, row[col.key])}</td>`;
          })
          .join('');
        return `<tr>${cells}</tr>`;
      })
      .join('');
  }

  function resetDetailPanel() {
    const headEl = document.getElementById('dashboardDetailTableHead');
    const bodyEl = document.getElementById('dashboardDetailTableBody');
    const titleEl = document.getElementById('dashboardDetailTitle');
    const hintEl = document.getElementById('dashboardDetailHint');
    const countEl = document.getElementById('dashboardDetailCount');
    const tableEl = document.getElementById('dashboardDetailTable');

    if (tableEl) {
      tableEl.classList.remove('table-coordinadores');
    }

    if (titleEl) {
      titleEl.textContent = 'Detalle';
    }

    if (hintEl) {
      hintEl.textContent = 'Selecciona una tarjeta superior para ver el detalle de sus registros.';
    }

    if (countEl) {
      countEl.textContent = '0 registros';
    }

    hideDashboardFeedback();

    const usuariosFilterWrap = getUsuariosFilterWrapElement();
    if (usuariosFilterWrap) {
      usuariosFilterWrap.classList.add('d-none');
    }

    if (headEl) {
      headEl.innerHTML = '<th>Selecciona una tarjeta superior para ver el detalle.</th>';
    }

    if (bodyEl) {
      bodyEl.innerHTML =
        '<tr><td class="text-center py-4 text-muted">Selecciona una tarjeta superior para cargar el detalle.</td></tr>';
    }
  }

  let chartInstance = null;
  let currentChartType = <%- JSON.stringify(selectedChart) %>;
  let detailEnabled = false;

  const chartVisualConfig = {
    estudiantes: {
      color: '#1f7aec',
      backgroundColor: 'rgba(31, 122, 236, 0.18)',
    },
    docentes: {
      color: '#219653',
      backgroundColor: 'rgba(33, 150, 83, 0.18)',
    },
    sanciones: {},
    sancionesActivas: {
      color: '#e63946',
      backgroundColor: 'rgba(230, 57, 70, 0.18)',
    },
    sancionesSaldadas: {
      color: '#28b6d8',
      backgroundColor: 'rgba(40, 182, 216, 0.18)',
    },
    laboratoristas: {
      color: '#2a2f36',
      backgroundColor: 'rgba(42, 47, 54, 0.18)',
    },
    coordinadores: {
      color: '#8b949e',
      backgroundColor: 'rgba(139, 148, 158, 0.18)',
    },
    usuariosRegistrados: {
      color: '#ff7a00',
      backgroundColor: 'rgba(255, 122, 0, 0.18)',
    },
  };

  function getChartTheme() {
    const styles = getComputedStyle(document.documentElement);
    return {
      text: styles.getPropertyValue('--app-text-main').trim() || '#171717',
      muted: styles.getPropertyValue('--app-text-muted').trim() || '#5f5a53',
      grid: styles.getPropertyValue('--app-chart-grid').trim() || 'rgba(23, 23, 23, 0.1)',
      surface: styles.getPropertyValue('--app-surface-strong').trim() || '#fffaf3',
    };
  }

  function getTotal(tipo) {
    if (!chartsData[tipo]) {
      return 0;
    }

    return chartsData[tipo].data.reduce((sum, val) => sum + Number(val || 0), 0);
  }

  function updateSummary(tipo, options = {}) {
    const shouldRenderDetail = options.renderDetail === true;
    const config = chartDefinitions[tipo];
    if (!config) {
      return;
    }

    document.getElementById('tituloGrafico').textContent = config.title;
    document.getElementById('dashboardChartHint').textContent = config.summary;
    document.getElementById('dashboardChartTotal').textContent = getTotal(tipo).toLocaleString();

    document.querySelectorAll('.dashboard-stat-card').forEach((card) => {
      card.classList.toggle('is-active', card.dataset.chartTarget === tipo);
    });

    try {
      if (shouldRenderDetail) {
        renderDetailTable(tipo);
        const panel = document.getElementById('dashboardDetailPanel');
        if (panel && typeof panel.scrollIntoView === 'function') {
          panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      } else {
        resetDetailPanel();
      }
    } catch (e) {
      // table rendering failures must not break chart updates
      console.warn('Dashboard detail table render failed:', e);
    }
  }

  function syncChartSelection(tipo) {
    const chartSelect = document.getElementById('tipoGrafico');
    const hiddenChartInput = document.getElementById('dashboardSelectedChart');

    if (chartSelect && chartSelect.value !== tipo) {
      chartSelect.value = tipo;
    }

    if (hiddenChartInput) {
      hiddenChartInput.value = tipo;
    }

    const url = new URL(window.location.href);
    url.searchParams.set('grafico', tipo);
    window.history.replaceState({}, '', url);
  }

  function renderChart(tipo, options = {}) {
    currentChartType = tipo;
    syncChartSelection(tipo);
    const ctx = document.getElementById('chartDinamico');
    const config = chartDefinitions[tipo];
    const theme = getChartTheme();

    if (!config || !ctx) {
      return;
    }

    if (chartInstance) {
      chartInstance.destroy();
    }

    updateSummary(tipo, options);

    if (tipo === 'sanciones') {
      chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: chartsData.sanciones.labels,
          datasets: [
            {
              label: 'Total sanciones',
              data: chartsData.sanciones.data,
              fill: false,
              borderColor: '#ffbf1f',
              backgroundColor: 'rgba(255, 191, 31, 0.18)',
              tension: 0.35,
              pointBackgroundColor: '#ffbf1f',
              pointBorderColor: theme.surface,
              pointBorderWidth: 2,
              pointRadius: 3,
              borderWidth: 3,
            },
            {
              label: 'Sanciones activas',
              data: chartsData.sancionesActivas.data,
              fill: false,
              borderColor: '#e63946',
              backgroundColor: 'rgba(230, 57, 70, 0.18)',
              tension: 0.35,
              pointBackgroundColor: '#e63946',
              pointBorderColor: theme.surface,
              pointBorderWidth: 2,
              pointRadius: 3,
              borderWidth: 2,
            },
            {
              label: 'Sanciones saldadas',
              data: chartsData.sancionesSaldadas.data,
              fill: false,
              borderColor: '#28b6d8',
              backgroundColor: 'rgba(40, 182, 216, 0.18)',
              tension: 0.35,
              pointBackgroundColor: '#28b6d8',
              pointBorderColor: theme.surface,
              pointBorderWidth: 2,
              pointRadius: 3,
              borderWidth: 2,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: theme.text }, display: true },
          },
          scales: {
            x: {
              ticks: { color: theme.muted },
              grid: { color: theme.grid },
            },
            y: {
              ticks: {
                color: theme.muted,
                stepSize: 1,
                callback: function(value) {
                  return Number.isInteger(value) ? value : '';
                },
              },
              beginAtZero: true,
              grid: { color: theme.grid },
            },
          },
        },
      });
      return;
    }

    const data = chartsData[tipo] || { labels: [], data: [] };
    const visual = chartVisualConfig[tipo] || chartVisualConfig.sancionesActivas;
    chartInstance = new Chart(ctx, {
      type: 'line',
      data: {
        labels: data.labels,
        datasets: [
          {
            label: config.title,
            data: data.data,
            fill: true,
            borderColor: visual.color,
            backgroundColor: visual.backgroundColor,
            tension: 0.35,
            pointBackgroundColor: visual.color,
            pointBorderColor: theme.surface,
            pointBorderWidth: 2,
            pointRadius: 3,
            borderWidth: 2.5,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { labels: { color: theme.text } },
        },
        scales: {
          x: {
            ticks: { color: theme.muted },
            grid: { color: theme.grid },
          },
          y: {
            ticks: {
              color: theme.muted,
              stepSize: 1,
              callback: function(value) {
                return Number.isInteger(value) ? value : '';
              },
            },
            beginAtZero: true,
            grid: { color: theme.grid },
          },
        },
      },
    });
  }

  function cambiarGrafico() {
    detailEnabled = false;
    renderChart(document.getElementById('tipoGrafico').value, { renderDetail: false });
  }

  document.addEventListener('DOMContentLoaded', function() {
    const emailEditorForm = document.getElementById('dashboardEmailEditorForm');
    const emailRoleSelect = document.getElementById('dashboardEmailEditorRole');
    const emailInput = document.getElementById('dashboardEmailEditorInput');
    const emailConfirmCheckbox = document.getElementById('dashboardEmailConfirmCheckbox');

    if (emailRoleSelect) {
      emailRoleSelect.addEventListener('change', function() {
        updateDashboardEmailConfirmSummary();
      });
    }

    if (emailInput) {
      emailInput.addEventListener('input', function() {
        updateDashboardEmailConfirmSummary();
      });
    }

    if (emailConfirmCheckbox) {
      emailConfirmCheckbox.addEventListener('change', function() {
        syncDashboardEmailSaveState();
      });
    }

    if (emailEditorForm) {
      emailEditorForm.addEventListener('submit', async function(event) {
        event.preventDefault();
        await actualizarCorreoUsuarioDesdeDashboard();
      });
    }

    const emailModalElement = document.getElementById('dashboardEmailEditorModal');
    if (emailModalElement) {
      emailModalElement.addEventListener('hidden.bs.modal', function() {
        dashboardEmailEditContext = null;
        const modalFeedback = document.getElementById('dashboardEmailModalFeedback');
        if (modalFeedback) {
          modalFeedback.classList.add('d-none');
          modalFeedback.textContent = '';
        }
        const saveButton = document.getElementById('dashboardEmailEditorSaveButton');
        if (saveButton) {
          saveButton.disabled = false;
          saveButton.textContent = 'Guardar y enrolar';
        }
        const confirmCheckbox = document.getElementById('dashboardEmailConfirmCheckbox');
        if (confirmCheckbox) {
          confirmCheckbox.checked = false;
        }
        updateDashboardEmailConfirmSummary();
        syncDashboardEmailSaveState();
      });
    }

    const usuariosFilter = document.getElementById('dashboardUsuariosFiltro');
    if (usuariosFilter) {
      usuariosFilter.addEventListener('change', function(event) {
        const selected = String(event.target.value || 'registrados');
        usuariosDashboardFilter = selected === 'placeholder' ? 'placeholder' : 'registrados';
        if (detailEnabled && currentChartType === 'usuariosRegistrados') {
          renderDetailTable('usuariosRegistrados');
        }
      });
    }

    const detailBody = document.getElementById('dashboardDetailTableBody');
    if (detailBody) {
      detailBody.addEventListener('click', async function(event) {
        const button = event.target.closest('[data-dashboard-action]');
        if (!button) return;

        const action = button.getAttribute('data-dashboard-action');
        const rowIndex = Number(button.getAttribute('data-row-index'));
        if (!Number.isInteger(rowIndex)) return;

        if (action === 'editar-correo') {
          openDashboardEmailEditorModal(rowIndex);
          return;
        }

        if (action === 'impersonar') {
          await impersonarUsuarioDesdeDashboard(rowIndex, button);
        }
      });
    }

    document.querySelectorAll('.dashboard-stat-card').forEach((card) => {
      card.addEventListener('click', function() {
        const chartTarget = card.dataset.chartTarget;
        detailEnabled = true;
        document.getElementById('tipoGrafico').value = chartTarget;
        renderChart(chartTarget, { renderDetail: true });
      });
    });

    resetDetailPanel();
    renderChart(currentChartType, { renderDetail: false });

    const themeObserver = new MutationObserver(function() {
      renderChart(currentChartType, { renderDetail: detailEnabled });
    });

    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-bs-theme'],
    });
  });
</script>

