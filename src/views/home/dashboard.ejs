<script nonce="<%= cspNonce %>">
  function escapeHtml(value) {
    if (value === null || value === undefined) return '';
    const str = String(value);
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatDate(value) {
    if (!value) return '';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return escapeHtml(value);
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    const hh = String(d.getHours()).padStart(2, '0');
    const mi = String(d.getMinutes()).padStart(2, '0');
    return `${yyyy}-${mm}-${dd} ${hh}:${mi}`;
  }

  function formatNumber(value) {
    if (value === null || value === undefined || value === '') return '';
    const num = Number(value);
    if (Number.isNaN(num)) return escapeHtml(value);
    return num.toLocaleString();
  }

  function renderList(value) {
    if (!value) return '';
    let arr = [];
    if (Array.isArray(value)) arr = value;
    else if (typeof value === 'string') arr = value.split(',').map((s) => s.trim()).filter(Boolean);
    if (!arr.length) return '<span class="text-muted">—</span>';
    return arr
      .filter((x) => x !== null && x !== undefined && x !== '')
      .map((x) => `<span class="badge text-bg-light border me-1 mb-1">${escapeHtml(x)}</span>`)
      .join('');
  }

  function renderEstadoBadge(value) {
    const raw = String(value || '').trim();
    if (!raw) return '<span class="text-muted">—</span>';
    const upper = raw.toUpperCase();
    let cls = 'text-bg-light border';
    if (
      upper === 'ACTIVA' ||
      upper === 'ACTIVO' ||
      upper === 'EN MORA' ||
      upper === 'PENDIENTE'
    ) {
      cls = 'text-bg-danger';
    } else if (upper === 'SALDADA' || upper === 'SALDADO' || upper === 'NORMALIZADO') {
      cls = 'text-bg-success';
    } else if (upper === 'INACTIVO' || upper === 'INACTIVA') {
      cls = 'text-bg-secondary';
    } else if (upper.startsWith('BLOQUEAD')) {
      cls = 'text-bg-dark';
    }
    return `<span class="badge ${cls}">${escapeHtml(raw)}</span>`;
  }

  function isActiveFlag(value) {
    if (value === true) return true;
    if (value === false) return false;
    if (typeof value === 'number') return value === 1;

    const normalized = String(value || '')
      .trim()
      .toLowerCase();
    return ['1', 'true', 'yes', 'on', 'si', 'sí', 'activo', 'activa'].includes(normalized);
  }

  function renderBooleanBadge(value) {
    return isActiveFlag(value)
      ? '<span class="badge text-bg-success">Activo</span>'
      : '<span class="badge text-bg-secondary">Inactivo</span>';
  }

  function normalizeFilterValue(value) {
    if (value === null || value === undefined) return '';
    if (Array.isArray(value)) {
      return value.map((item) => String(item || '').trim().toLowerCase()).join(' | ');
    }
    return String(value).trim().toLowerCase();
  }

  function safeFormatCell(def, value) {
    if (def && typeof def.format === 'function') {
      try {
        return def.format(value);
      } catch (e) {
        return escapeHtml(value == null ? '' : value);
      }
    }
    return escapeHtml(value == null ? '' : value);
  }

  function renderCollapsibleCell(value, maxLength) {
    const rawValue = String(value ?? '').trim();
    const normalizedMaxLength = Number.isInteger(maxLength) && maxLength > 0 ? maxLength : 120;

    if (!rawValue) {
      return '<span class="text-muted">—</span>';
    }

    if (rawValue.length <= normalizedMaxLength) {
      return escapeHtml(rawValue);
    }

    return `
      <span class="app-labs-cell-text is-collapsed" data-labs-text="true">${escapeHtml(rawValue)}</span>
      <button
        type="button"
        class="app-labs-toggle"
        data-labs-toggle="true"
        aria-expanded="false"
      >Ver más</button>
    `;
  }

  function renderUsuariosAdminActions(row) {
    const rowId = Number(row?.id);
    if (!Number.isInteger(rowId) || rowId <= 0) {
      return '<span class="text-muted">—</span>';
    }

    const usuarioActivo = isActiveFlag(row?.activo);
    const actions = [
      { action: 'editar-usuario', label: 'Editar usuario', icon: 'bi-person-gear', tone: 'primary' },
      { action: 'editar-correo', label: 'Editar correo', icon: 'bi-envelope', tone: 'secondary' },
      usuarioActivo
        ? { action: 'toggle-activo', label: 'Inactivar usuario', icon: 'bi-person-dash', tone: 'danger' }
        : { action: 'toggle-activo', label: 'Activar usuario', icon: 'bi-person-check', tone: 'success' },
      { action: 'impersonar', label: 'Impersonar usuario', icon: 'bi-incognito', tone: 'info' },
    ];

    const buttons = actions
      .map(
        (item) =>
          `<button type="button" class="app-grid-action" data-grid-action-tone="${item.tone}" data-dashboard-action="${item.action}" data-row-id="${rowId}" title="${item.label}" aria-label="${item.label}"><i class="bi ${item.icon} app-grid-action-icon" aria-hidden="true"></i></button>`
      )
      .join('');

    return `<div class="app-grid-actions dashboard-row-actions">${buttons}</div>`;
  }

  function getUsuariosFilterWrapElement() {
    return document.getElementById('dashboardUsuariosFilterWrap');
  }

  function getUsuariosColumnFilterWrapElement() {
    return document.getElementById('dashboardUsuariosColumnFilterWrap');
  }

  function getDashboardFeedbackElement() {
    return document.getElementById('dashboardDetailFeedback');
  }

  function hideDashboardFeedback() {
    const feedback = getDashboardFeedbackElement();
    if (!feedback) return;
    feedback.className = 'alert d-none py-2';
    feedback.textContent = '';
  }

  function showDashboardFeedback(message, type = 'success') {
    const feedback = getDashboardFeedbackElement();
    if (!feedback) return;
    const tone = type === 'error' ? 'alert-danger' : type === 'warning' ? 'alert-warning' : 'alert-success';
    feedback.className = `alert ${tone} py-2`;
    feedback.textContent = message;
    feedback.classList.remove('d-none');
  }

  function inferEnrollmentTypeFromRow(row) {
    const hasCodigo = String(row?.codigo || '').trim() !== '';
    const hasCarrera = String(row?.carrera || '').trim() !== '';
    return hasCodigo || hasCarrera ? 'estudiante' : 'docente';
  }

  function openDashboardEmailEditorModal(rowId) {
    const row = getUsuarioDashboardRowById(rowId);
    if (!row || !Number.isInteger(Number(row.id)) || !window.bootstrap) return;

    dashboardEmailEditContext = {
      rowId: Number(row.id),
    };

    const nameInput = document.getElementById('dashboardEmailEditorName');
    const documentInput = document.getElementById('dashboardEmailEditorDocument');
    const currentInput = document.getElementById('dashboardEmailEditorCurrent');
    const emailInput = document.getElementById('dashboardEmailEditorInput');
    const roleSelect = document.getElementById('dashboardEmailEditorRole');
    const confirmCheckbox = document.getElementById('dashboardEmailConfirmCheckbox');
    const notifyCheckbox = document.getElementById('dashboardEmailNotifyUser');
    const modalFeedback = document.getElementById('dashboardEmailModalFeedback');

    if (modalFeedback) {
      modalFeedback.classList.add('d-none');
      modalFeedback.textContent = '';
    }

    if (nameInput) nameInput.value = String(row.nombre || '');
    if (documentInput) documentInput.value = String(row.documento || '');
    if (currentInput) currentInput.value = String(row.correo || '');
    if (emailInput) emailInput.value = String(row.correo || '');
    if (roleSelect) roleSelect.value = inferEnrollmentTypeFromRow(row);
    if (confirmCheckbox) confirmCheckbox.checked = false;
    if (notifyCheckbox) notifyCheckbox.checked = false;

    updateDashboardEmailConfirmSummary();
    syncDashboardEmailSaveState();

    const modalElement = document.getElementById('dashboardEmailEditorModal');
    const modal = window.bootstrap.Modal.getOrCreateInstance(modalElement);
    modal.show();
  }

  function updateDashboardEmailConfirmSummary() {
    const documentInput = document.getElementById('dashboardEmailEditorDocument');
    const emailInput = document.getElementById('dashboardEmailEditorInput');
    const roleSelect = document.getElementById('dashboardEmailEditorRole');
    const summaryDocument = document.getElementById('dashboardEmailConfirmDocument');
    const summaryCorreo = document.getElementById('dashboardEmailConfirmCorreo');
    const summaryRole = document.getElementById('dashboardEmailConfirmRole');

    if (summaryDocument) {
      summaryDocument.textContent = String(documentInput?.value || '-').trim() || '-';
    }

    if (summaryCorreo) {
      summaryCorreo.textContent = String(emailInput?.value || '-').trim() || '-';
    }

    if (summaryRole) {
      const roleValue = String(roleSelect?.value || '').trim().toLowerCase();
      summaryRole.textContent = roleValue === 'docente' ? 'Docente' : 'Estudiante';
    }
  }

  function syncDashboardEmailSaveState() {
    const saveButton = document.getElementById('dashboardEmailEditorSaveButton');
    const confirmCheckbox = document.getElementById('dashboardEmailConfirmCheckbox');
    if (!saveButton || !confirmCheckbox) return;

    if (!confirmCheckbox.checked) {
      saveButton.disabled = true;
      saveButton.textContent = 'Confirma para guardar';
      return;
    }

    saveButton.disabled = false;
    saveButton.textContent = 'Guardar y enrolar';
  }

  function setDashboardUserEditorFeedback(message, type = 'error') {
    const feedback = document.getElementById('dashboardUserEditorFeedback');
    if (!feedback) return;
    if (!message) {
      feedback.className = 'alert alert-danger d-none py-2';
      feedback.textContent = '';
      return;
    }
    const tone = type === 'warning' ? 'alert-warning' : type === 'info' ? 'alert-info' : 'alert-danger';
    feedback.className = `alert ${tone} py-2`;
    feedback.textContent = message;
  }

  function renderDashboardUserEditorCurrent(usuario) {
    document.querySelectorAll('#dashboardUserEditorCurrent [data-user-field]').forEach((element) => {
      const field = element.getAttribute('data-user-field');
      const value = String(usuario?.[field] ?? '').trim();
      element.textContent = value || '-';
    });
  }

  function renderDashboardUserEditorRecords(registros, message) {
    const body = document.getElementById('dashboardUserEditorRecords');
    if (!body) return;

    if (message) {
      body.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-3">${escapeHtml(message)}</td></tr>`;
      return;
    }

    const currentCodigo = String(dashboardUserEditContext?.usuario?.codigo || '').trim();
    body.innerHTML = registros
      .map((registro, index) => {
        const codigo = String(registro.codigo || '');
        const isCurrent = codigo === currentCodigo;
        const estado = String(registro.estado || '').trim();
        const isEgresado = estado.toUpperCase() === 'EGRESADO';
        const estadoBadgeClass = isEgresado ? 'text-bg-warning' : 'text-bg-light border';
        const inputId = `dashboardUserEditorRecord${index}`;
        return `
          <tr class="${isCurrent ? 'table-primary' : ''}">
            <td class="text-center">
              <input class="form-check-input" type="radio" name="dashboardUserEditorRecord" id="${inputId}" value="${escapeHtml(codigo)}" ${isCurrent ? 'checked' : ''}>
            </td>
            <td>
              <label for="${inputId}" class="mb-0 fw-semibold">${escapeHtml(codigo)}</label>
              ${isCurrent ? '<span class="badge text-bg-primary ms-1">Actual en MILab</span>' : ''}
            </td>
            <td>${escapeHtml(registro.nombre || '-')}</td>
            <td>${escapeHtml(registro.carrera || '-')}</td>
            <td>${estado ? `<span class="badge ${estadoBadgeClass}">${escapeHtml(estado)}</span>` : '<span class="text-muted">-</span>'}${isEgresado ? '<div class="small text-warning-emphasis mt-1">Con este estado no se generan certificados.</div>' : ''}</td>
          </tr>
        `;
      })
      .join('');
  }

  function getDashboardUserEditorSelectedCodigo() {
    const selected = document.querySelector('input[name="dashboardUserEditorRecord"]:checked');
    return selected ? String(selected.value || '').trim() : '';
  }

  function syncDashboardUserEditorSaveState() {
    const saveButton = document.getElementById('dashboardUserEditorSave');
    const confirmCheckbox = document.getElementById('dashboardUserEditorConfirm');
    if (!saveButton) return;
    const selectedCodigo = getDashboardUserEditorSelectedCodigo();
    const currentCodigo = String(dashboardUserEditContext?.usuario?.codigo || '').trim();
    const canSave =
      !dashboardUserEditContext?.loading &&
      !dashboardUserEditContext?.saving &&
      Boolean(selectedCodigo) &&
      Boolean(confirmCheckbox?.checked);

    saveButton.disabled = !canSave;
    saveButton.textContent = dashboardUserEditContext?.saving
      ? 'Guardando...'
      : selectedCodigo && selectedCodigo === currentCodigo
        ? 'Guardar (actualizar datos)'
        : 'Guardar';
  }

  async function loadDashboardUserOatiRecords() {
    if (!dashboardUserEditContext) return;
    const rowId = dashboardUserEditContext.rowId;
    const reloadButton = document.getElementById('dashboardUserEditorReload');
    const confirmCheckbox = document.getElementById('dashboardUserEditorConfirm');

    dashboardUserEditContext.loading = true;
    if (reloadButton) reloadButton.disabled = true;
    if (confirmCheckbox) confirmCheckbox.checked = false;
    setDashboardUserEditorFeedback('');
    renderDashboardUserEditorRecords([], 'Consultando OATI...');
    syncDashboardUserEditorSaveState();

    try {
      const response = await fetch(`/milab/api/dashboard/usuarios/${rowId}/oati-registros`, {
        headers: { Accept: 'application/json' },
      });
      const payload = await response.json().catch(() => ({}));
      if (dashboardUserEditContext?.rowId !== rowId) return;

      if (payload.usuario) {
        dashboardUserEditContext.usuario = payload.usuario;
        renderDashboardUserEditorCurrent(payload.usuario);
      }

      if (!response.ok || !payload.ok) {
        setDashboardUserEditorFeedback(payload.message || 'No fue posible consultar OATI.');
        renderDashboardUserEditorRecords([], 'No hay registros para mostrar.');
        return;
      }

      const registros = Array.isArray(payload.registros) ? payload.registros : [];
      if (!registros.length) {
        setDashboardUserEditorFeedback('OATI no devolvió registros de estudiante para este documento.', 'warning');
        renderDashboardUserEditorRecords([], 'Sin registros en OATI.');
        return;
      }

      renderDashboardUserEditorRecords(registros);
    } catch {
      if (dashboardUserEditContext?.rowId !== rowId) return;
      setDashboardUserEditorFeedback('No fue posible consultar OATI. Verifica la conexión e inténtalo nuevamente.');
      renderDashboardUserEditorRecords([], 'No hay registros para mostrar.');
    } finally {
      if (dashboardUserEditContext?.rowId === rowId) {
        dashboardUserEditContext.loading = false;
        if (reloadButton) reloadButton.disabled = false;
        syncDashboardUserEditorSaveState();
      }
    }
  }

  function openDashboardUserEditorModal(rowId) {
    const row = getUsuarioDashboardRowById(rowId);
    if (!row || !Number.isInteger(Number(row.id)) || !window.bootstrap) return;

    dashboardUserEditContext = { rowId: Number(row.id), usuario: row, loading: false, saving: false };
    renderDashboardUserEditorCurrent(row);

    const modalElement = document.getElementById('dashboardUserEditorModal');
    window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
    loadDashboardUserOatiRecords();
  }

  function syncUsuariosRowsAfterUserUpdate(usuario) {
    const rowId = Number(usuario?.id);
    [tablesData.usuariosRegistrados, tablesData.usuariosPlaceholder].forEach((rows) => {
      if (!Array.isArray(rows)) return;
      const row = rows.find((item) => Number(item?.id) === rowId);
      if (!row) return;
      ['nombre', 'codigo', 'carrera', 'estado'].forEach((field) => {
        row[field] = usuario[field];
      });
    });
  }

  async function guardarRegistroOatiUsuarioDesdeDashboard() {
    if (!dashboardUserEditContext) return;
    const rowId = dashboardUserEditContext.rowId;
    const codigo = getDashboardUserEditorSelectedCodigo();
    const confirmCheckbox = document.getElementById('dashboardUserEditorConfirm');

    if (!codigo) {
      setDashboardUserEditorFeedback('Debes seleccionar un registro de OATI.');
      return;
    }

    if (!confirmCheckbox?.checked) {
      setDashboardUserEditorFeedback('Debes confirmar la asociación para continuar.');
      return;
    }

    dashboardUserEditContext.saving = true;
    setDashboardUserEditorFeedback('');
    syncDashboardUserEditorSaveState();

    try {
      const response = await fetch(`/milab/api/dashboard/usuarios/${rowId}/oati-registro`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          Accept: 'application/json',
        },
        body: JSON.stringify({ codigo }),
      });
      const payload = await response.json().catch(() => ({}));

      if (!response.ok || !payload.ok) {
        setDashboardUserEditorFeedback(payload.message || 'No fue posible guardar el registro seleccionado.');
        return;
      }

      syncUsuariosRowsAfterUserUpdate(payload.usuario);
      renderDetailTable('usuariosRegistrados');

      const modalElement = document.getElementById('dashboardUserEditorModal');
      window.bootstrap?.Modal.getOrCreateInstance(modalElement)?.hide();
      showDashboardFeedback(
        `Usuario actualizado: quedó asociado al código ${payload.usuario?.codigo || codigo} (${payload.usuario?.estado || 'sin estado'}).`,
        'success'
      );
    } catch {
      setDashboardUserEditorFeedback('No fue posible guardar el registro. Verifica la conexión e inténtalo nuevamente.');
    } finally {
      if (dashboardUserEditContext?.rowId === rowId) {
        dashboardUserEditContext.saving = false;
        syncDashboardUserEditorSaveState();
      }
    }
  }

  function isNoEmailPlaceholderCorreo(correo) {
    const normalized = String(correo || '').trim().toLowerCase();
    if (!normalized) return true;
    return normalized.includes('no-email') || normalized.endsWith('@placeholder.milab.local');
  }

  function getCurrentUsuariosRegistradosRows() {
    const registrados = Array.isArray(tablesData.usuariosRegistrados)
      ? tablesData.usuariosRegistrados
      : [];

    if (!canAdminManageUsuarios) {
      return registrados;
    }

    const placeholders = Array.isArray(tablesData.usuariosPlaceholder)
      ? tablesData.usuariosPlaceholder
      : [];

    return usuariosDashboardFilter === 'placeholder' ? placeholders : registrados;
  }

  function getUsuarioDashboardRowById(rowId) {
    const rows = getCurrentUsuariosRegistradosRows();
    return rows.find((row) => Number(row?.id) === Number(rowId)) || null;
  }

  function syncUsuariosRowsAfterActiveUpdate(rowId, activo) {
    const normalizedActivo = Boolean(activo);
    const targets = [tablesData.usuariosRegistrados, tablesData.usuariosPlaceholder];

    targets.forEach((rows) => {
      if (!Array.isArray(rows)) return;

      const row = rows.find((item) => Number(item?.id) === Number(rowId));
      if (!row) return;
      row.activo = normalizedActivo;
    });
  }

  function populateUsuariosColumnFilterOptions(columns) {
    const select = document.getElementById('dashboardUsuariosFiltroColumna');
    if (!select) return;

    const filterableColumns = (columns || []).filter((column) =>
      column && typeof column.key === 'string' && column.key && !column.key.startsWith('__')
    );

    const currentValue = String(usuariosColumnFilter.column || '__all');
    const options = ['<option value="__all">Todas las columnas</option>'];

    filterableColumns.forEach((column) => {
      options.push(
        `<option value="${escapeHtml(column.key)}">${escapeHtml(column.label || column.key)}</option>`
      );
    });

    select.innerHTML = options.join('');

    const hasCurrentColumn = filterableColumns.some((column) => column.key === currentValue);
    const selectedValue = currentValue === '__all' || hasCurrentColumn ? currentValue : '__all';
    usuariosColumnFilter.column = selectedValue;
    select.value = selectedValue;
  }

  function matchCellWithFilter(cellValue, filterValue) {
    const normalizedFilter = String(filterValue || '').trim().toLowerCase();
    if (!normalizedFilter) return true;

    if (['activo', 'activa'].includes(normalizedFilter)) {
      return isActiveFlag(cellValue);
    }

    if (['inactivo', 'inactiva'].includes(normalizedFilter)) {
      return !isActiveFlag(cellValue);
    }

    return normalizeFilterValue(cellValue) === normalizedFilter;
  }

  function applyUsuariosColumnFilter(rows, columns) {
    const normalizedFilterValue = String(usuariosColumnFilter.value || '').trim().toLowerCase();
    if (!normalizedFilterValue) {
      return rows;
    }

    const selectedColumn = String(usuariosColumnFilter.column || '__all');
    const filterableColumns = (columns || []).filter((column) =>
      column && typeof column.key === 'string' && column.key && !column.key.startsWith('__')
    );

    const keys =
      selectedColumn !== '__all'
        ? [selectedColumn]
        : filterableColumns.map((column) => column.key);

    if (!keys.length) {
      return rows;
    }

    return rows.filter((row) =>
      keys.some((key) => matchCellWithFilter(row?.[key], normalizedFilterValue))
    );
  }

  function syncUsuariosRowsAfterEmailUpdate(rowId, correo) {
    const registrados = Array.isArray(tablesData.usuariosRegistrados)
      ? tablesData.usuariosRegistrados
      : [];
    const placeholders = Array.isArray(tablesData.usuariosPlaceholder)
      ? tablesData.usuariosPlaceholder
      : [];

    const registeredIndex = registrados.findIndex((row) => Number(row?.id) === Number(rowId));
    const placeholderIndex = placeholders.findIndex((row) => Number(row?.id) === Number(rowId));
    const isPlaceholder = isNoEmailPlaceholderCorreo(correo);

    if (registeredIndex >= 0) {
      registrados[registeredIndex].correo = correo;
    }

    if (placeholderIndex >= 0) {
      placeholders[placeholderIndex].correo = correo;
    }

    if (!isPlaceholder && placeholderIndex >= 0) {
      const [row] = placeholders.splice(placeholderIndex, 1);
      if (row && registeredIndex < 0) {
        registrados.unshift(row);
      }
    }

    if (isPlaceholder && registeredIndex >= 0) {
      const [row] = registrados.splice(registeredIndex, 1);
      if (row && placeholderIndex < 0) {
        placeholders.unshift(row);
      }
    }
  }

  async function actualizarCorreoUsuarioDesdeDashboard() {
    if (!dashboardEmailEditContext || !Number.isInteger(dashboardEmailEditContext.rowId)) {
      showDashboardFeedback('No encontramos la cuenta seleccionada para editar.', 'error');
      return;
    }

    const emailInput = document.getElementById('dashboardEmailEditorInput');
    const roleSelect = document.getElementById('dashboardEmailEditorRole');
    const saveButton = document.getElementById('dashboardEmailEditorSaveButton');
    const confirmCheckbox = document.getElementById('dashboardEmailConfirmCheckbox');
    const notifyCheckbox = document.getElementById('dashboardEmailNotifyUser');
    const modalFeedback = document.getElementById('dashboardEmailModalFeedback');
    const normalizedCorreo = String(emailInput?.value || '').trim().toLowerCase();
    const tipoUsuario = String(roleSelect?.value || '').trim().toLowerCase();

    if (!normalizedCorreo || !normalizedCorreo.endsWith('@udistrital.edu.co')) {
      if (modalFeedback) {
        modalFeedback.textContent = 'Debes ingresar un correo institucional valido (@udistrital.edu.co).';
        modalFeedback.classList.remove('d-none');
      }
      return;
    }

    if (!['estudiante', 'docente'].includes(tipoUsuario)) {
      if (modalFeedback) {
        modalFeedback.textContent = 'Debes seleccionar si el enrolamiento será como estudiante o docente.';
        modalFeedback.classList.remove('d-none');
      }
      return;
    }

    if (!confirmCheckbox?.checked) {
      if (modalFeedback) {
        modalFeedback.textContent =
          'Debes confirmar el resumen para continuar con la edición y enrolamiento.';
        modalFeedback.classList.remove('d-none');
      }
      syncDashboardEmailSaveState();
      return;
    }

    try {
      window.MiLabSubmitLock.lock(saveButton, 'Realizando acción en dashboard...');
      const response = await fetch(
        `/milab/api/dashboard/usuarios/${dashboardEmailEditContext.rowId}/correo`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
            Accept: 'application/json',
          },
          body: JSON.stringify({
            correo: normalizedCorreo,
            tipoUsuario,
            notificarUsuario: Boolean(notifyCheckbox?.checked),
          }),
        }
      );

      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.ok) {
        if (modalFeedback) {
          modalFeedback.textContent = payload.message || 'No fue posible actualizar el correo.';
          modalFeedback.classList.remove('d-none');
        }
        return;
      }

      syncUsuariosRowsAfterEmailUpdate(dashboardEmailEditContext.rowId, payload.correo);
      renderDetailTable('usuariosRegistrados');

      const modalElement = document.getElementById('dashboardEmailEditorModal');
      const modal = window.bootstrap?.Modal.getOrCreateInstance(modalElement);
      modal?.hide();

      const notificationStatus = payload.notificacion?.status;
      const feedbackMessage =
        notificationStatus === 'SENT'
          ? `Cuenta actualizada y enrolada como ${tipoUsuario}. Se envió la notificación al nuevo correo.`
          : notificationStatus === 'FAILED'
            ? `Cuenta actualizada y enrolada como ${tipoUsuario}, pero no se pudo enviar la notificación.`
            : `Cuenta actualizada y enrolada como ${tipoUsuario}. Ya puede intentar ingresar con Microsoft.`;
      showDashboardFeedback(
        feedbackMessage,
        notificationStatus === 'FAILED' ? 'warning' : 'success'
      );
    } catch {
      if (modalFeedback) {
        modalFeedback.textContent =
          'No fue posible actualizar el correo. Verifica la conexión e inténtalo nuevamente.';
        modalFeedback.classList.remove('d-none');
      }
    }
  }

  async function toggleUsuarioActivoDesdeDashboard(rowId) {
    const row = getUsuarioDashboardRowById(rowId);
    if (!row || !Number.isInteger(Number(row.id))) return;

    hideDashboardFeedback();

    const nextActivo = !isActiveFlag(row.activo);
    const response = await fetch(`/milab/api/dashboard/usuarios/${Number(row.id)}/activo`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken,
        Accept: 'application/json',
      },
      body: JSON.stringify({ activo: nextActivo }),
    });

    const payload = await response.json().catch(() => ({}));
    if (!response.ok || !payload.ok) {
      showDashboardFeedback(
        payload.message || 'No fue posible actualizar el estado activo del usuario.',
        'error'
      );
      return;
    }

    syncUsuariosRowsAfterActiveUpdate(Number(row.id), Boolean(payload.activo));
    renderDetailTable('usuariosRegistrados');
    showDashboardFeedback(
      payload.activo
        ? 'Usuario activado correctamente. Ya puede autenticarse en la plataforma.'
        : 'Usuario inactivado correctamente. Su autenticación quedó bloqueada.',
      'success'
    );
  }

  async function impersonarUsuarioDesdeDashboard(rowId, btnElement) {
    const row = getUsuarioDashboardRowById(rowId);
    if (!row || !Number.isInteger(Number(row.id))) return;

    hideDashboardFeedback();

    window.MiLabSubmitLock.lock(btnElement, 'Realizando acción en dashboard...');
    try {
      const response = await fetch('/milab/api/dashboard/impersonacion/iniciar', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          Accept: 'application/json',
        },
        body: JSON.stringify({ usuarioId: Number(row.id) }),
      });

      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.ok) {
        showDashboardFeedback(payload.message || 'No fue posible impersonar la cuenta seleccionada.', 'error');
        window.MiLabSubmitLock.release(btnElement);
        return;
      }

      window.location.href = payload.redirect || '/milab/inicio';
    } catch (error) {
      console.error('Error iniciando impersonación:', error);
      showDashboardFeedback('No fue posible impersonar la cuenta seleccionada. Inténtalo nuevamente.', 'error');
      window.MiLabSubmitLock.release(btnElement);
    }
  }

  function renderDetailTable(tipo) {
    const headEl = document.getElementById('dashboardDetailTableHead');
    const bodyEl = document.getElementById('dashboardDetailTableBody');
    const titleEl = document.getElementById('dashboardDetailTitle');
    const hintEl = document.getElementById('dashboardDetailHint');
    const countEl = document.getElementById('dashboardDetailCount');
    const tableEl = document.getElementById('dashboardDetailTable');

    const columns = TABLE_COLUMN_DEFS[tipo];
    let rows = Array.isArray(tablesData[tipo]) ? tablesData[tipo] : [];
    const config = chartDefinitions[tipo];
    const usuariosFilterWrap = getUsuariosFilterWrapElement();

    if (usuariosFilterWrap) {
      const showUsuariosFilter = canAdminManageUsuarios && tipo === 'usuariosRegistrados';
      usuariosFilterWrap.classList.toggle('d-none', !showUsuariosFilter);
    }

    const usuariosColumnFilterWrap = getUsuariosColumnFilterWrapElement();
    if (usuariosColumnFilterWrap) {
      usuariosColumnFilterWrap.classList.toggle('d-none', tipo !== 'usuariosRegistrados');
    }

    if (tipo === 'usuariosRegistrados') {
      rows = getCurrentUsuariosRegistradosRows();
    }

    if (!columns || !config) {
      if (tableEl) {
        tableEl.classList.remove('table-coordinadores');
      }
      if (headEl) headEl.innerHTML = '<th>Selecciona una tarjeta superior para ver el detalle.</th>';
      if (bodyEl) {
        bodyEl.innerHTML =
          '<tr><td class="text-center py-4 text-muted">Selecciona una tarjeta superior para ver el detalle.</td></tr>';
      }
      return;
    }

    if (tableEl) {
      tableEl.classList.toggle('table-coordinadores', tipo === 'coordinadores');
    }

    titleEl.textContent = `Detalle - ${config.cardLabel || config.optionLabel || tipo}`;
    hintEl.textContent =
      config.summary ||
      'Registros que componen el total mostrado en la tarjeta. Se presenta el detalle paginado y buscable.';
    const detailMeta = tablesMeta[tipo];
    const isTruncated = detailMeta && detailMeta.total > detailMeta.shown;
    countEl.textContent = isTruncated
      ? `Últimos ${detailMeta.shown.toLocaleString()} de ${detailMeta.total.toLocaleString()} registros`
      : `${rows.length.toLocaleString()} registro${rows.length === 1 ? '' : 's'}`;

    const shouldRenderAdminActions = canAdminManageUsuarios && tipo === 'usuariosRegistrados';
    const resolvedColumns = shouldRenderAdminActions
      ? [...columns, { key: '__acciones_admin', label: 'Acciones' }]
      : columns;

    if (tipo === 'usuariosRegistrados') {
      populateUsuariosColumnFilterOptions(resolvedColumns);
      rows = applyUsuariosColumnFilter(rows, resolvedColumns);
    }

    headEl.innerHTML = resolvedColumns
      .map((col) =>
        col.key === '__acciones_admin'
          ? `<th scope="col" class="app-grid-actions-heading dashboard-actions-cell">${escapeHtml(col.label)}</th>`
          : `<th scope="col">${escapeHtml(col.label)}</th>`
      )
      .join('');

    if (!rows.length) {
      bodyEl.innerHTML = `<tr><td colspan="${resolvedColumns.length}" class="text-center py-4 text-muted">No hay registros para este indicador en el alcance actual.</td></tr>`;
      return;
    }

    bodyEl.innerHTML = rows
      .map((row) => {
        const cells = resolvedColumns
          .map((col) => {
            if (col.key === '__acciones_admin') {
              return `<td class="app-grid-actions-cell dashboard-actions-cell">${renderUsuariosAdminActions(row)}</td>`;
            }

            if (tipo === 'coordinadores' && col.key === 'soporte_resolucion') {
              return `<td>${renderCollapsibleCell(row[col.key], 100)}</td>`;
            }

            return `<td>${safeFormatCell(col, row[col.key])}</td>`;
          })
          .join('');
        return `<tr>${cells}</tr>`;
      })
      .join('');
  }

  function resetDetailPanel() {
    const headEl = document.getElementById('dashboardDetailTableHead');
    const bodyEl = document.getElementById('dashboardDetailTableBody');
    const titleEl = document.getElementById('dashboardDetailTitle');
    const hintEl = document.getElementById('dashboardDetailHint');
    const countEl = document.getElementById('dashboardDetailCount');
    const tableEl = document.getElementById('dashboardDetailTable');

    if (tableEl) {
      tableEl.classList.remove('table-coordinadores');
    }

    if (titleEl) {
      titleEl.textContent = 'Detalle';
    }

    if (hintEl) {
      hintEl.textContent = 'Selecciona una tarjeta superior para ver el detalle de sus registros.';
    }

    if (countEl) {
      countEl.textContent = '0 registros';
    }

    hideDashboardFeedback();

    const usuariosFilterWrap = getUsuariosFilterWrapElement();
    if (usuariosFilterWrap) {
      usuariosFilterWrap.classList.add('d-none');
    }

    const usuariosColumnFilterWrap = getUsuariosColumnFilterWrapElement();
    if (usuariosColumnFilterWrap) {
      usuariosColumnFilterWrap.classList.add('d-none');
    }

    if (headEl) {
      headEl.innerHTML = '<th>Selecciona una tarjeta superior para ver el detalle.</th>';
    }

    if (bodyEl) {
      bodyEl.innerHTML =
        '<tr><td class="text-center py-4 text-muted">Selecciona una tarjeta superior para cargar el detalle.</td></tr>';
    }
  }

  let chartInstance = null;
  let currentChartType = <%- JSON.stringify(selectedChart) %>;
  let detailEnabled = false;

  const GEN_COLORS = {
    blue: '#1f7aec',
    green: '#219653',
    amber: '#e08a00',
    red: '#d62839',
    teal: '#0f9fb5',
    purple: '#7b4fd6',
    slate: '#5e7178',
    orange: '#f2700d',
    pink: '#d6409f',
  };
  const GEN_SERIES_COLORS = [
    GEN_COLORS.blue,
    GEN_COLORS.amber,
    GEN_COLORS.purple,
    GEN_COLORS.teal,
    GEN_COLORS.pink,
    GEN_COLORS.green,
    GEN_COLORS.orange,
    GEN_COLORS.slate,
  ];
  const chartVisualConfig = {
    estudiantes: { color: GEN_COLORS.blue },
    docentes: { color: GEN_COLORS.green },
    laboratoristas: { color: GEN_COLORS.purple },
    coordinadores: { color: GEN_COLORS.slate },
    usuariosRegistrados: { color: GEN_COLORS.orange },
  };

  function hexToRgba(hex, alpha) {
    const value = String(hex || '').replace('#', '');
    const r = parseInt(value.slice(0, 2), 16);
    const g = parseInt(value.slice(2, 4), 16);
    const b = parseInt(value.slice(4, 6), 16);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }

  function buildAreaGradient(color) {
    return function(context) {
      const { chart } = context;
      const area = chart.chartArea;
      if (!area) return hexToRgba(color, 0.15);
      const gradient = chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
      gradient.addColorStop(0, hexToRgba(color, 0.32));
      gradient.addColorStop(1, hexToRgba(color, 0.02));
      return gradient;
    };
  }

  function getChartTheme() {
    const styles = getComputedStyle(document.documentElement);
    return {
      text: styles.getPropertyValue('--app-text-main').trim() || '#171717',
      muted: styles.getPropertyValue('--app-text-muted').trim() || '#5f5a53',
      grid: styles.getPropertyValue('--app-chart-grid').trim() || 'rgba(23, 23, 23, 0.1)',
      surface: styles.getPropertyValue('--app-surface-strong').trim() || '#fffaf3',
    };
  }

  function getTotal(tipo) {
    if (!chartsData[tipo]) {
      return 0;
    }

    return chartsData[tipo].data.reduce((sum, val) => sum + Number(val || 0), 0);
  }

  function updateSummary(tipo, options = {}) {
    const shouldRenderDetail = options.renderDetail === true;
    const config = chartDefinitions[tipo];
    if (!config) {
      return;
    }

    document.getElementById('tituloGrafico').textContent = config.title;
    document.getElementById('dashboardChartHint').textContent = config.summary;
    document.getElementById('dashboardChartTotal').textContent = getTotal(tipo).toLocaleString();

    document.querySelectorAll('.dashboard-kpi-card').forEach((card) => {
      const isActive = card.dataset.chartTarget === tipo;
      card.classList.toggle('is-active', isActive);
      card.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });

    try {
      if (shouldRenderDetail) {
        renderDetailTable(tipo);
        const panel = document.getElementById('dashboardDetailPanel');
        if (panel && typeof panel.scrollIntoView === 'function') {
          panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      } else {
        resetDetailPanel();
      }
    } catch (e) {
      // table rendering failures must not break chart updates
      console.warn('Dashboard detail table render failed:', e);
    }
  }

  function syncChartSelection(tipo) {
    const chartSelect = document.getElementById('tipoGrafico');
    const hiddenChartInput = document.getElementById('dashboardSelectedChart');

    if (chartSelect && chartSelect.value !== tipo) {
      chartSelect.value = tipo;
    }

    if (hiddenChartInput) {
      hiddenChartInput.value = tipo;
    }

    const url = new URL(window.location.href);
    url.searchParams.set('grafico', tipo);
    window.history.replaceState({}, '', url);
  }

  function renderChart(tipo, options = {}) {
    currentChartType = tipo;
    syncChartSelection(tipo);
    const ctx = document.getElementById('chartDinamico');
    const config = chartDefinitions[tipo];
    const theme = getChartTheme();

    if (!config || !ctx) {
      return;
    }

    if (chartInstance) {
      chartInstance.destroy();
    }

    updateSummary(tipo, options);

    const data = chartsData[tipo] || { labels: [], data: [] };
    const visual = chartVisualConfig[tipo] || { color: GEN_COLORS.blue };
    chartInstance = new Chart(ctx, {
      type: 'line',
      data: {
        labels: data.labels,
        datasets: [
          {
            label: config.title,
            data: data.data,
            fill: true,
            borderColor: visual.color,
            backgroundColor: buildAreaGradient(visual.color),
            tension: 0.35,
            pointBackgroundColor: visual.color,
            pointBorderColor: theme.surface,
            pointBorderWidth: 2,
            pointRadius: 3,
            borderWidth: 2.5,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { labels: { color: theme.text } },
        },
        scales: {
          x: {
            ticks: { color: theme.muted },
            grid: { color: theme.grid },
          },
          y: {
            ticks: {
              color: theme.muted,
              stepSize: 1,
              callback: function(value) {
                return Number.isInteger(value) ? value : '';
              },
            },
            beginAtZero: true,
            grid: { color: theme.grid },
          },
        },
      },
    });
  }

  function cambiarGrafico() {
    detailEnabled = false;
    renderChart(document.getElementById('tipoGrafico').value, { renderDetail: false });
  }

  const PYS_TONE_COLORS = { ok: '#219653', warn: '#e08a00', danger: '#d62839', info: '#1f7aec' };
  const PYS_RANKING_COLOR = '#1f7aec';
  const pazYSalvoCharts = [];
  let pazYSalvoChartsRendered = false;

  function truncatePysLabel(value, maxLength = 28) {
    const text = String(value || '');
    return text.length > maxLength ? `${text.slice(0, maxLength - 1)}…` : text;
  }

  function buildPysHorizontalBarConfig(labels, values, colors, theme) {
    return {
      type: 'bar',
      data: {
        labels: labels.map((label) => truncatePysLabel(label)),
        datasets: [
          {
            data: values,
            backgroundColor: colors,
            borderRadius: 6,
            maxBarThickness: 18,
          },
        ],
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { title: (items) => labels[items[0].dataIndex] } },
        },
        scales: {
          x: {
            beginAtZero: true,
            ticks: { precision: 0, color: theme.muted, font: { size: 11 } },
            grid: { color: theme.grid },
          },
          y: {
            ticks: { color: theme.text, font: { size: 11 } },
            grid: { display: false },
          },
        },
      },
    };
  }

  function buildPysDoughnutConfig(labels, values, colors, theme) {
    return {
      type: 'doughnut',
      data: {
        labels,
        datasets: [{ data: values, backgroundColor: colors, borderColor: theme.surface, borderWidth: 2 }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '62%',
        plugins: {
          legend: {
            position: 'right',
            labels: { color: theme.text, boxWidth: 10, boxHeight: 10, font: { size: 11 } },
          },
        },
      },
    };
  }

  function buildPysChartConfig(canvas, theme) {
    const data = pazYSalvoChartData;
    const kind = canvas.dataset.pysChart;

    if (kind === 'aging') {
      return buildPysHorizontalBarConfig(
        data.antiguedad.map((item) => item.label),
        data.antiguedad.map((item) => item.value),
        data.antiguedad.map((item) => PYS_TONE_COLORS[item.tone] || PYS_RANKING_COLOR),
        theme
      );
    }

    if (kind === 'ranking') {
      const group = data.rankingGroups[Number(canvas.dataset.pysGroup)];
      if (!group) return null;
      return buildPysHorizontalBarConfig(
        group.items.map((item) => item.nombre),
        group.items.map((item) => item.abiertas),
        PYS_RANKING_COLOR,
        theme
      );
    }

    if (kind === 'claims' && data.reclamaciones) {
      return buildPysDoughnutConfig(
        ['Sin respuesta', 'Procede', 'No procede'],
        [data.reclamaciones.pendientes, data.reclamaciones.procede, data.reclamaciones.noProcede],
        [PYS_TONE_COLORS.warn, PYS_TONE_COLORS.ok, PYS_TONE_COLORS.danger],
        theme
      );
    }

    if (kind === 'origin' && data.certificados) {
      return buildPysDoughnutConfig(
        data.certificados.origen.map((item) => item.label),
        data.certificados.origen.map((item) => item.value),
        data.certificados.origen.map((item) => PYS_TONE_COLORS[item.tone] || PYS_RANKING_COLOR),
        theme
      );
    }

    if (kind === 'reasons' && data.certificados) {
      return buildPysHorizontalBarConfig(
        data.certificados.motivos.map((item) => item.nombre),
        data.certificados.motivos.map((item) => item.total),
        PYS_TONE_COLORS.info,
        theme
      );
    }

    return null;
  }

  function renderPazYSalvoCharts() {
    if (!pazYSalvoChartData || typeof Chart === 'undefined') return;
    pazYSalvoCharts.splice(0).forEach((chart) => chart.destroy());
    const theme = getChartTheme();
    document.querySelectorAll('[data-pys-chart]').forEach((canvas) => {
      const config = buildPysChartConfig(canvas, theme);
      if (config) pazYSalvoCharts.push(new Chart(canvas, config));
    });
    pazYSalvoChartsRendered = true;
  }

  const GEN_USER_COLORS = {
    estudiantes: GEN_COLORS.blue,
    docentes: GEN_COLORS.green,
    laboratoristas: GEN_COLORS.purple,
    coordinadores: GEN_COLORS.slate,
  };
  const generalOverviewCharts = [];
  let generalOverviewChartsRendered = false;

  function buildGenActivityConfig(actividad, theme) {
    return {
      type: 'bar',
      data: {
        labels: actividad.labels,
        datasets: actividad.datasets.map((dataset) => {
          const color = GEN_USER_COLORS[dataset.key] || GEN_COLORS.slate;
          return {
            label: dataset.label,
            data: dataset.data,
            backgroundColor: hexToRgba(color, 0.85),
            hoverBackgroundColor: color,
            borderRadius: 5,
            maxBarThickness: 16,
          };
        }),
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: {
            position: 'top',
            align: 'end',
            labels: { color: theme.text, boxWidth: 10, boxHeight: 10, font: { size: 11 } },
          },
        },
        scales: {
          x: { ticks: { color: theme.muted, font: { size: 11 } }, grid: { display: false } },
          y: {
            beginAtZero: true,
            ticks: { precision: 0, color: theme.muted, font: { size: 11 } },
            grid: { color: theme.grid },
          },
        },
      },
    };
  }

  function buildGenPolarConfig(labels, values, colors, theme) {
    return {
      type: 'polarArea',
      data: {
        labels: labels.map((label) => truncatePysLabel(label, 24)),
        datasets: [
          {
            data: values,
            backgroundColor: colors.map((color) => hexToRgba(color, 0.72)),
            borderColor: theme.surface,
            borderWidth: 2,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'right',
            labels: { color: theme.text, boxWidth: 10, boxHeight: 10, font: { size: 11 } },
          },
          tooltip: { callbacks: { title: (items) => labels[items[0].dataIndex] } },
        },
        scales: {
          r: {
            beginAtZero: true,
            ticks: { display: false },
            grid: { color: theme.grid },
            angleLines: { color: theme.grid },
          },
        },
      },
    };
  }

  function buildGenGroupedHorizontalConfig(labels, datasets, theme, stacked, labelLength = 34) {
    return {
      type: 'bar',
      data: {
        labels: labels.map((label) => truncatePysLabel(label, labelLength)),
        datasets: datasets.map((dataset) => ({
          label: dataset.label,
          data: dataset.data,
          backgroundColor: hexToRgba(dataset.color, 0.85),
          hoverBackgroundColor: dataset.color,
          borderRadius: 5,
          maxBarThickness: 16,
        })),
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: {
            position: 'top',
            align: 'end',
            labels: { color: theme.text, boxWidth: 10, boxHeight: 10, font: { size: 11 } },
          },
          tooltip: { callbacks: { title: (items) => labels[items[0].dataIndex] } },
        },
        scales: {
          x: {
            stacked,
            beginAtZero: true,
            ticks: { precision: 0, color: theme.muted, font: { size: 11 } },
            grid: { color: theme.grid },
          },
          y: { stacked, ticks: { color: theme.text, font: { size: 11 } }, grid: { display: false } },
        },
      },
    };
  }

  function buildGenAreaConfig(labels, values, color, label, theme) {
    return {
      type: 'line',
      data: {
        labels,
        datasets: [
          {
            label,
            data: values,
            fill: true,
            borderColor: color,
            backgroundColor: buildAreaGradient(color),
            tension: 0.35,
            pointBackgroundColor: color,
            pointBorderColor: theme.surface,
            pointBorderWidth: 2,
            pointRadius: 3,
            borderWidth: 3,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { ticks: { color: theme.muted, font: { size: 11 } }, grid: { display: false } },
          y: {
            beginAtZero: true,
            ticks: { precision: 0, color: theme.muted, font: { size: 11 } },
            grid: { color: theme.grid },
          },
        },
      },
    };
  }

  function buildGenRadarConfig(labels, values, color, theme) {
    return {
      type: 'radar',
      data: {
        labels,
        datasets: [
          {
            label: 'Acciones',
            data: values,
            fill: true,
            backgroundColor: hexToRgba(color, 0.22),
            borderColor: color,
            pointBackgroundColor: color,
            pointBorderColor: theme.surface,
            borderWidth: 2,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          r: {
            beginAtZero: true,
            ticks: { display: false },
            grid: { color: theme.grid },
            angleLines: { color: theme.grid },
            pointLabels: { color: theme.text, font: { size: 11 } },
          },
        },
      },
    };
  }

  function buildGenCoverageChartConfig(kind, theme) {
    const cobertura = generalChartData.cobertura;
    const actividad = generalChartData.actividadLog;

    if (kind === 'coverage' && cobertura) {
      return buildGenGroupedHorizontalConfig(
        cobertura.facultades.map((item) => item.nombre),
        [
          {
            label: 'Con laboratorista',
            data: cobertura.facultades.map((item) => item.ualConLaboratorista),
            color: GEN_COLORS.green,
          },
          {
            label: 'Sin laboratorista',
            data: cobertura.facultades.map((item) => item.ualActivas - item.ualConLaboratorista),
            color: GEN_COLORS.red,
          },
        ],
        theme,
        true
      );
    }

    if (kind === 'coverageShare' && cobertura) {
      const totals = cobertura.totales;
      return buildPysDoughnutConfig(
        ['Con laboratorista', 'Sin laboratorista'],
        [totals.ualConLaboratorista, totals.ualActivas - totals.ualConLaboratorista],
        [GEN_COLORS.green, GEN_COLORS.red],
        theme
      );
    }

    if (kind === 'staff' && cobertura) {
      return buildGenGroupedHorizontalConfig(
        cobertura.facultades.map((item) => item.nombre),
        [
          {
            label: 'Laboratoristas',
            data: cobertura.facultades.map((item) => item.laboratoristas),
            color: GEN_COLORS.purple,
          },
          {
            label: 'Coordinadores',
            data: cobertura.facultades.map((item) => item.coordinadores),
            color: GEN_COLORS.teal,
          },
        ],
        theme,
        false,
        22
      );
    }

    if (kind === 'logMonthly' && actividad) {
      return buildGenAreaConfig(
        actividad.mensual.labels,
        actividad.mensual.data,
        GEN_COLORS.blue,
        'Acciones',
        theme
      );
    }

    if (kind === 'logActions' && actividad) {
      return buildPysHorizontalBarConfig(
        actividad.acciones.map((item) => item.nombre),
        actividad.acciones.map((item) => item.total),
        actividad.acciones.map((_, index) => GEN_SERIES_COLORS[index % GEN_SERIES_COLORS.length]),
        theme
      );
    }

    if (kind === 'logRoles' && actividad) {
      return buildPysDoughnutConfig(
        actividad.roles.map((item) => item.nombre),
        actividad.roles.map((item) => item.total),
        actividad.roles.map((_, index) => GEN_SERIES_COLORS[index % GEN_SERIES_COLORS.length]),
        theme
      );
    }

    if (kind === 'logWeekday' && actividad) {
      return buildGenRadarConfig(actividad.semana.labels, actividad.semana.data, GEN_COLORS.pink, theme);
    }

    if (kind === 'logActors' && actividad) {
      return buildPysHorizontalBarConfig(
        actividad.actores.map((item) => item.nombre),
        actividad.actores.map((item) => item.total),
        actividad.actores.map((_, index) => hexToRgba(GEN_COLORS.orange, Math.max(0.35, 0.95 - index * 0.08))),
        theme
      );
    }

    return null;
  }

  function buildGeneralChartConfig(canvas, theme) {
    const data = generalChartData;
    const kind = canvas.dataset.genChart;

    if (kind === 'activity') {
      return buildGenActivityConfig(data.actividad, theme);
    }

    if (kind === 'accountStates' && data.estadosCuenta) {
      return buildGenPolarConfig(
        data.estadosCuenta.map((item) => item.nombre),
        data.estadosCuenta.map((item) => item.total),
        data.estadosCuenta.map((_, index) => GEN_SERIES_COLORS[index % GEN_SERIES_COLORS.length]),
        theme
      );
    }

    if (kind === 'labStatus' && data.laboratoristasEstado) {
      return buildPysDoughnutConfig(
        data.laboratoristasEstado.map((item) => item.label),
        data.laboratoristasEstado.map((item) => item.value),
        [GEN_COLORS.purple, GEN_COLORS.slate],
        theme
      );
    }

    if (kind === 'programs' && data.programas) {
      return buildPysHorizontalBarConfig(
        data.programas.map((item) => item.nombre),
        data.programas.map((item) => item.total),
        data.programas.map((_, index) => hexToRgba(GEN_COLORS.blue, Math.max(0.35, 0.95 - index * 0.11))),
        theme
      );
    }

    if (kind === 'users' && data.usuarios) {
      const config = buildPysDoughnutConfig(
        data.usuarios.map((item) => item.label),
        data.usuarios.map((item) => item.value),
        data.usuarios.map((item) => GEN_USER_COLORS[item.key] || GEN_COLORS.slate),
        theme
      );
      config.type = 'pie';
      delete config.options.cutout;
      return config;
    }

    return buildGenCoverageChartConfig(kind, theme);
  }

  function renderGeneralOverviewCharts() {
    if (!generalChartData || typeof Chart === 'undefined') return;
    generalOverviewCharts.splice(0).forEach((chart) => chart.destroy());
    const theme = getChartTheme();
    document.querySelectorAll('[data-gen-chart]').forEach((canvas) => {
      const config = buildGeneralChartConfig(canvas, theme);
      if (config) generalOverviewCharts.push(new Chart(canvas, config));
    });
    generalOverviewChartsRendered = true;
  }

  function initDashboardSectionTabs() {
    const tabs = Array.from(document.querySelectorAll('[data-dashboard-section]'));
    if (!tabs.length) return;

    function activate(sectionId, { focus = false, updateHash = true } = {}) {
      const target = tabs.find((tab) => tab.dataset.dashboardSection === sectionId) || tabs[0];
      tabs.forEach((tab) => {
        const isActive = tab === target;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.tabIndex = isActive ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls'));
        if (panel) panel.hidden = !isActive;
      });
      if (focus) target.focus();
      if (updateHash) {
        const hash = target.dataset.dashboardSection === 'general' ? '' : `#${target.dataset.dashboardSection}`;
        history.replaceState(null, '', `${window.location.pathname}${window.location.search}${hash}`);
      }
      if (target.dataset.dashboardSection === 'general') {
        if (chartInstance) chartInstance.resize();
        if (!generalOverviewChartsRendered) renderGeneralOverviewCharts();
      }
      if (target.dataset.dashboardSection === 'paz-y-salvos' && !pazYSalvoChartsRendered) {
        renderPazYSalvoCharts();
      }
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab.dataset.dashboardSection));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        activate(tabs[nextIndex].dataset.dashboardSection, { focus: true });
      });
    });

    activate(window.location.hash.replace('#', '') || 'general', { updateHash: false });
  }

  document.addEventListener('DOMContentLoaded', function() {
    initDashboardSectionTabs();
    const emailEditorForm = document.getElementById('dashboardEmailEditorForm');
    const emailRoleSelect = document.getElementById('dashboardEmailEditorRole');
    const emailInput = document.getElementById('dashboardEmailEditorInput');
    const emailConfirmCheckbox = document.getElementById('dashboardEmailConfirmCheckbox');

    if (emailRoleSelect) {
      emailRoleSelect.addEventListener('change', function() {
        updateDashboardEmailConfirmSummary();
      });
    }

    if (emailInput) {
      emailInput.addEventListener('input', function() {
        updateDashboardEmailConfirmSummary();
      });
    }

    if (emailConfirmCheckbox) {
      emailConfirmCheckbox.addEventListener('change', function() {
        syncDashboardEmailSaveState();
      });
    }

    if (emailEditorForm) {
      emailEditorForm.addEventListener('submit', async function(event) {
        event.preventDefault();
        try {
          await actualizarCorreoUsuarioDesdeDashboard();
        } finally {
          window.MiLabSubmitLock.release(document.getElementById('dashboardEmailEditorSaveButton'));
          delete emailEditorForm.dataset.submitting;
          syncDashboardEmailSaveState();
        }
      });
    }

    const emailModalElement = document.getElementById('dashboardEmailEditorModal');
    if (emailModalElement) {
      emailModalElement.addEventListener('hidden.bs.modal', function() {
        dashboardEmailEditContext = null;
        const modalFeedback = document.getElementById('dashboardEmailModalFeedback');
        if (modalFeedback) {
          modalFeedback.classList.add('d-none');
          modalFeedback.textContent = '';
        }
        const saveButton = document.getElementById('dashboardEmailEditorSaveButton');
        if (saveButton) {
          saveButton.disabled = false;
          saveButton.textContent = 'Guardar y enrolar';
        }
        const confirmCheckbox = document.getElementById('dashboardEmailConfirmCheckbox');
        if (confirmCheckbox) {
          confirmCheckbox.checked = false;
        }
        updateDashboardEmailConfirmSummary();
        syncDashboardEmailSaveState();
      });
    }

    const usuariosFilter = document.getElementById('dashboardUsuariosFiltro');
    if (usuariosFilter) {
      usuariosFilter.addEventListener('change', function(event) {
        const selected = String(event.target.value || 'registrados');
        usuariosDashboardFilter = selected === 'placeholder' ? 'placeholder' : 'registrados';
        if (detailEnabled && currentChartType === 'usuariosRegistrados') {
          renderDetailTable('usuariosRegistrados');
        }
      });
    }

    const usuariosFilterColumn = document.getElementById('dashboardUsuariosFiltroColumna');
    if (usuariosFilterColumn) {
      usuariosFilterColumn.addEventListener('change', function(event) {
        usuariosColumnFilter.column = String(event.target.value || '__all');
        if (detailEnabled && currentChartType === 'usuariosRegistrados') {
          renderDetailTable('usuariosRegistrados');
        }
      });
    }

    const usuariosFilterValue = document.getElementById('dashboardUsuariosFiltroValor');
    if (usuariosFilterValue) {
      usuariosFilterValue.addEventListener('input', function(event) {
        usuariosColumnFilter.value = String(event.target.value || '');
        if (detailEnabled && currentChartType === 'usuariosRegistrados') {
          renderDetailTable('usuariosRegistrados');
        }
      });
    }

    const usuariosFilterClearButton = document.getElementById('dashboardUsuariosFiltroLimpiar');
    if (usuariosFilterClearButton) {
      usuariosFilterClearButton.addEventListener('click', function() {
        usuariosColumnFilter = { column: '__all', value: '' };
        if (usuariosFilterColumn) {
          usuariosFilterColumn.value = '__all';
        }
        if (usuariosFilterValue) {
          usuariosFilterValue.value = '';
        }
        if (detailEnabled && currentChartType === 'usuariosRegistrados') {
          renderDetailTable('usuariosRegistrados');
        }
      });
    }

    const detailBody = document.getElementById('dashboardDetailTableBody');
    const userEditorForm = document.getElementById('dashboardUserEditorForm');
    if (userEditorForm) {
      userEditorForm.addEventListener('submit', async function(event) {
        event.preventDefault();
        await guardarRegistroOatiUsuarioDesdeDashboard();
      });
      userEditorForm.addEventListener('change', function(event) {
        if (event.target?.name === 'dashboardUserEditorRecord') {
          const confirmCheckbox = document.getElementById('dashboardUserEditorConfirm');
          if (confirmCheckbox) confirmCheckbox.checked = false;
        }
        syncDashboardUserEditorSaveState();
      });
    }

    const userEditorReload = document.getElementById('dashboardUserEditorReload');
    if (userEditorReload) {
      userEditorReload.addEventListener('click', function() {
        loadDashboardUserOatiRecords();
      });
    }

    const userEditorModal = document.getElementById('dashboardUserEditorModal');
    if (userEditorModal) {
      userEditorModal.addEventListener('hidden.bs.modal', function() {
        dashboardUserEditContext = null;
        setDashboardUserEditorFeedback('');
        renderDashboardUserEditorRecords([], 'Sin consultar.');
        const confirmCheckbox = document.getElementById('dashboardUserEditorConfirm');
        if (confirmCheckbox) confirmCheckbox.checked = false;
        syncDashboardUserEditorSaveState();
      });
    }

    if (detailBody) {
      detailBody.addEventListener('click', async function(event) {
        const button = event.target.closest('[data-dashboard-action]');
        if (!button) return;

        const action = button.getAttribute('data-dashboard-action');
        const rowId = Number(button.getAttribute('data-row-id'));
        if (!Number.isInteger(rowId)) return;

        if (action === 'editar-usuario') {
          openDashboardUserEditorModal(rowId);
          return;
        }

        if (action === 'editar-correo') {
          openDashboardEmailEditorModal(rowId);
          return;
        }

        if (action === 'toggle-activo') {
          await toggleUsuarioActivoDesdeDashboard(rowId);
          return;
        }

        if (action === 'impersonar') {
          await impersonarUsuarioDesdeDashboard(rowId, button);
        }
      });
    }

    document.querySelectorAll('.dashboard-kpi-card').forEach((card) => {
      card.addEventListener('click', function() {
        const chartTarget = card.dataset.chartTarget;
        detailEnabled = true;
        document.getElementById('tipoGrafico').value = chartTarget;
        renderChart(chartTarget, { renderDetail: true });
      });
    });

    resetDetailPanel();
    renderChart(currentChartType, { renderDetail: false });
    const generalCanvas = document.querySelector('[data-gen-chart]');
    if (!generalOverviewChartsRendered && generalCanvas && generalCanvas.offsetParent) {
      renderGeneralOverviewCharts();
    }

    const themeObserver = new MutationObserver(function() {
      renderChart(currentChartType, { renderDetail: detailEnabled });
      if (generalOverviewChartsRendered) renderGeneralOverviewCharts();
      if (pazYSalvoChartsRendered) renderPazYSalvoCharts();
    });

    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-bs-theme'],
    });
  });
</script>

<%- include('../partials/footer'); -%>