<%- include('../partials/header'); -%>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Registro de coordinador</h1>
    <p class="app-page-subtitle">Configura el acceso, la información institucional y las facultades asociadas al nuevo coordinador.</p>
  </section>

  <section class="card app-form-panel col-xl-8 col-lg-10 mx-auto d-flex justify-content-center">
    <div class="card-body">
      <form
        method="get"
        action="/milab/api/registro_coordinador/load_info"
        class="row g-2 justify-content-center align-items-end app-form-grid mb-4"
      >
        <div class="col-12 col-md-8 mx-auto text-center">
          <label for="documento_lookup" class="form-label">Consulta en OATI por documento</label>
          <div class="input-group justify-content-center">
            <input
              type="text"
              inputmode="numeric"
              class="form-control"
              id="documento_lookup"
              name="documento"
              placeholder="Ej: 90000000"
              value="<%= lookupDocumento || '' %>"
            >
            <button class="btn btn-perso" type="submit" title="Consultar" aria-label="Consultar">
              <i class="bi bi-search" aria-hidden="true"></i>
            </button>
          </div>
          <small class="form-text text-muted">Si existe en OATI se precargan nombre y correo.</small>
        </div>
      </form>

      <% if (lookupMessage) { %>
        <div class="alert alert-<%= lookupStatus || 'warning' %>" role="alert">
          <%= lookupMessage %>
        </div>
      <% } %>

      <form method="post" action="/milab/api/registro_coordinador"
        data-oati-loading="true"
        data-oati-loading-message="Consultando datos en la OATI..." 
        class="row g-3 mx-auto d-flex justify-content-center app-form-grid" 
        onsubmit="return validarCorreo() && validarCampos()">
        <%- include('../partials/csrf_field') %>
        
    <p class="app-page-subtitle mb-2"><em>Ingresa los datos del coordinador y define su acceso institucional.</em></p>

    <div class="col-md-6">
      <label for="nombre" class="form-label">Nombre Completo</label>
      <input type="text" class="form-control" id="nombre" name="nombre" value="<%= lookupData?.nombre || '' %>" required>
    </div>

    <div class="col-md-6">
      <label for="documento" class="form-label">Número de Documento</label>
      <input
        type="text"
        inputmode="numeric"
        class="form-control"
        id="documento"
        name="documento"
        value="<%= lookupData?.documento || '' %>"
        required
      >
    </div>

    <div class="col-md-12">
      <label for="correo" class="form-label">Correo electrónico</label>
      <input type="email" class="form-control" id="correo" name="correo" value="<%= lookupData?.correo || '' %>" required>
    </div>

    <div class="col-md-12">
      <label for="role_name" class="form-label">Rol de acceso</label>
      <select id="role_name" name="role_name" class="form-select">
        <option value="coordinador" <%= (selectedRole || 'coordinador') === 'coordinador' ? 'selected' : '' %>>Coordinador (con alcance institucional definido abajo)</option>
        <option value="coordinador_general" <%= selectedRole === 'coordinador_general' ? 'selected' : '' %>>Coordinador General (lectura global, sin facultad a cargo)</option>
      </select>
      <small class="form-text text-muted">El Coordinador General podrá ver todos los módulos habilitados en modo solo lectura.</small>
    </div>

    <fieldset class="col-md-12" id="facultadesSection">
      <legend class="form-label fs-6">Alcance del coordinador</legend>
      <div class="mb-3">
        <label for="facultad_id" class="form-label">Facultad</label>
        <select class="form-select" id="facultad_id" name="facultad_id" required>
          <option value="">Selecciona una facultad</option>
          <% facultades.forEach(function(facultad) { %>
            <option value="<%= facultad.facultad_id %>"><%= facultad.nombre %></option>
          <% }); %>
        </select>
      </div>

      <div class="d-flex flex-column gap-2 mb-3">
        <div class="form-check">
          <input class="form-check-input" type="radio" id="alcance_facultad" name="alcance" value="facultad" checked>
          <label class="form-check-label" for="alcance_facultad">Toda la facultad</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" id="alcance_dependencias" name="alcance" value="dependencias">
          <label class="form-check-label" for="alcance_dependencias">Solo dependencias específicas</label>
        </div>
      </div>

      <div id="dependenciasSection" class="d-none">
        <label class="form-label" for="dependenciasSearch">Dependencias</label>
        <input
          type="search"
          class="form-control mb-2"
          id="dependenciasSearch"
          placeholder="Filtrar dependencias..."
          autocomplete="off"
        >
        <div class="coordinator-dependency-list" id="dependenciasOptions">
          <% dependencias.forEach(function(dependencia) { %>
            <label
              class="form-check coordinator-dependency-option"
              data-dependencia-option="true"
              data-facultad="<%= dependencia.facultad_id %>"
              data-search="<%= dependencia.nombre.toLowerCase() %>"
              hidden
            >
              <input
                class="form-check-input me-2"
                type="checkbox"
                name="dependencia_ids"
                value="<%= dependencia.dependencia_id %>"
                data-dependencia-checkbox="true"
              >
              <span class="form-check-label"><%= dependencia.nombre %></span>
            </label>
          <% }); %>
          <p class="text-muted mb-0" id="dependenciasEmpty" hidden>No hay dependencias que coincidan con la facultad y búsqueda seleccionadas.</p>
        </div>
        <small class="form-text text-muted">Puedes seleccionar una o varias dependencias de la facultad elegida.</small>
      </div>
    </fieldset>

    <!-- NUEVOS CAMPOS -->
    <div class="col-md-6">
      <label for="numero_resolucion_coordinador" class="form-label">Número y año de Resolución del encargo de coordinación</label>
      <input type="text" class="form-control" id="numero_resolucion_coordinador" name="numero_resolucion_coordinador" required>
    </div>

    <div class="col-md-6">
      <label for="soporte_resolucion" class="form-label">Soporte Resolución (URL) del sistema sgral </label>
      <input type="url" class="form-control" id="soporte_resolucion" name="soporte_resolucion" required>
    </div>

    <div id="mensajeError" class="col-md-10 mt-3 alert alert-danger d-none" role="alert"></div>

    <% if (error) { %>
      <div class="alert alert-danger" role="alert">
        <%= error %>
      </div>
    <% } %>

    <div class="col-md-12 mb-2 justify-content-center d-flex">
      <button class="btn btn-perso col-md-11" type="submit" id="abrirModal" data-submit-lock="true">Registrar</button>
    </div>

    <% if (confirmacion) { include('./confirm_create_account.ejs') } %>
  </form>
    </div>
  </section>
</main>

<%- include('../partials/footer'); -%>

<script nonce="<%= cspNonce %>">
  function validarCorreo() {
    var correoInput = document.getElementById('correo');
    var correo = correoInput.value.toLowerCase();
    var mensajeError = document.getElementById("mensajeError");
    mensajeError.classList.add("d-none");
    mensajeError.innerHTML = "";

    if (!correo.endsWith('@udistrital.edu.co')) {
      mensajeError.classList.remove("d-none");
      mensajeError.innerHTML = "<p>El correo debe ser institucional (@udistrital.edu.co).</p>";
      correoInput.value = '';
      return false;
    }
    return true;
  }

  function validarCampos() {
    var nombre = document.getElementById("nombre").value;
    var documento = document.getElementById("documento").value;
    var roleName = document.getElementById('role_name').value;
    var mensajeError = document.getElementById("mensajeError");
    mensajeError.classList.add("d-none");
    mensajeError.innerHTML = "";

    if (!/^[A-Za-zÀ-ÿ\s'.-]+$/.test(nombre)) {
      mensajeError.classList.remove("d-none");
      mensajeError.innerHTML += "<p>El nombre solo debe contener letras.</p>";
      return false;
    }

    if (!(/^\d+[1-9]\d*$/.test(documento))) {
      mensajeError.classList.remove("d-none");
      mensajeError.innerHTML += "<p>El documento debe ser un número válido y positivo.</p>";
      return false;
    }

    if (roleName === 'coordinador') {
      var facultyId = document.getElementById('facultad_id').value;
      var scope = document.querySelector('input[name="alcance"]:checked')?.value;
      var dependencies = document.querySelectorAll('input[name="dependencia_ids"]:checked');
      if (!facultyId) {
        mensajeError.classList.remove("d-none");
        mensajeError.innerHTML += "<p>Debe seleccionar una facultad.</p>";
        return false;
      }
      if (scope === 'dependencias' && dependencies.length === 0) {
        mensajeError.classList.remove("d-none");
        mensajeError.innerHTML += "<p>Debe seleccionar al menos una dependencia.</p>";
        return false;
      }
    }

    return true;
  }

  function syncFacultySection() {
    var roleSelect = document.getElementById('role_name');
    var facultiesSection = document.getElementById('facultadesSection');
    if (!roleSelect || !facultiesSection) {
      return;
    }

    var isGeneralRole = roleSelect.value === 'coordinador_general';
    facultiesSection.classList.toggle('d-none', isGeneralRole);
    facultiesSection.disabled = isGeneralRole;

    if (isGeneralRole) {
      var checks = document.querySelectorAll('input[name="dependencia_ids"]');
      checks.forEach(function (check) {
        check.checked = false;
      });
      document.getElementById('facultad_id').value = '';
    }
  }

  function updateDependencyOptions() {
    var facultyId = document.getElementById('facultad_id').value;
    var scope = document.querySelector('input[name="alcance"]:checked')?.value;
    var section = document.getElementById('dependenciasSection');
    var filter = document.getElementById('dependenciasSearch').value.trim().toLocaleLowerCase();
    var options = document.querySelectorAll('[data-dependencia-option="true"]');
    var visibleCount = 0;

    section.classList.toggle('d-none', scope !== 'dependencias');
    options.forEach(function (option) {
      var matchesFaculty = option.getAttribute('data-facultad') === facultyId;
      var matchesFilter = option.getAttribute('data-search').includes(filter);
      option.hidden = !matchesFaculty || !matchesFilter;
      if (!option.hidden) visibleCount++;
      if (!matchesFaculty) {
        option.querySelector('input').checked = false;
      }
    });
    document.getElementById('dependenciasEmpty').hidden = !facultyId || visibleCount > 0;
  }

  document.addEventListener('DOMContentLoaded', function () {
    var roleSelect = document.getElementById('role_name');
    if (roleSelect) {
      roleSelect.addEventListener('change', syncFacultySection);
    }
    document.getElementById('facultad_id').addEventListener('change', updateDependencyOptions);
    document.querySelectorAll('input[name="alcance"]').forEach(function (radio) {
      radio.addEventListener('change', updateDependencyOptions);
    });
    document.getElementById('dependenciasSearch').addEventListener('input', updateDependencyOptions);
    syncFacultySection();
    updateDependencyOptions();
  });
</script>
