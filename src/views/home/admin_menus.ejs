<%- include('../partials/header'); -%>

<main class="container app-page-shell admin-menus-page">
  <section class="app-page-header">
    <h1 class="app-page-title">Menus y permisos</h1>
    <p class="app-page-subtitle">Administra modulos, submodulos y permisos por rol.</p>
  </section>

  <section class="row justify-content-center">
    <div class="col-xl-11">

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
          <h2 class="h5">Crear menu</h2>
          <form method="POST" action="/milab/api/admin/menus" class="row g-3">
            <%- include('../partials/csrf_field') %>
            <div class="col-md-3">
              <label class="form-label">Seccion</label>
              <select class="form-select" name="section" required>
                <option value="primary">Primary</option>
                <option value="secondary">Secondary</option>
                <option value="account">Account</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label">Etiqueta</label>
              <input class="form-control" name="label" maxlength="200" required />
            </div>
            <div class="col-md-3">
              <label class="form-label">Ruta</label>
              <input class="form-control" name="route" maxlength="200" placeholder="/milab/api/..." />
            </div>
            <div class="col-md-3">
              <label class="form-label">Icono</label>
              <input class="form-control" name="icon" maxlength="100" placeholder="bi-..." />
            </div>
            <div class="col-md-3">
              <label class="form-label">Padre</label>
              <select class="form-select" name="parent_id">
                <option value="">Sin padre</option>
                <% menuItems.forEach(function(item) { %>
                  <% if (!item.parent_id && item.section === 'secondary') { %>
                    <option value="<%= item.id %>"><%= item.label %></option>
                  <% } %>
                <% }) %>
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label">Orden</label>
              <input class="form-control" type="number" name="order_index" value="0" />
            </div>
            <div class="col-md-2 d-flex align-items-center">
              <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="is_active" id="is_active" checked>
                <label class="form-check-label" for="is_active">Activo</label>
              </div>
            </div>
            <div class="col-12">
              <button class="btn btn-primary">Guardar menu</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
          <h2 class="h5 mb-2">Acceso a Prestamos por facultad</h2>
          <p class="text-muted mb-3">
            Si desactivas todas las facultades, estudiantes y docentes dejarán de ver el módulo de Préstamos. Además, cuando una facultad está desactivada, el coordinador, sus laboratoristas y monitores asignados no podrán usar el módulo en ese alcance.
          </p>
          <div class="table-responsive admin-permissions-table">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th>Facultad</th>
                  <th class="text-center">Coordinador</th>
                  <th class="text-center">Laboratorista</th>
                  <th class="text-center">Monitor</th>
                </tr>
              </thead>
              <tbody>
                <% if (!prestamosFacultyAccess || !prestamosFacultyAccess.length) { %>
                  <tr>
                    <td colspan="4" class="text-muted">No hay facultades disponibles.</td>
                  </tr>
                <% } %>
                <% (prestamosFacultyAccess || []).forEach(function(item) { %>
                  <tr>
                    <td>
                      <strong><%= item.nombre %></strong>
                    </td>
                    <td class="text-center">
                      <input
                        type="checkbox"
                        class="form-check-input prestamos-access-toggle"
                        data-facultad-id="<%= item.facultad_id %>"
                        data-role="coordinador"
                        <%= item.coordinador_permitido ? 'checked' : '' %>
                      />
                    </td>
                    <td class="text-center">
                      <input
                        type="checkbox"
                        class="form-check-input prestamos-access-toggle"
                        data-facultad-id="<%= item.facultad_id %>"
                        data-role="laboratorista"
                        <%= item.laboratorista_permitido ? 'checked' : '' %>
                      />
                    </td>
                    <td class="text-center">
                      <input
                        type="checkbox"
                        class="form-check-input prestamos-access-toggle"
                        data-submit-lock="true"
                        data-facultad-id="<%= item.facultad_id %>"
                        data-role="monitor"
                        <%= item.monitor_permitido ? 'checked' : '' %>
                      />
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <%
        const primaryItems = [];
        const accountItems = [];
        const secondaryParents = [];
        const childrenByParent = {};
        const permissionMap = new Set();

        permissions.forEach(function(permission) {
          if (permission.can_view) {
            permissionMap.add(`${permission.role_id}:${permission.menu_item_id}`);
          }
        });

        menuItems.forEach(function(item) {
          if (item.section === 'primary') {
            primaryItems.push(item);
            return;
          }

          if (item.section === 'account') {
            accountItems.push(item);
            return;
          }

          if (item.section === 'secondary') {
            if (!item.parent_id) {
              secondaryParents.push(item);
              return;
            }

            if (!childrenByParent[item.parent_id]) {
              childrenByParent[item.parent_id] = [];
            }
            childrenByParent[item.parent_id].push(item);
          }
        });
      %>

      <div class="card shadow-sm border-0 mb-4 admin-modules-card">
        <div class="card-body">
          <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
            <div>
              <h2 class="h5 mb-1">Modulos primarios</h2>
              <p class="text-muted mb-0">Expande cada modulo para ver submenus y permisos.</p>
            </div>
          </div>

          <div class="accordion admin-modules-accordion" id="adminMenuAccordion">
            <% if (!secondaryParents.length) { %>
              <p class="text-muted mb-0">No hay modulos secundarios registrados.</p>
            <% } %>

            <% secondaryParents.forEach(function(parent) { %>
              <% const children = childrenByParent[parent.id] || []; %>
              <div class="accordion-item">
                <h2 class="accordion-header" id="moduleHeading<%= parent.id %>">
                  <button
                    class="accordion-button collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#moduleCollapse<%= parent.id %>"
                    aria-expanded="false"
                    aria-controls="moduleCollapse<%= parent.id %>"
                  >
                    <div class="admin-module-summary">
                      <span class="admin-module-icon" aria-hidden="true">
                        <i class="bi <%= parent.icon || 'bi-grid-1x2' %>"></i>
                      </span>
                      <div class="admin-module-title">
                        <span class="admin-module-name"><%= parent.label %></span>
                        <span class="admin-module-meta"><%= parent.route || 'Sin ruta' %></span>
                      </div>
                      <span class="admin-module-count"><%= children.length %> submenus</span>
                    </div>
                  </button>
                </h2>
                <div
                  id="moduleCollapse<%= parent.id %>"
                  class="accordion-collapse collapse"
                  aria-labelledby="moduleHeading<%= parent.id %>"
                  data-bs-parent="#adminMenuAccordion"
                >
                  <div class="accordion-body">
                    <div class="table-responsive admin-permissions-table">
                      <table class="table align-middle admin-permissions-grid">
                        <colgroup>
                          <col class="admin-menu-info-column">
                          <col class="admin-menu-actions-column">
                          <% roles.forEach(function() { %>
                            <col class="admin-menu-role-column">
                          <% }) %>
                        </colgroup>
                        <thead>
                          <tr>
                            <th>Menú y ruta</th>
                            <th>Acciones</th>
                            <% roles.forEach(function(role) { %>
                              <th class="text-center admin-menu-role-heading" title="<%= role.name %>">
                                <%= role.name %>
                              </th>
                            <% }) %>
                          </tr>
                        </thead>
                        <tbody>
                          <tr class="admin-module-root">
                            <td class="admin-menu-info-cell">
                              <strong><%= parent.label %></strong>
                              <div class="text-muted small">Modulo principal</div>
                              <div class="admin-menu-route"><%= parent.route || 'Sin ruta' %></div>
                            </td>
                            <td class="admin-menu-actions-cell">
                              <div class="admin-menu-actions">
                                <button
                                  type="button"
                                  class="btn btn-sm btn-outline-primary"
                                  data-bs-toggle="modal"
                                  data-bs-target="#adminMenuEditModal"
                                  data-menu-id="<%= parent.id %>"
                                  data-section="secondary"
                                  data-parent-id=""
                                  data-section-locked="true"
                                  data-parent-locked="true"
                                  data-label="<%= parent.label %>"
                                  data-route="<%= parent.route || '' %>"
                                  data-icon="<%= parent.icon || '' %>"
                                  data-order-index="<%= parent.order_index || 0 %>"
                                  data-active="<%= parent.is_active ? 'true' : 'false' %>"
                                >
                                  Editar
                                </button>
                                <%
                                  const parentDeletePrompt = children.length
                                    ? `¿Eliminar el módulo «${parent.label}» junto con sus ${children.length} submenús y permisos?`
                                    : `¿Eliminar el módulo «${parent.label}» y sus permisos?`;
                                %>
                                <form
                                  method="POST"
                                  action="/milab/api/admin/menus/delete"
                                  data-confirm-submit="<%= parentDeletePrompt %>"
                                >
                                  <%- include('../partials/csrf_field') %>
                                  <input type="hidden" name="menu_item_id" value="<%= parent.id %>">
                                  <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Eliminar <%= parent.label %>">
                                    Eliminar
                                  </button>
                                </form>
                              </div>
                            </td>
                            <% roles.forEach(function(role) { %>
                              <% const permissionKey = `${role.id}:${parent.id}`; %>
                              <td class="text-center admin-menu-role-cell">
                                <input
                                  type="checkbox"
                                  class="form-check-input permission-toggle"
                                  data-submit-lock="true"
                                  data-role-id="<%= role.id %>"
                                  data-menu-id="<%= parent.id %>"
                                  <%= permissionMap.has(permissionKey) ? 'checked' : '' %>
                                />
                              </td>
                            <% }) %>
                          </tr>
                          <% if (!children.length) { %>
                            <tr>
                              <td colspan="<%= roles.length + 2 %>" class="text-muted">
                                Sin submenus asociados.
                              </td>
                            </tr>
                          <% } %>
                          <% children.forEach(function(item) { %>
                            <tr>
                              <td class="admin-menu-info-cell">
                                <strong><%= item.label %></strong>
                                <div class="admin-menu-route"><%= item.route || 'Sin ruta' %></div>
                              </td>
                              <td class="admin-menu-actions-cell">
                                <div class="admin-menu-actions">
                                  <button
                                    type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#adminMenuEditModal"
                                    data-menu-id="<%= item.id %>"
                                    data-section="secondary"
                                    data-parent-id="<%= item.parent_id %>"
                                    data-section-locked="true"
                                    data-parent-locked="false"
                                    data-label="<%= item.label %>"
                                    data-route="<%= item.route || '' %>"
                                    data-icon="<%= item.icon || '' %>"
                                    data-order-index="<%= item.order_index || 0 %>"
                                    data-active="<%= item.is_active ? 'true' : 'false' %>"
                                  >
                                    Editar
                                  </button>
                                  <form
                                    method="POST"
                                    action="/milab/api/admin/menus/delete"
                                    data-confirm-submit="¿Eliminar el submenú «<%= item.label %>» y sus permisos asociados?"
                                  >
                                    <%- include('../partials/csrf_field') %>
                                    <input type="hidden" name="menu_item_id" value="<%= item.id %>">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Eliminar <%= item.label %>">
                                      Eliminar
                                    </button>
                                  </form>
                                </div>
                              </td>
                              <% roles.forEach(function(role) { %>
                                <% const permissionKey = `${role.id}:${item.id}`; %>
                                <td class="text-center admin-menu-role-cell">
                                  <input
                                    type="checkbox"
                                    class="form-check-input permission-toggle"
                                    data-submit-lock="true"
                                    data-role-id="<%= role.id %>"
                                    data-menu-id="<%= item.id %>"
                                    <%= permissionMap.has(permissionKey) ? 'checked' : '' %>
                                  />
                                </td>
                              <% }) %>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body">
          <h2 class="h5 mb-3">Menus principales y cuenta</h2>
          <p class="text-muted mb-3">Accesos directos del header y perfil.</p>
          <div class="table-responsive admin-permissions-table">
            <table class="table align-middle admin-permissions-grid">
              <colgroup>
                <col class="admin-menu-info-column">
                <col class="admin-menu-actions-column">
                <% roles.forEach(function() { %>
                  <col class="admin-menu-role-column">
                <% }) %>
              </colgroup>
              <thead>
                <tr>
                  <th>Menú y ruta</th>
                  <th>Acciones</th>
                  <% roles.forEach(function(role) { %>
                    <th class="text-center admin-menu-role-heading" title="<%= role.name %>">
                      <%= role.name %>
                    </th>
                  <% }) %>
                </tr>
              </thead>
              <tbody>
                <% if (!primaryItems.length && !accountItems.length) { %>
                  <tr>
                    <td colspan="<%= roles.length + 2 %>" class="text-muted">
                      No hay menus principales registrados.
                    </td>
                  </tr>
                <% } %>
                <% primaryItems.concat(accountItems).forEach(function(item) { %>
                  <tr>
                    <td class="admin-menu-info-cell">
                      <span class="admin-menu-section"><%= item.section %></span>
                      <strong><%= item.label %></strong>
                      <div class="admin-menu-route"><%= item.route || 'Sin ruta' %></div>
                    </td>
                    <td class="admin-menu-actions-cell">
                      <div class="admin-menu-actions">
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-primary"
                          data-bs-toggle="modal"
                          data-bs-target="#adminMenuEditModal"
                          data-menu-id="<%= item.id %>"
                          data-section="<%= item.section %>"
                          data-parent-id=""
                          data-section-locked="false"
                          data-parent-locked="true"
                          data-label="<%= item.label %>"
                          data-route="<%= item.route || '' %>"
                          data-icon="<%= item.icon || '' %>"
                          data-order-index="<%= item.order_index || 0 %>"
                          data-active="<%= item.is_active ? 'true' : 'false' %>"
                        >
                          Editar
                        </button>
                        <form
                          method="POST"
                          action="/milab/api/admin/menus/delete"
                          data-confirm-submit="¿Eliminar «<%= item.label %>» y sus permisos asociados?"
                        >
                          <%- include('../partials/csrf_field') %>
                          <input type="hidden" name="menu_item_id" value="<%= item.id %>">
                          <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Eliminar <%= item.label %>">
                            Eliminar
                          </button>
                        </form>
                      </div>
                    </td>
                    <% roles.forEach(function(role) { %>
                      <% const permissionKey = `${role.id}:${item.id}`; %>
                      <td class="text-center admin-menu-role-cell">
                        <input
                          type="checkbox"
                          class="form-check-input permission-toggle"
                          data-submit-lock="true"
                          data-role-id="<%= role.id %>"
                          data-menu-id="<%= item.id %>"
                          <%= permissionMap.has(permissionKey) ? 'checked' : '' %>
                        />
                      </td>
                    <% }) %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="modal fade" id="adminMenuEditModal" tabindex="-1" aria-labelledby="adminMenuEditTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <form method="POST" action="/milab/api/admin/menus/update" id="adminMenuEditForm">
              <div class="modal-header">
                <h2 class="modal-title h5" id="adminMenuEditTitle">Editar ítem de menú</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
              </div>
              <div class="modal-body">
                <%- include('../partials/csrf_field') %>
                <input type="hidden" name="menu_item_id">
                <div class="mb-3">
                  <label class="form-label" for="adminMenuEditSection">Sección</label>
                  <select class="form-select" name="section" id="adminMenuEditSection" required>
                    <option value="primary">Primary</option>
                    <option value="account">Account</option>
                  </select>
                  <input type="hidden" name="section" id="adminMenuEditSectionFixed" disabled>
                </div>
                <div class="mb-3">
                  <label class="form-label" for="adminMenuEditParent">Módulo primario</label>
                  <select class="form-select" name="parent_id" id="adminMenuEditParent">
                    <option value="">Sin padre</option>
                    <% secondaryParents.forEach(function(candidateParent) { %>
                      <option value="<%= candidateParent.id %>"><%= candidateParent.label %></option>
                    <% }) %>
                  </select>
                  <input type="hidden" name="parent_id" id="adminMenuEditParentFixed" disabled>
                </div>
                <div class="mb-3">
                  <label class="form-label" for="adminMenuEditLabel">Nombre</label>
                  <input class="form-control" name="label" id="adminMenuEditLabel" maxlength="200" required>
                </div>
                <div class="mb-3">
                  <label class="form-label" for="adminMenuEditRoute">Ruta</label>
                  <input class="form-control" name="route" id="adminMenuEditRoute" maxlength="200">
                </div>
                <div class="row g-3">
                  <div class="col-8">
                    <label class="form-label" for="adminMenuEditIcon">Icono</label>
                    <input class="form-control" name="icon" id="adminMenuEditIcon" maxlength="100">
                  </div>
                  <div class="col-4">
                    <label class="form-label" for="adminMenuEditOrder">Orden</label>
                    <input class="form-control" type="number" name="order_index" id="adminMenuEditOrder">
                  </div>
                </div>
                <div class="form-check mt-3">
                  <input class="form-check-input" type="checkbox" name="is_active" id="adminMenuEditActive">
                  <label class="form-check-label" for="adminMenuEditActive">Activo</label>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script nonce="<%= cspNonce %>">
  document.querySelectorAll('.permission-toggle').forEach(function(checkbox) {
    checkbox.addEventListener('change', async function(event) {
      const roleId = event.target.getAttribute('data-role-id');
      const menuId = event.target.getAttribute('data-menu-id');
      const enabled = event.target.checked;
      const btnElement = event.target;

      try {
        window.MiLabSubmitLock.lock(btnElement, 'Guardando permisos de menú...');
        const response = await fetch('/milab/api/admin/menus/permissions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('input[name="_csrf"]')?.value || '',
          },
          body: JSON.stringify({
            role_id: roleId,
            menu_item_id: menuId,
            enabled,
          }),
        });

        const menuEditForm = document.getElementById('adminMenuEditForm');
        const menuEditSection = document.getElementById('adminMenuEditSection');
        const menuEditParent = document.getElementById('adminMenuEditParent');
        const menuEditSectionFixed = document.getElementById('adminMenuEditSectionFixed');
        const menuEditParentFixed = document.getElementById('adminMenuEditParentFixed');

        document.getElementById('adminMenuEditModal').addEventListener('show.bs.modal', function(event) {
          const trigger = event.relatedTarget;
          if (!trigger) return;

          menuEditForm.elements.namedItem('menu_item_id').value = trigger.dataset.menuId;
          menuEditSection.disabled = trigger.dataset.sectionLocked === 'true';
          menuEditSectionFixed.disabled = !menuEditSection.disabled;
          menuEditSection.value = trigger.dataset.section;
          menuEditSectionFixed.value = trigger.dataset.section;
          menuEditForm.elements.namedItem('label').value = trigger.dataset.label;
          menuEditForm.elements.namedItem('route').value = trigger.dataset.route;
          menuEditForm.elements.namedItem('icon').value = trigger.dataset.icon;
          menuEditForm.elements.namedItem('order_index').value = trigger.dataset.orderIndex;
          menuEditForm.elements.namedItem('is_active').checked = trigger.dataset.active === 'true';
          menuEditParent.disabled = trigger.dataset.parentLocked === 'true';
          menuEditParentFixed.disabled = !menuEditParent.disabled;
          menuEditParent.value = trigger.dataset.parentId || '';
          menuEditParentFixed.value = trigger.dataset.parentId || '';
        });

        const data = await response.json();
        if (!data.ok) {
          throw new Error(data.message || 'Error al actualizar permisos.');
        }
      } catch (error) {
        window.MiLabDialogs.alert(error.message || 'Error al actualizar permisos.');
        event.target.checked = !enabled;
      } finally {
        window.MiLabSubmitLock.release(btnElement);
      }
    });
  });

  document.querySelectorAll('.prestamos-access-toggle').forEach(function(checkbox) {
    checkbox.addEventListener('change', async function(event) {
      const facultadId = event.target.getAttribute('data-facultad-id');
      const role = event.target.getAttribute('data-role');
      const enabled = event.target.checked;
      const btnElement = event.target;

      try {
        window.MiLabSubmitLock.lock(btnElement, 'Guardando acceso a préstamos...');
        const response = await fetch('/milab/api/admin/menus/prestamos-access', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('input[name="_csrf"]')?.value || '',
          },
          body: JSON.stringify({
            facultad_id: facultadId,
            role,
            enabled,
          }),
        });

        const data = await response.json();
        if (!data.ok) {
          throw new Error(data.message || 'Error al actualizar acceso a prestamos.');
        }
      } catch (error) {
        window.MiLabDialogs.alert(error.message || 'Error al actualizar acceso a prestamos.');
        event.target.checked = !enabled;
      } finally {
        window.MiLabSubmitLock.release(btnElement);
      }
    });
  });
</script>

<%- include('../partials/footer'); -%>
