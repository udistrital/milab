                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">Documento</div>
                        <div class="fw-semibold" data-detail-field="documento"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Código</div>
                        <div class="fw-semibold" data-detail-field="codigo"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Programa</div>
                        <div class="fw-semibold" data-detail-field="programa"></div>
