<script nonce="<%= cspNonce %>">
    document.addEventListener('click', function (event) {
        const trigger = event.target.closest('.app-detail-button');

        if (!trigger) {
            return;
        }

        const fields = {
            documento: trigger.getAttribute('data-detalle-documento'),
            codigo: trigger.getAttribute('data-detalle-codigo'),
            programa: trigger.getAttribute('data-detalle-programa'),
            'estado-consulta': trigger.getAttribute('data-detalle-estado-consulta'),
            'codigos-sga': trigger.getAttribute('data-detalle-codigos-sga'),
            origen: trigger.getAttribute('data-detalle-origen'),
            categoria: trigger.getAttribute('data-detalle-categoria'),
            estado: trigger.getAttribute('data-detalle-estado'),
            fecha: trigger.getAttribute('data-detalle-fecha'),
            observacion: trigger.getAttribute('data-detalle-observacion'),
            laboratorista: trigger.getAttribute('data-detalle-laboratorista'),
            ual: trigger.getAttribute('data-detalle-ual'),
            'codigo-sga': trigger.getAttribute('data-detalle-codigo-sga'),
            'id-sga': trigger.getAttribute('data-detalle-id-sga'),
            'tipo-concepto': trigger.getAttribute('data-detalle-tipo-concepto'),
            'valor-sga': trigger.getAttribute('data-detalle-valor-sga'),
            'periodo-sga': [
                trigger.getAttribute('data-detalle-anio-sga'),
                trigger.getAttribute('data-detalle-periodo-sga'),
            ]
                .filter(Boolean)
                .join(' / '),
            'fecha-pago-sga': trigger.getAttribute('data-detalle-fecha-pago-sga'),
            facultad: trigger.getAttribute('data-detalle-facultad'),
            dependencia: trigger.getAttribute('data-detalle-dependencia'),
        };

        Object.keys(fields).forEach(function (key) {
            const target = document.querySelector(`[data-detail-field="${key}"]`);
            if (target) {
                target.textContent = fields[key] || '-';
            }
        });
    });

    const consultaForm = document.querySelector('.app-bulk-query-form');
    const consultaInput = document.getElementById('consulta_masiva');
    const consultaCounter = document.getElementById('consultaMasivaCount');
    const consultaButton = document.getElementById('consultaMasivaSubmit');
    const mensajeError = document.getElementById('mensajeError');
    const maxCodigos = Number(consultaForm.dataset.maxCodes) || 50;

    function obtenerCodigos() {
        return consultaInput.value
            .split(',')
            .map(function (codigo) { return codigo.trim(); })
            .filter(Boolean);
    }

    function actualizarContador() {
        const codigos = obtenerCodigos();
        const excedeLimite = codigos.length > maxCodigos;
        consultaCounter.textContent = `${codigos.length} / ${maxCodigos} códigos`;
        consultaCounter.classList.toggle('text-danger', excedeLimite);
        consultaButton.disabled = excedeLimite;

        if (excedeLimite) {
            mensajeError.textContent = `El máximo permitido es de ${maxCodigos} códigos por consulta.`;
            mensajeError.classList.remove('d-none');
        } else {
            mensajeError.textContent = '';
            mensajeError.classList.add('d-none');
        }

        return codigos;
    }

    consultaInput.addEventListener('input', actualizarContador);
    actualizarContador();

    function verificarEntrada() {
        const codigos = actualizarContador();
        if (codigos.length > maxCodigos) {
            return false;
        }

        if (codigos.some(function (codigo) { return !/^\d+$/.test(codigo); })) {
            mensajeError.textContent = 'Los códigos deben contener solamente números.';
            mensajeError.classList.remove('d-none');
            return false;
        }
        return true;
    }

    const progressModalElement = document.getElementById('consultaMasivaProgressModal');
    const progressModal =
        window.bootstrap?.Modal.getOrCreateInstance(progressModalElement, {
            backdrop: 'static',
            keyboard: false,
        }) || null;
    const progressMessage = document.getElementById('consultaMasivaProgressMessage');
    const progressIdentifier = document.getElementById('consultaMasivaProgressIdentifier');
    const progressCount = document.getElementById('consultaMasivaProgressCount');
    const progressBar = document.getElementById('consultaMasivaProgressBar');
    const progressTrack = progressBar.parentElement;
    const progressSteps = Array.from(
        progressModalElement.querySelectorAll('[data-progress-step]')
    );
    const progressStepIndexes = {
        data: 0,
        student: 0,
        identity: 1,
        sga: 2,
        condensing: 3,
        complete: 3,
        done: 3,
    };
    let consultaEnCurso = false;

    function actualizarProgreso(evento) {
        const porcentaje = Math.min(100, Math.max(0, Number(evento.percent) || 0));
        progressBar.style.width = `${porcentaje}%`;
        progressTrack.setAttribute('aria-valuenow', String(porcentaje));
        progressMessage.textContent = evento.message || 'Procesando la consulta masiva…';
        progressIdentifier.textContent = evento.identifier
            ? `${evento.identifierType || 'Identificador'}: ${evento.identifier}`
            : 'Preparando estudiantes…';
        progressCount.textContent = `${evento.completed || 0} / ${evento.total || 0}`;

        const activeIndex = progressStepIndexes[evento.stage] ?? 0;
        progressSteps.forEach((step, index) => {
            const completed = evento.stage === 'done' || index < activeIndex;
            step.classList.toggle('is-complete', completed);
            step.classList.toggle('is-active', index === activeIndex && evento.stage !== 'done');
        });
    }

    async function leerFlujoProgreso(response) {
        const contentType = response.headers.get('content-type') || '';
        if (!contentType.includes('application/x-ndjson')) {
            if (response.redirected) {
                window.location.assign(response.url);
                return null;
            }
            if (contentType.includes('application/json')) {
                const payload = await response.json();
                throw new Error(payload.message || 'No fue posible completar la consulta masiva.');
            }
            throw new Error('El servidor no devolvió el progreso de la consulta.');
        }
        if (!response.body || typeof response.body.getReader !== 'function') {
            throw new Error('El navegador no pudo leer el progreso de la consulta.');
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let reportHtml = null;
        let streamError = null;

        function processLine(line) {
            if (!line.trim()) return;
            const event = JSON.parse(line);
            if (event.type === 'progress') {
                actualizarProgreso(event);
            } else if (event.type === 'result') {
                reportHtml = event.html;
            } else if (event.type === 'error') {
                streamError = event.message || 'No fue posible completar la consulta masiva.';
            } else {
                throw new Error('El servidor envió un evento de progreso desconocido.');
            }
        }

        while (true) {
            const { done, value } = await reader.read();
            buffer += decoder.decode(value || new Uint8Array(), { stream: !done });
            const lines = buffer.split('\n');
            buffer = lines.pop() || '';
            lines.forEach(processLine);
            if (done) break;
        }
        if (buffer.trim()) processLine(buffer);
        if (streamError) throw new Error(streamError);
        if (!response.ok) throw new Error('No fue posible completar la consulta masiva.');
        if (!reportHtml) throw new Error('La consulta terminó sin generar el informe.');
        return reportHtml;
    }

    function actualizarInforme(html) {
        const documentResult = new DOMParser().parseFromString(html, 'text/html');
        const updatedReport = documentResult.getElementById('consultaMasivaReport');
        const currentReport = document.getElementById('consultaMasivaReport');
        if (!updatedReport || !currentReport) {
            throw new Error('No se pudo actualizar el informe de consulta masiva.');
        }

        const currentTable = currentReport.querySelector('table.js-data-grid');
        if (
            currentTable &&
            window.jQuery?.fn?.DataTable?.isDataTable(currentTable)
        ) {
            window.jQuery(currentTable).DataTable().destroy();
        }

        currentReport.replaceWith(document.importNode(updatedReport, true));
        const newReport = document.getElementById('consultaMasivaReport');
        document.dispatchEvent(
            new CustomEvent('milab:initialize-data-grids', {
                detail: { root: newReport },
            })
        );
    }

    consultaForm.addEventListener('submit', async function (event) {
        if (
            event.defaultPrevented ||
            consultaEnCurso ||
            !window.fetch ||
            !window.ReadableStream ||
            !progressModal
        ) {
            return;
        }

        event.preventDefault();
        consultaEnCurso = true;
        consultaButton.disabled = true;
        const buttonLabel = consultaButton.textContent;
        consultaButton.textContent = 'Consultando…';
        progressModal.show();
        actualizarProgreso({
            stage: 'data',
            message: 'Gestionando datos del lote',
            completed: 0,
            total: obtenerCodigos().length,
            percent: 0,
        });

        try {
            const response = await fetch(consultaForm.action, {
                method: 'POST',
                body: new FormData(consultaForm),
                credentials: 'same-origin',
                headers: { Accept: 'application/x-ndjson' },
            });
            const reportHtml = await leerFlujoProgreso(response);
            if (reportHtml) {
                actualizarInforme(reportHtml);
                mensajeError.textContent = '';
                mensajeError.classList.add('d-none');
            }
        } catch (error) {
            mensajeError.textContent =
                error.message || 'No fue posible completar la consulta masiva.';
            mensajeError.classList.remove('d-none');
        } finally {
            consultaEnCurso = false;
            consultaButton.textContent = buttonLabel;
            actualizarContador();
            progressModal.hide();
        }
    });
</script>
  
 



