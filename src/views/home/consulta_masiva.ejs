                        <div class="fw-semibold" data-detail-field="valor-sga"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Año / periodo SGA</div>
                        <div class="fw-semibold" data-detail-field="periodo-sga"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Fecha de pago SGA</div>
                        <div class="fw-semibold" data-detail-field="fecha-pago-sga"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Facultad</div>
                        <div class="fw-semibold" data-detail-field="facultad"></div>
