<%- include('../partials/header'); -%>
<% if (locals.tipo !== 'admin' && locals.tipo !== 'laboratorista' && locals.tipo !== 'coordinador'  ) { %>
    <script nonce="<%= cspNonce %>">
    window.location.href = '/milab/auth/login';
    </script>
  <% } else { %>

<main class="container app-page-shell app-bulk-query-page">
    <section class="app-page-header">
        <h1 class="app-page-title">Consulta masiva de estudiantes</h1>
        <p class="app-page-subtitle">Carga hasta 20 códigos por lote para revisar sanciones activas, observaciones y el laboratorio o dependencia que las reportó.</p>
    </section>

<%
    function resumirTexto(valor, limite) {
        const texto = typeof valor === 'string' ? valor.trim() : '';
        if (!texto) {
            return '-';
        }

        if (texto.length <= limite) {
            return texto;
        }

        return `${texto.slice(0, limite).trim()}...`;
    }
%>

<section class="card app-form-panel app-bulk-query-panel justify-content-center mx-auto">
    <div class="card-body text-light mt-2 mx-auto">
        <form action="/milab/api/get_list_estudiantes/consulta_masiva" method="post" class="app-bulk-query-form app-form-grid" onsubmit="return verificarEntrada()" data-max-codes="20" data-oati-loading="true" data-oati-loading-message="Consultando los registros en la OATI...">
            <%- include('../partials/csrf_field') %>
            <label class="lead" for="consulta_masiva">Ingrese los códigos o documentos de los estudiantes separados por coma (máximo 20 estudiantes)</label>
            <input type="text" class="form-control" id="consulta_masiva" name="consulta_masiva" maxlength="1038" required>
            <div id="consultaMasivaCount" class="form-text text-muted" aria-live="polite">0 / 20 códigos</div>
            <button id="consultaMasivaSubmit" type="submit" class="btn btn-perso" data-read-only-lock="true">Consultar</button>
        </form>
        <div id="mensajeError" class="mx-auto col-md-10 mt-3 alert alert-danger d-none" role="alert"></div>
        <% if (error) {%>
        <div class="alert alert-danger mt-3" role="alert">
            <%- error -%>
        </div>
        <% } %>
        <% if (sgaConsultaOmitida) { %>
        <div class="alert alert-warning mt-3" role="status">
            El servicio SGA no está configurado en este ambiente; los resultados incluyen únicamente multas de MILab.
        </div>
        <% } %>
    </div>
    <div class="card-header app-bulk-query-results-heading mt-3 text-center">
        <h5>Resultados del lote</h5>
    </div>
    <div class="card-body app-bulk-query-results pt-0">
            <div class="app-bulk-query-grid-wrap">
                <table id="myTable" class="table table-bordered table-striped js-data-grid app-grid-contained" data-grid-page-length="25" data-grid-scroll-x="true">
                    <thead class="text-light">
                        <tr>
                            <th>Documento</th>
                            <th>Código</th>
                            <th>Origen</th>
                            <th>Motivo de sanción</th>
                            <th>Estado de la sanción</th>
                            <th>Fecha de la sanción</th>
                            <th>Observación</th>
                            <th>Nombre del laboratorista</th>
                            <th>Laboratorio / dependencia</th>
                            <th data-grid-filter="false" data-grid-orderable="false">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(sampleData1.length > 0) {
                            sampleData1.forEach(function(data) { %>
                                <% data.multas.forEach(function(multa) { %>
                                <tr>
                                    
                                        <td class="text-light"><%= data.documento || '-' %></td>
                                        <td class="text-light"><%= data.codigo || data.identificador || '-' %></td>
                                        <% if (multa === null) { %>
                                            <td class="text-light">-</td>
                                            <td class="text-light">
                                                <em>El estudiante no tiene multas</em>
                                            </td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td class="text-center">-</td>
                                            <% } else if (multa === 'unknown') { %>
                                                    <td class="text-light">-</td>
                                                <td class="text-light">
                                                    <em>Este código no se encuentra registrado</em>
                                                </td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td class="text-center">-</td>
                                                <% } else if (multa === 'sga-error') { %>
                                                    <td class="text-light">SGA</td>
                                                    <td class="text-light"><em>No fue posible verificar las multas en SGA.</em></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td class="text-center">-</td>
                                            <% } else { %>
                                                    <td class="text-light"><%= multa.origen || 'MILab' %></td>
                                                <td class="text-light">
                                                    <em><%= resumirTexto(multa.cat_multa, 72) %></em>
                                                </td>
                                                <td class="text-light"><%= multa.con_estado_multa %></td>
                                                <td class="text-light"><%= multa.fecha_multa %></td>
                                                <td class="text-light"><%= resumirTexto(multa.obs_multa, 52) %></td>
                                                <td class="text-light"><%= multa.nombre_laboratorista %></td>
                                                <td class="text-light">
                                                    <%= multa.ual %>
                                                    <%- include('../partials/sanction-location', { sanction: multa }) %>
                                                </td>
                                                <td class="text-center">
                                                    <button
                                                        type="button"
                                                        class="btn btn-outline-info btn-sm app-detail-button"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#detalleConsultaMasivaModal"
                                                        data-detalle-documento="<%= data.documento || '-' %>"
                                                        data-detalle-codigo="<%= data.codigo || data.identificador || '-' %>"
                                                        data-detalle-origen="<%= multa.origen || 'MILab' %>"
                                                        data-detalle-categoria="<%= multa.cat_multa || '-' %>"
                                                        data-detalle-estado="<%= multa.con_estado_multa || '-' %>"
                                                        data-detalle-fecha="<%= multa.fecha_multa || '-' %>"
                                                        data-detalle-observacion="<%= multa.obs_multa || 'Sin observaciones' %>"
                                                        data-detalle-laboratorista="<%= multa.nombre_laboratorista || '-' %>"
                                                        data-detalle-ual="<%= multa.ual || '-' %>"
                                                        data-detalle-codigo-sga="<%= multa.codigo_ubicacion_sga || '' %>"
                                                        data-detalle-facultad="<%= multa.laboratorio_facultad || '' %>"
                                                        data-detalle-dependencia="<%= multa.laboratorio_dependencia || '' %>"
                                                    >
                                                        Ver detalle
                                                    </button>
                                                </td>
                                            <% } %> 
                                                                 
                                </tr>
                                <% }) %>  
                            <% });
                        } else { %>
                            <tr>
                                <td class="text-center">No hay registros en la base de datos</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
                <% if(sampleData1.length > 0) { %>
                    <div class="justify-content-center d-flex">
                        
                    <a href="/milab/api/get_list_estudiantes/generate_pdf?data=<%= encodeURIComponent(JSON.stringify(sampleData1)) %>" class="btn btn-perso mt-2 mb-2 col-md-11">Generar PDF</a>
                    </div>
                <% } %>

            </div>
    </div>
    <br>
</section>
</main>

<div class="modal fade app-detail-modal" id="detalleConsultaMasivaModal" tabindex="-1" aria-labelledby="detalleConsultaMasivaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detalleConsultaMasivaLabel">Detalle de la sanción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">Documento</div>
                        <div class="fw-semibold" data-detail-field="documento"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Código</div>
                        <div class="fw-semibold" data-detail-field="codigo"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Origen</div>
                        <div class="fw-semibold" data-detail-field="origen"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Estado</div>
                        <div class="fw-semibold" data-detail-field="estado"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Fecha</div>
                        <div class="fw-semibold" data-detail-field="fecha"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Laboratorista</div>
                        <div class="fw-semibold" data-detail-field="laboratorista"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Laboratorio / dependencia</div>
                        <div class="fw-semibold" data-detail-field="ual"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Código de concepto SGA</div>
                        <div class="fw-semibold" data-detail-field="codigo-sga"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Facultad</div>
                        <div class="fw-semibold" data-detail-field="facultad"></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Dependencia</div>
                        <div class="fw-semibold" data-detail-field="dependencia"></div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted small">Motivo de la sanción</div>
                        <div class="fw-semibold" data-detail-field="categoria"></div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted small">Observación</div>
                        <div class="fw-semibold" data-detail-field="observacion"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
<br>
<script nonce="<%= cspNonce %>">
    document.addEventListener('click', function (event) {
        const trigger = event.target.closest('.app-detail-button');

        if (!trigger) {
            return;
        }

        const fields = {
            documento: trigger.getAttribute('data-detalle-documento'),
            codigo: trigger.getAttribute('data-detalle-codigo'),
            origen: trigger.getAttribute('data-detalle-origen'),
            categoria: trigger.getAttribute('data-detalle-categoria'),
            estado: trigger.getAttribute('data-detalle-estado'),
            fecha: trigger.getAttribute('data-detalle-fecha'),
            observacion: trigger.getAttribute('data-detalle-observacion'),
            laboratorista: trigger.getAttribute('data-detalle-laboratorista'),
            ual: trigger.getAttribute('data-detalle-ual'),
            'codigo-sga': trigger.getAttribute('data-detalle-codigo-sga'),
            facultad: trigger.getAttribute('data-detalle-facultad'),
            dependencia: trigger.getAttribute('data-detalle-dependencia'),
        };

        Object.keys(fields).forEach(function (key) {
            const target = document.querySelector(`[data-detail-field="${key}"]`);
            if (target) {
                target.textContent = fields[key] || '-';
            }
        });
    });

    const consultaForm = document.querySelector('.app-bulk-query-form');
    const consultaInput = document.getElementById('consulta_masiva');
    const consultaCounter = document.getElementById('consultaMasivaCount');
    const consultaButton = document.getElementById('consultaMasivaSubmit');
    const mensajeError = document.getElementById('mensajeError');
    const maxCodigos = Number(consultaForm.dataset.maxCodes) || 20;

    function obtenerCodigos() {
        return consultaInput.value
            .split(',')
            .map(function (codigo) { return codigo.trim(); })
            .filter(Boolean);
    }

    function actualizarContador() {
        const codigos = obtenerCodigos();
        const excedeLimite = codigos.length > maxCodigos;
        consultaCounter.textContent = `${codigos.length} / ${maxCodigos} códigos`;
        consultaCounter.classList.toggle('text-danger', excedeLimite);
        consultaButton.disabled = excedeLimite;

        if (excedeLimite) {
            mensajeError.textContent = `El máximo permitido es de ${maxCodigos} códigos por consulta.`;
            mensajeError.classList.remove('d-none');
        } else {
            mensajeError.textContent = '';
            mensajeError.classList.add('d-none');
        }

        return codigos;
    }

    consultaInput.addEventListener('input', actualizarContador);
    actualizarContador();

    function verificarEntrada() {
        const codigos = actualizarContador();
        if (codigos.length > maxCodigos) {
            return false;
        }

        if (codigos.some(function (codigo) { return !/^\d+$/.test(codigo); })) {
            mensajeError.textContent = 'Los códigos deben contener solamente números.';
            mensajeError.classList.remove('d-none');
            return false;
        }
        return true;
    }
</script>
  
 



  <%- include('../partials/footer'); -%>
  <% } %>