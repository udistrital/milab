<%- include('../../../partials/header'); -%>

<main class="container app-page-shell">
  <section class="app-page-header">
    <div class="d-flex align-items-center gap-2 mb-2">
      <a
        href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/mantenimientos"
        class="btn btn-outline-secondary btn-sm"
      >
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>
    <h1 class="app-page-title">Modificar Mantenimiento</h1>
    <p class="app-page-subtitle">
      Ajusta los datos del mantenimiento mientras este Programado o En ejecución. Una vez
      Cumplido, el registro no puede editarse.
    </p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="alert"><%= successMessage %></div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h5 class="mb-0">Equipo asociado</h5>
      <span class="badge bg-secondary" data-testid="hv-mto-editar-estado"><%= estadoEtiqueta %></span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <span class="text-muted d-block small">Codigo interno</span>
          <strong><%= equipo.codigo || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Nombre</span>
          <strong><%= equipo.nombre || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Ubicacion</span>
          <strong><%= equipo.ubicacion || equipo.laboratorio || '—' %></strong>
        </div>
        <% if (fechaCierreDisplay) { %>
          <div class="col-md-4">
            <span class="text-muted d-block small">Fecha de cierre</span>
            <strong><%= fechaCierreDisplay %></strong>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <% if (!editable) { %>
    <div class="alert alert-warning" role="status" data-testid="hv-mto-editar-bloqueado">
      <i class="bi bi-lock me-2"></i>
      Este mantenimiento esta "<%= estadoEtiqueta %>" y no puede editarse. Si requiere una
      corrección, usa el mecanismo de anulación y nuevo registro.
    </div>
  <% } %>

  <form id="hv-mto-editar-form" data-editable="<%= editable ? 'true' : 'false' %>">
    <section class="card app-table-panel text-light mb-4">
      <div class="card-header">
        <h5 class="mb-0">Datos del mantenimiento</h5>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-8">
            <label for="hv-mto-item" class="form-label">
              Item o descripcion <span class="text-danger">*</span>
            </label>
            <input
              type="text"
              class="form-control"
              id="hv-mto-item"
              name="item"
              value="<%= mantenimiento.item || '' %>"
              required
              <%= editable ? '' : 'disabled' %>
            />
          </div>
          <div class="col-md-4">
            <label for="hv-mto-tipo" class="form-label">
              Tipo de mantenimiento <span class="text-danger">*</span>
            </label>
            <select
              class="form-select"
              id="hv-mto-tipo"
              name="tipo_mantenimiento"
              required
              <%= editable ? '' : 'disabled' %>
            >
              <option value="">Seleccione un tipo...</option>
              <% tiposMantenimiento.forEach(function (tipo) { %>
                <option
                  value="<%= tipo.codigo %>"
                  <%= mantenimiento.tipo_mantenimiento === tipo.codigo ? 'selected' : '' %>
                ><%= tipo.etiqueta %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-4">
            <label for="hv-mto-fecha" class="form-label">Fecha de realizacion</label>
            <input
              type="date"
              class="form-control"
              id="hv-mto-fecha"
              name="fecha_realizacion"
              value="<%= fechaRealizacionValor %>"
              <%= editable ? '' : 'disabled' %>
            />
          </div>
          <div class="col-md-4">
            <label for="hv-mto-responsable" class="form-label">Responsable</label>
            <input
              type="text"
              class="form-control"
              id="hv-mto-responsable"
              name="responsable"
              value="<%= mantenimiento.responsable || '' %>"
              <%= editable ? '' : 'disabled' %>
            />
          </div>
          <div class="col-md-4">
            <label for="hv-mto-garantia" class="form-label">Tiempo de garantia</label>
            <input
              type="text"
              class="form-control"
              id="hv-mto-garantia"
              name="tiempo_garantia"
              value="<%= mantenimiento.tiempo_garantia || '' %>"
              <%= editable ? '' : 'disabled' %>
            />
          </div>
          <div class="col-md-6">
            <label for="hv-mto-empresa" class="form-label">Empresa contratada</label>
            <textarea
              class="form-control"
              id="hv-mto-empresa"
              name="datos_empresa_contratada"
              rows="2"
              <%= editable ? '' : 'disabled' %>
            ><%= mantenimiento.datos_empresa_contratada || '' %></textarea>
          </div>
          <div class="col-md-6">
            <label for="hv-mto-especificaciones" class="form-label"
              >Especificaciones del mantenimiento</label
            >
            <textarea
              class="form-control"
              id="hv-mto-especificaciones"
              name="especificaciones_mantenimiento"
              rows="3"
              <%= editable ? '' : 'disabled' %>
            ><%= mantenimiento.especificaciones_mantenimiento || '' %></textarea>
          </div>
          <div class="col-md-6">
            <label for="hv-mto-repuestos" class="form-label">Observaciones de repuestos</label>
            <textarea
              class="form-control"
              id="hv-mto-repuestos"
              name="observaciones_repuestos"
              rows="3"
              <%= editable ? '' : 'disabled' %>
            ><%= mantenimiento.observaciones_repuestos || '' %></textarea>
          </div>
        </div>
      </div>
    </section>

    <div class="d-flex gap-2 mb-5">
      <% if (editable) { %>
        <button type="submit" class="btn btn-perso" id="hv-mto-editar-btn" data-submit-lock="true">
          <i class="bi bi-save"></i>
          <span>Guardar cambios</span>
        </button>
        <button
          type="button"
          class="btn btn-outline-success"
          id="hv-mto-editar-cerrar"
          data-testid="hv-mto-editar-cerrar"
        >
          <i class="bi bi-check2-circle"></i>
          <span>Cerrar mantenimiento</span>
        </button>
      <% } %>
      <a
        href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/mantenimientos"
        class="btn btn-outline-secondary"
      >
        <%= editable ? 'Cancelar' : 'Volver' %>
      </a>
    </div>

    <div id="hv-mto-editar-loading" class="d-none mb-3">
      <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
      <span class="ms-2">Guardando cambios...</span>
    </div>

    <div id="hv-mto-editar-error" class="d-none mb-3">
      <div class="alert alert-danger" role="alert" id="hv-mto-editar-error-msg"></div>
    </div>
  </form>
</main>

<script nonce="<%= cspNonce %>">
  (function () {
    var equipoId = <%- Number(hojaVida.equipo_id) %>;
    var mantenimientoId = <%- Number(mantenimiento.id) %>;
    var listadoUrl = '/milab/prestamos/hojas-vida/' + equipoId + '/mantenimientos';
    var form = document.getElementById('hv-mto-editar-form');
    var esEditable = form && form.getAttribute('data-editable') === 'true';
    var loading = document.getElementById('hv-mto-editar-loading');
    var errorBox = document.getElementById('hv-mto-editar-error');
    var errorMsg = document.getElementById('hv-mto-editar-error-msg');
    var submitBtn = document.getElementById('hv-mto-editar-btn');
    var cerrarBtn = document.getElementById('hv-mto-editar-cerrar');

    function mostrarError(mensaje) {
      if (loading) loading.classList.add('d-none');
      if (errorMsg) errorMsg.textContent = mensaje;
      if (errorBox) errorBox.classList.remove('d-none');
      if (submitBtn) submitBtn.disabled = false;
      if (cerrarBtn) cerrarBtn.disabled = false;
    }

    if (esEditable && form) {
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        if (errorBox) errorBox.classList.add('d-none');
        if (loading) loading.classList.remove('d-none');
        if (submitBtn) submitBtn.disabled = true;

        var formData = new FormData(form);
        var cuerpo = new URLSearchParams();
        formData.forEach(function (value, key) {
          cuerpo.append(key, value);
        });

        fetch('/milab/api/hojas-vida/' + equipoId + '/mantenimientos/' + mantenimientoId, {
          method: 'PUT',
          credentials: 'same-origin',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
          },
          body: cuerpo.toString(),
        })
          .then(function (res) {
            return res
              .json()
              .then(function (body) {
                return { ok: res.ok && body && body.ok === true, body: body };
              })
              .catch(function () {
                return { ok: false, body: null };
              });
          })
          .then(function (result) {
            if (result.ok) {
              window.location.href = listadoUrl;
              return;
            }
            mostrarError(
              result.body && result.body.message
                ? result.body.message
                : 'No fue posible actualizar el mantenimiento.'
            );
          })
          .catch(function () {
            mostrarError('No se pudo conectar con el servidor. Intenta nuevamente.');
          });
      });
    }

    if (esEditable && cerrarBtn) {
      cerrarBtn.addEventListener('click', function () {
        if (
          !window.confirm(
            '¿Confirmas cerrar este mantenimiento como "Cumplido"? Esta accion no se puede deshacer.'
          )
        ) {
          return;
        }

        cerrarBtn.disabled = true;
        if (loading) loading.classList.remove('d-none');

        var cuerpo = new URLSearchParams();
        cuerpo.append('estado', 'CUMPLIDO');

        fetch('/milab/api/hojas-vida/' + equipoId + '/mantenimientos/' + mantenimientoId + '/estado', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
          },
          body: cuerpo.toString(),
        })
          .then(function (res) {
            return res
              .json()
              .then(function (body) {
                return { ok: res.ok && body && body.ok === true, body: body };
              })
              .catch(function () {
                return { ok: false, body: null };
              });
          })
          .then(function (result) {
            if (result.ok) {
              window.location.href = listadoUrl;
              return;
            }
            mostrarError(
              result.body && result.body.message
                ? result.body.message
                : 'No fue posible cerrar el mantenimiento.'
            );
          })
          .catch(function () {
            mostrarError('No se pudo conectar con el servidor. Intenta nuevamente.');
          });
      });
    }
  })();
</script>

<%- include('../../../partials/footer'); -%>
