<%- include('../../../partials/header'); -%>

<style>
  .hv-example-modal .modal-content {
    overflow: hidden;
    border: 0;
    border-radius: 1rem;
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 28%);
  }

  .hv-example-modal .modal-header {
    color: #fff;
    background: linear-gradient(120deg, #12366a, #2864a8 58%, #22a6a1);
  }

  .hv-example-modal .modal-header .btn-close {
    filter: invert(1) grayscale(100%) brightness(200%);
  }

  .hv-example-sheet {
    overflow: hidden;
    border: 1px solid #d9e2ef;
    border-radius: 0.75rem;
    background: #f7f9fc;
  }

  .hv-example-sheet__bar {
    padding: 0.75rem 1rem;
    color: #34445a;
    background: #eef2f7;
    border-bottom: 1px solid #d9e2ef;
  }

  .hv-example-table {
    min-width: 760px;
    margin: 0;
    background: #fff;
  }

  .hv-example-table th,
  .hv-example-table td {
    vertical-align: middle;
  }

  .hv-example-table__label {
    width: 20%;
    font-weight: 700;
    color: #21456f;
    background: #e9f1fb;
  }

  .hv-example-table__value {
    width: 30%;
    font-weight: 500;
  }
</style>

<main class="container app-page-shell">
  <section class="app-page-header">
    <div class="d-flex align-items-center gap-2 mb-2">
      <a href="/milab/inventarios/hojas-vida" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>
    <h1 class="app-page-title">Cargar Hoja de Vida</h1>
    <p class="app-page-subtitle">
      Sube el archivo Excel o PDF con la informacion del formato SIGUD del equipo.
    </p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="alert"><%= successMessage %></div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header">
      <h5 class="mb-0">Equipo seleccionado</h5>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <span class="text-muted d-block small">Codigo interno</span>
          <strong><%= equipo.codigo || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Codigo inventario</span>
          <strong><%= equipo.codigo_inventario || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Numero de serie</span>
          <strong><%= equipo.numero_serie || '—' %></strong>
        </div>
        <div class="col-md-6">
          <span class="text-muted d-block small">Nombre</span>
          <strong><%= equipo.nombre || equipo.nombre_bien || '—' %></strong>
        </div>
        <div class="col-md-3">
          <span class="text-muted d-block small">Ubicacion</span>
          <strong><%= equipo.ubicacion || equipo.laboratorio || '—' %></strong>
        </div>
        <div class="col-md-3">
          <span class="text-muted d-block small">Facultad</span>
          <strong><%= equipo.facultad || '—' %></strong>
        </div>
      </div>
    </div>
  </section>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header">
      <h5 class="mb-0">Cargar archivo</h5>
    </div>
    <div class="card-body">
      <form id="hv-carga-form" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="hv-archivo" class="form-label">Archivo (Excel o PDF)</label>
          <input
            type="file"
            class="form-control"
            id="hv-archivo"
            name="archivo"
            accept="<%= allowedFormats %>"
            required
          />
          <div class="form-text text-muted">
            Formatos permitidos: <%= allowedFormats %>. Tamano maximo: <%= maxSizeMB %> MB.
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-perso" id="hv-submit-btn" data-submit-lock="true">
            <i class="bi bi-upload"></i>
            <span>Cargar archivo</span>
          </button>
          <a href="/milab/inventarios/hojas-vida" class="btn btn-outline-secondary">
            Cancelar
          </a>
        </div>
      </form>

      <div class="alert alert-info mt-3 mb-0 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h4 class="h6 mb-1">¿Necesitas ver el formato del Excel SIGUD?</h4>
          <p class="mb-0">
            Consulta un ejemplo visual antes de cargar el archivo. Para lectura automática,
            usa preferiblemente <code>.xlsx</code>.
          </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <button
            type="button"
            class="btn btn-outline-primary"
            data-bs-toggle="modal"
            data-bs-target="#hvExcelExampleModal"
            data-testid="hv-ejemplo-excel-btn"
            aria-haspopup="dialog"
          >
            <i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>
            Ver ejemplo del Excel
          </button>
        </div>
      </div>

      <div id="hv-loading" class="d-none mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="ms-2">Procesando archivo...</span>
      </div>

      <div id="hv-error" class="d-none mt-3">
        <div class="alert alert-danger" role="alert" id="hv-error-msg"></div>
      </div>

      <div id="hv-success" class="d-none mt-3">
        <div class="alert alert-success" role="alert" id="hv-success-msg"></div>
        <div id="hv-resultado" class="mt-3"></div>
      </div>
    </div>
  </section>
</main>

<div
  class="modal fade hv-example-modal"
  id="hvExcelExampleModal"
  tabindex="-1"
  aria-labelledby="hvExcelExampleTitle"
  aria-hidden="true"
  data-testid="hv-ejemplo-excel-modal"
>
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <span class="badge rounded-pill text-bg-light mb-2">Ejemplo de formato SIGUD</span>
          <h2 class="modal-title h4" id="hvExcelExampleTitle">Así debe verse el Excel</h2>
          <p class="mb-0 opacity-75">Formato de hoja de vida para lectura automática en MiLab.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body p-4">
        <p>
          MiLab lee el archivo como una hoja de pares <strong>etiqueta - valor</strong>. Las
          etiquetas deben ir en columnas impares, por ejemplo <strong>A, C, E</strong>, y su valor
          correspondiente en la celda siguiente.
        </p>
        <div class="alert alert-warning small">
          <strong>Importante:</strong> el formato <code>.xls</code> se conserva como evidencia,
          pero la lectura automática funciona sobre <code>.xlsx</code>.
        </div>

        <div class="hv-example-sheet">
          <div class="hv-example-sheet__bar d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <strong>Hoja: Hoja de vida</strong>
            <span class="small">Pares etiqueta - valor del formato SIGUD</span>
          </div>
          <div class="table-responsive">
            <table class="table table-bordered hv-example-table">
              <tbody>
                <tr>
                  <th class="hv-example-table__label" scope="row">Nombre del equipo</th>
                  <td class="hv-example-table__value">Microscopio binocular</td>
                  <th class="hv-example-table__label" scope="row">Area</th>
                  <td class="hv-example-table__value">Laboratorio de Microbiologia</td>
                </tr>
                <tr>
                  <th class="hv-example-table__label" scope="row">Modelo</th>
                  <td class="hv-example-table__value">CX23LEDRFS1C</td>
                  <th class="hv-example-table__label" scope="row">Fecha de compra</th>
                  <td class="hv-example-table__value">2024-02-14</td>
                </tr>
                <tr>
                  <th class="hv-example-table__label" scope="row">Año</th>
                  <td class="hv-example-table__value">2024</td>
                  <th class="hv-example-table__label" scope="row">Marca</th>
                  <td class="hv-example-table__value">Olympus</td>
                </tr>
                <tr>
                  <th class="hv-example-table__label" scope="row">Cantidades</th>
                  <td class="hv-example-table__value">1</td>
                  <th class="hv-example-table__label" scope="row">Responsable</th>
                  <td class="hv-example-table__value">Laboratorista de Biologia</td>
                </tr>
                <tr>
                  <th class="hv-example-table__label" scope="row">Supervisor</th>
                  <td class="hv-example-table__value">Coordinacion General de Laboratorios</td>
                  <th class="hv-example-table__label" scope="row">Numero de inventario</th>
                  <td class="hv-example-table__value">INV-2024-0158</td>
                </tr>
                <tr>
                  <th class="hv-example-table__label" scope="row">Funcion</th>
                  <td class="hv-example-table__value">Observacion de muestras biologicas</td>
                  <th class="hv-example-table__label" scope="row">Uso</th>
                  <td class="hv-example-table__value">Academico; Investigacion</td>
                </tr>
                <tr>
                  <th class="hv-example-table__label" scope="row">Descripcion fisica</th>
                  <td class="hv-example-table__value">Equipo de mesa con base metalica y cabezal binocular</td>
                  <th class="hv-example-table__label" scope="row">Especificaciones tecnicas</th>
                  <td class="hv-example-table__value">Ocular WF 10x, objetivo 4x/10x/40x/100x</td>
                </tr>
                <tr>
                  <th class="hv-example-table__label" scope="row">Instrucciones de uso</th>
                  <td class="hv-example-table__value">Encender, ajustar iluminacion y enfocar progresivamente</td>
                  <th class="hv-example-table__label" scope="row">Condiciones de seguridad</th>
                  <td class="hv-example-table__value">Usar con manos secas y cubrir al finalizar</td>
                </tr>
                <tr>
                  <th class="hv-example-table__label" scope="row">Protocolo de limpieza</th>
                  <td class="hv-example-table__value">Limpiar lentes con papel especializado y alcohol isopropilico</td>
                  <th class="hv-example-table__label" scope="row">Foto del equipo</th>
                  <td class="hv-example-table__value">Imagen frontal del equipo</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  (function () {
    const equipoId = <%= equipo.id %>;
    const csrfMeta = document.querySelector('meta[name="csrf-token"]');
    const csrfToken = csrfMeta && csrfMeta.content ? csrfMeta.content : '';
    const form = document.getElementById('hv-carga-form');
    const loading = document.getElementById('hv-loading');
    const errorBox = document.getElementById('hv-error');
    const errorMsg = document.getElementById('hv-error-msg');
    const successBox = document.getElementById('hv-success');
    const successMsg = document.getElementById('hv-success-msg');
    const resultado = document.getElementById('hv-resultado');
    const submitBtn = document.getElementById('hv-submit-btn');

    function mostrarError(mensaje) {
      loading.classList.add('d-none');
      successBox.classList.add('d-none');
      errorMsg.textContent = mensaje;
      errorBox.classList.remove('d-none');
      if (submitBtn) submitBtn.disabled = false;
    }

    function mostrarExito(data) {
      loading.classList.add('d-none');
      errorBox.classList.add('d-none');
      successMsg.textContent = data.message || 'Archivo cargado exitosamente.';
      successBox.classList.remove('d-none');

      let html = '<div class="card card-body bg-dark-subtle border-secondary"><h6 class="mb-2">Campos detectados en el archivo:</h6>';
      const campos = data.campos_extraidos || {};
      const claves = Object.keys(campos);
      if (claves.length === 0) {
        html += '<p class="text-muted mb-2">No se detectaron campos automaticamente. Deberas ingresarlos manualmente en la confirmacion.</p>';
      } else {
        html += '<ul class="mb-2 small">';
        claves.forEach(function (clave) {
          html += '<li><strong>' + clave + ':</strong> ' + String(campos[clave]).substring(0, 80) + '</li>';
        });
        html += '</ul>';
      }
      if (data.advertencia_estructura) {
        html += '<div class="alert alert-warning py-2 px-3 small mb-2">' + data.advertencia_estructura + '</div>';
      }
      html += '<div class="mt-2"><a href="' + data.confirmar_url + '" class="btn btn-perso btn-sm"><i class="bi bi-check-circle"></i> Revisar y confirmar</a></div>';
      html += '</div>';
      resultado.innerHTML = html;

      if (submitBtn) submitBtn.disabled = true;
    }

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      errorBox.classList.add('d-none');
      successBox.classList.add('d-none');

      const input = document.getElementById('hv-archivo');
      const archivo = input.files[0];
      if (!archivo) {
        mostrarError('Debes seleccionar un archivo.');
        return;
      }

      loading.classList.remove('d-none');
      if (submitBtn) submitBtn.disabled = true;

      const formData = new FormData();
      formData.append('archivo', archivo);

      try {
        const response = await fetch('/milab/api/hojas-vida/' + equipoId + '/cargar', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            Accept: 'application/json',
            ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {}),
          },
          body: formData,
        });

        const contentType = response.headers.get('content-type') || '';
        let data = {};
        if (contentType.includes('application/json')) {
          data = await response.json();
        }

        if (response.ok) {
          mostrarExito(data.data || data);
        } else if (response.status === 409) {
          const detalles = data.details || {};
          let msg = data.message || 'El equipo ya tiene una hoja de vida.';
          if (detalles.view_url) {
            msg += ' Puedes <a href="' + detalles.view_url + '">ver la hoja de vida existente</a>.';
          }
          mostrarError(msg);
        } else {
          const message = [data.message, data.message2].filter(Boolean).join('. ');
          mostrarError(message || 'Ocurrio un error al cargar el archivo.');
        }
      } catch (err) {
        mostrarError('No se pudo conectar con el servidor. Intenta nuevamente.');
      }
    });
  })();
</script>

<%- include('../../../partials/footer'); -%>
