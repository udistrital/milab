<%- include('../../../partials/header'); -%>

<main class="container app-page-shell">
  <section class="app-page-header">
    <div class="d-flex align-items-center gap-2 mb-2">
      <a href="/milab/prestamos/hojas-vida" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>
    <h1 class="app-page-title">Cargar Hoja de Vida</h1>
    <p class="app-page-subtitle">
      Sube el archivo Excel o PDF con la informacion del formato SIGUD del equipo.
    </p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="alert"><%= successMessage %></div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header">
      <h5 class="mb-0">Equipo seleccionado</h5>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <span class="text-muted d-block small">Codigo interno</span>
          <strong><%= equipo.codigo || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Codigo inventario</span>
          <strong><%= equipo.codigo_inventario || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Numero de serie</span>
          <strong><%= equipo.numero_serie || '—' %></strong>
        </div>
        <div class="col-md-6">
          <span class="text-muted d-block small">Nombre</span>
          <strong><%= equipo.nombre || equipo.nombre_bien || '—' %></strong>
        </div>
        <div class="col-md-3">
          <span class="text-muted d-block small">Ubicacion</span>
          <strong><%= equipo.ubicacion || equipo.laboratorio || '—' %></strong>
        </div>
        <div class="col-md-3">
          <span class="text-muted d-block small">Facultad</span>
          <strong><%= equipo.facultad || '—' %></strong>
        </div>
      </div>
    </div>
  </section>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header">
      <h5 class="mb-0">Cargar archivo</h5>
    </div>
    <div class="card-body">
      <form id="hv-carga-form" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="hv-archivo" class="form-label">Archivo (Excel o PDF)</label>
          <input
            type="file"
            class="form-control"
            id="hv-archivo"
            name="archivo"
            accept="<%= allowedFormats %>"
            required
          />
          <div class="form-text text-muted">
            Formatos permitidos: <%= allowedFormats %>. Tamano maximo: <%= maxSizeMB %> MB.
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-perso" id="hv-submit-btn" data-submit-lock="true">
            <i class="bi bi-upload"></i>
            <span>Cargar archivo</span>
          </button>
          <a href="/milab/prestamos/hojas-vida" class="btn btn-outline-secondary">
            Cancelar
          </a>
        </div>
      </form>

      <div id="hv-loading" class="d-none mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="ms-2">Procesando archivo...</span>
      </div>

      <div id="hv-error" class="d-none mt-3">
        <div class="alert alert-danger" role="alert" id="hv-error-msg"></div>
      </div>

      <div id="hv-success" class="d-none mt-3">
        <div class="alert alert-success" role="alert" id="hv-success-msg"></div>
        <div id="hv-resultado" class="mt-3"></div>
      </div>
    </div>
  </section>
</main>

<script nonce="<%= cspNonce %>">
  (function () {
    const equipoId = <%= equipo.id %>;
    const form = document.getElementById('hv-carga-form');
    const loading = document.getElementById('hv-loading');
    const errorBox = document.getElementById('hv-error');
    const errorMsg = document.getElementById('hv-error-msg');
    const successBox = document.getElementById('hv-success');
    const successMsg = document.getElementById('hv-success-msg');
    const resultado = document.getElementById('hv-resultado');
    const submitBtn = document.getElementById('hv-submit-btn');

    function mostrarError(mensaje) {
      loading.classList.add('d-none');
      successBox.classList.add('d-none');
      errorMsg.textContent = mensaje;
      errorBox.classList.remove('d-none');
      if (submitBtn) submitBtn.disabled = false;
    }

    function mostrarExito(data) {
      loading.classList.add('d-none');
      errorBox.classList.add('d-none');
      successMsg.textContent = data.message || 'Archivo cargado exitosamente.';
      successBox.classList.remove('d-none');

      let html = '<div class="card card-body bg-dark-subtle border-secondary"><h6 class="mb-2">Campos detectados en el archivo:</h6>';
      const campos = data.campos_extraidos || {};
      const claves = Object.keys(campos);
      if (claves.length === 0) {
        html += '<p class="text-muted mb-2">No se detectaron campos automaticamente. Deberas ingresarlos manualmente en la confirmacion.</p>';
      } else {
        html += '<ul class="mb-2 small">';
        claves.forEach(function (clave) {
          html += '<li><strong>' + clave + ':</strong> ' + String(campos[clave]).substring(0, 80) + '</li>';
        });
        html += '</ul>';
      }
      if (data.advertencia_estructura) {
        html += '<div class="alert alert-warning py-2 px-3 small mb-2">' + data.advertencia_estructura + '</div>';
      }
      html += '<div class="mt-2"><a href="' + data.confirmar_url + '" class="btn btn-perso btn-sm"><i class="bi bi-check-circle"></i> Revisar y confirmar</a></div>';
      html += '</div>';
      resultado.innerHTML = html;

      if (submitBtn) submitBtn.disabled = true;
    }

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      errorBox.classList.add('d-none');
      successBox.classList.add('d-none');

      const input = document.getElementById('hv-archivo');
      const archivo = input.files[0];
      if (!archivo) {
        mostrarError('Debes seleccionar un archivo.');
        return;
      }

      loading.classList.remove('d-none');
      if (submitBtn) submitBtn.disabled = true;

      const formData = new FormData();
      formData.append('archivo', archivo);

      try {
        const response = await fetch('/milab/api/hojas-vida/' + equipoId + '/cargar', {
          method: 'POST',
          body: formData,
        });

        const contentType = response.headers.get('content-type') || '';
        let data = {};
        if (contentType.includes('application/json')) {
          data = await response.json();
        }

        if (response.ok) {
          mostrarExito(data.data || data);
        } else if (response.status === 409) {
          const detalles = data.details || {};
          let msg = data.message || 'El equipo ya tiene una hoja de vida.';
          if (detalles.view_url) {
            msg += ' Puedes <a href="' + detalles.view_url + '">ver la hoja de vida existente</a>.';
          }
          mostrarError(msg);
        } else {
          mostrarError(data.message || 'Ocurrio un error al cargar el archivo.');
        }
      } catch (err) {
        mostrarError('No se pudo conectar con el servidor. Intenta nuevamente.');
      }
    });
  })();
</script>

<%- include('../../../partials/footer'); -%>
