<%- include('../../../partials/header'); -%>

<%
  var totalMantenimientos = mantenimientos.length;
  var enEjecucion = mantenimientos.filter(function (m) { return m.estado === 'EN_EJECUCION'; }).length;
  var vencidos = mantenimientos.filter(function (m) { return m.situacion === 'VENCIDO'; }).length;
  var proximos = mantenimientos.filter(function (m) { return m.situacion === 'PROXIMO_VENCER'; }).length;
%>

<main class="container app-page-shell">
  <section class="app-page-header">
    <div class="d-flex align-items-center gap-2 mb-2">
      <a
        href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>"
        class="btn btn-outline-secondary btn-sm"
      >
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>
    <h1 class="app-page-title">Mantenimientos del Equipo</h1>
    <p class="app-page-subtitle">
      Historial de mantenimientos registrados para el activo, con estado, costos y alertas.
    </p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="alert"><%= successMessage %></div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
      <h5 class="mb-0">Equipo asociado</h5>
      <a
        href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/mantenimientos/nuevo"
        class="btn btn-perso btn-sm"
        data-testid="action-nuevo-mantenimiento"
      >
        <i class="bi bi-plus-circle"></i> Agregar Mantenimiento
      </a>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <span class="text-muted d-block small">Codigo interno</span>
          <strong><%= equipo.codigo || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Nombre</span>
          <strong><%= equipo.nombre || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Ubicacion</span>
          <strong><%= equipo.ubicacion || equipo.laboratorio || '—' %></strong>
        </div>
      </div>
    </div>
  </section>

  <section class="card app-table-panel text-light mb-4" data-testid="hv-mto-resumen">
    <div class="card-header">
      <h5 class="mb-0">Resumen de costos y alertas</h5>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3">
          <span class="text-muted d-block small">Mantenimientos</span>
          <strong data-testid="hv-mto-total"><%= totalMantenimientos %></strong>
        </div>
        <div class="col-md-3">
          <span class="text-muted d-block small">Costo acumulado del equipo</span>
          <strong data-testid="hv-mto-costo-acumulado"><%= costoAcumuladoDisplay %></strong>
        </div>
        <div class="col-md-3">
          <span class="text-muted d-block small">Alertas</span>
          <span class="d-flex gap-1 flex-wrap">
            <span class="badge bg-primary">En ejecución: <%= enEjecucion %></span>
            <span class="badge bg-danger">Vencidos: <%= vencidos %></span>
            <span class="badge bg-warning text-dark">Próximos: <%= proximos %></span>
          </span>
        </div>
        <div class="col-md-3">
          <span class="text-muted d-block small">Ventana de alerta</span>
          <strong><%= diasAlerta %> días antes del vencimiento</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Mantenimientos</h5>
      <span class="badge bg-secondary">
        <%= totalMantenimientos %> mantenimiento<%= totalMantenimientos === 1 ? '' : 's' %>
      </span>
    </div>
    <div class="card-body" id="hv-mto-lista">
      <% if (!totalMantenimientos) { %>
        <div class="alert alert-warning mb-0" data-testid="hv-mto-vacio">
          Aun no hay mantenimientos registrados para este equipo.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-dark table-striped align-middle mb-0">
            <thead>
              <tr>
                <th>Item</th>
                <th>Tipo</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Alerta</th>
                <th>Costo</th>
                <th>Responsable</th>
                <th>Cierre</th>
                <th data-grid-filter="false" data-grid-orderable="false">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% mantenimientos.forEach(function (mantenimiento) { %>
                <tr data-testid="hv-mto-item">
                  <td><%= mantenimiento.item || '—' %></td>
                  <td><%= mantenimiento.tipo_mantenimiento_etiqueta || '—' %></td>
                  <td><%= mantenimiento.fecha_realizacion_display || '—' %></td>
                  <td>
                    <span class="badge bg-<%= mantenimiento.estado_clase %>"><%= mantenimiento.estado_etiqueta %></span>
                  </td>
                  <td>
                    <span class="badge bg-<%= mantenimiento.situacion_clase %>"><%= mantenimiento.situacion_etiqueta %></span>
                    <% if (mantenimiento.dias_restantes !== null && mantenimiento.dias_restantes !== undefined) { %>
                      <small class="d-block text-muted">
                        <%= mantenimiento.dias_restantes >= 0
                          ? mantenimiento.dias_restantes + ' día(s) restantes'
                          : Math.abs(mantenimiento.dias_restantes) + ' día(s) de vencimiento' %>
                      </small>
                    <% } %>
                  </td>
                  <td><%= mantenimiento.costo_display %></td>
                  <td><%= mantenimiento.responsable || '—' %></td>
                  <td><%= mantenimiento.fecha_cierre_display || '—' %></td>
                  <td>
                    <div class="d-flex gap-1 flex-wrap">
                      <% if (mantenimiento.es_editable) { %>
                        <a
                          class="btn btn-outline-warning btn-sm"
                          href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/mantenimientos/<%= mantenimiento.id %>/editar"
                          data-testid="action-editar-mantenimiento"
                        >
                          <i class="bi bi-pencil"></i> Editar
                        </a>
                        <% if (mantenimiento.estado === 'PENDIENTE') { %>
                          <button
                            type="button"
                            class="btn btn-outline-primary btn-sm js-mto-estado"
                            data-mantenimiento-id="<%= mantenimiento.id %>"
                            data-estado="EN_EJECUCION"
                            data-testid="action-iniciar-mantenimiento"
                          >
                            <i class="bi bi-play-circle"></i> En ejecución
                          </button>
                        <% } %>
                        <button
                          type="button"
                          class="btn btn-success btn-sm js-mto-estado"
                          data-mantenimiento-id="<%= mantenimiento.id %>"
                          data-estado="CUMPLIDO"
                          data-testid="action-cerrar-mantenimiento"
                        >
                          <i class="bi bi-check-circle"></i> Cerrar
                        </button>
                        <button
                          type="button"
                          class="btn btn-outline-dark btn-sm js-mto-estado"
                          data-mantenimiento-id="<%= mantenimiento.id %>"
                          data-estado="CANCELADO"
                          data-testid="action-cancelar-mantenimiento"
                        >
                          <i class="bi bi-x-circle"></i> Cancelar
                        </button>
                      <% } else { %>
                        <span class="text-muted small">Registro cerrado</span>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>

  <div id="hv-mto-feedback" class="d-none mb-3" data-testid="hv-mto-feedback">
    <div class="alert alert-info mb-0" role="alert" id="hv-mto-feedback-msg"></div>
  </div>
</main>

<script nonce="<%= cspNonce %>">
  (function () {
    var equipoId = <%- Number(hojaVida.equipo_id) %>;
    var feedback = document.getElementById('hv-mto-feedback');
    var feedbackMsg = document.getElementById('hv-mto-feedback-msg');

    function mostrarFeedback(mensaje, clase) {
      if (!feedback || !feedbackMsg) return;
      feedbackMsg.className = 'alert mb-0 alert-' + (clase || 'info');
      feedbackMsg.textContent = mensaje;
      feedback.classList.remove('d-none');
    }

    document.querySelectorAll('.js-mto-estado').forEach(function (boton) {
      boton.addEventListener('click', function () {
        var mantenimientoId = boton.getAttribute('data-mantenimiento-id');
        var estado = boton.getAttribute('data-estado');
        boton.disabled = true;
        mostrarFeedback('Actualizando el estado del mantenimiento...', 'info');

        fetch(
          '/milab/api/hojas-vida/' +
            equipoId +
            '/mantenimientos/' +
            mantenimientoId +
            '/estado',
          {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            },
            body: new URLSearchParams({ estado: estado }).toString(),
          }
        )
          .then(function (res) {
            return res
              .json()
              .then(function (body) {
                return { ok: res.ok && body && body.ok === true, body: body };
              })
              .catch(function () {
                return { ok: false, body: null };
              });
          })
          .then(function (result) {
            if (result.ok) {
              window.location.reload();
              return;
            }
            boton.disabled = false;
            mostrarFeedback(
              result.body && result.body.message
                ? result.body.message
                : 'No fue posible actualizar el estado del mantenimiento.',
              'danger'
            );
          })
          .catch(function () {
            boton.disabled = false;
            mostrarFeedback('No se pudo conectar con el servidor. Intenta nuevamente.', 'danger');
          });
      });
    });
  })();
</script>

<%- include('../../../partials/footer'); -%>
