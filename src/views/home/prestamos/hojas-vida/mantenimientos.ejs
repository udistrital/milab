<%- include('../../../partials/header'); -%>

<main class="container app-page-shell">
  <section class="app-page-header">
    <div class="d-flex align-items-center gap-2 mb-2">
      <a
        href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>"
        class="btn btn-outline-secondary btn-sm"
      >
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>
    <h1 class="app-page-title">Mantenimientos del Equipo</h1>
    <p class="app-page-subtitle">
      Historial de mantenimientos registrados para el activo.
    </p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="alert"><%= successMessage %></div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
      <h5 class="mb-0">Equipo asociado</h5>
      <a
        href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/mantenimientos/nuevo"
        class="btn btn-perso btn-sm"
        data-testid="action-nuevo-mantenimiento"
      >
        <i class="bi bi-plus-circle"></i> Agregar Mantenimiento
      </a>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <span class="text-muted d-block small">Codigo interno</span>
          <strong><%= equipo.codigo || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Nombre</span>
          <strong><%= equipo.nombre || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Ubicacion</span>
          <strong><%= equipo.ubicacion || equipo.laboratorio || '—' %></strong>
        </div>
      </div>
    </div>
  </section>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Mantenimientos</h5>
      <span class="badge bg-secondary">
        <%= mantenimientos.length %> mantenimiento<%= mantenimientos.length === 1 ? '' : 's' %>
      </span>
    </div>
    <div class="card-body" id="hv-mto-lista">
      <% if (!mantenimientos.length) { %>
        <div class="alert alert-warning mb-0" data-testid="hv-mto-vacio">
          Aun no hay mantenimientos registrados para este equipo.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-dark table-striped align-middle mb-0">
            <thead>
              <tr>
                <th>Item</th>
                <th>Tipo</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Responsable</th>
                <th>Cierre</th>
                <th class="text-center">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% mantenimientos.forEach(function (mantenimiento) { %>
                <tr data-testid="hv-mto-item">
                  <td><%= mantenimiento.item || '—' %></td>
                  <td><%= mantenimiento.tipo_mantenimiento_etiqueta || '—' %></td>
                  <td><%= mantenimiento.fecha_realizacion_display || '—' %></td>
                  <td>
                    <span class="badge bg-<%= mantenimiento.estado_clase %>"><%= mantenimiento.estado_etiqueta %></span>
                  </td>
                  <td><%= mantenimiento.responsable || '—' %></td>
                  <td><%= mantenimiento.fecha_cierre_display || '—' %></td>
                  <td class="text-center">
                    <% if (mantenimiento.editable) { %>
                      <div class="d-inline-flex gap-2">
                        <a
                          href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/mantenimientos/<%= mantenimiento.id %>/editar"
                          class="btn btn-outline-info btn-sm"
                          data-testid="hv-mto-editar"
                        >
                          <i class="bi bi-pencil"></i> Editar
                        </a>
                        <button
                          type="button"
                          class="btn btn-outline-success btn-sm js-mto-cerrar"
                          data-mantenimiento-id="<%= mantenimiento.id %>"
                          data-testid="hv-mto-cerrar"
                        >
                          <i class="bi bi-check2-circle"></i> Cerrar
                        </button>
                      </div>
                    <% } else { %>
                      <span class="text-muted small" data-testid="hv-mto-cerrado">
                        <i class="bi bi-lock"></i> Cerrado
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>
</main>

<script nonce="<%= cspNonce %>">
  (function () {
    var equipoId = <%- Number(hojaVida.equipo_id) %>;

    document.querySelectorAll('.js-mto-cerrar').forEach(function (boton) {
      boton.addEventListener('click', function () {
        var mantenimientoId = Number(boton.getAttribute('data-mantenimiento-id'));
        if (!mantenimientoId) {
          return;
        }

        if (!window.confirm('¿Confirmas cerrar este mantenimiento como "Cumplido"? Esta accion no se puede deshacer.')) {
          return;
        }

        boton.disabled = true;

        var cuerpo = new URLSearchParams();
        cuerpo.append('estado', 'CUMPLIDO');

        fetch('/milab/api/hojas-vida/' + equipoId + '/mantenimientos/' + mantenimientoId + '/estado', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
          },
          body: cuerpo.toString(),
        })
          .then(function (res) {
            return res
              .json()
              .then(function (body) {
                return { ok: res.ok && body && body.ok === true, body: body };
              })
              .catch(function () {
                return { ok: false, body: null };
              });
          })
          .then(function (result) {
            if (result.ok) {
              window.location.reload();
              return;
            }
            boton.disabled = false;
            window.alert(
              result.body && result.body.message
                ? result.body.message
                : 'No fue posible cerrar el mantenimiento.'
            );
          })
          .catch(function () {
            boton.disabled = false;
            window.alert('No se pudo conectar con el servidor. Intenta nuevamente.');
          });
      });
    });
  })();
</script>

<%- include('../../../partials/footer'); -%>
