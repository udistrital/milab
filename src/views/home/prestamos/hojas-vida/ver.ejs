<%- include('../../../partials/header'); -%>

<%
  function formatearValor(valor, tipo) {
    if (valor === null || valor === undefined || valor === '') return '—';
    if (tipo === 'date' || valor instanceof Date) {
      var fecha = new Date(valor);
      if (!isNaN(fecha.getTime())) {
        var pad = function (n) { return String(n).padStart(2, '0'); };
        return pad(fecha.getDate()) + '/' + pad(fecha.getMonth() + 1) + '/' + fecha.getFullYear();
      }
    }
    return String(valor);
  }

  var estado = hojaVida.estado || 'ACTIVA';
  var estadoClase = estado === 'ACTIVA' ? 'success' : 'warning';
  var estadoEtiqueta = estado === 'ACTIVA' ? 'Activa' : 'Pendiente de confirmacion';
  var foto = null;
  (documentos || []).forEach(function (doc) {
    if (doc.tipo_documento === 'FOTOGRAFIA_EQUIPO' && !foto) { foto = doc; }
  });
%>

<main class="container app-page-shell" data-testid="hv-ver">
  <section class="app-page-header">
    <div class="d-flex align-items-center gap-2 mb-2">
      <a href="/milab/inventarios/hojas-vida" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>
    <h1 class="app-page-title">Hoja de Vida del Equipo</h1>
    <p class="app-page-subtitle">
      Informacion documental, tecnica e historica registrada para el activo.
    </p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="alert"><%= successMessage %></div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
      <h5 class="mb-0">Equipo asociado</h5>
      <span class="badge bg-<%= estadoClase %>" data-testid="hv-estado"><%= estadoEtiqueta %></span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <span class="text-muted d-block small">Codigo interno</span>
          <strong><%= equipo.codigo || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Nombre</span>
          <strong><%= equipo.nombre || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Ubicacion</span>
          <strong><%= equipo.ubicacion || equipo.laboratorio || '—' %></strong>
        </div>
      </div>
      <div class="d-flex gap-2 flex-wrap mt-3">
        <a
          href="/milab/inventarios/hojas-vida/<%= hojaVida.equipo_id %>/imprimir"
          target="_blank"
          rel="noopener"
          class="btn btn-perso btn-sm"
          data-testid="action-imprimir-hv"
        >
          <i class="bi bi-printer"></i> Imprimir
        </a>
        <a
          href="/milab/inventarios/hojas-vida/<%= hojaVida.equipo_id %>/mantenimientos"
          class="btn btn-outline-primary btn-sm"
          data-testid="action-mantenimientos-hv"
        >
          <i class="bi bi-tools"></i> Mantenimientos
        </a>
        <a
          href="/milab/inventarios/hojas-vida/<%= hojaVida.equipo_id %>/historial"
          class="btn btn-outline-info btn-sm"
          data-testid="action-historial-hv"
        >
          <i class="bi bi-clock-history"></i> Ver Historial
        </a>
        <a
          href="/milab/inventarios/hojas-vida/<%= hojaVida.equipo_id %>/editar"
          class="btn btn-outline-secondary btn-sm"
          data-testid="action-editar-hv"
        >
          <i class="bi bi-pencil"></i> Editar HV
        </a>
      </div>
    </div>
  </section>

  <% if (foto) { %>
    <section class="card app-table-panel text-light mb-4" data-testid="hv-fotografia">
      <div class="card-header">
        <h5 class="mb-0">Fotografia del equipo</h5>
      </div>
      <div class="card-body text-center">
        <img
          src="/milab/inventarios/hojas-vida/<%= hojaVida.id %>/documento/<%= foto.id %>"
          alt="Fotografia del equipo"
          class="img-fluid rounded"
          style="max-height: 320px;"
        />
      </div>
    </section>
  <% } %>

  <% secciones.forEach(function (grupo) { %>
    <section class="card app-table-panel text-light mb-4">
      <div class="card-header">
        <h5 class="mb-0"><%= grupo.seccion %></h5>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <% grupo.campos.forEach(function (campo) { %>
            <%
              var valor = formatearValor(hojaVida[campo.nombre], campo.tipo);
              var esCompleto = campo.tipo === 'textarea' ? 12 : 4;
            %>
            <div class="col-md-<%= esCompleto %>">
              <span class="text-muted d-block small"><%= campo.etiqueta %></span>
              <span data-testid="hv-ver-campo-<%= campo.nombre %>" style="white-space: pre-line;"><%= valor %></span>
            </div>
          <% }); %>
        </div>
      </div>
    </section>
  <% }); %>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header">
      <h5 class="mb-0">Documentos adjuntos</h5>
    </div>
    <div class="card-body">
      <% if (!documentos || !documentos.length) { %>
        <div class="alert alert-warning mb-0" data-testid="hv-documentos-vacio">
          No hay documentos adjuntos para esta hoja de vida.
        </div>
      <% } else { %>
        <ul class="list-unstyled mb-0">
          <% documentos.forEach(function (doc) { %>
            <li class="mb-2 d-flex align-items-center gap-2 flex-wrap" data-testid="hv-documento">
              <span class="badge bg-secondary"><%= doc.tipo_documento %></span>
              <a
                href="/milab/inventarios/hojas-vida/<%= hojaVida.id %>/documento/<%= doc.id %>"
                target="_blank"
                rel="noopener"
              >
                <i class="bi bi-paperclip me-1"></i><%= doc.nombre_archivo || 'documento' %>
              </a>
              <small class="text-muted"><%= doc.fecha_carga_display || '—' %></small>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </section>
</main>

<%- include('../../../partials/footer'); -%>
