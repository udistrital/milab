<%- include('../../../partials/header'); -%>

<%
  function formatearValor(valor, tipo) {
    if (valor === null || valor === undefined || valor === '') return '—';
    if (tipo === 'date' || valor instanceof Date) {
      var fecha = new Date(valor);
      if (!isNaN(fecha.getTime())) {
        var pad = function (n) { return String(n).padStart(2, '0'); };
        return pad(fecha.getDate()) + '/' + pad(fecha.getMonth() + 1) + '/' + fecha.getFullYear();
      }
    }
    return String(valor);
  }

  var estado = hojaVida.estado || 'ACTIVA';
  var estadoClase = estado === 'ACTIVA' ? 'success' : 'warning';
  var estadoEtiqueta = estado === 'ACTIVA' ? 'Activa' : 'Pendiente de confirmacion';
  var foto = null;
  (documentos || []).forEach(function (doc) {
    if (doc.tipo_documento === 'FOTOGRAFIA_EQUIPO' && !foto) { foto = doc; }
  });
  var listaMantenimientos = typeof mantenimientos !== 'undefined' && mantenimientos ? mantenimientos : [];
  var resumenHV = typeof resumen !== 'undefined' && resumen ? resumen : {};
  var etiquetasDocumento = {
    EXCEL_ORIGEN: 'Documento original (Excel)',
    PDF_ORIGEN: 'Documento original (PDF)',
    FOTOGRAFIA_EQUIPO: 'Fotografía del equipo',
  };
  var claseDocumento = {
    EXCEL_ORIGEN: 'secondary',
    PDF_ORIGEN: 'secondary',
    FOTOGRAFIA_EQUIPO: 'info',
  };
%>

<main class="container app-page-shell" data-testid="hv-ver">
  <section class="app-page-header">
    <div class="d-flex align-items-center gap-2 mb-2">
      <a href="/milab/prestamos/hojas-vida" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>
    <h1 class="app-page-title">Hoja de Vida del Equipo</h1>
    <p class="app-page-subtitle">
      Informacion documental, tecnica e historica registrada para el activo.
    </p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="alert"><%= successMessage %></div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
      <h5 class="mb-0">Equipo asociado</h5>
      <span class="badge bg-<%= estadoClase %>" data-testid="hv-estado"><%= estadoEtiqueta %></span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <span class="text-muted d-block small">Codigo interno</span>
          <strong><%= equipo.codigo || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Nombre</span>
          <strong><%= equipo.nombre || '—' %></strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Ubicacion</span>
          <strong><%= equipo.ubicacion || equipo.laboratorio || '—' %></strong>
        </div>
      </div>
      <div class="d-flex gap-2 flex-wrap mt-3">
        <a
          href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/imprimir"
          target="_blank"
          rel="noopener"
          class="btn btn-perso btn-sm"
          data-testid="action-imprimir-hv"
        >
          <i class="bi bi-printer"></i> Imprimir Hoja de Vida
        </a>
        <a
          href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/mantenimientos"
          class="btn btn-outline-primary btn-sm"
          data-testid="action-mantenimientos-hv"
        >
          <i class="bi bi-tools"></i> Mantenimientos
        </a>
        <a
          href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/mantenimientos/nuevo"
          class="btn btn-outline-primary btn-sm"
          data-testid="action-agregar-mantenimiento-hv"
        >
          <i class="bi bi-plus-lg"></i> Agregar mantenimiento
        </a>
        <a
          href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/historial"
          class="btn btn-outline-info btn-sm"
          data-testid="action-historial-hv"
        >
          <i class="bi bi-clock-history"></i> Ver Historial
        </a>
        <a
          href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/editar"
          class="btn btn-outline-secondary btn-sm"
          data-testid="action-editar-hv"
        >
          <i class="bi bi-pencil"></i> Editar HV
        </a>
      </div>
    </div>
  </section>

  <% if (foto) { %>
    <section class="card app-table-panel text-light mb-4" data-testid="hv-fotografia">
      <div class="card-header">
        <h5 class="mb-0">Fotografia del equipo</h5>
      </div>
      <div class="card-body text-center">
        <img
          src="/milab/prestamos/hojas-vida/<%= hojaVida.id %>/documento/<%= foto.id %>"
          alt="Fotografia del equipo"
          class="img-fluid rounded"
          style="max-height: 320px;"
        />
      </div>
    </section>
  <% } %>

  <% secciones.forEach(function (grupo) { %>
    <section class="card app-table-panel text-light mb-4">
      <div class="card-header">
        <h5 class="mb-0"><%= grupo.seccion %></h5>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <% grupo.campos.forEach(function (campo) { %>
            <%
              var valor;
              if (campo.nombre === 'tipo_uso' && typeof tipoUsoTexto !== 'undefined') {
                valor = tipoUsoTexto || '—';
              } else {
                valor = formatearValor(hojaVida[campo.nombre], campo.tipo);
              }
              var esCompleto = campo.tipo === 'textarea' || campo.tipo === 'uso' ? 12 : 4;
            %>
            <div class="col-md-<%= esCompleto %>">
              <span class="text-muted d-block small"><%= campo.etiqueta %></span>
              <span data-testid="hv-ver-campo-<%= campo.nombre %>" style="white-space: pre-line;"><%= valor %></span>
            </div>
          <% }); %>
        </div>
      </div>
    </section>
  <% }); %>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header">
      <h5 class="mb-0">Documentos adjuntos</h5>
    </div>
    <div class="card-body">
      <% if (!documentos || !documentos.length) { %>
        <div class="alert alert-warning mb-0" data-testid="hv-documentos-vacio">
          No hay documentos adjuntos para esta hoja de vida.
        </div>
      <% } else { %>
        <ul class="list-unstyled mb-0">
          <% documentos.forEach(function (doc) { %>
            <li class="mb-2 d-flex align-items-center gap-2 flex-wrap" data-testid="hv-documento">
              <span class="badge bg-<%= claseDocumento[doc.tipo_documento] || 'secondary' %>">
                <%= etiquetasDocumento[doc.tipo_documento] || doc.tipo_documento %>
              </span>
              <a
                href="/milab/prestamos/hojas-vida/<%= hojaVida.id %>/documento/<%= doc.id %>"
                target="_blank"
                rel="noopener"
              >
                <i class="bi bi-paperclip me-1"></i><%= doc.nombre_archivo || 'documento' %>
              </a>
              <small class="text-muted"><%= doc.fecha_carga_display || '—' %></small>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </section>

  <section class="card app-table-panel text-light mb-4" data-testid="hv-resumen-uso">
    <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
      <h5 class="mb-0">Resumen de mantenimiento y uso</h5>
      <% if (resumenHV.alerta) { %>
        <span class="badge bg-<%= resumenHV.alerta.clase %>" data-testid="hv-alerta-mantenimiento"><%= resumenHV.alerta.etiqueta %></span>
      <% } else { %>
        <span class="badge bg-success" data-testid="hv-alerta-mantenimiento">Mantenimiento vigente</span>
      <% } %>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3">
          <span class="text-muted d-block small">Mantenimientos registrados</span>
          <strong data-testid="hv-resumen-mantenimientos"><%= resumenHV.mantenimientos_total || 0 %></strong>
        </div>
        <div class="col-md-3">
          <span class="text-muted d-block small">Costo acumulado de mantenimiento</span>
          <strong data-testid="hv-resumen-costo"><%= resumenHV.costo_mantenimiento_display || '$0' %></strong>
        </div>
        <div class="col-md-3">
          <span class="text-muted d-block small">Cantidad de prestamos</span>
          <strong data-testid="hv-resumen-prestamos"><%= resumenHV.prestamos_total || 0 %></strong>
        </div>
        <div class="col-md-3">
          <span class="text-muted d-block small">Ventana de alerta</span>
          <strong><%= resumenHV.dias_alerta_vencimiento || 30 %> dias antes del vencimiento</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="card app-table-panel text-light mb-4" data-testid="hv-historial-mantenimientos">
    <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
      <h5 class="mb-0">Historial de mantenimientos</h5>
      <a
        href="/milab/prestamos/hojas-vida/<%= hojaVida.equipo_id %>/mantenimientos/nuevo"
        class="btn btn-outline-primary btn-sm"
        data-testid="action-hv-historial-agregar"
      >
        <i class="bi bi-plus-lg"></i> Agregar mantenimiento
      </a>
    </div>
    <div class="card-body">
      <% if (!listaMantenimientos.length) { %>
        <div class="alert alert-warning mb-0" data-testid="hv-historial-mantenimientos-vacio">
          Aun no hay mantenimientos registrados para este equipo.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-dark table-striped align-middle mb-0">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Descripcion</th>
                <th>Responsable</th>
                <th>Empresa</th>
                <th>Repuestos / Observaciones</th>
                <th>Costo</th>
                <th>Estado</th>
                <th>Fecha de cierre</th>
              </tr>
            </thead>
            <tbody>
              <% listaMantenimientos.forEach(function (mantenimiento) { %>
                <tr data-testid="hv-historial-mantenimiento">
                  <td><%= mantenimiento.fecha_realizacion_display || '—' %></td>
                  <td><%= mantenimiento.tipo_mantenimiento_etiqueta || '—' %></td>
                  <td>
                    <span data-testid="hv-historial-mantenimiento-item"><%= mantenimiento.item || '—' %></span>
                    <% if (mantenimiento.especificaciones_mantenimiento) { %>
                      <small class="d-block text-muted"><%= mantenimiento.especificaciones_mantenimiento %></small>
                    <% } %>
                  </td>
                  <td><%= mantenimiento.responsable || '—' %></td>
                  <td><%= mantenimiento.datos_empresa_contratada || '—' %></td>
                  <td><%= mantenimiento.observaciones_repuestos || '—' %></td>
                  <td><%= mantenimiento.costo_display || '$0' %></td>
                  <td>
                    <span class="badge bg-<%= mantenimiento.estado_clase %>"><%= mantenimiento.estado_etiqueta %></span>
                  </td>
                  <td><%= mantenimiento.fecha_cierre_display || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('../../../partials/footer'); -%>
