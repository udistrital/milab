<%- include('../../../partials/header'); -%>

<main class="container app-page-shell" data-testid="dashboard-hojas-vida">
  <section class="app-page-header">
    <div class="d-flex align-items-center gap-2 mb-2">
      <a href="/milab/inventarios/hojas-vida" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>
    <h1 class="app-page-title">Dashboard de Hojas de Vida y Mantenimientos</h1>
    <p class="app-page-subtitle">
      Consulta el estado de las hojas de vida y el semaforo de mantenimientos segun el alcance de tu rol.
    </p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="alert"><%= successMessage %></div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header">
      <h5 class="mb-0">Filtros</h5>
    </div>
    <div class="card-body">
      <form id="hvdb-filtros" class="row g-3 align-items-end">
        <div class="col-md-3">
          <label for="hvdb-facultad" class="form-label">Facultad</label>
          <select class="form-select" id="hvdb-facultad" name="facultad_id" data-testid="hvdb-facultad">
            <option value="">Todas las facultades de mi alcance</option>
          </select>
        </div>
        <div class="col-md-3">
          <label for="hvdb-laboratorio" class="form-label">Dependencia</label>
          <select class="form-select" id="hvdb-laboratorio" name="ual_id" data-testid="hvdb-dependencia">
            <option value="">Todas las dependencias de mi alcance</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="hvdb-tipo" class="form-label">Tipo</label>
          <select class="form-select" id="hvdb-tipo" name="tipo_mantenimiento">
            <option value="">Todos</option>
            <% tiposMantenimiento.forEach(function (tipo) { %>
              <option value="<%= tipo.codigo %>"><%= tipo.etiqueta %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <label for="hvdb-estado" class="form-label">Estado</label>
          <select class="form-select" id="hvdb-estado" name="estado">
            <option value="">Todos</option>
            <% estadosMantenimiento.forEach(function (estado) { %>
              <option value="<%= estado.codigo %>"><%= estado.etiqueta %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <label for="hvdb-desde" class="form-label">Desde</label>
          <input type="date" class="form-control" id="hvdb-desde" name="fecha_desde" />
        </div>
        <div class="col-md-2">
          <label for="hvdb-hasta" class="form-label">Hasta</label>
          <input type="date" class="form-control" id="hvdb-hasta" name="fecha_hasta" />
        </div>
        <div class="col-md-10 d-flex gap-2">
          <button type="submit" class="btn btn-perso" data-submit-lock="true">
            <i class="bi bi-search"></i>
            <span>Actualizar dashboard</span>
          </button>
          <button type="reset" class="btn btn-outline-secondary" id="hvdb-reset">
            <i class="bi bi-arrow-counterclockwise"></i>
            <span>Limpiar</span>
          </button>
        </div>
      </form>
    </div>
  </section>

  <div id="hvdb-loading" class="alert alert-info">
    <i class="bi bi-hourglass-split me-2"></i>Cargando indicadores...
  </div>

  <div id="hvdb-error" class="alert alert-danger d-none" role="alert">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <span id="hvdb-error-msg">No fue posible generar el dashboard.</span>
  </div>

  <section id="hvdb-kpis" class="dashboard-pys-cards mb-4 d-none">
    <article class="dashboard-pys-card pys-tone-info">
      <span class="dashboard-pys-card-label"><i class="bi bi-journal-medical" aria-hidden="true"></i> Equipos con hoja de vida</span>
      <strong class="dashboard-pys-card-value" data-testid="hvdb-kpi-equipos">0</strong>
      <span class="dashboard-pys-card-hint" id="hvdb-kpi-equipos-detalle"></span>
    </article>
    <article class="dashboard-pys-card pys-tone-warn">
      <span class="dashboard-pys-card-label"><i class="bi bi-hourglass-split" aria-hidden="true"></i> Hojas pendientes de confirmar</span>
      <strong class="dashboard-pys-card-value" data-testid="hvdb-kpi-hojas-pendientes">0</strong>
      <span class="dashboard-pys-card-hint">Requieren confirmacion</span>
    </article>
    <article class="dashboard-pys-card pys-tone-danger">
      <span class="dashboard-pys-card-label"><i class="bi bi-journal-x" aria-hidden="true"></i> Equipos sin hoja de vida</span>
      <strong class="dashboard-pys-card-value" data-testid="hvdb-kpi-sin-hoja">0</strong>
      <span class="dashboard-pys-card-hint">Equipos activos sin registro</span>
    </article>
    <article class="dashboard-pys-card kpi-tone-labs">
      <span class="dashboard-pys-card-label"><i class="bi bi-tools" aria-hidden="true"></i> Mantenimientos</span>
      <strong class="dashboard-pys-card-value" data-testid="hvdb-kpi-mantenimientos">0</strong>
      <span class="dashboard-pys-card-hint" id="hvdb-kpi-mantenimientos-detalle"></span>
    </article>
    <article class="dashboard-pys-card pys-tone-danger">
      <span class="dashboard-pys-card-label"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Mantenimiento vencido</span>
      <strong class="dashboard-pys-card-value" data-testid="hvdb-kpi-mto-vencido">0</strong>
      <span class="dashboard-pys-card-hint">Equipos que requieren atencion</span>
    </article>
    <article class="dashboard-pys-card pys-tone-warn">
      <span class="dashboard-pys-card-label"><i class="bi bi-clock-history" aria-hidden="true"></i> Proximo mantenimiento</span>
      <strong class="dashboard-pys-card-value" data-testid="hvdb-kpi-mto-proximo">0</strong>
      <span class="dashboard-pys-card-hint">Dentro del periodo de alerta</span>
    </article>
    <article class="dashboard-pys-card pys-tone-info">
      <span class="dashboard-pys-card-label"><i class="bi bi-wrench-adjustable" aria-hidden="true"></i> En mantenimiento</span>
      <strong class="dashboard-pys-card-value" data-testid="hvdb-kpi-mto-ejecucion">0</strong>
      <span class="dashboard-pys-card-hint">Trabajos en ejecucion</span>
    </article>
    <article class="dashboard-pys-card pys-tone-ok">
      <span class="dashboard-pys-card-label"><i class="bi bi-check-circle" aria-hidden="true"></i> Mantenimiento al dia</span>
      <strong class="dashboard-pys-card-value" data-testid="hvdb-kpi-mto-vigente">0</strong>
      <span class="dashboard-pys-card-hint">Sin alerta proxima o vencida</span>
    </article>
    <article class="dashboard-pys-card pys-tone-ok">
      <span class="dashboard-pys-card-label"><i class="bi bi-check2-all" aria-hidden="true"></i> Mantenimiento realizado</span>
      <strong class="dashboard-pys-card-value" data-testid="hvdb-kpi-mto-cumplido">0</strong>
      <span class="dashboard-pys-card-hint">Equipos con trabajo cumplido</span>
    </article>
    <article class="dashboard-pys-card pys-tone-info">
      <span class="dashboard-pys-card-label"><i class="bi bi-tools" aria-hidden="true"></i> Sin mantenimiento</span>
      <strong class="dashboard-pys-card-value" data-testid="hvdb-kpi-mto-sin-registro">0</strong>
      <span class="dashboard-pys-card-hint">Equipos sin mantenimiento registrado</span>
    </article>
    <article class="dashboard-pys-card kpi-tone-sanctions">
      <span class="dashboard-pys-card-label"><i class="bi bi-cash-coin" aria-hidden="true"></i> Costo total</span>
      <strong class="dashboard-pys-card-value" data-testid="hvdb-kpi-costo">$0</strong>
      <span class="dashboard-pys-card-hint" id="hvdb-kpi-costo-detalle"></span>
    </article>
  </section>

  <section id="hvdb-charts" class="dashboard-pys-panels d-none">
    <article class="dashboard-pys-panel">
      <h3>Mantenimientos por estado</h3>
      <div class="dashboard-pys-chart dashboard-inventory-chart--doughnut">
        <canvas data-hvdb-chart="estado" role="img" aria-label="Distribucion de mantenimientos por estado"></canvas>
      </div>
    </article>
    <article class="dashboard-pys-panel">
      <h3>Mantenimientos por tipo</h3>
      <div class="dashboard-pys-chart dashboard-inventory-chart">
        <canvas data-hvdb-chart="tipo" role="img" aria-label="Mantenimientos por tipo"></canvas>
      </div>
    </article>
    <article class="dashboard-pys-panel dashboard-gen-panel--wide">
      <h3>Evolucion mensual de mantenimientos</h3>
      <div class="dashboard-pys-chart dashboard-inventory-chart">
        <canvas data-hvdb-chart="periodo" role="img" aria-label="Mantenimientos y costo por mes"></canvas>
      </div>
    </article>
    <article class="dashboard-pys-panel">
      <h3>Equipos por estado de mantenimiento</h3>
      <div class="dashboard-pys-chart dashboard-inventory-chart--doughnut">
        <canvas data-hvdb-chart="situacion" role="img" aria-label="Equipos por estado de mantenimiento"></canvas>
      </div>
    </article>
    <article class="dashboard-pys-panel">
      <h3>Laboratorios con mas mantenimientos</h3>
      <div class="dashboard-pys-chart dashboard-inventory-chart">
        <canvas data-hvdb-chart="laboratorios" role="img" aria-label="Mantenimientos por laboratorio"></canvas>
      </div>
    </article>
    <article class="dashboard-pys-panel dashboard-gen-panel--wide">
      <h3>Equipos con mayor costo de mantenimiento</h3>
      <div class="dashboard-pys-chart dashboard-inventory-chart--tall">
        <canvas data-hvdb-chart="equipos" role="img" aria-label="Equipos con mayor costo de mantenimiento"></canvas>
      </div>
    </article>
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script nonce="<%= cspNonce %>">
  (function () {
    var ENDPOINT = '/milab/api/hojas-vida/dashboard';
    var FILTER_OPTIONS_ENDPOINT = '/milab/api/hojas-vida/dashboard/opciones';
    var formEl = document.getElementById('hvdb-filtros');
    var resetBtn = document.getElementById('hvdb-reset');
    var facultadEl = document.getElementById('hvdb-facultad');
    var dependenciaEl = document.getElementById('hvdb-laboratorio');
    var loadingEl = document.getElementById('hvdb-loading');
    var errorEl = document.getElementById('hvdb-error');
    var errorMsgEl = document.getElementById('hvdb-error-msg');
    var kpisEl = document.getElementById('hvdb-kpis');
    var chartsEl = document.getElementById('hvdb-charts');
    var chartInstances = {};

    var CHART_COLORS = {
      blue: '#1f7aec',
      green: '#219653',
      amber: '#e08a00',
      red: '#d62839',
      teal: '#0f9fb5',
      purple: '#7b4fd6',
      slate: '#5e7178',
      orange: '#f2700d',
      pink: '#d6409f',
    };

    function getChartTheme() {
      var styles = getComputedStyle(document.documentElement);
      return {
        text: styles.getPropertyValue('--app-text-main').trim() || '#171717',
        muted: styles.getPropertyValue('--app-text-muted').trim() || '#5f5a53',
        grid: styles.getPropertyValue('--app-chart-grid').trim() || 'rgba(23, 23, 23, 0.1)',
        surface: styles.getPropertyValue('--app-surface-strong').trim() || '#fffaf3',
      };
    }

    function hexToRgba(hex, alpha) {
      var value = String(hex || '').replace('#', '');
      var red = parseInt(value.slice(0, 2), 16);
      var green = parseInt(value.slice(2, 4), 16);
      var blue = parseInt(value.slice(4, 6), 16);
      return 'rgba(' + red + ', ' + green + ', ' + blue + ', ' + alpha + ')';
    }

    function buildAreaGradient(color) {
      return function (context) {
        var chart = context.chart;
        var area = chart.chartArea;
        if (!area) return hexToRgba(color, 0.15);
        var gradient = chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
        gradient.addColorStop(0, hexToRgba(color, 0.32));
        gradient.addColorStop(1, hexToRgba(color, 0.02));
        return gradient;
      };
    }

    function actualizarDependencias() {
      var facultadId = facultadEl.value;
      Array.prototype.forEach.call(dependenciaEl.options, function (option, index) {
        if (index === 0) return;
        var coincide = !facultadId || option.getAttribute('data-facultad-id') === facultadId;
        option.hidden = !coincide;
        option.disabled = !coincide;
      });
      var seleccionada = dependenciaEl.options[dependenciaEl.selectedIndex];
      if (seleccionada && seleccionada.disabled) dependenciaEl.value = '';
    }

    function cargarOpcionesFiltros() {
      return fetch(FILTER_OPTIONS_ENDPOINT, {
        method: 'GET',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      })
        .then(function (res) {
          return res.json().then(function (body) {
            return { ok: res.ok && body && body.ok === true, body: body };
          });
        })
        .then(function (result) {
          if (!result.ok) {
            throw new Error(
              (result.body && result.body.message) ||
                'No fue posible cargar las facultades y dependencias de tu alcance.'
            );
          }
          var data = result.body.data || {};
          (data.faculties || []).forEach(function (faculty) {
            var option = document.createElement('option');
            option.value = String(faculty.id);
            option.textContent = faculty.nombre;
            facultadEl.appendChild(option);
          });
          (data.dependencies || []).forEach(function (dependency) {
            var option = document.createElement('option');
            option.value = String(dependency.id);
            option.textContent = dependency.nombre;
            option.setAttribute('data-facultad-id', String(dependency.facultad_id));
            dependenciaEl.appendChild(option);
          });
          actualizarDependencias();
        });
    }

    var ESTADO_COLORES = {
      PENDIENTE: CHART_COLORS.amber,
      EN_EJECUCION: CHART_COLORS.blue,
      CUMPLIDO: CHART_COLORS.green,
      VENCIDO: CHART_COLORS.red,
      CANCELADO: CHART_COLORS.slate,
    };
    var PALETA = [
      CHART_COLORS.blue,
      CHART_COLORS.amber,
      CHART_COLORS.purple,
      CHART_COLORS.teal,
      CHART_COLORS.pink,
      CHART_COLORS.green,
      CHART_COLORS.orange,
      CHART_COLORS.slate,
    ];
    var SITUACION_COLORES = {
      VENCIDO: CHART_COLORS.red,
      PROXIMO_VENCER: CHART_COLORS.amber,
      EN_EJECUCION: CHART_COLORS.blue,
      VIGENTE: CHART_COLORS.green,
      CUMPLIDO: CHART_COLORS.teal,
      SIN_MANTENIMIENTO: CHART_COLORS.slate,
    };

    function numero(valor) {
      try {
        return new Intl.NumberFormat('es-CO').format(Number(valor || 0));
      } catch (e) {
        return String(Number(valor || 0));
      }
    }

    function moneda(valor) {
      try {
        return new Intl.NumberFormat('es-CO', {
          style: 'currency',
          currency: 'COP',
          maximumFractionDigits: 0,
        }).format(Number(valor || 0));
      } catch (e) {
        return '$' + Number(valor || 0);
      }
    }

    function toggle(el, visible) {
      if (!el) return;
      if (visible) el.classList.remove('d-none');
      else el.classList.add('d-none');
    }

    function renderChart(nombre, canvas, config) {
      if (!canvas || typeof window.Chart === 'undefined') return;
      if (chartInstances[nombre]) chartInstances[nombre].destroy();
      chartInstances[nombre] = new window.Chart(canvas, config);
    }

    function render(data) {
      var theme = getChartTheme();
      var resumen = (data && data.resumen) || {};
      document.querySelector('[data-testid="hvdb-kpi-equipos"]').textContent = numero(
        resumen.equipos_con_hoja_vida
      );
      document.getElementById('hvdb-kpi-equipos-detalle').textContent =
        numero(resumen.hojas_activas) +
        ' hojas activas';

      document.querySelector('[data-testid="hvdb-kpi-hojas-pendientes"]').textContent = numero(
        resumen.hojas_pendientes
      );
      document.querySelector('[data-testid="hvdb-kpi-sin-hoja"]').textContent = numero(
        resumen.equipos_sin_hoja_vida
      );

      document.querySelector('[data-testid="hvdb-kpi-mantenimientos"]').textContent = numero(
        resumen.mantenimientos_total
      );
      document.getElementById('hvdb-kpi-mantenimientos-detalle').textContent =
        'Registros · promedio ' + moneda(resumen.costo_promedio);

      var mantenimiento = resumen.mantenimiento_por_situacion || {};
      document.querySelector('[data-testid="hvdb-kpi-mto-vencido"]').textContent = numero(
        mantenimiento.VENCIDO
      );
      document.querySelector('[data-testid="hvdb-kpi-mto-proximo"]').textContent = numero(
        mantenimiento.PROXIMO_VENCER
      );
      document.querySelector('[data-testid="hvdb-kpi-mto-ejecucion"]').textContent = numero(
        mantenimiento.EN_EJECUCION
      );
      document.querySelector('[data-testid="hvdb-kpi-mto-vigente"]').textContent = numero(
        mantenimiento.VIGENTE
      );
      document.querySelector('[data-testid="hvdb-kpi-mto-cumplido"]').textContent = numero(
        mantenimiento.CUMPLIDO
      );
      document.querySelector('[data-testid="hvdb-kpi-mto-sin-registro"]').textContent = numero(
        mantenimiento.SIN_MANTENIMIENTO
      );

      document.querySelector('[data-testid="hvdb-kpi-costo"]').textContent = moneda(
        resumen.costo_total
      );
      document.getElementById('hvdb-kpi-costo-detalle').textContent =
        'Equipos activos: ' + numero(resumen.equipos_total);

      toggle(kpisEl, true);
      toggle(chartsEl, true);

      if (typeof window.Chart === 'undefined') return;

      var porEstado = data.por_estado || [];
      renderChart('estado', document.querySelector('[data-hvdb-chart="estado"]'), {
        type: 'doughnut',
        data: {
          labels: porEstado.map(function (item) {
            return item.etiqueta;
          }),
          datasets: [
            {
              data: porEstado.map(function (item) {
                return item.total;
              }),
              backgroundColor: porEstado.map(function (item) {
                return ESTADO_COLORES[item.estado] || '#64748b';
              }),
              borderColor: theme.surface,
              borderWidth: 2,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '62%',
          plugins: {
            legend: {
              position: 'right',
              labels: { color: theme.text, boxWidth: 10, boxHeight: 10, font: { size: 11 } },
            },
          },
        },
      });

      var porTipo = data.por_tipo || [];
      renderChart('tipo', document.querySelector('[data-hvdb-chart="tipo"]'), {
        type: 'bar',
        data: {
          labels: porTipo.map(function (item) {
            return item.etiqueta;
          }),
          datasets: [
            {
              label: 'Mantenimientos',
              data: porTipo.map(function (item) {
                return item.total;
              }),
              backgroundColor: porTipo.map(function (_, index) {
                return PALETA[index % PALETA.length];
              }),
              borderRadius: 6,
              maxBarThickness: 24,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: {
              ticks: { color: theme.muted, font: { size: 11 } },
              grid: { display: false },
            },
            y: {
              beginAtZero: true,
              ticks: { color: theme.muted, precision: 0, font: { size: 11 } },
              grid: { color: theme.grid },
            },
          },
        },
      });

      var porPeriodo = data.por_periodo || [];
      renderChart('periodo', document.querySelector('[data-hvdb-chart="periodo"]'), {
        type: 'line',
        data: {
          labels: porPeriodo.map(function (item) {
            return item.periodo;
          }),
          datasets: [
            {
              label: 'Mantenimientos',
              data: porPeriodo.map(function (item) {
                return item.total;
              }),
              borderColor: CHART_COLORS.blue,
              backgroundColor: buildAreaGradient(CHART_COLORS.blue),
              fill: true,
              tension: 0.35,
              pointBackgroundColor: CHART_COLORS.blue,
              pointBorderColor: theme.surface,
              pointBorderWidth: 2,
              pointRadius: 3,
              borderWidth: 3,
            },
            {
              label: 'Costo',
              data: porPeriodo.map(function (item) {
                return item.costo;
              }),
              borderColor: CHART_COLORS.amber,
              backgroundColor: buildAreaGradient(CHART_COLORS.amber),
              fill: false,
              tension: 0.35,
              pointBackgroundColor: CHART_COLORS.amber,
              pointBorderColor: theme.surface,
              pointBorderWidth: 2,
              pointRadius: 3,
              borderWidth: 3,
              yAxisID: 'yCosto',
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: { color: theme.text, boxWidth: 10, boxHeight: 10, font: { size: 11 } },
            },
          },
          scales: {
            x: { ticks: { color: theme.muted, font: { size: 11 } }, grid: { display: false } },
            y: {
              beginAtZero: true,
              ticks: { color: theme.muted, precision: 0, font: { size: 11 } },
              grid: { color: theme.grid },
              title: { display: true, text: 'Mantenimientos', color: theme.text },
            },
            yCosto: {
              beginAtZero: true,
              position: 'right',
              ticks: { color: theme.muted, font: { size: 11 } },
              grid: { display: false },
            },
          },
        },
      });

      var semaforo = [
        { situacion: 'VENCIDO', etiqueta: 'Vencido', total: mantenimiento.VENCIDO },
        {
          situacion: 'PROXIMO_VENCER',
          etiqueta: 'Proximo mantenimiento',
          total: mantenimiento.PROXIMO_VENCER,
        },
        {
          situacion: 'EN_EJECUCION',
          etiqueta: 'En mantenimiento',
          total: mantenimiento.EN_EJECUCION,
        },
        { situacion: 'VIGENTE', etiqueta: 'Al dia', total: mantenimiento.VIGENTE },
        { situacion: 'CUMPLIDO', etiqueta: 'Realizado', total: mantenimiento.CUMPLIDO },
        {
          situacion: 'SIN_MANTENIMIENTO',
          etiqueta: 'Sin mantenimiento',
          total: mantenimiento.SIN_MANTENIMIENTO,
        },
      ];
      renderChart('situacion', document.querySelector('[data-hvdb-chart="situacion"]'), {
        type: 'doughnut',
        data: {
          labels: semaforo.map(function (item) {
            return item.etiqueta;
          }),
          datasets: [
            {
              data: semaforo.map(function (item) {
                return item.total;
              }),
              backgroundColor: semaforo.map(function (item) {
                return SITUACION_COLORES[item.situacion] || '#64748b';
              }),
              borderColor: theme.surface,
              borderWidth: 2,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '62%',
          plugins: {
            legend: {
              position: 'right',
              labels: { color: theme.text, boxWidth: 10, boxHeight: 10, font: { size: 11 } },
            },
          },
        },
      });

      var porLaboratorio = (data.por_laboratorio || []).slice(0, 8);
      renderChart('laboratorios', document.querySelector('[data-hvdb-chart="laboratorios"]'), {
        type: 'bar',
        data: {
          labels: porLaboratorio.map(function (item) {
            return item.laboratorio;
          }),
          datasets: [
            {
              label: 'Mantenimientos',
              data: porLaboratorio.map(function (item) {
                return item.total;
              }),
              backgroundColor: CHART_COLORS.purple,
              borderRadius: 6,
              maxBarThickness: 18,
            },
          ],
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: {
              beginAtZero: true,
              ticks: { color: theme.muted, precision: 0, font: { size: 11 } },
              grid: { color: theme.grid },
            },
            y: {
              ticks: { color: theme.text, font: { size: 11 } },
              grid: { display: false },
            },
          },
        },
      });

      var equipos = data.top_equipos_costo || [];
      renderChart('equipos', document.querySelector('[data-hvdb-chart="equipos"]'), {
        type: 'bar',
        data: {
          labels: equipos.map(function (item) {
            return item.equipo_nombre || item.equipo_codigo || 'Equipo';
          }),
          datasets: [
            {
              label: 'Costo',
              data: equipos.map(function (item) {
                return item.costo;
              }),
              backgroundColor: CHART_COLORS.teal,
              borderRadius: 6,
              maxBarThickness: 18,
            },
          ],
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: {
              beginAtZero: true,
              ticks: {
                color: theme.muted,
                font: { size: 11 },
                callback: function (value) {
                  return moneda(value);
                },
              },
            },
            y: {
              ticks: { color: theme.text, font: { size: 11 } },
              grid: { display: false },
            },
          },
        },
      });
    }

    function cargar() {
      loadingEl.classList.remove('d-none');
      errorEl.classList.add('d-none');

      var formData = new FormData(formEl);
      var params = new URLSearchParams();
      formData.forEach(function (value, key) {
        var val = String(value || '').trim();
        if (val) params.append(key, val);
      });
      var qs = params.toString();
      var url = qs ? ENDPOINT + '?' + qs : ENDPOINT;

      fetch(url, {
        method: 'GET',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      })
        .then(function (res) {
          return res
            .json()
            .then(function (body) {
              return { ok: res.ok && body && body.ok === true, body: body };
            })
            .catch(function () {
              return { ok: false, body: null };
            });
        })
        .then(function (result) {
          loadingEl.classList.add('d-none');
          if (result.ok) {
            render(result.body.data || {});
            return;
          }
          errorMsgEl.textContent =
            result.body && result.body.message
              ? result.body.message
              : 'No fue posible generar el dashboard.';
          errorEl.classList.remove('d-none');
        })
        .catch(function () {
          loadingEl.classList.add('d-none');
          errorMsgEl.textContent = 'No se pudo conectar con el servidor. Intenta nuevamente.';
          errorEl.classList.remove('d-none');
        });
    }

    formEl.addEventListener('submit', function (event) {
      event.preventDefault();
      cargar();
    });

    facultadEl.addEventListener('change', actualizarDependencias);
    dependenciaEl.addEventListener('change', function () {
      var seleccionada = dependenciaEl.options[dependenciaEl.selectedIndex];
      var facultadId = seleccionada && seleccionada.getAttribute('data-facultad-id');
      if (facultadId) {
        facultadEl.value = facultadId;
        actualizarDependencias();
        dependenciaEl.value = seleccionada.value;
      }
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        setTimeout(function () {
          actualizarDependencias();
          cargar();
        }, 0);
      });
    }

    cargarOpcionesFiltros()
      .then(cargar)
      .catch(function (error) {
        loadingEl.classList.add('d-none');
        errorMsgEl.textContent = error.message || 'No se pudieron cargar los filtros de alcance.';
        errorEl.classList.remove('d-none');
      });
  })();
</script>

<%- include('../../../partials/footer'); -%>
