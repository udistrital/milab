<%- include('../../../partials/header'); -%>

<main class="container app-page-shell" data-testid="reportes-alertas">
  <section class="app-page-header">
    <div class="d-flex align-items-center gap-2 mb-2">
      <a href="/milab/prestamos/hojas-vida" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>
    <h1 class="app-page-title">Equipos con Alertas de Mantenimiento</h1>
    <p class="app-page-subtitle">
      Equipos que requieren mantenimiento, estan proximos, vencidos o actualmente en mantenimiento.
    </p>
  </section>

  <div id="ra-loading" class="alert alert-info">
    <i class="bi bi-hourglass-split me-2"></i>Cargando alertas...
  </div>

  <div id="ra-error" class="alert alert-danger d-none" role="alert">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <span id="ra-error-msg">No fue posible generar el reporte.</span>
  </div>

  <section id="ra-resumen" class="card app-table-panel text-light mb-4 d-none">
    <div class="card-header">
      <h5 class="mb-0">Resumen</h5>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <span class="text-muted d-block small">Equipos con alerta</span>
          <strong data-testid="ra-total">0</strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Ventana de alerta</span>
          <strong><span data-testid="ra-dias-alerta">30</span> dias antes del vencimiento</strong>
        </div>
        <div class="col-md-4">
          <span class="text-muted d-block small">Por situacion</span>
          <span id="ra-por-situacion" class="d-flex gap-1 flex-wrap"></span>
        </div>
      </div>
    </div>
  </section>

  <section id="ra-panel" class="card app-table-panel text-light mb-4 d-none">
    <div class="card-header">
      <h5 class="mb-0">Detalle de equipos con alerta</h5>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-dark table-striped align-middle mb-0">
          <thead>
            <tr>
              <th>Equipo</th>
              <th>Codigo inventario</th>
              <th>Laboratorio / UAL</th>
              <th>Facultad</th>
              <th>Tipo</th>
              <th>Fecha programada</th>
              <th>Estado</th>
              <th>Alerta</th>
              <th>Dias restantes / vencimiento</th>
            </tr>
          </thead>
          <tbody id="ra-tbody"></tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<script nonce="<%= cspNonce %>">
  (function () {
    var ENDPOINT = '/milab/api/hojas-vida/reportes/alertas';
    var loadingEl = document.getElementById('ra-loading');
    var errorEl = document.getElementById('ra-error');
    var errorMsgEl = document.getElementById('ra-error-msg');
    var resumenEl = document.getElementById('ra-resumen');
    var panelEl = document.getElementById('ra-panel');
    var tbodyEl = document.getElementById('ra-tbody');

    function escapeHtml(str) {
      var s = str == null ? '' : String(str);
      return s.replace(/[&<>"]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
      });
    }

    function formatearFecha(valor) {
      if (!valor) return '-';
      var texto = String(valor).slice(0, 10);
      var partes = texto.split('-');
      if (partes.length === 3) return partes[2] + '/' + partes[1] + '/' + partes[0];
      return texto;
    }

    function textoDias(fila) {
      var dias = fila.dias_restantes;
      if (dias === null || dias === undefined) return '-';
      if (dias >= 0) return dias + ' dia(s) restantes';
      return Math.abs(dias) + ' dia(s) de vencimiento';
    }

    function toggle(panel, visible) {
      if (!panel) return;
      if (visible) panel.classList.remove('d-none');
      else panel.classList.add('d-none');
    }

    function render(data) {
      document.querySelector('[data-testid="ra-total"]').textContent = String(data.total || 0);
      document.querySelector('[data-testid="ra-dias-alerta"]').textContent = String(
        data.dias_alerta_vencimiento || 30
      );

      var porSituacionEl = document.getElementById('ra-por-situacion');
      porSituacionEl.innerHTML = '';
      var porSituacion = data.por_situacion || {};
      Object.keys(porSituacion).forEach(function (clave) {
        var span = document.createElement('span');
        span.className = 'badge bg-secondary';
        span.textContent = clave + ': ' + porSituacion[clave];
        porSituacionEl.appendChild(span);
      });

      var alertas = data.alertas || [];
      tbodyEl.innerHTML = '';
      alertas.forEach(function (fila) {
        var tr = document.createElement('tr');
        tr.setAttribute('data-testid', 'ra-item');
        tr.innerHTML =
          '<td>' + (escapeHtml(fila.equipo_nombre) || '-') + '</td>' +
          '<td>' + (escapeHtml(fila.codigo_inventario) || '-') + '</td>' +
          '<td>' + (escapeHtml(fila.laboratorio) || '-') + '</td>' +
          '<td>' + (escapeHtml(fila.facultad) || '-') + '</td>' +
          '<td>' + (escapeHtml(fila.tipo_mantenimiento_etiqueta) || '-') + '</td>' +
          '<td>' + formatearFecha(fila.fecha_programada) + '</td>' +
          '<td>' + (escapeHtml(fila.estado_etiqueta) || '-') + '</td>' +
          '<td><span class="badge bg-' + escapeHtml(fila.situacion_clase) + '">' +
          (escapeHtml(fila.situacion_etiqueta) || '-') + '</span></td>' +
          '<td>' + escapeHtml(textoDias(fila)) + '</td>';
        tbodyEl.appendChild(tr);
      });

      toggle(resumenEl, true);
      toggle(panelEl, alertas.length > 0);
    }

    fetch(ENDPOINT, {
      method: 'GET',
      credentials: 'same-origin',
      headers: { Accept: 'application/json' },
    })
      .then(function (res) {
        return res
          .json()
          .then(function (body) {
            return { ok: res.ok && body && body.ok === true, body: body };
          })
          .catch(function () {
            return { ok: false, body: null };
          });
      })
      .then(function (result) {
        loadingEl.classList.add('d-none');
        if (result.ok) {
          render(result.body.data || {});
          return;
        }
        errorMsgEl.textContent =
          result.body && result.body.message
            ? result.body.message
            : 'No fue posible generar el reporte.';
        errorEl.classList.remove('d-none');
      })
      .catch(function () {
        loadingEl.classList.add('d-none');
        errorMsgEl.textContent = 'No se pudo conectar con el servidor. Intenta nuevamente.';
        errorEl.classList.remove('d-none');
      });
  })();
</script>

<%- include('../../../partials/footer'); -%>
