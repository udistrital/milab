<%- include('../../../partials/header'); -%>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Gestión laboratorio</h1>
    <p class="app-page-subtitle">
      <strong><%= laboratorio.laboratorio %></strong> · <%= laboratorio.facultad %>
      <% if (laboratorio.dependencia) { %> · <%= laboratorio.dependencia %><% } %>
    </p>
  </section>

  <section class="row g-2 mb-3" aria-label="Estadísticas del laboratorio">
    <div class="col-6 col-xl-3"><div class="card app-table-panel text-light p-3">Préstamos activos: <strong><%= stats.activos %></strong></div></div>
    <div class="col-6 col-xl-3"><div class="card app-table-panel text-light p-3">Solicitudes pendientes: <strong><%= stats.pendientes %></strong></div></div>
    <div class="col-6 col-xl-3"><div class="card app-table-panel text-light p-3">Préstamos finalizados: <strong><%= stats.finalizados %></strong></div></div>
    <div class="col-6 col-xl-3"><div class="card app-table-panel text-light p-3">Equipos disponibles: <strong><%= stats.disponibles %></strong></div></div>
  </section>

  <div class="alert alert-info" role="status">
    No tienes submódulos disponibles para este laboratorio según los permisos asignados.
  </div>
</main>

<%- include('../../../partials/footer'); -%>
