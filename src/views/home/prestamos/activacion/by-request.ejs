<%- include('../../../partials/header'); -%>

<style>
  .by-request-poster {
    max-width: 900px;
    margin: 0 auto;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(135deg, #0b132b 0%, #1c2541 52%, #3a506b 100%);
    color: #ffffff;
  }

  .by-request-poster__brand {
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    text-transform: uppercase;
    color: #9bd1ff;
  }

  .by-request-poster__qr {
    width: 270px;
    height: 270px;
    border-radius: 1rem;
    background: #ffffff;
    padding: 0.85rem;
  }
</style>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Poster QR · Préstamos by Request</h1>
    <p class="app-page-subtitle">
      <strong><%= laboratorio.laboratorio %></strong> · <%= laboratorio.facultad %>
    </p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="status"><%= successMessage %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="by-request-poster p-4 p-lg-5 shadow-lg">
    <div class="d-flex flex-column flex-lg-row align-items-center justify-content-between gap-4">
      <div class="pe-lg-4">
        <div class="by-request-poster__brand mb-2">
          <i class="bi bi-qr-code-scan me-1"></i> MiLab · Solicitud de préstamo
        </div>
        <h2 class="h3 mb-3">
          Escanea y solicita equipos para este laboratorio
        </h2>
        <p class="mb-3 text-light-emphasis">
          Acceso directo al flujo de solicitud de equipos con laboratorio precargado.
        </p>
        <ul class="mb-0 ps-3">
          <li>Laboratorio: <strong><%= laboratorio.laboratorio %></strong></li>
          <li>Facultad: <strong><%= laboratorio.facultad %></strong></li>
          <li>Ruta: <code class="text-info"><%= byRequestPath %></code></li>
        </ul>
      </div>
      <div class="text-center">
        <img class="by-request-poster__qr" src="<%= qrDataUrl %>" alt="Código QR de préstamo by request">
        <div class="small mt-2 text-light-emphasis">Escanéame</div>
      </div>
    </div>
  </section>

  <section class="d-flex flex-wrap gap-2 justify-content-end mt-4">
    <a class="btn btn-outline-light btn-sm" href="/milab/prestamos/activacion/laboratorios/<%= laboratorio.ualId %>">
      Volver al wizard
    </a>
    <a class="btn btn-outline-info btn-sm" href="/milab/prestamos/activacion/laboratorios/<%= laboratorio.ualId %>/by-request/qr.png">
      Descargar QR PNG
    </a>
    <button class="btn btn-perso btn-sm" type="button" onclick="window.print()">
      Imprimir / Guardar PDF
    </button>
  </section>
</main>

<%- include('../../../partials/footer'); -%>
