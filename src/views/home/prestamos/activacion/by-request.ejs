<%- include('../../../partials/header'); -%>

<style>
  .by-request-shell {
    max-width: 960px;
    margin: 0 auto;
  }

  .by-request-card {
    border-radius: 1rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
    background: #ffffff;
  }

  .by-request-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 999px;
    padding: 0.28rem 0.65rem;
    background: rgba(244, 163, 0, 0.14);
    color: #b45309;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .by-request-card__title {
    margin: 0.5rem 0 0.6rem;
    font-size: 1.7rem;
    font-weight: 800;
    color: #0f172a;
  }

  .by-request-card__qr-wrap {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1rem;
    display: inline-flex;
  }

  .by-request-card__qr {
    width: 320px;
    height: 320px;
    display: block;
  }

  .by-request-card__url {
    font-size: 0.79rem;
    word-break: break-all;
    color: #64748b;
  }

  @media (max-width: 767.98px) {
    .by-request-card__qr {
      width: 260px;
      height: 260px;
    }
  }
</style>

<main class="container app-page-shell">
  <section class="app-page-header by-request-shell">
    <h1 class="app-page-title">Plantilla QR · Solicitudes de préstamo</h1>
    <p class="app-page-subtitle">
      <strong><%= laboratorio.laboratorio %></strong> · <%= laboratorio.facultad %>
    </p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="status"><%= successMessage %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="by-request-shell">
    <div class="card by-request-card p-4 p-lg-5">
      <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-7">
          <span class="by-request-card__badge">
            <i class="bi bi-qr-code-scan"></i> MiLab · Solicitud de préstamo
          </span>
          <h2 class="by-request-card__title">Escanea para solicitar préstamos de este laboratorio</h2>
          <p class="text-muted mb-3">
            Comparte este código con estudiantes y docentes para abrir la solicitud con laboratorio precargado.
          </p>
          <ul class="mb-3 ps-3">
            <li>Laboratorio: <strong><%= laboratorio.laboratorio %></strong></li>
            <li>Facultad: <strong><%= laboratorio.facultad %></strong></li>
          </ul>
          <p class="mb-0 by-request-card__url"><%= byRequestUrl %></p>
        </div>
        <div class="col-12 col-lg-5 text-center">
          <div class="by-request-card__qr-wrap">
            <img class="by-request-card__qr" src="<%= qrDataUrl %>" alt="Código QR para solicitar préstamos">
          </div>
          <div class="small text-muted mt-2">Escanéame</div>
        </div>
      </div>
    </div>
  </section>

  <section class="by-request-shell d-flex flex-wrap gap-2 justify-content-end mt-4">
    <a class="btn btn-perso btn-sm" href="/milab/prestamos/activacion/laboratorios/<%= laboratorio.ualId %>">
      Volver al laboratorio
    </a>
    <a
      class="btn btn-perso btn-sm"
      href="/milab/prestamos/activacion/laboratorios/<%= laboratorio.ualId %>/by-request/poster.pdf?orientation=portrait"
      target="_blank"
      rel="noopener"
    >
      Descargar Plantilla QR vertical
    </a>
    <a
      class="btn btn-perso btn-sm"
      href="/milab/prestamos/activacion/laboratorios/<%= laboratorio.ualId %>/by-request/poster.pdf?orientation=landscape"
      target="_blank"
      rel="noopener"
    >
      Descargar Plantilla QR horizontal
    </a>
  </section>
</main>

<%- include('../../../partials/footer'); -%>
