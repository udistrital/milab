<%- include('../../../partials/header'); -%>

<style>
  .wizard-step-card {
    border-left: 0.25rem solid var(--bs-border-color);
  }

  .wizard-step-card--done {
    border-left-color: var(--bs-success);
  }

  .wizard-step-card--blocked {
    border-left-color: var(--bs-warning);
  }

  .wizard-step-number {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    background: var(--bs-secondary-bg);
  }
</style>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Paso a paso de activación</h1>
    <p class="app-page-subtitle">
      <strong><%= laboratorio.laboratorio %></strong> · <%= laboratorio.facultad %>
    </p>
  </section>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="status"><%= successMessage %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="card app-form-panel text-light mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center small mb-2">
        <span>Avance general</span>
        <strong><%= laboratorio.completion.percent %>%</strong>
      </div>
      <div class="progress" role="progressbar" aria-valuenow="<%= laboratorio.completion.percent %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar <%= laboratorio.canActivateLoans ? 'bg-success' : 'bg-warning' %>" style="width: <%= laboratorio.completion.percent %>%"></div>
      </div>
      <p class="small text-light-emphasis mb-0 mt-2">
        Completados <%= laboratorio.completion.completedCount %> de <%= laboratorio.completion.totalCount %> criterios para habilitar préstamos.
      </p>
    </div>
  </section>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
      <h2 class="h5 mb-0">Checklist para activar préstamos</h2>
      <% if (laboratorio.canActivateLoans) { %>
        <span class="badge bg-success">Listo para activar</span>
      <% } else { %>
        <span class="badge bg-warning text-dark">Pendiente</span>
      <% } %>
    </div>
    <div class="card-body">
      <div class="list-group list-group-flush">
        <% checklist.forEach(function(item) { %>
          <div class="list-group-item d-flex justify-content-between align-items-start gap-3 px-0">
            <div>
              <div class="fw-semibold"><%= item.label %></div>
              <div class="small text-light-emphasis"><%= item.detail %></div>
            </div>
            <span class="badge <%= item.ready ? 'bg-success' : 'bg-secondary' %>">
              <%= item.ready ? 'Cumple' : 'Falta' %>
            </span>
          </div>
        <% }) %>
      </div>
      <div class="d-flex justify-content-end mt-3">
        <% if (laboratorio.canActivateLoans) { %>
          <a class="btn btn-success btn-sm" href="/milab/prestamos/activacion/laboratorios/<%= laboratorio.ualId %>/activar-prestamos">
            Activar préstamos
          </a>
        <% } else { %>
          <button class="btn btn-outline-secondary btn-sm" type="button" disabled>
            Activa criterios pendientes para continuar
          </button>
        <% } %>
      </div>
    </div>
  </section>

  <section class="d-flex flex-column gap-3">
    <% steps.forEach(function(step) { %>
      <% const cardStateClass = step.done ? 'wizard-step-card--done' : (step.blocked ? 'wizard-step-card--blocked' : ''); %>
      <article class="card app-table-panel text-light wizard-step-card <%= cardStateClass %>">
        <div class="card-body d-flex flex-column gap-3">
          <div class="d-flex align-items-start justify-content-between gap-3">
            <div class="d-flex align-items-start gap-2">
              <span class="wizard-step-number"><%= step.order %></span>
              <div>
                <h2 class="h5 mb-1"><%= step.title %></h2>
                <p class="small text-light-emphasis mb-0"><%= step.description %></p>
              </div>
            </div>
            <div class="d-flex flex-column align-items-end gap-2">
              <% if (step.done) { %>
                <span class="badge bg-success">Completado</span>
              <% } else if (step.blocked) { %>
                <span class="badge bg-warning text-dark">Bloqueado</span>
              <% } else { %>
                <span class="badge bg-secondary">Pendiente</span>
              <% } %>
              <% if (step.optional) { %>
                <span class="badge text-bg-info">Opcional</span>
              <% } %>
            </div>
          </div>

          <div class="small">
            <strong>Estado actual:</strong> <%= step.statusLabel %>
          </div>

          <div class="d-flex justify-content-end">
            <% if (step.blocked) { %>
              <button class="btn btn-outline-secondary btn-sm" type="button" disabled>
                Completa pasos previos
              </button>
            <% } else { %>
              <a class="btn btn-perso btn-sm" href="<%= step.actionHref %>">
                <%= step.actionLabel %>
              </a>
            <% } %>
          </div>
        </div>
      </article>
    <% }) %>
  </section>

  <div class="mt-4">
    <a class="btn btn-outline-warning btn-sm me-2" href="/milab/prestamos/activacion/laboratorios/<%= laboratorio.ualId %>/by-request">
      Generar poster QR by Request
    </a>
    <a class="btn btn-outline-light btn-sm" href="/milab/prestamos/activacion/laboratorios">
      Volver al listado
    </a>
  </div>
</main>
