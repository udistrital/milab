<%- include('../../../partials/header'); -%>

<style>
  .activation-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    border: 1px solid rgba(15, 23, 42, 0.12);
    padding: 0.16rem 0.54rem;
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.82);
  }

  .activation-status-dot {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 999px;
    display: inline-block;
  }

  .activation-status-dot--green {
    background: #16a34a;
  }

  .activation-status-dot--yellow {
    background: #d97706;
  }

  .activation-status-dot--red {
    background: #dc2626;
  }

  .activation-status-dot--gray {
    background: #94a3b8;
  }

  .activation-check-item {
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 0.9rem;
    padding: 0.9rem;
    background: rgba(255, 255, 255, 0.65);
  }

  .activation-check-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.2rem;
  }

  .activation-check-detail {
    margin: 0;
    font-size: 0.86rem;
    color: #475569;
  }

  .activation-practice-choice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .activation-practice-choice .btn-check:checked + .activation-practice-option {
    background-color: #4858a1;
    box-shadow: 0 0 0 0.2rem rgba(23, 42, 71, 0.2);
  }

  .activation-lab-carousel {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 2.5rem;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .activation-lab-carousel__arrow {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid #e7e5e4;
    border-radius: 50%;
    background: #fff;
    color: #9a5b00;
    font-size: 1.15rem;
    text-decoration: none;
    box-shadow: 0 3px 10px rgba(120, 87, 30, 0.08);
  }

  .activation-lab-carousel__arrow:hover,
  .activation-lab-carousel__arrow:focus-visible {
    border-color: #e8b84a;
    background: #fff3d4;
    color: #9a5b00;
  }

  .activation-lab-carousel__current {
    min-width: 0;
    padding: 0.8rem 0.9rem;
    border: 1px solid #e7e5e4;
    border-radius: 0.8rem;
    background: #fff;
    box-shadow: 0 4px 12px rgba(120, 87, 30, 0.06);
  }

  @media (max-width: 575.98px) {
    .activation-lab-carousel {
      grid-template-columns: 2.25rem minmax(0, 1fr) 2.25rem;
      gap: 0.4rem;
    }

    .activation-lab-carousel__arrow {
      width: 2.25rem;
      height: 2.25rem;
    }
  }
</style>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Gestionar laboratorio</h1>
    <% if (!laboratoryCarousel || laboratoryCarousel.laboratorios.length <= 1) { %>
      <p class="app-page-subtitle"><strong><%= laboratorio.laboratorio %></strong> · <%= laboratorio.facultad %></p>
    <% } %>
  </section>

  <% if (laboratoryCarousel && laboratoryCarousel.laboratorios.length > 1) { %>
    <section class="activation-lab-carousel" aria-label="Navegar por los laboratorios">
      <a
        class="activation-lab-carousel__arrow"
        href="<%= laboratoryCarousel.previousHref %>"
        aria-label="Laboratorio anterior"
      ><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
      <article class="activation-lab-carousel__current">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
          <div class="min-w-0">
            <div class="fw-bold text-uppercase"><%= laboratorio.laboratorio %></div>
            <div class="small text-muted"><%= laboratorio.facultad %><% if (laboratorio.dependencia) { %> · <%= laboratorio.dependencia %><% } %></div>
          </div>
          <% if (laboratorio.loanActivated) { %>
            <span class="badge text-bg-success">Activado</span>
          <% } else { %>
            <span class="badge text-bg-warning"><%= laboratorio.completion.percent %>% configurado</span>
          <% } %>
        </div>
        <div class="small text-muted mt-1" aria-live="polite">
          Laboratorio <%= laboratoryCarousel.selectedIndex + 1 %> de <%= laboratoryCarousel.laboratorios.length %>
        </div>
      </article>
      <a
        class="activation-lab-carousel__arrow"
        href="<%= laboratoryCarousel.nextHref %>"
        aria-label="Siguiente laboratorio"
      ><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
    </section>
  <% } %>

  <% if (successMessage) { %>
    <div class="alert alert-success" role="status"><%= successMessage %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="card app-form-panel text-light mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center small mb-2">
        <span>Avance general del laboratorio</span>
        <strong><%= laboratorio.completion.percent %>%</strong>
      </div>
      <div class="progress" role="progressbar" aria-valuenow="<%= laboratorio.completion.percent %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar <%= laboratorio.canActivateLoans ? 'bg-success' : 'bg-warning' %>" style="width: <%= laboratorio.completion.percent %>%"></div>
      </div>
      <p class="small text-light-emphasis mt-2 mb-0">
        Completados <%= laboratorio.completion.completedCount %> de <%= laboratorio.completion.totalCount %> criterios.
      </p>
    </div>
  </section>

  <section class="card app-table-panel text-light mb-4">
    <div class="card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
      <h2 class="h5 mb-0">Checklist para activar préstamos</h2>
      <% if (laboratorio.loanActivated) { %>
        <span class="badge bg-success">Activado</span>
      <% } else if (laboratorio.canActivateLoans) { %>
        <span class="badge bg-success">Listo para activar</span>
      <% } else { %>
        <span class="badge bg-warning text-dark">Pendiente</span>
      <% } %>
    </div>
    <div class="card-body">
      <div class="d-flex flex-column gap-3">
        <% checklist.forEach(function(item) { %>
          <div class="activation-check-item d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div class="flex-grow-1">
              <div class="d-flex align-items-start justify-content-between gap-3 mb-2 flex-wrap">
                <div class="activation-check-title"><%= item.label %></div>
                <span class="badge <%= item.ready ? 'bg-success' : 'bg-warning text-dark' %>">
                  <%= item.ready ? 'Cumple' : 'Pendiente' %>
                </span>
              </div>
              <p class="activation-check-detail"><%= item.detail %></p>
              <% if (item.extraDetail) { %>
                <p class="activation-check-detail"><%= item.extraDetail %></p>
              <% } %>
              <% if (item.pendingDetail) { %>
                <p class="activation-check-detail mb-0"><strong>Tarea pendiente:</strong> <%= item.pendingDetail %></p>
              <% } %>
              <% if (item.showPracticeChoice) { %>
                <form action="<%= item.practiceChoiceAction %>" method="post" class="activation-practice-choice">
                  <%- include('../../../partials/csrf_field') %>
                  <input
                    class="btn-check"
                    type="radio"
                    id="laboratorioPracticasSi<%= laboratorio.ualId %>"
                    name="tiene_practicas"
                    value="true"
                    autocomplete="off"
                    required
                    <%= item.practiceChoice === 'true' ? 'checked' : '' %>
                  >
                  <label class="btn btn-perso btn-sm activation-practice-option" for="laboratorioPracticasSi<%= laboratorio.ualId %>">
                    Sí, tendrá prácticas
                  </label>
                  <input
                    class="btn-check"
                    type="radio"
                    id="laboratorioPracticasNo<%= laboratorio.ualId %>"
                    name="tiene_practicas"
                    value="false"
                    autocomplete="off"
                    required
                    <%= item.practiceChoice === 'false' ? 'checked' : '' %>
                  >
                  <label class="btn btn-perso btn-sm activation-practice-option" for="laboratorioPracticasNo<%= laboratorio.ualId %>">
                    No tendrá prácticas
                  </label>
                  <button class="btn btn-perso btn-sm" type="submit">
                    <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Guardar decisión
                  </button>
                </form>
              <% } %>
            </div>
            <% if (item.actionHref) { %>
              <a class="btn btn-outline-secondary btn-sm" href="<%= item.actionHref %>">
                <%= item.actionLabel || 'Gestionar' %>
              </a>
            <% } %>
          </div>
        <% }) %>
      </div>
      <div class="d-flex justify-content-end mt-3">
        <% if (laboratorio.canActivateLoans && !laboratorio.loanActivated) { %>
          <form action="/milab/prestamos/activacion/laboratorios/<%= laboratorio.ualId %>/activar-prestamos" method="post">
            <%- include('../../../partials/csrf_field') %>
            <button class="btn btn-success btn-sm" type="submit">Activar préstamos</button>
          </form>
        <% } %>
      </div>
    </div>
  </section>

  <div class="d-flex flex-wrap justify-content-center gap-2">
    <% if (laboratorio.loanActivated) { %>
      <a class="btn btn-perso btn-sm" href="/milab/prestamos/activacion/laboratorios/<%= laboratorio.ualId %>/by-request">
        Generar Plantilla QR
      </a>
    <% } %>
    <a class="btn btn-perso btn-sm" href="/milab/prestamos/activacion/laboratorios">
      Volver al listado
    </a>
  </div>
</main>

<%- include('../../../partials/footer'); -%>

