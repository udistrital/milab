<%- include('../../../partials/header'); -%>

<style>
  .activation-lab-card {
    border-radius: 1rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
  }

  .activation-lab-card .progress {
    height: 0.55rem;
    border-radius: 999px;
  }

  .activation-meta-pill {
    border-radius: 999px;
    border: 1px solid rgba(15, 23, 42, 0.12);
    padding: 0.18rem 0.62rem;
    font-size: 0.77rem;
    background: rgba(248, 250, 252, 0.65);
  }

  .activation-state {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    background: rgba(255, 255, 255, 0.8);
  }

  .activation-state__dot {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 999px;
    display: inline-block;
  }

  .activation-state__dot--green {
    background: #16a34a;
  }

  .activation-celebration {
    overflow: hidden;
    text-align: center;
  }

  .activation-celebration__icon {
    font-size: 4rem;
    color: #16a34a;
  }

  .activation-confetti {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .activation-confetti span {
    position: absolute;
    top: -1rem;
    left: calc(var(--confetti-index) * 6.25%);
    width: 0.55rem;
    height: 0.9rem;
    background: hsl(calc(var(--confetti-index) * 37), 80%, 55%);
    animation: activation-confetti-fall 1.8s ease-in forwards;
    animation-delay: calc(var(--confetti-index) * 45ms);
  }

  @keyframes activation-confetti-fall {
    to {
      transform: translateY(18rem) rotate(540deg);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .activation-confetti span {
      animation: none;
    }
  }

  .activation-state__dot--yellow {
    background: #d97706;
  }

  .activation-state__dot--red {
    background: #dc2626;
  }
</style>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Mis laboratorios</h1>
    <p class="app-page-subtitle">Configura inventario y activa préstamos con seguimiento por laboratorio.</p>
  </section>

  <% if (successMessage && !activationComplete) { %>
    <div class="alert alert-success" role="status"><%= successMessage %></div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <% if (!Array.isArray(laboratorios) || laboratorios.length === 0) { %>
    <div class="alert alert-info" role="status">No hay laboratorios asignados en tu alcance actual.</div>
  <% } else { %>
    <section class="row g-3">
      <% laboratorios.forEach(function(item) { %>
        <% const stateDot = item.state?.key === 'completo' || item.state?.key === 'listo'
          ? 'activation-state__dot--green'
          : item.state?.key === 'proceso'
            ? 'activation-state__dot--yellow'
            : 'activation-state__dot--red'; %>
        <article class="col-12 col-xl-6">
          <div class="card app-table-panel activation-lab-card text-light h-100">
            <div class="card-body d-flex flex-column gap-3">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                  <h2 class="h5 mb-1"><%= item.laboratorio %></h2>
                  <p class="small text-light-emphasis mb-0">
                    <%= item.facultad %><% if (item.dependencia) { %> · <%= item.dependencia %><% } %>
                  </p>
                </div>
                <span class="activation-state">
                  <span class="activation-state__dot <%= stateDot %>" aria-hidden="true"></span>
                  <%= item.state?.label || 'Pendiente' %>
                </span>
              </div>

              <div>
                <div class="d-flex justify-content-between align-items-center small mb-1">
                  <span>Avance general</span>
                  <strong><%= item.completion.percent %>%</strong>
                </div>
                <div class="progress" aria-label="Progreso de activación">
                  <div
                    class="progress-bar <%= item.canActivateLoans ? 'bg-success' : 'bg-warning' %>"
                    role="progressbar"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="<%= item.completion.percent %>"
                    style="width: <%= item.completion.percent %>%"
                  ></div>
                </div>
              </div>

              <div class="d-flex flex-wrap gap-2">
                <span class="activation-meta-pill">Inventarios pendientes: <strong><%= item.counters.pendingInventories %></strong></span>
                <span class="activation-meta-pill">Equipos listos: <strong><%= item.counters.equiposListos %></strong></span>
                <span class="activation-meta-pill">Horarios activos: <strong><%= item.counters.horariosActivos %></strong></span>
              </div>

              <div class="mt-auto d-flex flex-wrap gap-2">
                <a class="btn btn-perso btn-sm" href="/milab/prestamos/activacion/laboratorios/<%= item.ualId %>">
                  Configurar laboratorio
                </a>
                <% if (item.loanActivated) { %>
                  <a class="btn btn-perso btn-sm" href="/milab/prestamos/activacion/laboratorios/<%= item.ualId %>/by-request">
                    Plantilla QR
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </section>
  <% } %>
</main>

<% if (activationComplete) { %>
  <div class="modal fade" id="laboratoryActivationCelebration" tabindex="-1" aria-labelledby="laboratoryActivationCelebrationTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content position-relative activation-celebration">
        <div class="activation-confetti" aria-hidden="true">
          <% for (let confettiIndex = 0; confettiIndex < 16; confettiIndex += 1) { %>
            <span style="--confetti-index: <%= confettiIndex %>"></span>
          <% } %>
        </div>
        <div class="modal-body py-5">
          <div class="activation-celebration__icon" aria-hidden="true"><i class="bi bi-check-circle-fill"></i></div>
          <h2 class="h4 mt-3" id="laboratoryActivationCelebrationTitle">¡Laboratorio configurado!</h2>
          <p class="mb-4"><%= successMessage || 'La configuración del laboratorio se completó correctamente.' %></p>
          <button type="button" class="btn btn-success" data-bs-dismiss="modal">Continuar</button>
        </div>
      </div>
    </div>
  </div>
  <script nonce="<%= cspNonce %>">
    document.addEventListener('DOMContentLoaded', function() {
      var celebration = document.getElementById('laboratoryActivationCelebration');
      if (celebration && window.bootstrap && window.bootstrap.Modal) {
        window.bootstrap.Modal.getOrCreateInstance(celebration).show();
      }
    });
  </script>
<% } %>

<%- include('../../../partials/footer'); -%>

