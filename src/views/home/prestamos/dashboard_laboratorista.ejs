<%- include('../../partials/header'); -%>

<style>
  .loan-laboratory-card {
    border: 1px solid #e7e5e4;
    border-radius: 0.9rem;
    background: #fff;
    box-shadow: 0 5px 16px rgba(120, 87, 30, 0.07);
  }

  .loan-laboratory-carousel {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: 0.75rem;
  }

  .loan-laboratory-carousel.is-single {
    grid-template-columns: minmax(0, 1fr);
  }

  .loan-laboratory-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid #e7e5e4;
    border-radius: 50%;
    background: #fff;
    color: #9a5b00;
    font-size: 1.2rem;
    text-decoration: none;
  }

  .loan-laboratory-arrow:hover,
  .loan-laboratory-arrow:focus-visible {
    border-color: #e8b84a;
    background: #fff3d4;
    color: #9a5b00;
  }

  @media (max-width: 575.98px) {
    .loan-laboratory-carousel {
      grid-template-columns: 2.25rem minmax(0, 1fr) 2.25rem;
      gap: 0.4rem;
    }

    .loan-laboratory-arrow {
      width: 2.25rem;
      height: 2.25rem;
    }
  }
</style>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Mis laboratorios</h1>
    <p class="app-page-subtitle">
      Configura cada laboratorio para habilitar la gestión de préstamos.
    </p>
  </section>

  <% if (errorMessage) { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
  <% } %>

  <% const labs = Array.isArray(laboratorios) ? laboratorios : []; const selected = labs[selectedIndex] || null; %>
  <% if (!selected) { %>
    <div class="alert alert-info" role="status">No hay laboratorios asignados en tu alcance actual.</div>
  <% } else { %>
    <section
      class="loan-laboratory-carousel <%= labs.length > 1 ? '' : 'is-single' %>"
      aria-label="Laboratorios asignados"
    >
      <% if (previousLaboratorio) { %>
        <a
          class="loan-laboratory-arrow"
          href="/milab/prestamos/?laboratorio=<%= previousLaboratorio.ualId %>"
          aria-label="Laboratorio anterior"
        ><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
      <% } %>

      <article class="loan-laboratory-card p-3 p-md-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
          <div class="min-w-0">
            <h2 class="h5 mb-1 text-uppercase"><%= selected.laboratorio %></h2>
            <p class="small text-muted mb-0">
              <%= selected.facultad %><% if (selected.dependencia) { %> · <%= selected.dependencia %><% } %>
            </p>
          </div>
          <span class="badge text-bg-warning"><%= selected.completion?.percent || 0 %>% configurado</span>
        </div>

        <div class="progress mt-3 mb-3" role="progressbar" aria-valuenow="<%= selected.completion?.percent || 0 %>" aria-valuemin="0" aria-valuemax="100">
          <div
            class="progress-bar <%= selected.canActivateLoans ? 'bg-success' : 'bg-warning' %>"
            style="width: <%= selected.completion?.percent || 0 %>%"
          ></div>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-perso btn-sm" href="/milab/prestamos/activacion/laboratorios/<%= selected.ualId %>">
            Configurar laboratorio
          </a>
        </div>
      </article>

      <% if (nextLaboratorio) { %>
        <a
          class="loan-laboratory-arrow"
          href="/milab/prestamos/?laboratorio=<%= nextLaboratorio.ualId %>"
          aria-label="Siguiente laboratorio"
        ><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
      <% } %>
    </section>

    <% if (labs.length > 1) { %>
      <div class="small text-muted text-center mt-2" aria-live="polite">
        Laboratorio <%= selectedIndex + 1 %> de <%= labs.length %>
      </div>
    <% } %>
  <% } %>
</main>

<%- include('../../partials/footer'); -%>
