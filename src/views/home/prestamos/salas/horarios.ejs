<%- include('../../../partials/header'); -%>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Horarios UAL</h1>
    <p class="app-page-subtitle">
      <strong><%= sala && sala.nombre ? sala.nombre : 'Sala' %></strong>
      <% if (sala && sala.facultad && sala.laboratorio) { %>
        - <%= sala.facultad %> / <%= sala.laboratorio %>
      <% } %>
    </p>
  </section>

  <div id="horariosSalaAlerts">
    <% if (successMessage) { %>
      <div class="alert alert-success" role="alert"><%= successMessage %></div>
    <% } %>
    <% if (errorMessage) { %>
      <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
    <% } %>
  </div>

  <section class="card app-form-panel text-light mb-4">
    <div class="card-header d-flex justify-content-center align-items-center gap-3 flex-wrap">
      <h5 class="mb-0">Carga masiva de horarios</h5>
    </div>
    <div class="card-body">
      <form id="importarHorarioSalaForm" class="row g-3" novalidate>
        <div class="col-md-3">
          <label for="fechaInicioCargaSala" class="form-label">Fecha inicio *</label>
          <input type="date" class="form-control" id="fechaInicioCargaSala" required>
        </div>
        <div class="col-md-3">
          <label for="fechaFinCargaSala" class="form-label">Fecha fin *</label>
          <input type="date" class="form-control" id="fechaFinCargaSala" required disabled>
        </div>
        <div class="col-md-6">
          <label for="archivoHorariosSala" class="form-label">Archivo Excel (.xls/.xlsx)</label>
          <input
            type="file"
            class="form-control"
            id="archivoHorariosSala"
            accept=".xls,.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel"
            required
          >
        </div>
        <div class="col-12 d-flex justify-content-center align-items-center flex-wrap gap-2">
          <button
            type="button"
            class="btn btn-outline-primary"
            data-bs-toggle="modal"
            data-bs-target="#ayudaCargaHorariosModal"
          >
            Ayuda para preparar el Excel
          </button>
          <a class="btn btn-outline-primary" href="/milab/prestamos/salas/<%= sala.id %>/horarios/plantilla">
            Descargar Excel guía
          </a>
          <button type="submit" class="btn btn-perso" id="importarHorarioSalaSubmitBtn" data-submit-lock="true">
            Confirmar e importar horario
          </button>
        </div>
      </form>
      <p class="form-text mt-3 mb-0 text-center">
        La fecha de inicio debe ser lunes y la fecha fin domingo. La vigencia debe ser de una semana
        como mínimo y seis meses como máximo.
      </p>
    </div>
  </section>

  <section class="card app-table-panel text-light">
    <div class="card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
      <h5 class="mb-0">Horarios registrados</h5>
      <span class="badge text-bg-secondary"><%= Array.isArray(horarios) ? horarios.length : 0 %> horario(s)</span>
    </div>
    <div class="card-body">
      <% if (horarios && horarios.length > 0) { %>
        <div class="row g-3 align-items-end justify-content-center mb-4">
          <div class="col-sm-6 col-md-4">
            <label for="fechaSemanaRegistrada" class="form-label">Semana a visualizar</label>
            <input type="date" class="form-control" id="fechaSemanaRegistrada">
          </div>
          <div class="col-sm-6 col-md-4 d-flex justify-content-center">
            <button type="button" class="btn btn-warning text-dark" id="previsualizarHorariosRegistradosBtn">
              Previsualizar semana
            </button>
          </div>
        </div>
        <div id="calendarioHorariosRegistrados" class="table-responsive d-none mb-4">
          <table class="table table-sm table-bordered align-middle" id="horariosRegistradosCalendar">
            <thead></thead>
            <tbody></tbody>
          </table>
          <p class="small text-light-emphasis mb-0">
            Puedes marcar espacios vacíos como práctica libre; este paso es opcional.
          </p>
          <div class="d-flex justify-content-center mt-3">
            <button type="button" class="btn btn-perso d-none" id="guardarPracticaLibreBtn" data-submit-lock="true">
              Guardar espacios como práctica libre
            </button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle">
            <thead>
              <tr>
                <th>Contexto</th>
                <th>Franja</th>
                <th>Tipo</th>
                <th>Modalidad</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% horarios.forEach(function(item) { %>
                <tr>
                  <td>
                    <% if (item.fecha) { %>
                      <span><%= new Date(item.fecha).toLocaleDateString('es-CO', { timeZone: 'America/Bogota' }) %></span>
                    <% } else { %>
                      <span>
                        <%= ({
                          0: 'Domingo',
                          1: 'Lunes',
                          2: 'Martes',
                          3: 'Miercoles',
                          4: 'Jueves',
                          5: 'Viernes',
                          6: 'Sabado'
                        })[item.dia_semana] || 'Sin definir' %>
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <%= String(item.hora_inicio || '').slice(0, 5) %>
                    -
                    <%= String(item.hora_fin || '').slice(0, 5) %>
                  </td>
                  <td class="text-capitalize"><%= item.tipo_practica || '-' %></td>
                  <td class="text-capitalize"><%= item.modalidad_libre || '-' %></td>
                  <td>
                    <span class="badge <%= item.activo ? 'bg-success' : 'bg-secondary' %>">
                      <%= item.activo ? 'Activo' : 'Inactivo' %>
                    </span>
                  </td>
                  <td class="text-end">
                    <button
                      type="button"
                      class="btn btn-outline-danger btn-sm js-delete-horario-sala"
                      data-horario-id="<%= item.id %>"
                      data-submit-lock="true"
                    >
                      Eliminar
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="alert alert-info mb-0">No hay horarios registrados para esta sala.</div>
      <% } %>
    </div>
  </section>
  <div class="d-flex justify-content-center mt-4">
    <a class="btn btn-perso" href="<%= returnTo || '/milab/prestamos/activacion/laboratorios' %>">
      Volver al checklist
    </a>
  </div>
</main>

<div
  class="modal fade"
  id="ayudaCargaHorariosModal"
  tabindex="-1"
  aria-labelledby="ayudaCargaHorariosTitulo"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <span class="badge rounded-pill text-bg-light mb-2">Guía de carga</span>
          <h2 class="modal-title h5" id="ayudaCargaHorariosTitulo">Cómo preparar el Excel</h2>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <p>
          Usa una fila por cada bloque de clase y conserva los encabezados del ejemplo. El sistema
          utiliza el día y la hora para registrar los bloques como práctica docente/magistral.
        </p>
        <div class="table-responsive">
          <table class="table table-bordered align-middle">
            <thead>
              <tr>
                <th>Periodo</th>
                <th>Día</th>
                <th>Hora</th>
                <th>Asignatura</th>
                <th>Grupo</th>
                <th>Proyecto</th>
                <th>Inscritos</th>
                <th>Docente</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>2026-3</td>
                <td>LUNES</td>
                <td>6PM-7PM</td>
                <td>24908 - ROBÓTICA</td>
                <td>583-241</td>
                <td>583 - INGENIERÍA EN CONTROL</td>
                <td>23</td>
                <td>Nombre del docente</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="alert alert-info mb-0">
          El día debe ser de lunes a domingo y la hora debe indicar inicio y fin, por ejemplo
          <strong>6PM-7PM</strong>. La vigencia seleccionada aplica a cada bloque semanal. El
          sistema rechaza horarios duplicados o que se traslapen. Asignatura, grupo, proyecto,
          inscritos y docente son columnas de referencia del archivo; los horarios se guardan en la
          estructura existente de la UAL.
        </div>
      </div>
      <div class="modal-footer">
        <a class="btn btn-outline-primary me-auto" href="/milab/prestamos/salas/<%= sala.id %>/horarios/plantilla">
          Descargar Excel guía
        </a>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  (function() {
    var salaId = <%- JSON.stringify(sala && sala.id ? String(sala.id) : '') %>;
    var alertsContainer = document.getElementById('horariosSalaAlerts');
    var importForm = document.getElementById('importarHorarioSalaForm');
    var importInput = document.getElementById('archivoHorariosSala');
    var importButton = document.getElementById('importarHorarioSalaSubmitBtn');
    var fechaInicioCargaSala = document.getElementById('fechaInicioCargaSala');
    var fechaFinCargaSala = document.getElementById('fechaFinCargaSala');
    var weekInput = document.getElementById('fechaSemanaRegistrada');
    var previewRegisteredButton = document.getElementById('previsualizarHorariosRegistradosBtn');
    var calendarContainer = document.getElementById('calendarioHorariosRegistrados');
    var calendarTable = document.getElementById('horariosRegistradosCalendar');
    var saveFreePracticeButton = document.getElementById('guardarPracticaLibreBtn');
    var registeredSchedules = <%- JSON.stringify((horarios || []).map(function(item) {
      return {
        id: item.id,
        fecha: item.fecha instanceof Date ? item.fecha.toISOString().slice(0, 10) : String(item.fecha || '').slice(0, 10),
        dia_semana: item.dia_semana,
        hora_inicio: String(item.hora_inicio || '').slice(0, 5),
        hora_fin: String(item.hora_fin || '').slice(0, 5),
        tipo_practica: item.tipo_practica || 'docente',
        activo: Boolean(item.activo),
      };
    })) %>;

    if (!salaId || !alertsContainer) return;

    function showAlert(type, message) {
      var alert = document.createElement('div');
      alert.className = 'alert alert-' + type + ' alert-dismissible fade show';
      alert.setAttribute('role', 'alert');
      alert.innerHTML =
        message +
        '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>';
      alertsContainer.prepend(alert);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function postJson(url, payload) {
      var response = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': <%- JSON.stringify(csrfToken || '') %> },
        body: JSON.stringify(payload || {}),
      });

      var data = await response.json().catch(function() {
        return { success: false, message: 'No fue posible procesar la respuesta del servidor.' };
      });

      if (!response.ok || !data.success) {
        throw new Error(data.message || 'La operacion no pudo completarse.');
      }

      return data;
    }

    async function postFormData(url, formData) {
      var response = await fetch(url, {
        method: 'POST',
        headers: { 'X-CSRF-Token': <%- JSON.stringify(csrfToken || '') %> },
        body: formData,
      });

      var data = await response.json().catch(function() {
        return { success: false, message: 'No fue posible procesar la respuesta del servidor.' };
      });

      if (!response.ok || !data.success) {
        throw new Error(data.message || 'La operacion no pudo completarse.');
      }

      return data;
    }

    function addDays(date, days) {
      var result = new Date(date.getTime());
      result.setDate(result.getDate() + days);
      return result;
    }

    function dateKey(date) {
      return [
        date.getFullYear(),
        String(date.getMonth() + 1).padStart(2, '0'),
        String(date.getDate()).padStart(2, '0'),
      ].join('-');
    }

    fechaInicioCargaSala.addEventListener('change', function() {
      fechaFinCargaSala.value = '';
      fechaFinCargaSala.disabled = true;
      fechaFinCargaSala.removeAttribute('min');
      fechaFinCargaSala.removeAttribute('max');

      if (!fechaInicioCargaSala.value) return;

      var selectedStart = new Date(fechaInicioCargaSala.value + 'T12:00:00');
      if (selectedStart.getDay() !== 1) {
        fechaInicioCargaSala.value = '';
        showAlert('warning', 'La fecha de inicio debe ser un lunes.');
        return;
      }

      fechaFinCargaSala.min = dateKey(addDays(selectedStart, 6));
      fechaFinCargaSala.max = dateKey(addDays(selectedStart, 181));
      fechaFinCargaSala.disabled = false;
    });

    fechaFinCargaSala.addEventListener('change', function() {
      if (!fechaFinCargaSala.value) return;

      var selectedStart = new Date(fechaInicioCargaSala.value + 'T12:00:00');
      var selectedEnd = new Date(fechaFinCargaSala.value + 'T12:00:00');
      if (selectedEnd < selectedStart) {
        fechaFinCargaSala.value = '';
        showAlert('warning', 'La fecha fin no puede ser anterior a la fecha inicio.');
        return;
      }
      if (selectedEnd.getDay() !== 0) {
        fechaFinCargaSala.value = '';
        showAlert('warning', 'La fecha de fin debe ser un domingo.');
      }
    });

    if (weekInput && !weekInput.value) {
      var firstScheduleDate = registeredSchedules
        .filter(function(item) { return item.activo && /^\d{4}-\d{2}-\d{2}$/.test(item.fecha); })
        .map(function(item) { return item.fecha; })
        .sort()[0];
      weekInput.value = firstScheduleDate || dateKey(new Date());
    }

    function timeMinutes(value) {
      var parts = String(value || '').split(':').map(Number);
      return parts.length === 2 && parts.every(Number.isFinite) ? parts[0] * 60 + parts[1] : null;
    }

    function selectedFreeSlots() {
      if (!calendarContainer) return [];
      return Array.from(calendarContainer.querySelectorAll('.js-ual-free-slot:checked')).map(function(input) {
        return input.value;
      });
    }

    function renderRegisteredCalendar() {
      if (!weekInput || !weekInput.value || !calendarTable || !calendarContainer) return;

      var startDate = new Date(weekInput.value + 'T12:00:00');
      var days = Array.from({ length: 7 }, function(_item, index) {
        var date = addDays(startDate, index);
        return {
          date: dateKey(date),
          dayNumber: date.getDay(),
          label: new Intl.DateTimeFormat('es-CO', { weekday: 'short', day: '2-digit', month: 'short' }).format(date),
        };
      });
      var dateSet = new Set(days.map(function(day) { return day.date; }));
      var schedules = registeredSchedules.filter(function(item) {
        return item.activo && (dateSet.has(item.fecha) || (!item.fecha && item.dia_semana !== null));
      });
      var timeValues = schedules.flatMap(function(item) {
        return [timeMinutes(item.hora_inicio), timeMinutes(item.hora_fin)].filter(Number.isFinite);
      });
      var minMinute = timeValues.length ? Math.floor(Math.min.apply(null, timeValues) / 60) * 60 : 7 * 60;
      var maxMinute = timeValues.length ? Math.ceil(Math.max.apply(null, timeValues) / 60) * 60 : 20 * 60;
      if (maxMinute <= minMinute) maxMinute = minMinute + 60;

      var thead = calendarTable.querySelector('thead');
      var tbody = calendarTable.querySelector('tbody');
      thead.innerHTML = '';
      tbody.innerHTML = '';
      var header = document.createElement('tr');
      var timeHeader = document.createElement('th');
      timeHeader.textContent = 'Hora';
      header.appendChild(timeHeader);
      days.forEach(function(day) {
        var th = document.createElement('th');
        th.textContent = day.label;
        header.appendChild(th);
      });
      thead.appendChild(header);

      for (var minute = minMinute; minute < maxMinute; minute += 60) {
        var row = document.createElement('tr');
        var start = String(Math.floor(minute / 60)).padStart(2, '0') + ':' + String(minute % 60).padStart(2, '0');
        var endMinute = minute + 60;
        var end = String(Math.floor(endMinute / 60)).padStart(2, '0') + ':' + String(endMinute % 60).padStart(2, '0');
        var label = document.createElement('th');
        label.textContent = start + ' - ' + end;
        row.appendChild(label);

        days.forEach(function(day) {
          var td = document.createElement('td');
          var matching = schedules.filter(function(item) {
            var matchesDate = item.fecha
              ? item.fecha === day.date
              : Number(item.dia_semana) === day.dayNumber;
            var itemStart = timeMinutes(item.hora_inicio);
            var itemEnd = timeMinutes(item.hora_fin);
            return matchesDate && itemStart < endMinute && itemEnd > minute;
          });

          if (matching.length) {
            var badge = document.createElement('span');
            badge.className = 'badge ' + (matching.some(function(item) { return item.tipo_practica === 'docente'; }) ? 'bg-primary' : 'bg-success');
            badge.textContent = matching.some(function(item) { return item.tipo_practica === 'docente'; }) ? 'Docente' : 'Libre';
            td.appendChild(badge);
          } else {
            var wrapper = document.createElement('label');
            wrapper.className = 'd-flex justify-content-center';
            var checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.className = 'form-check-input js-ual-free-slot';
            checkbox.value = day.date + '|' + start + '|' + end;
            wrapper.appendChild(checkbox);
            td.appendChild(wrapper);
          }
          row.appendChild(td);
        });
        tbody.appendChild(row);
      }

      calendarContainer.classList.remove('d-none');
      if (saveFreePracticeButton) saveFreePracticeButton.classList.add('d-none');
    }

    if (importForm && importInput && importButton) {
      importForm.addEventListener('submit', async function(event) {
        event.preventDefault();

        if (!importInput.files || !importInput.files.length) {
          showAlert('danger', 'Selecciona un archivo de Excel para importar.');
          return;
        }
        if (!fechaInicioCargaSala.value || !fechaFinCargaSala.value) {
          showAlert('danger', 'Debes definir la fecha de inicio y fin de la carga.');
          return;
        }

        var file = importInput.files[0];
        var formData = new FormData();
        formData.append('archivo', file);
        formData.append('fecha_inicio', fechaInicioCargaSala.value);
        formData.append('fecha_fin', fechaFinCargaSala.value);

        try {
          window.MiLabSubmitLock.lock(importButton, 'Importando horarios...');
          var result = await postFormData(
            '/milab/prestamos/salas/' + encodeURIComponent(salaId) + '/horarios/importar',
            formData
          );
          showAlert('success', result.message || 'Horarios importados correctamente.');
          importForm.reset();
          window.setTimeout(function() {
            window.location.reload();
          }, 900);
        } catch (error) {
          showAlert('danger', error.message || 'No fue posible importar el archivo de horarios.');
        } finally {
          window.MiLabSubmitLock.release(importButton);
        }
      });
    }

    if (previewRegisteredButton) {
      previewRegisteredButton.addEventListener('click', renderRegisteredCalendar);
    }

    if (calendarContainer) {
      calendarContainer.addEventListener('change', function(event) {
        if (event.target && event.target.classList.contains('js-ual-free-slot')) {
          saveFreePracticeButton.classList.toggle('d-none', selectedFreeSlots().length === 0);
        }
      });
    }

    if (saveFreePracticeButton) {
      saveFreePracticeButton.addEventListener('click', async function() {
        var slots = selectedFreeSlots();
        if (!slots.length) return;
        try {
          window.MiLabSubmitLock.lock(saveFreePracticeButton, 'Guardando espacios...');
          var result = await postJson(
            '/milab/prestamos/salas/' + encodeURIComponent(salaId) + '/horarios/libres',
            { slots }
          );
          showAlert('success', result.message || 'Espacios de práctica libre guardados.');
          window.setTimeout(function() {
            window.location.reload();
          }, 700);
        } catch (error) {
          showAlert('danger', error.message || 'No fue posible guardar los espacios seleccionados.');
        } finally {
          window.MiLabSubmitLock.release(saveFreePracticeButton);
        }
      });
    }

    document.querySelectorAll('.js-delete-horario-sala').forEach(function(button) {
      button.addEventListener('click', async function() {
        var horarioId = button.getAttribute('data-horario-id');
        if (!horarioId || !(await window.MiLabDialogs.confirm('¿Deseas eliminar este horario?'))) return;

        var btn = button;

        try {
          window.MiLabSubmitLock.lock(btn, 'Eliminando horario...');
          var result = await postJson('/milab/prestamos/salas/horarios/' + encodeURIComponent(horarioId) + '/eliminar');
          showAlert('success', result.message || 'Horario eliminado correctamente.');
          window.setTimeout(function() {
            window.location.reload();
          }, 700);
        } catch (error) {
          if (error.message && error.message.indexOf('tiene practicas asociadas') >= 0) {
            try {
              var confirmResult = await postJson(
                '/milab/prestamos/salas/horarios/' + encodeURIComponent(horarioId) + '/eliminar',
                { confirmar_cierre: true }
              );
              showAlert('warning', confirmResult.message || 'Horario eliminado y reservas afectadas canceladas.');
              window.setTimeout(function() {
                window.location.reload();
              }, 700);
              return;
            } catch (confirmError) {
              showAlert('danger', confirmError.message || 'No fue posible cerrar el horario con sus reservas afectadas.');
            }
          } else {
            showAlert('danger', error.message || 'No fue posible eliminar el horario.');
          }
        } finally {
          window.MiLabSubmitLock.release(btn);
        }
      });
    });

  })();
</script>

<%- include('../../../partials/footer'); -%>
