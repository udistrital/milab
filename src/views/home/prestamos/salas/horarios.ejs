<%- include('../../../partials/header'); -%>

<style>
  #horariosRegistradosCalendar {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    width: 100%;
    min-width: 0;
    height: 100%;
    margin-bottom: 0;
  }

  #horariosRegistradosCalendar thead {
    display: block;
    min-width: 0;
  }

  #horariosRegistradosCalendar tbody {
    display: grid;
    grid-template-rows: repeat(var(--calendar-week-rows, 6), minmax(0, 1fr));
    min-height: 0;
    overflow: hidden;
  }

  #horariosRegistradosCalendar thead tr,
  #horariosRegistradosCalendar tbody tr {
    display: grid;
    grid-template-columns: 6rem repeat(7, minmax(0, 1fr));
    min-width: 0;
    min-height: 0;
  }

  #horariosRegistradosCalendar.ual-calendar-month thead tr,
  #horariosRegistradosCalendar.ual-calendar-month tbody tr {
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  #horariosRegistradosCalendar th,
  #horariosRegistradosCalendar td {
    display: block;
    min-width: 0;
  }

  #horariosRegistradosCalendar th,
  #horariosRegistradosCalendar td {
    padding: 0.2rem 0.35rem;
    overflow: hidden;
  }

  #horariosRegistradosCalendar .ual-calendar-time {
    width: 6rem;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .ual-calendar-dialog {
    width: min(96vw, 1400px);
    max-width: none;
    height: 94vh;
    margin: 3vh auto;
  }

  .ual-calendar-dialog .modal-content {
    height: 100%;
    overflow: hidden;
  }

  .ual-calendar-dialog .modal-header {
    flex: 0 0 auto;
    padding: 0.65rem 1rem 0.35rem;
  }

  .ual-calendar-dialog .modal-body {
    display: flex;
    min-height: 0;
    flex: 1 1 auto;
    flex-direction: column;
    overflow: hidden;
    padding: 0.4rem 1rem 0.6rem;
  }

  .ual-calendar-controls,
  .ual-calendar-footer {
    flex: 0 0 auto;
  }

  .ual-calendar-controls {
    margin-bottom: 0.35rem !important;
  }

  .ual-calendar-table-wrap {
    min-height: 0;
    flex: 1 1 auto;
    overflow: hidden;
  }

  #horariosRegistradosCalendar.ual-calendar-month tbody td {
    vertical-align: top;
  }

  #horariosRegistradosCalendar.ual-calendar-week--dense .form-check-input {
    width: 0.85rem;
    height: 0.85rem;
    margin: 0;
  }

  #horariosRegistradosCalendar th.ual-calendar-holiday,
  #horariosRegistradosCalendar td.ual-calendar-holiday {
    background-color: #fff3cd !important;
    color: #664d03 !important;
  }

  .ual-calendar-holiday-indicator {
    display: block;
    width: fit-content;
    margin: 0.1rem auto 0;
    font-size: 0.65rem;
  }

  #horariosRegistradosCalendar.ual-calendar-month .ual-calendar-holiday-indicator {
    display: inline-block;
    margin: 0;
    vertical-align: middle;
  }

  #horariosRegistradosCalendar.ual-calendar-month .ual-schedule-badge {
    margin-top: 0.1rem;
    padding: 0.05rem 0.25rem;
    font-size: 0.65rem;
    line-height: 1.15;
  }

  .ual-calendar-month-more {
    display: block;
    overflow: hidden;
    font-size: 0.7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .horario-actions-column {
    width: 10rem;
  }

  .horario-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .ual-schedule-badge {
    display: block;
    padding: 0.15rem 0.3rem;
    line-height: 1.1;
    text-align: left;
    cursor: default;
  }

  .ual-schedule-badge + .ual-schedule-badge {
    margin-top: 0.1rem;
  }

  .ual-schedule-badge__title,
  .ual-schedule-badge__meta {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ual-schedule-badge__meta {
    font-weight: 500;
    opacity: 0.9;
  }

  .ual-schedule-tooltip {
    --bs-tooltip-opacity: 1;
  }

  .ual-schedule-tooltip .tooltip-inner {
    max-width: 20rem;
    text-align: left;
    white-space: pre-line;
  }

  @media (max-width: 767.98px) {
    .ual-calendar-dialog {
      width: 100vw;
      height: 100dvh;
      margin: 0;
    }

    .ual-calendar-dialog .modal-body {
      padding-right: 0.4rem;
      padding-left: 0.4rem;
    }

    #horariosRegistradosCalendar .ual-calendar-time {
      width: 4.5rem;
      font-size: 0.65rem;
    }

    #horariosRegistradosCalendar th,
    #horariosRegistradosCalendar td {
      padding: 0.12rem 0.15rem;
      font-size: 0.7rem;
    }

    .ual-calendar-controls .btn {
      padding: 0.25rem 0.4rem;
      font-size: 0.75rem;
    }
  }
</style>

<main class="container app-page-shell">
  <section class="app-page-header">
    <h1 class="app-page-title">Horarios UAL</h1>
    <p class="app-page-subtitle">
      <strong><%= sala && sala.nombre ? sala.nombre : 'Sala' %></strong>
      <% if (sala && sala.facultad && sala.laboratorio) { %>
        - <%= sala.facultad %> / <%= sala.laboratorio %>
      <% } %>
    </p>
  </section>

  <div id="horariosSalaAlerts">
    <% if (successMessage) { %>
      <div class="alert alert-success" role="alert"><%= successMessage %></div>
    <% } %>
    <% if (errorMessage) { %>
      <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
    <% } %>
  </div>

  <section class="card app-form-panel text-light mb-4">
    <div class="card-header d-flex justify-content-center align-items-center gap-3 flex-wrap">
      <h5 class="mb-0">Carga masiva de horarios</h5>
    </div>
    <div class="card-body">
      <form id="importarHorarioSalaForm" class="row g-3" novalidate>
        <div class="col-md-3">
          <label for="fechaInicioCargaSala" class="form-label">Fecha inicio *</label>
          <input type="date" class="form-control" id="fechaInicioCargaSala" required>
        </div>
        <div class="col-md-3">
          <label for="fechaFinCargaSala" class="form-label">Fecha fin *</label>
          <input type="date" class="form-control" id="fechaFinCargaSala" required disabled>
        </div>
        <div class="col-md-6">
          <label for="archivoHorariosSala" class="form-label">Archivo Excel (.xls/.xlsx)</label>
          <input
            type="file"
            class="form-control"
            id="archivoHorariosSala"
            accept=".xls,.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel"
            required
          >
        </div>
        <div class="col-12 d-flex justify-content-center align-items-center flex-wrap gap-2">
          <button
            type="button"
            class="btn btn-outline-primary"
            data-bs-toggle="modal"
            data-bs-target="#ayudaCargaHorariosModal"
          >
            Ayuda para preparar el Excel
          </button>
          <a class="btn btn-outline-primary" href="/milab/prestamos/salas/<%= sala.id %>/horarios/plantilla">
            Descargar Excel guía
          </a>
          <button type="submit" class="btn btn-perso" id="importarHorarioSalaSubmitBtn" data-submit-lock="true">
            Confirmar e importar horario
          </button>
        </div>
      </form>
      <p class="form-text mt-3 mb-0 text-center">
        La fecha de inicio no puede ser anterior a hoy, debe ser lunes y la fecha fin domingo. La
        vigencia debe ser de una semana como mínimo y seis meses como máximo.
      </p>
    </div>
  </section>

  <section class="card app-table-panel text-light">
    <div class="card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
      <h5 class="mb-0">Horarios registrados</h5>
      <span class="badge text-bg-secondary"><%= Array.isArray(horarios) ? horarios.length : 0 %> horario(s)</span>
    </div>
    <div class="card-body">
      <% if (horarios && horarios.length > 0) { %>
        <div class="row g-3 align-items-end justify-content-center mb-4">
          <div class="col-sm-6 col-md-4">
            <label for="fechaSemanaRegistrada" class="form-label">Fecha de referencia</label>
            <input type="date" class="form-control" id="fechaSemanaRegistrada">
          </div>
          <div class="col-sm-6 col-md-4 d-flex justify-content-center">
            <button type="button" class="btn btn-warning text-dark" id="previsualizarHorariosRegistradosBtn">
              Previsualizar horario
            </button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle">
            <thead>
              <tr>
                <th>Contexto</th>
                <th>Franja</th>
                <th>Tipo de Práctica</th>
                <th>Modalidad</th>
                <th>Estado</th>
                <th class="text-end horario-actions-column">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% horarios.forEach(function(item) {
                const itemFechaKey = item.fecha
                  ? (item.fecha instanceof Date ? item.fecha.toISOString().slice(0, 10) : String(item.fecha).slice(0, 10))
                  : '';
                const itemEsFestivo = itemFechaKey && (festivos || []).some(function(festivo) {
                  return String(festivo.fecha || '').slice(0, 10) === itemFechaKey;
                });
              %>
                <tr>
                  <td>
                    <% if (item.fecha) { %>
                      <span><%= new Date(item.fecha).toLocaleDateString('es-CO', { timeZone: 'America/Bogota' }) %></span>
                    <% } else { %>
                      <span>
                        <%= ({
                          0: 'Domingo',
                          1: 'Lunes',
                          2: 'Martes',
                          3: 'Miercoles',
                          4: 'Jueves',
                          5: 'Viernes',
                          6: 'Sabado'
                        })[item.dia_semana] || 'Sin definir' %>
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <%= String(item.hora_inicio || '').slice(0, 5) %>
                    -
                    <%= String(item.hora_fin || '').slice(0, 5) %>
                  </td>
                  <td>
                    <%= item.tipo_practica === 'docente'
                      ? 'Docente / Clase Magistral'
                      : item.tipo_practica === 'libre'
                        ? 'Práctica libre'
                        : item.tipo_practica || '-' %>
                  </td>
                  <td>
                    <% if (item.tipo_practica === 'docente') { %>
                      No aplica
                    <% } else { %>
                      <%= ({
                        uno_a_uno: 'Uno a uno',
                        uno_a_varios: 'Uno a varios',
                        varios_a_uno: 'Varios a uno'
                      })[item.modalidad_libre] || item.modalidad_libre || '-' %>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge <%= item.activo ? 'bg-success' : 'bg-secondary' %>">
                      <%= item.activo ? 'Activo' : 'Inactivo' %>
                    </span>
                  </td>
                  <td class="horario-actions-column">
                    <div class="horario-actions">
                      <button
                        type="button"
                        class="btn btn-outline-primary btn-sm js-edit-horario-sala"
                        <%= itemEsFestivo ? 'disabled title="No se puede modificar un horario en un día festivo"' : '' %>
                        data-horario-id="<%= item.id %>"
                        data-fecha="<%= itemFechaKey %>"
                        data-dia-semana="<%= item.dia_semana !== null && item.dia_semana !== undefined ? item.dia_semana : '' %>"
                        data-hora-inicio="<%= String(item.hora_inicio || '').slice(0, 5) %>"
                        data-hora-fin="<%= String(item.hora_fin || '').slice(0, 5) %>"
                        data-tipo-practica="<%= item.tipo_practica || 'docente' %>"
                        data-modalidad-libre="<%= item.modalidad_libre || '' %>"
                        data-activo="<%= item.activo ? 'true' : 'false' %>"
                      >
                        Editar
                      </button>
                      <button
                        type="button"
                        class="btn btn-outline-danger btn-sm js-delete-horario-sala"
                        data-horario-id="<%= item.id %>"
                        data-submit-lock="true"
                      >
                        Eliminar
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="alert alert-info mb-0">No hay horarios registrados para esta sala.</div>
      <% } %>
    </div>
  </section>
  <div class="d-flex justify-content-center mt-4">
    <a class="btn btn-perso" href="<%= returnTo || '/milab/prestamos/activacion/laboratorios' %>">
      Volver al checklist
    </a>
  </div>
</main>

<div
  class="modal fade"
  id="ayudaCargaHorariosModal"
  tabindex="-1"
  aria-labelledby="ayudaCargaHorariosTitulo"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <span class="badge rounded-pill text-bg-light mb-2">Guía de carga</span>
          <h2 class="modal-title h5" id="ayudaCargaHorariosTitulo">Cómo preparar el Excel</h2>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <p>
          Usa una fila por cada bloque de clase y conserva los encabezados del ejemplo. El sistema
          utiliza el día y la hora para registrar los bloques como práctica docente/magistral.
        </p>
        <div class="table-responsive">
          <table class="table table-bordered align-middle">
            <thead>
              <tr>
                <th>Periodo</th>
                <th>Día</th>
                <th>Hora</th>
                <th>Asignatura</th>
                <th>Grupo</th>
                <th>Proyecto</th>
                <th>Inscritos</th>
                <th>Docente</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>2026-3</td>
                <td>LUNES</td>
                <td>6PM-7PM</td>
                <td>24908 - ROBÓTICA</td>
                <td>583-241</td>
                <td>583 - INGENIERÍA EN CONTROL</td>
                <td>23</td>
                <td>Nombre del docente</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="alert alert-info mb-0">
          El día debe ser de lunes a domingo y la hora debe indicar inicio y fin, por ejemplo
          <strong>6PM-7PM</strong>. La vigencia seleccionada aplica a cada bloque semanal. El
          sistema rechaza horarios duplicados o que se traslapen. La asignatura y el docente se
          guardan con cada bloque y se muestran en el calendario; grupo, proyecto e inscritos son
          columnas de referencia del archivo.
        </div>
      </div>
      <div class="modal-footer">
        <a class="btn btn-outline-primary me-auto" href="/milab/prestamos/salas/<%= sala.id %>/horarios/plantilla">
          Descargar Excel guía
        </a>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<div
  class="modal fade"
  id="calendarioHorariosUALModal"
  tabindex="-1"
  aria-labelledby="calendarioHorariosUALTitulo"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-xl ual-calendar-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h2 class="modal-title h5 mb-1" id="calendarioHorariosUALTitulo">Calendario de horarios UAL</h2>
          <p class="small text-muted mb-0">Los días sin horarios aparecen deshabilitados; los festivos están resaltados.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 ual-calendar-controls">
          <div class="btn-group" role="group" aria-label="Vista del calendario">
            <button type="button" class="btn btn-outline-primary active" data-calendar-mode="week">Semana</button>
            <button type="button" class="btn btn-outline-primary" data-calendar-mode="month">Mes</button>
          </div>
          <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-secondary" id="calendarioAnteriorBtn" aria-label="Periodo anterior">
              &lsaquo;
            </button>
            <strong id="calendarioPeriodoLabel" class="text-center"></strong>
            <button type="button" class="btn btn-outline-secondary" id="calendarioSiguienteBtn" aria-label="Periodo siguiente">
              &rsaquo;
            </button>
            <button type="button" class="btn btn-outline-primary" id="calendarioHoyBtn">Hoy</button>
          </div>
        </div>
        <div class="table-responsive ual-calendar-table-wrap">
          <table class="table table-sm table-bordered align-middle" id="horariosRegistradosCalendar">
            <thead></thead>
            <tbody></tbody>
          </table>
        </div>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2 ual-calendar-footer">
          <p class="small text-muted mb-0">
            En la vista semanal puedes marcar espacios vacíos de días configurados como práctica libre.
            <span class="badge text-bg-warning ms-1">Festivo</span>
          </p>
          <div class="d-flex flex-wrap align-items-end gap-2">
            <div class="d-none" id="modalidadPracticaLibreGroup">
              <label for="modalidadPracticaLibre" class="form-label mb-1">Modalidad</label>
              <select class="form-select" id="modalidadPracticaLibre">
                <option value="uno_a_uno">Uno a uno</option>
                <option value="uno_a_varios">Uno a varios</option>
                <option value="varios_a_uno">Varios a uno</option>
              </select>
            </div>
            <button type="button" class="btn btn-perso d-none" id="guardarPracticaLibreBtn" data-submit-lock="true">
              Guardar espacios como práctica libre
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div
  class="modal fade"
  id="editarHorarioSalaModal"
  tabindex="-1"
  aria-labelledby="editarHorarioSalaTitulo"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="editarHorarioSalaForm">
        <div class="modal-header">
          <h2 class="modal-title h5" id="editarHorarioSalaTitulo">Editar horario</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" id="editarHorarioError" role="alert"></div>
          <input type="hidden" id="editarHorarioSalaId">
          <div class="mb-3" id="editarHorarioFechaGroup">
            <label for="editarHorarioFecha" class="form-label">Fecha *</label>
            <input type="date" class="form-control" id="editarHorarioFecha" required>
          </div>
          <div class="mb-3 d-none" id="editarHorarioDiaGroup">
            <label for="editarHorarioDia" class="form-label">Día *</label>
            <select class="form-select" id="editarHorarioDia" required>
              <option value="1">Lunes</option>
              <option value="2">Martes</option>
              <option value="3">Miércoles</option>
              <option value="4">Jueves</option>
              <option value="5">Viernes</option>
              <option value="6">Sábado</option>
              <option value="0">Domingo</option>
            </select>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-6">
              <label for="editarHorarioInicio" class="form-label">Hora inicio *</label>
              <input type="time" class="form-control" id="editarHorarioInicio" required>
            </div>
            <div class="col-6">
              <label for="editarHorarioFin" class="form-label">Hora fin *</label>
              <input type="time" class="form-control" id="editarHorarioFin" required>
            </div>
          </div>
          <div class="mb-3">
            <label for="editarHorarioTipo" class="form-label">Tipo de Práctica *</label>
            <select class="form-select" id="editarHorarioTipo" required>
              <option value="docente">Docente / Clase Magistral</option>
              <option value="libre">Práctica libre</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="editarHorarioModalidad" class="form-label">Modalidad</label>
            <select class="form-select" id="editarHorarioModalidad">
              <option value="">No aplica</option>
              <option value="uno_a_uno">Uno a uno</option>
              <option value="uno_a_varios">Uno a varios</option>
              <option value="varios_a_uno">Varios a uno</option>
            </select>
            <div class="form-text" id="editarHorarioModalidadAyuda">
              La modalidad solo aplica para prácticas libres.
            </div>
          </div>
          <div>
            <label for="editarHorarioEstado" class="form-label">Estado *</label>
            <select class="form-select" id="editarHorarioEstado" required>
              <option value="true">Activo</option>
              <option value="false">Inactivo</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-perso" id="guardarEdicionHorarioBtn" data-submit-lock="true">
            Guardar cambios
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
  (function() {
    var salaId = <%- JSON.stringify(sala && sala.id ? String(sala.id) : '') %>;
    var alertsContainer = document.getElementById('horariosSalaAlerts');
    var importForm = document.getElementById('importarHorarioSalaForm');
    var importInput = document.getElementById('archivoHorariosSala');
    var importButton = document.getElementById('importarHorarioSalaSubmitBtn');
    var fechaInicioCargaSala = document.getElementById('fechaInicioCargaSala');
    var fechaFinCargaSala = document.getElementById('fechaFinCargaSala');
    var weekInput = document.getElementById('fechaSemanaRegistrada');
    var previewRegisteredButton = document.getElementById('previsualizarHorariosRegistradosBtn');
    var calendarModalEl = document.getElementById('calendarioHorariosUALModal');
    var calendarContainer = calendarModalEl;
    var calendarTable = document.getElementById('horariosRegistradosCalendar');
    var saveFreePracticeButton = document.getElementById('guardarPracticaLibreBtn');
    var freePracticeModalityGroup = document.getElementById('modalidadPracticaLibreGroup');
    var freePracticeModality = document.getElementById('modalidadPracticaLibre');
    var calendarPeriodLabel = document.getElementById('calendarioPeriodoLabel');
    var previousPeriodButton = document.getElementById('calendarioAnteriorBtn');
    var nextPeriodButton = document.getElementById('calendarioSiguienteBtn');
    var todayPeriodButton = document.getElementById('calendarioHoyBtn');
    var calendarModeButtons = document.querySelectorAll('[data-calendar-mode]');
    var calendarModal =
      calendarModalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal
        ? new bootstrap.Modal(calendarModalEl)
        : null;
    var editScheduleModalEl = document.getElementById('editarHorarioSalaModal');
    var editScheduleModal =
      editScheduleModalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal
        ? new bootstrap.Modal(editScheduleModalEl)
        : null;
    var editScheduleForm = document.getElementById('editarHorarioSalaForm');
    var editScheduleSaveButton = document.getElementById('guardarEdicionHorarioBtn');
    var calendarMode = 'week';
    var calendarAnchorDate = null;
    var calendarTooltips = [];
    var registeredSchedules = <%- JSON.stringify((horarios || []).map(function(item) {
      return {
        id: item.id,
        fecha: item.fecha instanceof Date ? item.fecha.toISOString().slice(0, 10) : String(item.fecha || '').slice(0, 10),
        dia_semana: item.dia_semana,
        hora_inicio: String(item.hora_inicio || '').slice(0, 5),
        hora_fin: String(item.hora_fin || '').slice(0, 5),
        tipo_practica: item.tipo_practica || 'docente',
        modalidad_libre: item.modalidad_libre || '',
        asignatura: String(item.asignatura || '').trim(),
        docente: String(item.docente || '').trim(),
        activo: Boolean(item.activo),
      };
    })).replace(/</g, '\\u003c') %>;
    var registeredHolidays = <%- JSON.stringify((festivos || []).map(function(item) {
      return {
        fecha: String(item.fecha || '').slice(0, 10),
        nombre: String(item.nombre || '').trim(),
      };
    })).replace(/</g, '\\u003c') %>;
    var holidayByDate = new Map(registeredHolidays.map(function(item) {
      return [item.fecha, item];
    }));

    if (!salaId || !alertsContainer) return;

    function showAlert(type, message) {
      var alert = document.createElement('div');
      alert.className = 'alert alert-' + type + ' alert-dismissible fade show';
      alert.setAttribute('role', 'alert');
      alert.innerHTML =
        message +
        '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>';
      alertsContainer.prepend(alert);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function postJson(url, payload, method) {
      var response = await fetch(url, {
        method: method || 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': <%- JSON.stringify(csrfToken || '') %> },
        body: JSON.stringify(payload || {}),
      });

      var data = await response.json().catch(function() {
        return { success: false, message: 'No fue posible procesar la respuesta del servidor.' };
      });

      if (!response.ok || !data.success) {
        throw new Error(data.message || 'La operacion no pudo completarse.');
      }

      return data;
    }

    async function postFormData(url, formData) {
      var response = await fetch(url, {
        method: 'POST',
        headers: { 'X-CSRF-Token': <%- JSON.stringify(csrfToken || '') %> },
        body: formData,
      });

      var data = await response.json().catch(function() {
        return { success: false, message: 'No fue posible procesar la respuesta del servidor.' };
      });

      if (!response.ok || !data.success) {
        throw new Error(data.message || 'La operacion no pudo completarse.');
      }

      return data;
    }

    function addDays(date, days) {
      var result = new Date(date.getTime());
      result.setDate(result.getDate() + days);
      return result;
    }

    function dateKey(date) {
      return [
        date.getFullYear(),
        String(date.getMonth() + 1).padStart(2, '0'),
        String(date.getDate()).padStart(2, '0'),
      ].join('-');
    }

    function currentDateKeyInBogota() {
      return new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Bogota',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).format(new Date());
    }

    fechaInicioCargaSala.min = currentDateKeyInBogota();

    fechaInicioCargaSala.addEventListener('change', function() {
      fechaFinCargaSala.value = '';
      fechaFinCargaSala.disabled = true;
      fechaFinCargaSala.removeAttribute('min');
      fechaFinCargaSala.removeAttribute('max');

      if (!fechaInicioCargaSala.value) return;
      if (fechaInicioCargaSala.value < currentDateKeyInBogota()) {
        fechaInicioCargaSala.value = '';
        showAlert('warning', 'La fecha de inicio no puede ser anterior a la fecha actual.');
        return;
      }

      var selectedStart = new Date(fechaInicioCargaSala.value + 'T12:00:00');
      if (selectedStart.getDay() !== 1) {
        fechaInicioCargaSala.value = '';
        showAlert('warning', 'La fecha de inicio debe ser un lunes.');
        return;
      }

      fechaFinCargaSala.min = dateKey(addDays(selectedStart, 6));
      fechaFinCargaSala.max = dateKey(addDays(selectedStart, 181));
      fechaFinCargaSala.disabled = false;
    });

    fechaFinCargaSala.addEventListener('change', function() {
      if (!fechaFinCargaSala.value) return;

      var selectedStart = new Date(fechaInicioCargaSala.value + 'T12:00:00');
      var selectedEnd = new Date(fechaFinCargaSala.value + 'T12:00:00');
      if (selectedEnd < selectedStart) {
        fechaFinCargaSala.value = '';
        showAlert('warning', 'La fecha fin no puede ser anterior a la fecha inicio.');
        return;
      }
      if (selectedEnd.getDay() !== 0) {
        fechaFinCargaSala.value = '';
        showAlert('warning', 'La fecha de fin debe ser un domingo.');
      }
    });

    if (weekInput && !weekInput.value) {
      var firstScheduleDate = registeredSchedules
        .filter(function(item) { return item.activo && /^\d{4}-\d{2}-\d{2}$/.test(item.fecha); })
        .map(function(item) { return item.fecha; })
        .sort()[0];
      weekInput.value = firstScheduleDate || dateKey(new Date());
    }

    function timeMinutes(value) {
      var parts = String(value || '').split(':').map(Number);
      return parts.length === 2 && parts.every(Number.isFinite) ? parts[0] * 60 + parts[1] : null;
    }

    function selectedFreeSlots() {
      if (!calendarContainer) return [];
      return Array.from(calendarContainer.querySelectorAll('.js-ual-free-slot:checked')).map(function(input) {
        return input.value;
      });
    }

    function getWeekStart(date) {
      return addDays(date, -((date.getDay() + 6) % 7));
    }

    function getHoliday(date) {
      return holidayByDate.get(date) || null;
    }

    function getDaySchedules(day) {
      if (getHoliday(day.date)) return [];
      return registeredSchedules.filter(function(item) {
        if (!item.activo) return false;
        return item.fecha
          ? item.fecha === day.date
          : item.dia_semana !== null && Number(item.dia_semana) === day.dayNumber;
      });
    }

    var modalityLabels = {
      uno_a_uno: 'Uno a uno',
      uno_a_varios: 'Uno a varios',
      varios_a_uno: 'Varios a uno',
    };

    function scheduleTooltipText(item) {
      var range = 'Horario: ' + item.hora_inicio + ' - ' + item.hora_fin;
      if (item.tipo_practica === 'docente') {
        return [
          'Asignatura: ' + (item.asignatura || 'Sin registrar'),
          'Docente: ' + (item.docente || 'Sin registrar'),
          'Tipo: Docente / Clase Magistral',
          range,
        ].join('\n');
      }
      return [
        'Tipo: Práctica libre',
        'Modalidad: ' + (modalityLabels[item.modalidad_libre] || 'Sin definir'),
        range,
      ].join('\n');
    }

    function buildScheduleBadge(item, options) {
      var isTeacherPractice = item.tipo_practica === 'docente';
      var title = isTeacherPractice ? item.asignatura || 'Clase magistral' : 'Práctica libre';
      var meta = isTeacherPractice ? item.docente : modalityLabels[item.modalidad_libre] || '';
      var tooltipText = scheduleTooltipText(item);
      var badge = document.createElement('span');
      badge.className =
        'badge ual-schedule-badge ' + (isTeacherPractice ? 'bg-primary' : 'bg-success');
      badge.tabIndex = 0;
      badge.title = tooltipText;

      var titleEl = document.createElement('span');
      titleEl.className = 'ual-schedule-badge__title';
      titleEl.textContent = (options.startPrefix ? item.hora_inicio + ' ' : '') + title;
      badge.appendChild(titleEl);

      var metaText = [options.range, options.hideMeta ? '' : meta].filter(Boolean).join(' · ');
      if (metaText) {
        var metaEl = document.createElement('span');
        metaEl.className = 'ual-schedule-badge__meta';
        metaEl.textContent = metaText;
        badge.appendChild(metaEl);
      }

      attachScheduleTooltip(badge);
      return badge;
    }

    function attachScheduleTooltip(element, title) {
      if (typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;
      if (title) element.title = title;
      calendarTooltips.push(
        new bootstrap.Tooltip(element, {
          animation: false,
          container: calendarModalEl,
          customClass: 'ual-schedule-tooltip',
        })
      );
    }

    function formatTime(minute) {
      return String(Math.floor(minute / 60)).padStart(2, '0') + ':' + String(minute % 60).padStart(2, '0');
    }

    function resetCalendar() {
      calendarTooltips.forEach(function(tooltip) {
        tooltip.dispose();
      });
      calendarTooltips = [];
      calendarTable.querySelector('thead').innerHTML = '';
      calendarTable.querySelector('tbody').innerHTML = '';
      saveFreePracticeButton.classList.add('d-none');
      freePracticeModalityGroup.classList.add('d-none');
    }

    function renderWeekCalendar() {
      var weekStart = getWeekStart(calendarAnchorDate);
      var weekdayFormatter = new Intl.DateTimeFormat('es-CO', { weekday: 'short' });
      var monthFormatter = new Intl.DateTimeFormat('es-CO', { month: 'short' });
      var days = Array.from({ length: 7 }, function(_item, index) {
        var date = addDays(weekStart, index);
        return {
          date: dateKey(date),
          dayNumber: date.getDay(),
          label: [
            weekdayFormatter.format(date).replace('.', ''),
            String(date.getDate()).padStart(2, '0'),
            monthFormatter.format(date).replace('.', ''),
          ].join(' '),
        };
      });
      var daySchedules = days.map(getDaySchedules);
      var schedules = daySchedules.flat();
      var timeValues = schedules.flatMap(function(item) {
        return [timeMinutes(item.hora_inicio), timeMinutes(item.hora_fin)].filter(Number.isFinite);
      });
      var minMinute = timeValues.length ? Math.floor(Math.min.apply(null, timeValues) / 60) * 60 : 7 * 60;
      var maxMinute = timeValues.length ? Math.ceil(Math.max.apply(null, timeValues) / 60) * 60 : 20 * 60;
      if (maxMinute <= minMinute) maxMinute = minMinute + 60;
      var slotCount = (maxMinute - minMinute) / 60;

      resetCalendar();
      calendarTable.classList.remove('ual-calendar-month');
      calendarTable.classList.add('ual-calendar-week');
      calendarTable.classList.toggle('ual-calendar-week--dense', slotCount >= 12);
      calendarTable.style.setProperty('--calendar-week-rows', String(slotCount));
      var header = document.createElement('tr');
      var timeHeader = document.createElement('th');
      timeHeader.className = 'ual-calendar-time';
      timeHeader.textContent = 'Hora';
      header.appendChild(timeHeader);
      days.forEach(function(day, index) {
        var th = document.createElement('th');
        th.textContent = day.label;
        if (!daySchedules[index].length) th.className = 'table-secondary text-muted';
        var holiday = getHoliday(day.date);
        if (holiday) {
          th.classList.add('ual-calendar-holiday');
          var holidayIndicator = document.createElement('span');
          holidayIndicator.className = 'badge text-bg-warning ual-calendar-holiday-indicator';
          holidayIndicator.textContent = 'Festivo';
          holidayIndicator.setAttribute('aria-label', 'Festivo: ' + holiday.nombre);
          th.appendChild(holidayIndicator);
          attachScheduleTooltip(holidayIndicator, holiday.nombre);
        }
        header.appendChild(th);
      });
      calendarTable.querySelector('thead').appendChild(header);

      for (var minute = minMinute; minute < maxMinute; minute += 60) {
        var row = document.createElement('tr');
        var endMinute = minute + 60;
        var start = formatTime(minute);
        var end = formatTime(endMinute);
        var label = document.createElement('th');
        label.className = 'ual-calendar-time';
        label.textContent = start + ' - ' + end;
        row.appendChild(label);

        days.forEach(function(day, index) {
          var td = document.createElement('td');
          var holiday = getHoliday(day.date);
          if (holiday) {
            td.classList.add('ual-calendar-holiday');
            td.setAttribute('aria-label', 'Festivo: ' + holiday.nombre);
          }
          if (!daySchedules[index].length) {
            td.classList.add('table-secondary', 'text-muted', 'text-center');
            td.textContent = 'Sin horario';
            row.appendChild(td);
            return;
          }

          var matching = daySchedules[index].filter(function(item) {
            var itemStart = timeMinutes(item.hora_inicio);
            var itemEnd = timeMinutes(item.hora_fin);
            return itemStart < endMinute && itemEnd > minute;
          });
          if (matching.length) {
            matching.forEach(function(item) {
              var matchesSlot = item.hora_inicio === start && item.hora_fin === end;
              td.appendChild(
                buildScheduleBadge(item, {
                  range: matchesSlot ? '' : item.hora_inicio + '-' + item.hora_fin,
                  hideMeta: slotCount >= 12,
                })
              );
            });
          } else {
            var wrapper = document.createElement('label');
            wrapper.className = 'd-flex justify-content-center';
            var checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.className = 'form-check-input js-ual-free-slot';
            checkbox.value = day.date + '|' + start + '|' + end;
            wrapper.appendChild(checkbox);
            td.appendChild(wrapper);
          }
          row.appendChild(td);
        });
        calendarTable.querySelector('tbody').appendChild(row);
      }

      calendarPeriodLabel.textContent =
        new Intl.DateTimeFormat('es-CO', { day: '2-digit', month: 'long', year: 'numeric' }).format(
          weekStart
        ) +
        ' – ' +
        new Intl.DateTimeFormat('es-CO', { day: '2-digit', month: 'long', year: 'numeric' }).format(
          addDays(weekStart, 6)
        );
    }

    function renderMonthCalendar() {
      var monthStart = new Date(
        calendarAnchorDate.getFullYear(),
        calendarAnchorDate.getMonth(),
        1,
        12
      );
      var gridStart = getWeekStart(monthStart);
      var weekdays = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
      resetCalendar();
      calendarTable.classList.remove('ual-calendar-week');
      calendarTable.classList.remove('ual-calendar-week--dense');
      calendarTable.classList.add('ual-calendar-month');
      calendarTable.style.removeProperty('--calendar-week-rows');

      var header = document.createElement('tr');
      weekdays.forEach(function(label) {
        var th = document.createElement('th');
        th.textContent = label;
        header.appendChild(th);
      });
      calendarTable.querySelector('thead').appendChild(header);

      for (var week = 0; week < 6; week += 1) {
        var row = document.createElement('tr');
        for (var dayIndex = 0; dayIndex < 7; dayIndex += 1) {
          var date = addDays(gridStart, week * 7 + dayIndex);
          var day = {
            date: dateKey(date),
            dayNumber: date.getDay(),
          };
          var daySchedules = getDaySchedules(day);
          var holiday = getHoliday(day.date);
          var td = document.createElement('td');
          td.className = 'align-top';
          if (date.getMonth() !== monthStart.getMonth() || !daySchedules.length) {
            td.classList.add('table-secondary', 'text-muted');
          }
          if (holiday) {
            td.classList.add('ual-calendar-holiday');
            td.setAttribute('aria-label', 'Festivo: ' + holiday.nombre);
          }

          var dateLabel = document.createElement('strong');
          dateLabel.className = holiday ? 'd-inline-block me-1 mb-0' : 'd-block mb-1';
          dateLabel.textContent = String(date.getDate());
          td.appendChild(dateLabel);
          if (holiday) {
            var holidayIndicator = document.createElement('span');
            holidayIndicator.className = 'badge text-bg-warning ual-calendar-holiday-indicator';
            holidayIndicator.textContent = 'Festivo';
            holidayIndicator.setAttribute('aria-label', 'Festivo: ' + holiday.nombre);
            td.appendChild(holidayIndicator);
            attachScheduleTooltip(holidayIndicator, holiday.nombre);
          }
          daySchedules.slice(0, 2).forEach(function(item) {
            td.appendChild(buildScheduleBadge(item, { startPrefix: true, hideMeta: true }));
          });
          if (daySchedules.length > 2) {
            var moreLabel = document.createElement('small');
            moreLabel.className = 'ual-calendar-month-more';
            moreLabel.textContent = '+' + (daySchedules.length - 2) + ' más';
            attachScheduleTooltip(
              moreLabel,
              daySchedules
                .slice(2)
                .map(function(item) {
                  return scheduleTooltipText(item);
                })
                .join('\n\n')
            );
            td.appendChild(moreLabel);
          }
          if (!daySchedules.length) {
            var disabledLabel = document.createElement('small');
            disabledLabel.className = 'd-block';
            disabledLabel.textContent = 'Sin horario';
            td.appendChild(disabledLabel);
          }
          row.appendChild(td);
        }
        calendarTable.querySelector('tbody').appendChild(row);
      }

      calendarPeriodLabel.textContent = new Intl.DateTimeFormat('es-CO', {
        month: 'long',
        year: 'numeric',
      }).format(monthStart);
    }

    function renderCalendar() {
      if (!calendarAnchorDate || !calendarTable) return;
      if (calendarMode === 'month') {
        renderMonthCalendar();
      } else {
        renderWeekCalendar();
      }
    }

    if (importForm && importInput && importButton) {
      importForm.addEventListener('submit', async function(event) {
        event.preventDefault();

        if (!importInput.files || !importInput.files.length) {
          showAlert('danger', 'Selecciona un archivo de Excel para importar.');
          return;
        }
        if (!fechaInicioCargaSala.value || !fechaFinCargaSala.value) {
          showAlert('danger', 'Debes definir la fecha de inicio y fin de la carga.');
          return;
        }
        if (fechaInicioCargaSala.value < currentDateKeyInBogota()) {
          showAlert('danger', 'La fecha de inicio no puede ser anterior a la fecha actual.');
          return;
        }

        var file = importInput.files[0];
        var formData = new FormData();
        formData.append('archivo', file);
        formData.append('fecha_inicio', fechaInicioCargaSala.value);
        formData.append('fecha_fin', fechaFinCargaSala.value);

        try {
          window.MiLabSubmitLock.lock(importButton, 'Importando horarios...');
          var result = await postFormData(
            '/milab/prestamos/salas/' + encodeURIComponent(salaId) + '/horarios/importar',
            formData
          );
          showAlert('success', result.message || 'Horarios importados correctamente.');
          importForm.reset();
          window.setTimeout(function() {
            window.location.reload();
          }, 900);
        } catch (error) {
          showAlert('danger', error.message || 'No fue posible importar el archivo de horarios.');
        } finally {
          window.MiLabSubmitLock.release(importButton);
        }
      });
    }

    var editScheduleDateGroup = document.getElementById('editarHorarioFechaGroup');
    var editScheduleDayGroup = document.getElementById('editarHorarioDiaGroup');
    var editScheduleDate = document.getElementById('editarHorarioFecha');
    var editScheduleDay = document.getElementById('editarHorarioDia');
    var editScheduleStart = document.getElementById('editarHorarioInicio');
    var editScheduleEnd = document.getElementById('editarHorarioFin');
    var editScheduleType = document.getElementById('editarHorarioTipo');
    var editScheduleModality = document.getElementById('editarHorarioModalidad');
    var editScheduleModalityHelp = document.getElementById('editarHorarioModalidadAyuda');
    var editScheduleActive = document.getElementById('editarHorarioEstado');
    var editScheduleId = document.getElementById('editarHorarioSalaId');
    var editScheduleError = document.getElementById('editarHorarioError');

    function syncEditScheduleModality() {
      var isTeacherPractice = editScheduleType.value === 'docente';
      editScheduleModality.disabled = isTeacherPractice;
      editScheduleModalityHelp.textContent = isTeacherPractice
        ? 'No aplica para Docente / Clase Magistral.'
        : 'Selecciona la modalidad para la práctica libre.';
      if (isTeacherPractice) {
        editScheduleModality.value = '';
      } else if (!editScheduleModality.value) {
        editScheduleModality.value = 'uno_a_uno';
      }
    }

    editScheduleType.addEventListener('change', syncEditScheduleModality);

    document.querySelectorAll('.js-edit-horario-sala').forEach(function(button) {
      button.addEventListener('click', function() {
        if (!editScheduleModal) {
          showAlert('danger', 'No fue posible abrir el formulario de edición.');
          return;
        }

        var fecha = button.getAttribute('data-fecha') || '';
        var isDateSpecific = Boolean(fecha);
        editScheduleId.value = button.getAttribute('data-horario-id') || '';
        editScheduleDate.value = fecha;
        editScheduleDate.min = currentDateKeyInBogota();
        editScheduleDay.value = button.getAttribute('data-dia-semana') || '1';
        editScheduleDateGroup.classList.toggle('d-none', !isDateSpecific);
        editScheduleDayGroup.classList.toggle('d-none', isDateSpecific);
        editScheduleDate.required = isDateSpecific;
        editScheduleDay.required = !isDateSpecific;
        editScheduleStart.value = button.getAttribute('data-hora-inicio') || '';
        editScheduleEnd.value = button.getAttribute('data-hora-fin') || '';
        editScheduleType.value = button.getAttribute('data-tipo-practica') || 'docente';
        editScheduleModality.value = button.getAttribute('data-modalidad-libre') || '';
        editScheduleActive.value = button.getAttribute('data-activo') || 'true';
        editScheduleError.classList.add('d-none');
        editScheduleError.textContent = '';
        syncEditScheduleModality();
        editScheduleModal.show();
      });
    });

    if (editScheduleForm && editScheduleSaveButton) {
      editScheduleForm.addEventListener('submit', async function(event) {
        event.preventDefault();
        if (!editScheduleForm.reportValidity()) return;

        var isDateSpecific = !editScheduleDateGroup.classList.contains('d-none');
        if (isDateSpecific && editScheduleDate.value < currentDateKeyInBogota()) {
          showAlert('warning', 'La fecha del horario no puede ser anterior a la fecha actual.');
          return;
        }
        if (isDateSpecific && getHoliday(editScheduleDate.value)) {
          showAlert('warning', 'No se pueden agregar ni modificar horarios en un día festivo.');
          return;
        }

        var payload = {
          fecha: isDateSpecific ? editScheduleDate.value : '',
          dia_semana: isDateSpecific ? '' : editScheduleDay.value,
          hora_inicio: editScheduleStart.value,
          hora_fin: editScheduleEnd.value,
          tipo_practica: editScheduleType.value,
          modalidad_libre:
            editScheduleType.value === 'docente' ? '' : editScheduleModality.value,
          activo: editScheduleActive.value,
        };

        try {
          window.MiLabSubmitLock.lock(editScheduleSaveButton, 'Guardando cambios...');
          var result = await postJson(
            '/milab/prestamos/salas/' +
              encodeURIComponent(salaId) +
              '/horarios/' +
              encodeURIComponent(editScheduleId.value),
            payload,
            'PUT'
          );
          editScheduleModal.hide();
          showAlert('success', result.message || 'Horario actualizado correctamente.');
          window.setTimeout(function() {
            window.location.reload();
          }, 700);
        } catch (error) {
          editScheduleError.textContent =
            error.message || 'No fue posible actualizar el horario.';
          editScheduleError.classList.remove('d-none');
        } finally {
          window.MiLabSubmitLock.release(editScheduleSaveButton);
        }
      });
    }

    if (previewRegisteredButton) {
      previewRegisteredButton.addEventListener('click', function() {
        if (!weekInput.value || !calendarModal) {
          showAlert('warning', 'Selecciona una fecha para visualizar el calendario.');
          return;
        }
        calendarAnchorDate = new Date(weekInput.value + 'T12:00:00');
        calendarMode = 'week';
        calendarModeButtons.forEach(function(button) {
          button.classList.toggle('active', button.getAttribute('data-calendar-mode') === calendarMode);
        });
        renderCalendar();
        calendarModal.show();
      });
    }

    if (<%- JSON.stringify(Boolean(showCalendar)) %> && weekInput && previewRegisteredButton) {
      var today = new Date();
      var todayMonth = String(today.getMonth() + 1).padStart(2, '0');
      var todayDay = String(today.getDate()).padStart(2, '0');
      weekInput.value = today.getFullYear() + '-' + todayMonth + '-' + todayDay;
      previewRegisteredButton.click();
    }

    calendarModeButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        calendarMode = button.getAttribute('data-calendar-mode') === 'month' ? 'month' : 'week';
        calendarModeButtons.forEach(function(modeButton) {
          modeButton.classList.toggle(
            'active',
            modeButton.getAttribute('data-calendar-mode') === calendarMode
          );
        });
        renderCalendar();
      });
    });

    function moveCalendarPeriod(direction) {
      if (!calendarAnchorDate) return;
      if (calendarMode === 'month') {
        calendarAnchorDate = new Date(
          calendarAnchorDate.getFullYear(),
          calendarAnchorDate.getMonth() + direction,
          1,
          12
        );
      } else {
        calendarAnchorDate = addDays(getWeekStart(calendarAnchorDate), direction * 7);
      }
      weekInput.value = dateKey(calendarAnchorDate);
      renderCalendar();
    }

    if (previousPeriodButton) {
      previousPeriodButton.addEventListener('click', function() {
        moveCalendarPeriod(-1);
      });
    }

    if (nextPeriodButton) {
      nextPeriodButton.addEventListener('click', function() {
        moveCalendarPeriod(1);
      });
    }

    if (todayPeriodButton) {
      todayPeriodButton.addEventListener('click', function() {
        calendarAnchorDate = new Date(currentDateKeyInBogota() + 'T12:00:00');
        calendarMode = 'week';
        if (weekInput) weekInput.value = currentDateKeyInBogota();
        calendarModeButtons.forEach(function(button) {
          button.classList.toggle('active', button.getAttribute('data-calendar-mode') === 'week');
        });
        renderCalendar();
      });
    }

    if (calendarContainer) {
      calendarContainer.addEventListener('change', function(event) {
        if (event.target && event.target.classList.contains('js-ual-free-slot')) {
          var hasSelectedSlots = selectedFreeSlots().length > 0;
          saveFreePracticeButton.classList.toggle('d-none', !hasSelectedSlots);
          freePracticeModalityGroup.classList.toggle('d-none', !hasSelectedSlots);
        }
      });
    }

    if (saveFreePracticeButton) {
      saveFreePracticeButton.addEventListener('click', async function() {
        var slots = selectedFreeSlots();
        if (!slots.length) return;
        try {
          window.MiLabSubmitLock.lock(saveFreePracticeButton, 'Guardando espacios...');
          var result = await postJson(
            '/milab/prestamos/salas/' + encodeURIComponent(salaId) + '/horarios/libres',
            { slots, modalidad_libre: freePracticeModality.value }
          );
          showAlert('success', result.message || 'Espacios de práctica libre guardados.');
          window.setTimeout(function() {
            window.location.reload();
          }, 700);
        } catch (error) {
          showAlert('danger', error.message || 'No fue posible guardar los espacios seleccionados.');
        } finally {
          window.MiLabSubmitLock.release(saveFreePracticeButton);
        }
      });
    }

    document.querySelectorAll('.js-delete-horario-sala').forEach(function(button) {
      button.addEventListener('click', async function() {
        var horarioId = button.getAttribute('data-horario-id');
        if (!horarioId || !(await window.MiLabDialogs.confirm('¿Deseas eliminar este horario?'))) return;

        var btn = button;

        try {
          window.MiLabSubmitLock.lock(btn, 'Eliminando horario...');
          var result = await postJson('/milab/prestamos/salas/horarios/' + encodeURIComponent(horarioId) + '/eliminar');
          showAlert('success', result.message || 'Horario eliminado correctamente.');
          window.setTimeout(function() {
            window.location.reload();
          }, 700);
        } catch (error) {
          if (error.message && error.message.indexOf('tiene practicas asociadas') >= 0) {
            try {
              var confirmResult = await postJson(
                '/milab/prestamos/salas/horarios/' + encodeURIComponent(horarioId) + '/eliminar',
                { confirmar_cierre: true }
              );
              showAlert('warning', confirmResult.message || 'Horario eliminado y reservas afectadas canceladas.');
              window.setTimeout(function() {
                window.location.reload();
              }, 700);
              return;
            } catch (confirmError) {
              showAlert('danger', confirmError.message || 'No fue posible cerrar el horario con sus reservas afectadas.');
            }
          } else {
            showAlert('danger', error.message || 'No fue posible eliminar el horario.');
          }
        } finally {
          window.MiLabSubmitLock.release(btn);
        }
      });
    });

  })();
</script>

