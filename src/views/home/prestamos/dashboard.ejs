                        </p>
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2">
                          <p class="mb-0" style="font-size: 0.78rem; color: #6b7280;">
                            Inicio: <strong style="color: #374151;"><%= formatDate(loan.fecha_inicio) %></strong>
                          </p>
                          <p class="mb-0" style="font-size: 0.78rem; color: #6b7280;">
                            Devolución: <strong style="color: #374151;"><%= formatDate(loan.fecha_fin) %></strong>
                          </p>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div
                    class="d-flex flex-column align-items-center justify-content-center gap-2 text-center py-4"
                    style="color: #6b7280;"
                  >
                    <i class="bi bi-box-seam" style="font-size: 2rem; color: #7c3aed; opacity: 0.8;"></i>
                    <p class="mb-0" style="font-weight: 700; color: #374151;">Sin préstamos activos</p>
                    <p class="mb-0" style="font-size: 0.84rem;">Solicita un equipo desde el panel de accesos rápidos.</p>
                  </div>
                <% } %>
              </div>
            </article>
          </div>

          <div class="col-lg-6">
            <article class="card h-100" style="border-radius: 16px; border: 1px solid var(--app-border);">
              <div class="card-header d-flex justify-content-between align-items-center" style="background: transparent; border-bottom: 1px solid rgba(17, 24, 39, 0.06);">
                <h5 class="mb-0" style="font-weight: 800; color: #111827; font-size: 1rem;">
                  <i class="bi bi-hourglass-split me-2" style="color: #f59e0b;"></i>
                  Mis solicitudes pendientes
                </h5>
                <a
                  href="/milab/prestamos/mis-solicitudes"
                  class="btn btn-sm px-3"
                  style="border-radius: 10px; background: rgba(124, 58, 237, 0.06); color: #7c3aed; font-weight: 700; border: 1px solid rgba(124, 58, 237, 0.12);"
                >
                  Ver todas
                  <i class="bi bi-arrow-right-short ms-1"></i>
                </a>
              </div>
              <div class="card-body d-flex flex-column gap-3">
                <% if (pendingRequests && pendingRequests.length) { %>
                  <% pendingRequests.slice(0, 3).forEach(function(reqItem) { %>
                    <div
                      class="d-flex align-items-start gap-3 p-3"
                      style="border-radius: 14px; background: rgba(251, 146, 60, 0.04); border: 1px solid rgba(251, 146, 60, 0.10);"
                    >
                      <div
                        style="
                          width: 48px; height: 48px; border-radius: 12px; flex: 0 0 48px;
                          display: inline-flex; align-items: center; justify-content: center;
                          background: #ffffff; border: 1px solid rgba(17, 24, 39, 0.08);
                        "
                      >
                        <i class="bi bi-camera" style="font-size: 1.15rem; color: #6b7280;"></i>
                      </div>
                      <div class="flex-grow-1 min-w-0">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                          <h6 class="mb-0" style="font-weight: 800; color: #111827; font-size: 0.95rem;">
                            <%= reqItem.equipo_nombre || reqItem.nombre || 'Equipo' %>
                          </h6>
                          <span
                            class="badge"
                            style="
                              background: rgba(251, 146, 60, 0.14); color: #d97706;
                              padding: 0.35rem 0.7rem; border-radius: 999px; font-weight: 700; font-size: 0.72rem;
                            "
                          >
                            Pendiente
                          </span>
                        </div>
                        <p class="mb-1" style="font-size: 0.82rem; color: #6b7280;">
                          Código: <strong style="color: #374151;"><%= reqItem.equipo_codigo || reqItem.codigo || '-' %></strong>
                        </p>
                        <p class="mb-0" style="font-size: 0.78rem; color: #6b7280;">
                          Solicitado: <strong style="color: #374151;"><%= formatDate(reqItem.fecha_inicio || reqItem.fecha_solicitud) %></strong>
                        </p>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div
                    class="d-flex flex-column align-items-center justify-content-center gap-2 text-center py-4"
                    style="color: #6b7280;"
                  >
                    <i class="bi bi-patch-check" style="font-size: 2rem; color: #3b82f6; opacity: 0.8;"></i>
                    <p class="mb-0" style="font-weight: 700; color: #374151;">Sin solicitudes pendientes</p>
                    <p class="mb-0" style="font-size: 0.84rem;">Todas tus solicitudes han sido procesadas.</p>
                  </div>
                <% } %>
              </div>
            </article>
          </div>
        </section>
      <% } %>

      <section class="mt-4">
        <article class="card" style="border-radius: 16px; border: 1px solid var(--app-border);">
          <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2" style="background: transparent; border-bottom: 1px solid rgba(17, 24, 39, 0.06);">
            <div>
              <h5 class="mb-1" style="font-weight: 800; color: #111827; font-size: 1.05rem;">
                <i class="bi bi-bar-chart-line me-2" style="color: #111827; opacity: 0.7;"></i>
                Estadísticas de préstamos
              </h5>
              <p class="mb-0" style="font-size: 0.84rem; color: #6b7280;">
                Resumen general del estado del módulo de préstamos.
              </p>
            </div>
            <div class="d-flex align-items-center gap-2">
              <select class="form-select form-select-sm" style="border-radius: 10px; font-weight: 700; font-size: 0.82rem;">
                <option>Este mes</option>
                <option>Últimos 3 meses</option>
                <option>Últimos 6 meses</option>
                <option>Este año</option>
              </select>
            </div>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-lg-3 col-md-6">
                <div
                  class="p-4 h-100"
                  style="border-radius: 14px; background: rgba(17, 24, 39, 0.02); border: 1px solid rgba(17, 24, 39, 0.06);"
                >
                  <p class="mb-2" style="font-size: 0.82rem; font-weight: 700; color: #4b5563;">
                    Préstamos por estado
                  </p>
                  <div class="d-flex align-items-center gap-3">
                    <svg viewBox="0 0 36 36" width="72" height="72" aria-hidden="true">
                      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e5e7eb" stroke-width="4"/>
                      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#10b981" stroke-width="4"
                        stroke-dasharray="<%= ((statsData.finalizados || 0) / Math.max(1, (statsData.activos || 0) + (statsData.pendientes || 0) + (statsData.finalizados || 0)) * 100).toFixed(1) %> 100"
                        stroke-dashoffset="25" stroke-linecap="round"/>
                      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#7c3aed" stroke-width="4"
                        stroke-dasharray="<%= ((statsData.activos || 0) / Math.max(1, (statsData.activos || 0) + (statsData.pendientes || 0) + (statsData.finalizados || 0)) * 100).toFixed(1) %> 100"
                        stroke-dashoffset="<%= 25 - ((statsData.finalizados || 0) / Math.max(1, (statsData.activos || 0) + (statsData.pendientes || 0) + (statsData.finalizados || 0)) * 100) %>"
                        stroke-linecap="round"/>
                      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#f59e0b" stroke-width="4"
                        stroke-dasharray="<%= ((statsData.pendientes || 0) / Math.max(1, (statsData.activos || 0) + (statsData.pendientes || 0) + (statsData.finalizados || 0)) * 100).toFixed(1) %> 100"
                        stroke-dashoffset="<%= 25 - (((statsData.finalizados || 0) + (statsData.activos || 0)) / Math.max(1, (statsData.activos || 0) + (statsData.pendientes || 0) + (statsData.finalizados || 0)) * 100) %>"
                        stroke-linecap="round"/>
                    </svg>
                    <div class="d-flex flex-column gap-1" style="font-size: 0.78rem;">
                      <div class="d-flex align-items-center gap-2">
                        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: #7c3aed;"></span>
                        <span style="color: #4b5563;">
                          Activos <strong style="color: #111827;"><%= statsData.activos || 0 %></strong>
                        </span>
                      </div>
                      <div class="d-flex align-items-center gap-2">
                        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: #f59e0b;"></span>
                        <span style="color: #4b5563;">
                          Pendientes <strong style="color: #111827;"><%= statsData.pendientes || 0 %></strong>
                        </span>
                      </div>
                      <div class="d-flex align-items-center gap-2">
                        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: #10b981;"></span>
                        <span style="color: #4b5563;">
                          Finalizados <strong style="color: #111827;"><%= statsData.finalizados || 0 %></strong>
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-lg-3 col-md-6">
                <div
                  class="p-4 h-100"
                  style="border-radius: 14px; background: rgba(17, 24, 39, 0.02); border: 1px solid rgba(17, 24, 39, 0.06);"
                >
                  <p class="mb-2" style="font-size: 0.82rem; font-weight: 700; color: #4b5563;">
                    Préstamos por categoría
                  </p>
                  <div class="d-flex align-items-center gap-3">
                    <svg viewBox="0 0 36 36" width="72" height="72" aria-hidden="true">
                      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e5e7eb" stroke-width="4"/>
                      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#3b82f6" stroke-width="4"
                        stroke-dasharray="60 100" stroke-dashoffset="25" stroke-linecap="round"/>
                      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#06b6d4" stroke-width="4"
                        stroke-dasharray="33 100" stroke-dashoffset="-35" stroke-linecap="round"/>
                      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#8b5cf6" stroke-width="4"
                        stroke-dasharray="7 100" stroke-dashoffset="-68" stroke-linecap="round"/>
                    </svg>
                    <div class="d-flex flex-column gap-1" style="font-size: 0.78rem;">
                      <div class="d-flex align-items-center gap-2">
                        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: #3b82f6;"></span>
                        <span style="color: #4b5563;">Equipos</span>
                      </div>
                      <div class="d-flex align-items-center gap-2">
                        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: #06b6d4;"></span>
                        <span style="color: #4b5563;">Elementos</span>
                      </div>
                      <div class="d-flex align-items-center gap-2">
                        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: #8b5cf6;"></span>
                        <span style="color: #4b5563;">Otros</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-lg-3 col-md-6">
                <div
                  class="p-4 h-100 d-flex flex-column gap-2"
                  style="border-radius: 14px; background: rgba(17, 24, 39, 0.02); border: 1px solid rgba(17, 24, 39, 0.06);"
                >
                  <p class="mb-0" style="font-size: 0.82rem; font-weight: 700; color: #4b5563;">
                    Tasa de cumplimiento
                  </p>
                  <div class="d-flex align-items-center gap-3">
                    <svg viewBox="0 0 36 36" width="72" height="72" aria-hidden="true">
                      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e5e7eb" stroke-width="4"/>
                      <circle cx="18" cy="18" r="15.9" fill="none" stroke="#10b981" stroke-width="5"
                        stroke-dasharray="92 100" stroke-dashoffset="25" stroke-linecap="round"/>
                      <text x="18" y="20.35" text-anchor="middle" font-size="9" font-weight="800" fill="#111827">92%</text>
                    </svg>
                    <div style="font-size: 0.78rem;">
                      <p class="mb-1" style="font-weight: 700; color: #111827;">Devoluciones a tiempo</p>
                      <p class="mb-0" style="color: #059669; font-weight: 800;">
                        Excelente trabajo 🎉
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-lg-3 col-md-6">
                <div
                  class="p-4 h-100 d-flex flex-column gap-2"
                  style="border-radius: 14px; background: rgba(17, 24, 39, 0.02); border: 1px solid rgba(17, 24, 39, 0.06);"
                >
                  <p class="mb-0" style="font-size: 0.82rem; font-weight: 700; color: #4b5563;">
                    Tiempo promedio
                  </p>
                  <div class="d-flex align-items-center gap-3">
                    <div
                      style="
                        width: 72px; height: 72px; border-radius: 50%;
                        background: rgba(124, 58, 237, 0.08); color: #7c3aed;
                        display: inline-flex; align-items: center; justify-content: center;
                        border: 4px solid rgba(124, 58, 237, 0.18);
                      "
                    >
                      <i class="bi bi-alarm" style="font-size: 1.5rem;"></i>
                    </div>
                    <div style="font-size: 0.78rem;">
                      <p class="mb-1" style="font-weight: 800; color: #111827; font-size: 1.1rem;">
                        5.2 días
                      </p>
                      <p class="mb-0" style="color: #6b7280;">
                        Tiempo promedio de préstamo
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      </section>

      <% if (moduleCards && moduleCards.length) { %>
        <section class="mt-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 style="font-weight: 800; color: #111827; font-size: 1.05rem; margin: 0;">
              Módulos disponibles
            </h5>
          </div>
          <div class="row g-3">
            <% moduleCards.forEach(function(mod) { %>
              <div class="col-md-4 col-xl-3">
                <a
                  href="<%= mod.href %>"
                  class="card h-100 text-decoration-none d-block"
                  style="
                    border: 1px solid rgba(17, 24, 39, 0.08); border-radius: 16px;
                    transition: all 0.18s ease; background: #ffffff;
                  "
                  onmouseover="this.style.transform='translateY(-2px)';this.style.borderColor='rgba(124, 58, 237, 0.25)';this.style.boxShadow='0 14px 28px rgba(17, 24, 39, 0.08)';"
                  onmouseout="this.style.transform='';this.style.borderColor='';this.style.boxShadow='';"
                >
                  <div class="card-body d-flex flex-column gap-3">
                    <div
                      style="
                        width: 48px; height: 48px; border-radius: 12px;
                        display: inline-flex; align-items: center; justify-content: center;
                        background: <%= mod.tone || 'rgba(124, 58, 237, 0.12)' %>;
                        color: <%= mod.iconColor || '#7c3aed' %>;
                        font-size: 1.3rem;
                      "
                    >
                      <i class="bi <%= mod.icon || 'bi-box-seam' %>"></i>
                    </div>
                    <div>
                      <h6 class="mb-1" style="font-weight: 800; color: #111827; font-size: 0.98rem;">
                        <%= mod.label %>
                      </h6>
                      <p class="mb-0" style="font-size: 0.82rem; color: #6b7280; line-height: 1.5;">
                        <%= mod.description || '' %>
                      </p>
                    </div>
                    <div
                      class="d-inline-flex align-items-center gap-1 mt-auto"
                      style="font-weight: 700; font-size: 0.82rem; color: #7c3aed;"
                    >
                      Abrir módulo
                      <i class="bi bi-arrow-right-short"></i>
                    </div>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>
    </div>

    <div class="col-xl-4">
      <aside
        class="card"
        style="
          position: sticky; top: 1rem;
          border-radius: 18px;
          border: 1px solid var(--app-border);
          background: linear-gradient(180deg, #ffffff 0%, rgba(248, 250, 252, 0.8) 100%);
        "
      >
        <div class="card-body d-flex flex-column gap-4">
          <section>
            <h5 class="mb-3" style="font-weight: 800; color: #111827; font-size: 1rem;">
              <i class="bi bi-lightning-charge-fill me-2" style="color: #7c3aed;"></i>
              Accesos rápidos
            </h5>
            <div class="d-flex flex-column gap-2">
              <% if (quickLinks && quickLinks.length) { %>
                <% quickLinks.forEach(function(link) { %>
                  <a
                    href="<%= link.href %>"
                    class="d-flex align-items-center gap-3 p-3 text-decoration-none"
                    style="
                      border-radius: 14px;
                      border: 1px solid rgba(17, 24, 39, 0.06);
                      background: #ffffff;
                      transition: all 0.18s ease;
                    "
                    onmouseover="this.style.borderColor='rgba(124, 58, 237, 0.25)';this.style.background='rgba(124, 58, 237, 0.03)';"
                    onmouseout="this.style.borderColor='';this.style.background='';"
                  >
                    <div
                      style="
                        width: 40px; height: 40px; border-radius: 10px; flex: 0 0 40px;
                        display: inline-flex; align-items: center; justify-content: center;
                        background: <%= link.tone || 'rgba(124, 58, 237, 0.1)' %>;
                        color: <%= link.iconColor || '#7c3aed' %>;
                        font-size: 1rem;
                      "
                    >
                      <i class="bi <%= link.icon || 'bi-arrow-right-circle' %>"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                      <p class="mb-0" style="font-weight: 800; color: #111827; font-size: 0.92rem;">
                        <%= link.label %>
                      </p>
                      <% if (link.helper) { %>
                        <p class="mb-0" style="font-size: 0.78rem; color: #6b7280;">
                          <%= link.helper %>
                        </p>
                      <% } %>
                    </div>
                    <i class="bi bi-chevron-right" style="color: #9ca3af; font-size: 0.9rem;"></i>
                  </a>
                <% }) %>
              <% } %>

              <a
                href="<%= isManagementRole ? '/milab/prestamos/reportes' : '/milab/prestamos/mis-solicitudes' %>"
                class="d-flex align-items-center justify-content-center gap-2 mt-2 p-3 text-decoration-none"
                style="
                  border-radius: 14px;
                  border: 1px dashed rgba(124, 58, 237, 0.35);
                  background: rgba(124, 58, 237, 0.04);
                  color: #7c3aed;
                  font-weight: 800;
                  font-size: 0.9rem;
                "
              >
                Ver todas las opciones
                <i class="bi bi-arrow-right-short"></i>
              </a>
            </div>
          </section>

          <hr style="border-color: rgba(17, 24, 39, 0.08); margin: 0;">

          <section>
            <h5 class="mb-3" style="font-weight: 800; color: #111827; font-size: 1rem;">
              <i class="bi bi-activity me-2" style="color: #0ea5e9;"></i>
              Actividad reciente
            </h5>
            <div class="d-flex flex-column gap-3">
              <% if (recentActivity && recentActivity.length) { %>
                <% recentActivity.forEach(function(activity) { %>
                  <div class="d-flex align-items-start gap-3">
                    <div
                      style="
                        width: 32px; height: 32px; border-radius: 50%; flex: 0 0 32px;
                        display: inline-flex; align-items: center; justify-content: center;
                        background: <%= activity.tone || 'rgba(124, 58, 237, 0.12)' %>;
                        color: <%= activity.iconColor || '#7c3aed' %>;
                        font-size: 0.8rem;
                      "
                    >
                      <i class="bi <%= activity.icon || 'bi-circle-fill' %>"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                      <p class="mb-0" style="font-size: 0.86rem; font-weight: 700; color: #111827;">
                        <%= activity.title %>
                      </p>
                      <p class="mb-0" style="font-size: 0.76rem; color: #6b7280;">
                        <%= activity.subject || '' %>
                      </p>
                      <p class="mb-0" style="font-size: 0.72rem; color: #9ca3af; margin-top: 2px;">
                        <%= timeAgo(activity.date) %>
                      </p>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div
                  class="d-flex flex-column align-items-center justify-content-center gap-1 text-center py-3"
                  style="color: #9ca3af;"
                >
                  <i class="bi bi-clock-history" style="font-size: 1.5rem;"></i>
                  <p class="mb-0" style="font-size: 0.82rem; font-weight: 700; color: #6b7280;">
                    Sin actividad reciente
                  </p>
                  <p class="mb-0" style="font-size: 0.76rem;">
                    Las novedades aparecerán aquí.
                  </p>
                </div>
              <% } %>
            </div>

            <% if (isManagementRole) { %>
              <a
                href="/milab/prestamos/auditoria"
                class="d-flex align-items-center justify-content-center gap-2 mt-3 p-2 text-decoration-none"
                style="
                  border-radius: 12px;
                  color: #7c3aed;
                  font-weight: 700;
                  font-size: 0.84rem;
                "
              >
                Ver toda la actividad
                <i class="bi bi-arrow-right-short"></i>
              </a>
            <% } %>
          </section>
        </div>
      </aside>
    </div>
  </div>
</main>

<%- include('../../../partials/footer'); -%>
