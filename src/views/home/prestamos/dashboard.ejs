  <%- include('../../partials/footer') %>
  <script>
    (function () {
      const expandBtn = document.getElementById('btn-expand-modules');
      const allModules = document.getElementById('all-modules');
      if (!expandBtn || !allModules) {
        if (allModules) {
          allModules.style.display = 'block';
        }
        return;
      }
      expandBtn.addEventListener('click', function (ev) {
        ev.preventDefault();
        ev.stopPropagation();
        const isHidden = allModules.style.display === 'none' || allModules.style.display === '';
        allModules.style.display = isHidden ? 'block' : 'none';
        expandBtn.innerHTML = isHidden
          ? 'Ocultar opciones <i class="bi bi-arrow-up ms-1"></i>'
          : 'Ver todas las opciones <i class="bi bi-arrow-right ms-1"></i>';
      });
    })();
  </script>
