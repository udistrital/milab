<%- include('../../../partials/header'); -%>

<%
  const roles = Array.isArray(locals.roles) ? locals.roles : [];
  const primaryRole = (locals.tipo || '').toString().trim().toLowerCase();
  const isManagementRole = ['admin', 'coordinador', 'laboratorista', 'monitor'].includes(primaryRole);
  const isStudentOrTeacher = ['estudiante', 'docente'].includes(primaryRole);
  const statsData = locals.stats || {};
  const activeLoans = Array.isArray(locals.activeLoans) ? locals.activeLoans : [];
  const pendingRequests = Array.isArray(locals.pendingRequests) ? locals.pendingRequests : [];
  const recentActivity = Array.isArray(locals.recentActivity) ? locals.recentActivity : [];
  const moduleCards = Array.isArray(locals.moduleCards) ? locals.moduleCards : [];
  const quickLinks = Array.isArray(locals.quickLinks) ? locals.quickLinks : [];

  function formatDate(dateStr) {
    if (!dateStr) return '-';
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    const months = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
    return `${d.getDate()}/${months[d.getMonth()]}/${d.getFullYear()}`;
  }

  function timeAgo(dateStr) {
    if (!dateStr) return 'Hace un tiempo';
    const now = new Date();
    const d = new Date(dateStr);
    const diffMs = now.getTime() - d.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);
    if (diffMins < 1) return 'Ahora mismo';
    if (diffMins < 60) return `Hace ${diffMins} minuto${diffMins === 1 ? '' : 's'}`;
    if (diffHours < 24) return `Hace ${diffHours} hora${diffHours === 1 ? '' : 's'}`;
    if (diffDays < 30) return `Hace ${diffDays} día${diffDays === 1 ? '' : 's'}`;
    return formatDate(dateStr);
  }
%>

