<%- include('../../partials/header'); -%>
  <style>
    .prestamos-hero {
      background: linear-gradient(135deg, #f5f3ff 0%, #eef2ff 50%, #faf5ff 100%);
      border: 1px solid #e9d5ff;
      border-radius: 18px;
      padding: 28px 32px;
      position: relative;
      overflow: hidden;
    }
    .prestamos-hero-illustration {
      position: absolute;
      right: 24px;
      top: 50%;
      transform: translateY(-50%);
      width: 220px;
      height: 200px;
      opacity: 0.9;
      pointer-events: none;
    }
    .prestamos-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #7c3aed;
    }
    .prestamos-hero-title {
      font-size: 2rem;
      font-weight: 800;
      margin-top: 10px;
      margin-bottom: 8px;
      color: #1e1b4b;
